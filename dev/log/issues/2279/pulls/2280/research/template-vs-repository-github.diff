+++ .github/workflows/release-preflight.yml	2026-09-21 07:17:58.465957730 +0000
@@ -0,0 +1,70 @@
+name: Release Preflight
+
+# === PROVE THE RELEASE CAN BE PUBLISHED BEFORE BUILDING IT (issue #2221) ===
+#
+# A push to main exists to produce a release: if a credential that release
+# needs is missing or expired, that is the answer to the run, and everything
+# after it is spend. Before this workflow, DOCKERHUB_TOKEN was first touched by
+# a `docker/login-action` step that runs after npm has already published.
+#
+# The probe attempts a write (it opens a blob upload session and cancels it),
+# because a login proves nothing: ghcr.io hands a push-scoped token to any
+# credential it accepts, and docker.io answers an anonymous push-scope request
+# with 200 and silently narrows the scope to pull. See
+# scripts/registry-probe.lib.mjs for the measurements behind that.
+#
+# It lives in its own file, called from release.yml, because release.yml is
+# line-limited (scripts/check-file-line-limits.sh, issue #1593).
+
+on:
+  workflow_call:
+    secrets:
+      DOCKERHUB_USERNAME:
+        required: false
+      DOCKERHUB_TOKEN:
+        required: false
+
+permissions:
+  contents: read
+
+env:
+  GIT_CONFIG_COUNT: '1'
+  GIT_CONFIG_KEY_0: init.defaultBranch
+  GIT_CONFIG_VALUE_0: main
+
+jobs:
+  preflight:
+    name: Probe publishing credentials
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+      # Lets the probe confirm this runner can mint the OIDC token that npm
+      # trusted publishing needs, instead of finding out at `npm publish`.
+      id-token: write
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v7
+        with:
+          persist-credentials: false
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v7
+        with:
+          node-version: '24.x'
+
+      - name: Probe publishing credentials
+        id: preflight
+        env:
+          # A push to main and a manual dispatch publish, so they fail fast;
+          # everything else reports. The `github` context inside a reusable
+          # workflow is the caller's, so this reads the original event.
+          # Passed through the environment rather than interpolated into the
+          # `run:` line (zizmor template-injection).
+          PREFLIGHT_MODE: ${{ ((github.event_name == 'push' && github.ref == 'refs/heads/main') || github.event_name == 'workflow_dispatch') && 'release' || 'report' }}
+          DOCKERHUB_USERNAME: ${{ secrets.DOCKERHUB_USERNAME }}
+          DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}
+          # Reachability, not just writability: what an anonymous consumer gets
+          # for the images the last release published. Never blocking.
+          PREFLIGHT_PULL_TARGETS: docker.io/konard/hive-mind:latest docker.io/konard/hive-mind-dind:latest
+        run: node scripts/preflight-credentials.mjs --mode "$PREFLIGHT_MODE"
