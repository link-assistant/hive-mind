b01761395\",\"content\":\"{\\\"total_count\\\":12,\\\"workflows\\\":[{\\\"id\\\":197771173,\\\"node_id\\\":\\\"W_kwDOPUU0qc4Lyb-l\\\",\\\"name\\\":\\\"Cleanup Test Repositories\\\",\\\"path\\\":\\\".github/workflows/cleanup-test-repos.yml\\\",\\\"state\\\":\\\"active\\\",\\\"created_at\\\":\\\"2025-10-14T10:31:16.000Z\\\",\\\"updated_at\\\":\\\"2025-10-14T10:31:16.000Z\\\",\\\"url\\\":\\\"https://api.github.com/repos/link-assistant/hive-mind/actions/workflows/197771173\\\",\\\"html_url\\\":\\\"https://github.com/link-assistant/hive-mind/blob/main/.github/workflows/cleanup-test-repos.yml\\\",\\\"badge_url\\\":\\\"https://github.com/link-assistant/hive-mind/workflows/Cleanup%20Test%20Repositories/badge.svg\\\"},{\\\"id\\\":213106413,\\\"node_id\\\":\\\"W_kwDOPUU0qc4Ms77t\\\",\\\"name\\\":\\\"pages-build-deployment\\\",\\\"path\\\":\\\"dynamic/pages/pages-build-deployment\\\",\\\"state\\\":\\\"active\\\",\\\"created_at\\\":\\\"2025-12-04T22:57:32.000Z\\\",\\\"updated_at\\\":\\\"2025-12-04T22:57:32.000Z\\\",\\\"url\\\":\\\"https://api.github.com/repos/link-assistant/hive-mind/actions/workflows/213106413\\\",\\\"html_url\\\":\\\"https://github.com/link-assistant/hive-mind/actions/workflows/pages/pages-build-deployment\\\",\\\"badge_url\\\":\\\"https://github.com/link-assistant/hive-mind/actions/workflows/pages/pages-build-deployment/badge.svg\\\"},{\\\"id\\\":215589360,\\\"node_id\\\":\\\"W_kwDOPUU0qc4M2aHw\\\",\\\"name\\\":\\\"CI\\\",\\\"path\\\":\\\".github/workflows/ci.yml\\\",\\\"state\\\":\\\"active\\\",\\\"created_at\\\":\\\"2025-12-13T12:09:30.000Z\\\",\\\"updated_at\\\":\\\"2025-12-13T12:09:30.000Z\\\",\\\"url\\\":\\\"https://api.github.com/repos/link-assistant/hive-mind/actions/workflows/215589360\\\",\\\"html_url\\\":\\\"https://github.com/link-assistant/hive-mind/blob/main/.github/workflows/ci.yml\\\",\\\"badge_url\\\":\\\"https://github.com/link-assistant/hive-mind/workflows/CI/badge.svg\\\"},{\\\"id\\\":215799203,\\\"node_id\\\":\\\"W_kwDOPUU0qc4M3NWj\\\",\\