[2026-10-17T17:01:26.545Z] [INFO]           "before": "name: Test Hello World Scala\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n  build-and-test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Set up Scala\n        use: scala-lang/setup-scala@v1\n        with:\n          scala-version: \"2.13.12\"\n\n      - name: Compile and run HelloWorld\n        run: |\n          scalac HelloWorld.scala\n          scala HelloWorld\n\n      - name: Verify output\n        run: |\n          output=$(scala HelloWorld)\n          if [ \"$output\" = \"Hello, World!\" ]; then\n            echo \"Output matches expected value.\"\n          else\n            echo \"Expected: 'Hello, World!'\"\n            echo \"Got: '$output'\"\n            exit 1\n          fi",
