kill_condition in KILL_UNLOCK_CONDITIONS:\\n00810| \\t\\tif game_manager:\\n00811| \\t\\t\\tfor weapon_id in kill_condition.get(\\\"weapons\\\", []):\\n00812| \\t\\t\\t\\tif weapon_id in game_manager.unlocked_weapons:\\n00813| \\t\\t\\t\\t\\tgame_manager.unlocked_weapons[weapon_id] = false\\n00814| \\n00815| \\t\\tif active_item_manager:\\n00816| \\t\\t\\tfor item_type in kill_condition.get(\\\"active_items\\\", []):\\n00817| \\t\\t\\t\\tif item_type in active_item_manager.unlocked_active_items:\\n00818| \\t\\t\\t\\t\\tactive_item_manager.unlocked_active_items[item_type] = false\\n00819| \\n00820| \\t\\tif grenade_manager:\\n00821| \\t\\t\\tfor grenade_type in kill_condition.get(\\\"grenades\\\", []):\\n00822| \\t\\t\\t\\tif grenade_type in grenade_manager.unlocked_grenades:\\n00823| \\t\\t\\t\\t\\tgrenade_manager.unlocked_grenades[grenade_type] = false\\n00824| \\n00825| \\t# Also reset items from all-difficulties conditions\\n00826| \\tfor all_diff_condition in ALL_DIFFICULTIES_UNLOCK_CONDITIONS:\\n00827| \\t\\tif game_manager:\\n00828| \\t\\t\\tfor weapon_id in all_diff_condition.get(\\\"weapons\\\", []):\\n00829| \\t\\t\\t\\tif weapon_id in game_manager.unlocked_weapons:\\n00830| \\t\\t\\t\\t\\tgame_manager.unlocked_weapons[weapon_id] = false\\n00831| \\n00832| \\t\\tif active_item_manager:\\n00833| \\t\\t\\tfor item_type in all_diff_condition.get(\\\"active_items\\\", []):\\n00834| \\t\\t\\t\\tif item_type in active_item_manager.unlocked_active_items:\\n00835| \\t\\t\\t\\t\\tactive_item_manager.unlocked_active_items[item_type] = false\\n00836| \\n00837| \\t\\tif grenade_manager:\\n00838| \\t\\t\\tfor grenade_type in all_diff_condition.get(\\\"grenades\\\", []):\\n00839| \\t\\t\\t\\tif grenade_type in grenade_manager.unlocked_grenades:\\n00840| \\t\\t\\t\\t\\tgrenade_manager.unlocked_grenades[grenade_type] = false\\n00841| \\n00842| \\t_log(\\\"Reset condition-gated items to locked state\\\")\\n00843| \\n00844| \\n00845| ## Reset condition-gated items to locked state on startup, then restore items that\\n00846| ## the player legitimately unlocked (i.e., they opened the case by holding LMB).\\n00847| ## PersistManager has already loaded the saved unlock state before this runs (deferred).\\n00848| ## The reset removes any incorrectly-saved states; the restore brings back valid unlocks.\\n00849| ## Issue #1052: items were reverting to locked state after game restart.\\n00850| func _reset_and_apply_all_unlocks() -> void:\\n00851| \\t# Snapshot which condition-gated items PersistManager already restored from the save file.\\n00852| \\tvar saved_weapons: Array[String] = _get_unlocked_condition_gated_weapons()\\n00853| \\tvar saved_grenades: Array[int] = _get_unlocked_condition_gated_grenades()\\n00854| \\tvar saved_active_items: Array[int] = _get_unlocked_condition_gated_active_items()\\n00855| \\n00856| \\t# Reset all condition-gated items to locked (removes corrupt / legacy unlock states).\\n00857| \\t_reset_condition_gated_items()\\n00858| \\n00859| \\t# Re-apply only items that were saved AND whose condition is currently met.\\n00860| \\t# Items unlocked without a met condition indicate corrupt data and stay locked.\\n00861| \\t_restore_saved_unlocks(saved_weapons, saved_grenades, saved_active_items)\\n00862| \\n00863| \\n00864| ## Collect weapon IDs from all condition tables that are currently marked as unlocked in GameManager.\\n00865| func _get_unlocked_condition_gated_weapons() -> Array[String]:\\n00866| \\tvar result: Array[String] = []\\n00867| \\tvar game_manager: Node = get_node_or_null(\\\"/root/GameManager\\\")\\n00868| \\tif not game_manager:\\n00869| \\t\\treturn result\\n00870| \\tfor condition_key in UNLOCK_CONDITIONS:\\n00871| \\t\\tfor weapon_id in UNLOCK_CONDITIONS[condition_key].get(\\\"weapons\\\", []):\\n00872| \\t\\t\\tif weapon_id not in result and game_manager.unlocked_weapons.get(weapon_id, false):\\n00873| \\t\\t\\t\\tresult.append(weapon_id)\\n00874| \\tfor multi_condition in MULTI_UNLOCK_CONDITIONS:\\n00875| \\t\\tfor weapon_id in multi_condition.get(\\\"weapons\\\", []):\\n00876| \\t\\t\\tif weapon_id not in result and game_manager.unlocked_weapons.get(weapon_id, false):\\n00877| \\t\\t\\t\\tresult.append(weapon_id)\\n00878| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n00879| \\t\\tfor weapon_id in kill_condition.get(\\\"weapons\\\", []):\\n00880| \\t\\t\\tif weapon_id not in result and game_manager.unlocked_weapons.get(weapon_id, false):\\n00881| \\t\\t\\t\\tresult.append(weapon_id)\\n00882| \\tfor all_diff_condition in ALL_DIFFICULTIES_UNLOCK_CONDITIONS:\\n00883| \\t\\tfor weapon_id in all_diff_condition.get(\\\"weapons\\\", []):\\n00884| \\t\\t\\tif weapon_id not in result and game_manager.unlocked_weapons.get(weapon_id, false):\\n00885| \\t\\t\\t\\tresult.append(weapon_id)\\n00886| \\treturn result\\n00887| \\n00888| \\n00889| ## Collect grenade types from all condition tables that are currently marked as unlocked.\\n00890| func _get_unlocked_condition_gated_grenades() -> Array[int]:\\n00891| \\tvar result: Array[int] = []\\n00892| \\tvar grenade_manager: Node = get_node_or_null(\\\"/root/GrenadeManager\\\")\\n00893| \\tif not grenade_manager:\\n00894| \\t\\treturn result\\n00895| \\tfor condition_key in UNLOCK_CONDITIONS:\\n00896| \\t\\tfor grenade_type in UNLOCK_CONDITIONS[condition_key].get(\\\"grenades\\\", []):\\n00897| \\t\\t\\tif grenade_type not in result and grenade_manager.unlocked_grenades.get(grenade_type, false):\\n00898| \\t\\t\\t\\tresult.append(grenade_type)\\n00899| \\tfor multi_condition in MULTI_UNLOCK_CONDITIONS:\\n00900| \\t\\tfor grenade_type in multi_condition.get(\\\"grenades\\\", []):\\n00901| \\t\\t\\tif grenade_type not in result and grenade_manager.unlocked_grenades.get(grenade_type, false):\\n00902| \\t\\t\\t\\tresult.append(grenade_type)\\n00903| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n00904| \\t\\tfor grenade_type in kill_condition.get(\\\"grenades\\\", []):\\n00905| \\t\\t\\tif grenade_type not in result and grenade_manager.unlocked_grenades.get(grenade_type, false):\\n00906| \\t\\t\\t\\tresult.append(grenade_type)\\n00907| \\tfor all_diff_condition in ALL_DIFFICULTIES_UNLOCK_CONDITIONS:\\n00908| \\t\\tfor grenade_type in all_diff_condition.get(\\\"grenades\\\", []):\\n00909| \\t\\t\\tif grenade_type not in result and grenade_manager.unlocked_grenades.get(grenade_type, false):\\n00910| \\t\\t\\t\\tresult.append(grenade_type)\\n00911| \\treturn result\\n00912| \\n00913| \\n00914| ## Collect active item types from all condition tables that are currently marked as unlocked.\\n00915| func _get_unlocked_condition_gated_active_items() -> Array[int]:\\n00916| \\tvar result: Array[int] = []\\n00917| \\tvar active_item_manager: Node = get_node_or_null(\\\"/root/ActiveItemManager\\\")\\n00918| \\tif not active_item_manager:\\n00919| \\t\\treturn result\\n00920| \\tfor condition_key in UNLOCK_CONDITIONS:\\n00921| \\t\\tfor item_type in UNLOCK_CONDITIONS[condition_key].get(\\\"active_items\\\", []):\\n00922| \\t\\t\\tif item_type not in result and active_item_manager.unlocked_active_items.get(item_type, false):\\n00923| \\t\\t\\t\\tresult.append(item_type)\\n00924| \\tfor multi_condition in MULTI_UNLOCK_CONDITIONS:\\n00925| \\t\\tfor item_type in multi_condition.get(\\\"active_items\\\", []):\\n00926| \\t\\t\\tif item_type not in result and active_item_manager.unlocked_active_items.get(item_type, false):\\n00927| \\t\\t\\t\\tresult.append(item_type)\\n00928| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n00929| \\t\\tfor item_type in kill_condition.get(\\\"active_items\\\", []):\\n00930| \\t\\t\\tif item_type not in result and active_item_manager.unlocked_active_items.get(item_type, false):\\n00931| \\t\\t\\t\\tresult.append(item_type)\\n00932| \\tfor all_diff_condition in ALL_DIFFICULTIES_UNLOCK_CONDITIONS:\\n00933| \\t\\tfor item_type in all_diff_condition.get(\\\"active_items\\\", []):\\n00934| \\t\\t\\tif item_type not in result and active_item_manager.unlocked_active_items.get(item_type, false):\\n00935| \\t\\t\\t\\tresult.append(item_type)\\n00936| \\treturn result\\n00937| \\n00938| \\n00939| ## Restore saved unlock state for condition-gated items after a reset.\\n00940| ## Only items whose unlock condition is currently met are restored; others stay locked.\\n00941| func _restore_saved_unlocks(\\n00942| \\t\\tweapons: Array[String],\\n00943| \\t\\tgrenades: Array[int],\\n00944| \\t\\tactive_items: Array[int]) -> void:\\n00945| \\tvar game_manager: Node = get_node_or_null(\\\"/root/GameManager\\\")\\n00946| \\tvar grenade_manager: Node = get_node_or_null(\\\"/root/GrenadeManager\\\")\\n00947| \\tvar active_item_manager: Node = get_node_or_null(\\\"/root/ActiveItemManager\\\")\\n00948| \\n00949| \\tfor weapon_id in weapons:\\n00950| \\t\\tif game_manager and is_weapon_condition_met(weapon_id):\\n00951| \\t\\t\\tif weapon_id in game_manager.unlocked_weapons:\\n00952| \\t\\t\\t\\tgame_manager.unlocked_weapons[weapon_id] = true\\n00953| \\t\\t\\t\\t_log(\\\"Restored saved unlock for weapon: %s\\\" % weapon_id)\\n00954| \\t\\telse:\\n00955| \\t\\t\\t_log(\\\"Skipped restore for weapon '%s' (condition not met — treating as corrupt save)\\\" % weapon_id)\\n00956| \\n00957| \\tfor grenade_type in grenades:\\n00958| \\t\\tif grenade_manager and is_grenade_condition_met(grenade_type):\\n00959| \\t\\t\\tif grenade_type in grenade_manager.unlocked_grenades:\\n00960| \\t\\t\\t\\tgrenade_manager.unlocked_grenades[grenade_type] = true\\n00961| \\t\\t\\t\\t_log(\\\"Restored saved unlock for grenade type: %d\\\" % grenade_type)\\n00962| \\t\\telse:\\n00963| \\t\\t\\t_log(\\\"Skipped restore for grenade type %d (condition not met — treating as corrupt save)\\\" % grenade_type)\\n00964| \\n00965| \\tfor item_type in active_items:\\n00966| \\t\\tif active_item_manager and is_active_item_condition_met(item_type):\\n00967| \\t\\t\\tif item_type in active_item_manager.unlocked_active_items:\\n00968| \\t\\t\\t\\tactive_item_manager.unlocked_active_items[item_type] = true\\n00969| \\t\\t\\t\\t_log(\\\"Restored saved unlock for active item type: %d\\\" % item_type)\\n00970| \\t\\telse:\\n00971| \\t\\t\\t_log(\\\"Skipped restore for active item type %d (condition not met — treating as corrupt save)\\\" % item_type)\\n00972| \\n00973| \\n00974| ## Return a human-readable description of the unlock condition for a weapon.\\n00975| ## Used by the armory tooltip to show locked-item unlock requirements.\\n00976| ## @param weapon_id: The weapon ID to look up.\\n00977| ## @return: A string describing how to unlock this weapon, or \\\"\\\" if not found.\\n00978| func get_weapon_unlock_description(weapon_id: String) -> String:\\n00979| \\tfor condition_key in UNLOCK_CONDITIONS:\\n00980| \\t\\tvar condition: Dictionary = UNLOCK_CONDITIONS[condition_key]\\n00981| \\t\\tif weapon_id in condition.get(\\\"weapons\\\", []):\\n00982| \\t\\t\\treturn _build_single_level_description(condition_key, condition)\\n00983| \\tfor multi_condition in MULTI_UNLOCK_CONDITIONS:\\n00984| \\t\\tif weapon_id in multi_condition.get(\\\"weapons\\\", []):\\n00985| \\t\\t\\treturn _build_multi_level_description(multi_condition)\\n00986| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n00987| \\t\\tif weapon_id in kill_condition.get(\\\"weapons\\\", []):\\n00988| \\t\\t\\treturn _build_kill_condition_description(kill_condition)\\n00989| \\tfor all_diff_condition in ALL_DIFFICULTIES_UNLOCK_CONDITIONS:\\n00990| \\t\\tif weapon_id in all_diff_condition.get(\\\"weapons\\\", []):\\n00991| \\t\\t\\treturn tr(\\\"UNLOCK_COND_ALL_DIFFICULTIES\\\")\\n00992| \\treturn \\\"\\\"\\n00993| \\n00994| \\n00995| ## Return a human-readable description of the unlock condition for a grenade type.\\n00996| ## @param grenade_type: The grenade type int to look up.\\n00997| ## @return: A string describing how to unlock this grenade, or \\\"\\\" if not found.\\n00998| func get_grenade_unlock_description(grenade_type: int) -> String:\\n00999| \\tfor condition_key in UNLOCK_CONDITIONS:\\n01000| \\t\\tvar condition: Dictionary = UNLOCK_CONDITIONS[condition_key]\\n01001| \\t\\tif grenade_type in condition.get(\\\"grenades\\\", []):\\n01002| \\t\\t\\treturn _build_single_level_description(condition_key, condition)\\n01003| \\tfor multi_condition in MULTI_UNLOCK_CONDITIONS:\\n01004| \\t\\tif grenade_type in multi_condition.get(\\\"grenades\\\", []):\\n01005| \\t\\t\\treturn _build_multi_level_description(multi_condition)\\n01006| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n01007| \\t\\tif grenade_type in kill_condition.get(\\\"grenades\\\", []):\\n01008| \\t\\t\\treturn _build_kill_condition_description(kill_condition)\\n01009| \\tfor all_diff_condition in ALL_DIFFICULTIES_UNLOCK_CONDITIONS:\\n01010| \\t\\tif grenade_type in all_diff_condition.get(\\\"grenades\\\", []):\\n01011| \\t\\t\\treturn tr(\\\"UNLOCK_COND_ALL_DIFFICULTIES\\\")\\n01012| \\treturn \\\"\\\"\\n01013| \\n01014| \\n01015| ## Return a human-readable description of the unlock condition for an active item type.\\n01016| ## @param item_type: The active item type int to look up.\\n01017| ## @return: A string describing how to unlock this item, or \\\"\\\" if not found.\\n01018| func get_active_item_unlock_description(item_type: int) -> String:\\n01019| \\tfor condition_key in UNLOCK_CONDITIONS:\\n01020| \\t\\tvar condition: Dictionary = UNLOCK_CONDITIONS[condition_key]\\n01021| \\t\\tif item_type in condition.get(\\\"active_items\\\", []):\\n01022| \\t\\t\\treturn _build_single_level_description(condition_key, condition)\\n01023| \\tfor multi_condition in MULTI_UNLOCK_CONDITIONS:\\n01024| \\t\\tif item_type in multi_condition.get(\\\"active_items\\\", []):\\n01025| \\t\\t\\treturn _build_multi_level_description(multi_condition)\\n01026| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n01027| \\t\\tif item_type in kill_condition.get(\\\"active_items\\\", []):\\n01028| \\t\\t\\treturn _build_kill_condition_description(kill_condition)\\n01029| \\tfor all_diff_condition in ALL_DIFFICULTIES_UNLOCK_CONDITIONS:\\n01030| \\t\\tif item_type in all_diff_condition.get(\\\"active_items\\\", []):\\n01031| \\t\\t\\treturn tr(\\\"UNLOCK_COND_ALL_DIFFICULTIES\\\")\\n01032| \\treturn \\\"\\\"\\n01033| \\n01034| \\n01035| ## Level scene path to translation key mapping (mirrors UnlockTableMenu.LEVEL_NAMES).\\n01036| const _LEVEL_NAME_KEYS: Dictionary = {\\n01037| \\t\\\"res://scenes/levels/LabyrinthLevel.tscn\\\": \\\"LEVEL_LABYRINTH_NAME\\\",\\n01038| \\t\\\"res://scenes/levels/BuildingLevel.tscn\\\": \\\"LEVEL_BUILDING_NAME\\\",\\n01039| \\t\\\"res://scenes/levels/TestTier.tscn\\\": \\\"LEVEL_POLYGON_NAME\\\",\\n01040| \\t\\\"res://scenes/levels/CastleLevel.tscn\\\": \\\"LEVEL_CASTLE_NAME\\\",\\n01041| \\t\\\"res://scenes/levels/RevolverLevel.tscn\\\": \\\"LEVEL_DOUBLE_CORRIDOR_NAME\\\",\\n01042| \\t\\\"res://scenes/levels/BeachLevel.tscn\\\": \\\"LEVEL_BEACH_NAME\\\",\\n01043| \\t\\\"res://scenes/levels/DocksLevel.tscn\\\": \\\"LEVEL_DOCKS_NAME\\\",\\n01044| \\t\\\"res://scenes/levels/CityLevel.tscn\\\": \\\"LEVEL_CITY_NAME\\\",\\n01045| \\t\\\"res://scenes/levels/FactoryLevel.tscn\\\": \\\"LEVEL_FACTORY_NAME\\\",\\n01046| \\t\\\"res://scenes/levels/DecadenceLevel.tscn\\\": \\\"LEVEL_DECADENCE_NAME\\\",\\n01047| \\t\\\"res://scenes/levels/Labyrinth2Level.tscn\\\": \\\"LEVEL_LABYRINTH_COMPLEX_NAME\\\",\\n01048| \\t\\\"res://scenes/levels/SewerLevel.tscn\\\": \\\"LEVEL_SEWER_NAME\\\",\\n01049| \\t\\\"res://scenes/levels/RailwayStationLevel.tscn\\\": \\\"LEVEL_RAILWAY_STATION_NAME\\\",\\n01050| \\t\\\"res://scenes/levels/WinterForestLevel.tscn\\\": \\\"LEVEL_WINTER_FOREST_NAME\\\"\\n01051| }\\n01052| \\n01053| \\n01054| ## Build a description string for a single-level UNLOCK_CONDITIONS entry.\\n01055| func _build_single_level_description(condition_key: String, condition: Dictionary) -> String:\\n01056| \\tvar scene_path: String = _extract_scene_path(condition_key)\\n01057| \\tvar name_key: String = _LEVEL_NAME_KEYS.get(scene_path, \\\"\\\")\\n01058| \\tvar level_name: String = tr(name_key) if name_key != \\\"\\\" else scene_path.get_file().get_basename()\\n01059| \\tvar min_rank: String = condition.get(\\\"min_rank\\\", \\\"D\\\")\\n01060| \\tif min_rank == \\\"F\\\":\\n01061| \\t\\treturn tr(\\\"UNLOCK_COND_COMPLETE_LEVEL\\\") % level_name\\n01062| \\treturn tr(\\\"UNLOCK_COND_COMPLETE_LEVEL_AT_RANK\\\") % [level_name, min_rank]\\n01063| \\n01064| \\n01065| ## Build a description string for a MULTI_UNLOCK_CONDITIONS entry.\\n01066| func _build_multi_level_description(multi_condition: Dictionary) -> String:\\n01067| \\tvar parts: Array[String] = []\\n01068| \\tfor level_entry in multi_condition.get(\\\"levels\\\", []):\\n01069| \\t\\tvar path: String = level_entry.get(\\\"path\\\", \\\"\\\")\\n01070| \\t\\tvar min_rank: String = level_entry.get(\\\"min_rank\\\", \\\"S\\\")\\n01071| \\t\\tvar name_key: String = _LEVEL_NAME_KEYS.get(path, \\\"\\\")\\n01072| \\t\\tvar level_name: String = tr(name_key) if name_key != \\\"\\\" else path.get_file().get_basename()\\n01073| \\t\\tparts.append(\\\"%s %s\\\" % [level_name, min_rank])\\n01074| \\treturn tr(\\\"UNLOCK_COND_COMPLETE_MULTI\\\") % \\\" + \\\".join(parts)\\n01075| \\n01076| \\n01077| ## Build a description string for a KILL_UNLOCK_CONDITIONS entry.\\n01078| func _build_kill_condition_description(kill_condition: Dictionary) -> String:\\n01079| \\tvar stat: String = kill_condition.get(\\\"stat\\\", \\\"\\\")\\n01080| \\tvar min_kills: int = kill_condition.get(\\\"min_kills\\\", 0)\\n01081| \\tif stat == \\\"shots_fired_special_weapons\\\":\\n01082| \\t\\treturn tr(\\\"UNLOCK_COND_SHOTS_SPECIAL_WEAPONS\\\") % min_kills\\n01083| \\tif stat == \\\"total_deaths\\\":\\n01084| \\t\\treturn tr(\\\"UNLOCK_COND_TOTAL_DEATHS\\\") % min_kills\\n01085| \\tif stat == \\\"no_damage_levels_completed\\\":\\n01086| \\t\\treturn tr(\\\"UNLOCK_COND_NO_DAMAGE_LEVELS\\\") % min_kills\\n01087| \\tif stat == \\\"levels_completed_rank_a_or_higher\\\":\\n01088| \\t\\treturn tr(\\\"UNLOC