        "content": "1\t/**\n2\t * Reply variation groups (R-C2).\n3\t *\n4\t * A `ReplyVariationGroup` is a labelled set of strings that all\n5\t * answer the same prompt. `findCandidates(history, prompt)` returns\n6\t * outgoing user messages whose Sørensen-Dice similarity to `prompt`\n7\t * exceeds `threshold` — a tiny, dependency-free fuzzy ranker.\n8\t */\n9\t\n10\tconst bigrams = (s) => {\n11\t  const out = new Set();\n12\t  const t = s.toLowerCase();\n13\t  for (let i = 0; i < t.length - 1; i += 1) {\n14\t    out.add(t.slice(i, i + 2));\n15\t  }\n16\t  return out;\n17\t};\n18\t\n19\texport const dice = (a, b) => {\n20\t  const A = bigrams(a);\n21\t  const B = bigrams(b);\n22\t  if (A.size === 0 && B.size === 0) {\n23\t    return 1;\n24\t  }\n25\t  let inter = 0;\n26\t  for (const x of A) {\n27\t    if (B.has(x)) {\n28\t      inter += 1;\n29\t    }\n30\t  }\n31\t  return (2 * inter) / (A.size + B.size);\n32\t};\n33\t\n34\texport const findCandidates = (history, prompt, threshold = 0.4) =>\n35\t  history\n36\t    .map((m) => ({ message: m, score: dice(prompt, m.body ?? m) }))\n37\t    .filter((c) => c.score >= threshold)\n38\t    .sort((a, b) => b.score - a.score);\n39\t\n40\texport const createReplyGroup = ({ id, label, variations }) => ({\n41\t  id: `reply:${id}`,\n42\t  tokens: ['reply-group', id, label],\n43\t  children: [],\n44\t  variations: [...variations],\n45\t});\n46\t\n47\texport const pickVariation = (group, mode = 'random') => {\n48\t  if (mode === 'first') {\n49\t    return group.variations[0];\n50\t  }\n51\t  const i = Math.floor(Math.random() * group.variations.length);\n52\t  return group.variations[i];\n53\t};\n54\t"
