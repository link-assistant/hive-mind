ding === 'function') {\\n00137|         encoding();\\n00138|       } else if (callback) {\\n00139|         callback();\\n00140|       }\\n00141|       return true;\\n00142|     };\\n00143|     try {\\n00144|       argv = parseCliArgumentsWithLino({\\n00145|         argv: ['node', 'hive', ...rawArgs],\\n00146|         commandName: 'hive',\\n00147|         createYargsConfig,\\n00148|         positionalAliases: ['github-url'],\\n00149|       });\\n00150|       // Restore stderr if parsing succeeded\\n00151|       process.stderr.write = originalStderrWrite;\\n00152|     } catch (error) {\\n00153|       // Restore stderr before handling the error\\n00154|       process.stderr.write = originalStderrWrite;\\n00155|       // If .strict() mode catches an unknown argument, yargs will throw an error\\n00156|       // We should fail fast for truly invalid arguments\\n00157|       if (error.message && error.message.includes('Unknown argument')) {\\n00158|         console.error('Error:', error.message);\\n00159|         process.exit(1);\\n00160|       }\\n00161|       // Yargs sometimes throws \\\"Not enough arguments\\\" errors even when arguments are present\\n00162|       // This is a quirk with optional positional arguments [github-url]\\n00163|       // The error.argv object still contains the parsed arguments, so we can safely continue\\n00164|       if (error.argv) {\\n00165|         argv = error.argv;\\n00166|       } else {\\n00167|         // If there's no argv object, it's a real error - show the captured stderr\\n00168|         if (stderrBuffer) {\\n00169|           process.stderr.write(stderrBuffer);\\n00170|         }\\n00171|         throw error;\\n00172|       }\\n00173|     }\\n00174|     // Apply aliases after successful parsing as well as the legacy error.argv path.\\n00175|     if (argv && (argv.skipToolCheck || argv.skipClaudeCheck)) argv.skipToolConnectionCheck = true;\\n00176|     if (argv && argv.toolCheck === false) argv.toolConnectionCheck = false;\\n00177|     let githubUrl = argv['github-url'];\\n00178|     // Set global verbose mode\\n00179|     global.verboseMode = argv.verbose;\\n00180|     const { initI18n } = await import('./i18n.lib.mjs');\\n00181|     await initI18n({ language: argv.language, uiLanguage: argv.uiLanguage, workLanguage: argv.workLanguage });\\n00182|     setupVerboseLogInterceptor(); // Issue #1466: capture [VERBOSE] output in log files\\n00183|     setupStdioLogInterceptor(); // Issue #1549: capture ALL terminal output in log file\\n00184|     // Use the universal GitHub URL parser\\n00185|     if (githubUrl) {\\n00186|       const parsedUrl = parseGitHubUrl(githubUrl);\\n00187|       if (!parsedUrl.valid) {\\n00188|         console.error('Error: Invalid GitHub URL format');\\n00189|         if (parsedUrl.error) console.error(`  ${parsedUrl.error}`);\\n00190|         if (parsedUrl.inputHint || parsedUrl.suggestion) console.error([parsedUrl.inputHint, parsedUrl.suggestion && `💡 Did you mean ${parsedUrl.suggestion}?`].filter(Boolean).join('\\\\n'));\\n00191|         console.error('\\\\nExpected: https://github.com/owner or https://github.com/owner/repo');\\n00192|         console.error('You can use any of these formats:');\\n00193|         console.error('  - https://github.com/owner');\\n00194|         console.error('  - https://github.com/owner/repo');\\n00195|         console.error('  - http://github.com/owner (will be converted to https)');\\n00196|         console.error('  - github.com/owner (will add https://)');\\n00197|         console.error('  - owner (will be converted to https://github.com/owner)');\\n00198|         console.error('  - owner/repo (will be converted to https://github.com/owner/repo)');\\n00199|         await safeExit(1, 'Error occurred');\\n00200|       }\\n00201|       // Issue #2194: report a repaired URL before monitoring starts, so the user\\n00202|       // can catch a wrong guess instead of watching the wrong repository.\\n00203|       if (hasNotableRepair(parsedUrl.repairs)) {\\n00204|         console.error('ℹ️  Repaired the GitHub URL before monitoring:');\\n00205|         console.error(`     You typed: ${revealHiddenCharacters(githubUrl)}`);\\n00206|         console.error(`     Using:     ${parsedUrl.canonical || parsedUrl.normalized}`);\\n00207|         console.error(`     Repaired:  ${formatUrlRepairs(parsedUrl.repairs, { notableOnly: true })}`);\\n00208|       }\\n00209|       // Issue #2615: `owner/repo/issues` (or `/pulls`) means that repository, as in the Telegram bot.\\n00210|       if (parsedUrl.type === 'issues_list' || parsedUrl.type === 'pulls_list') Object.assign(parsedUrl, { type: 'repo', normalized: `https://github.com/${parsedUrl.owner}/${parsedUrl.repo}` });\\n00211|       // Check if it's a valid type for hive (user or repo)\\n00212|       if (parsedUrl.type !== 'user' && parsedUrl.type !== 'repo') {\\n00213|         console.error('Error: Invalid GitHub URL for monitoring');\\n00214|         console.error(`  URL type '${parsedUrl.type}' is not supported`);\\n00215|         if (parsedUrl.inputHint || parsedUrl.suggestion) console.error([parsedUrl.inputHint, parsedUrl.suggestion && `💡 Did you mean ${parsedUrl.suggestion}?`].filter(Boolean).join('\\\\n'));\\n00216|         console.error('Expected: https://github.com/owner or https://github.com/owner/repo');\\n00217|         await safeExit(1, 'Error occurred');\\n00218|       }\\n00219|       // Use the normalized URL\\n00220|       githubUrl = parsedUrl.normalized;\\n00221|     }\\n00222|     // Validate GitHub URL format ONCE AND FOR ALL at the beginning\\n00223|     // Parse URL format: https://github.com/owner or https://github.com/owner/repo\\n00224|     let urlMatch = null;\\n00225|     // Only validate if we have a URL\\n00226|     const needsUrlValidation = githubUrl;\\n00227|     if (needsUrlValidation) {\\n00228|       // Do the regex matching ONCE - this result will be used everywhere\\n00229|       urlMatch = githubUrl.match(/^https:\\\\/\\\\/gi