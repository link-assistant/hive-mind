toolConnectionCheck = false;\\n00177|     let githubUrl = argv['github-url'];\\n00178|     // Set global verbose mode\\n00179|     global.verboseMode = argv.verbose;\\n00180|     const { initI18n } = await import('./i18n.lib.mjs');\\n00181|     await initI18n({ language: argv.language, uiLanguage: argv.uiLanguage, workLanguage: argv.workLanguage });\\n00182|     setupVerboseLogInterceptor(); // Issue #1466: capture [VERBOSE] output in log files\\n00183|     setupStdioLogInterceptor(); // Issue #1549: capture ALL terminal output in log file\\n00184|     // Use the universal GitHub URL parser\\n00185|     if (githubUrl) {\\n00186|       const parsedUrl = parseGitHubUrl(githubUrl);\\n00187|       if (!parsedUrl.valid) {\\n00188|         console.error('Error: Invalid GitHub URL format');\\n00189|         if (parsedUrl.error) console.error(`  ${parsedUrl.error}`);\\n00190|         if (parsedUrl.inputHint || parsedUrl.suggestion) console.error([parsedUrl.inputHint, parsedUrl.suggestion && `💡 Did you mean ${parsedUrl.suggestion}?`].filter(Boolean).join('\\\\n'));\\n00191|         console.error('\\\\nExpected: https://github.com/owner or https://github.com/owner/repo');\\n00192|         console.error('You can use any of these formats:');\\n00193|         console.error('  - https://github.com/owner');\\n00194|         console.error('  - https://github.com/owner/repo');\\n00195|         console.error('  - http://github.com/owner (will be converted to https)');\\n00196|         console.error('  - github.com/owner (will add https://)');\\n00197|         console.error('  - owner (will be converted to https://github.com/owner)');\\n00198|         console.error('  - owner/repo (will be converted to https://github.com/owner/repo)');\\n00199|         await safeExit(1, 'Error occurred');\\n00200|       }\\n00201|       // Issue #2194: report a repaired URL before monitoring starts, so the user\\n00202|       // can catch a wrong guess instead of watching the wrong repository.\\n00203