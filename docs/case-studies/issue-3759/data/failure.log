grid li {\nsrc/pages/pages.css:421:.symbols__grid li:hover {\nsrc/pages/pages.css:426:.symbols__grid svg {\nsrc/pages/pages.css:431:.symbols__grid span {\nimport '../App.css';\nimport '../App.sections.css';\nimport '../Layout.css';\nimport '../pages/pages.css';\n// The skins (issue #13) and the technical fonts of the futuristic one.\nimport '@fontsource/orbitron/latin-500.css';\nimport '@fontsource/orbitron/latin-700.css';\nimport '@fontsource/electrolize/latin-400.css';\nimport '@fontsource/chakra-petch/latin-400.css';\nimport '@fontsource/chakra-petch/latin-600.css';\nimport '@fontsource/share-tech-mono/latin-400.css';\nimport '../skins.glass.css';\nimport '../skins.liquid.css';\nimport '../skins.future.css';\n// Responsive and print overrides must come last.\nimport '../App.media.css';\nimport { useEffect, useRef } from 'react';\nimport { motto } from '../data/motto';\nimport { centreCurrent, watchEdges } from './edges';\nimport { PAGES } from '../pages/pages';\nimport { useLang } from '../i18n/prefs';\nimport { useNotation } from '../links/notation';\nimport Cosmos from './Cosmos';\nimport LiquidRefraction from './LiquidRefraction';\nimport PrefSwitches from './PrefSwitches';\nimport Sound from './Sound';\n\n/**\n * Shared frame of every page: the cosmic background, the page navigation\n * (plus optional in-page section links) and the footer with the link to the\n * settings of the background and the skin (issue #13).\n */\nexport default function Layout({ page, sections = null, children, footer = null }) {\n  const { t } = useLang();\n  const { n } = useNotation();\n  const pages = useRef(null);\n  const sectionList = useRef(null);\n  const hasSections = Boolean(sections);\n  // On a narrow screen the lists of pages and sections scroll sideways: show the current\n  // page and fade the edges that have more links behind them.\n  useEffect(() => {\n    if (pages.current) centreCurrent(pages.current);\n    return watchEdges([pages.current, sectionList.current].filter(Boolean));\n  }, [page, hasSections]);\n  return (\n    <div className=\"app\">\n      <Cosmos />\n      <LiquidRefraction />\n      <Sound />\n      <header className=\"topbar\">\n        <div className=\"topbar__row\">\n          <a className=\"nav__brand mono\" href=\"/\">\n            konard<span className=\"nav__cursor\">_</span>\n          </a>\n          <nav className=\"pages\" aria-label=\"Pages\">\n            <ul ref={pages}>\n              {PAGES.map((p) => (\n                <li key={p.id}>\n                  <a href={p.href} aria-current={p.id === page ? 'page' : undefined}>\n                    {t(p.label)}\n                  </a>\n                </li>\n              ))}\n            </ul>\n          </nav>\n          <PrefSwitches />\n        </div>\n        {sections && (\n          <nav className=\"nav\" aria-label=\"Sections\">\n            <a className=\"nav__top mono\" href=\"#top\" aria-label={t({ en: 'Back to top', ru: 'Наверх' })}>\n              ↑\n            </a>\n            <ul ref={sectionList}>\n              {sections.map(([id, label]) => (\n                <li key={id}>\n                  <a href={`#${id}`}>{t(label)}</a>\n                </li>\n              ))}\n            </ul>\n          </nav>\n20:export function NetworkExample({ example, random = Math.random }) {\n21-  const [code, setCode] = useState(example.code);\n22-  const size = code.split(' ').length;\n23-  const isExample = code === example.code;\n24-  const { lang, t } = useLang();\n25-  const links = `${size} ${plural(size, lang, OF_LINKS)}`;\n26-  return (\n27-    <div className=\"theory__example\">\n28-      <button\n29-        type=\"button\"\n30-        className=\"theory__network\"\n31-        onClick={() => setCode(randomCode(random))}\n32-        title={t({ en: 'Show a random network of 1–4 links', ru: 'Показать случайную сеть из 1–4 связей' })}\n33-      >\n34-        <Glyph code={code} size={96} title={`${t({ en: 'Network of', ru: 'Сеть из' })} ${links}: ${code}`} />\n35-      </button>\n36-      <dl className=\"theory__notations\">\n37-        <dt>{t({ en: 'math notation', ru: 'математическая нотация' })}</dt>\n38-        <dd className=\"mono\" data-notation=\"math\">\n39-          {mathNotation(code)}\n40-        </dd>\n41-        <dt>{t({ en: 'links notation', ru: 'нотация связей' })}</dt>\n42-        <dd className=\"mono\" data-notation=\"links\">\n43-          {linksNotation(code).map((l) => (\n44-            <span key={l}>{l}</span>\n45-          ))}\n46-        </dd>\n47-      </dl>\n48-      <p className=\"muted\">\n49-        {isExample\n50-          ? t({\n51-              en: 'Two links refer to themselves (points), the third connects them: a graph edge is just a link.',\n52-              ru: 'Две связи ссылаются сами на себя (точки), третья соединяет их: ребро графа — это просто связь.',\n53-            })\n54-          : `${t({ en: 'A random network of', ru: 'Случайная сеть из' })} ${links}.`}{' '}\n55-        {t({\n56-          en: `Every link is (index: source target), 0 is nothing; the math notation writes the same sources and targets as digits in base ${size + 1}. Click the symbol for another random network.`,\n57-          ru: `Каждая связь — это (индекс: начало конец), 0 означает «ничего»; математическая нотация записывает те же начала и концы цифрами в системе счисления с основанием ${size + 1}. Нажмите на символ, чтобы увидеть другую случайную сеть.`,\n58-        })}\n59-      </p>\n60-    </div>\n--\n79:          <NetworkExample example={theory.example} />\n80-          <p className=\"theory__actions\">\n81-            <a className=\"button button--primary\" href={theory.repo} target=\"_blank\" rel=\"noopener noreferrer\">\n82-              link-foundation/meta-theory\n83-            </a>\n84-            <a className=\"button\" href={theory.pdfs} target=\"_blank\" rel=\"noopener noreferrer\">\n85-              {t({ en: 'All PDFs (ZIP)', ru: 'Все PDF (ZIP)' })}\n86-            </a>\n87-          </p>\n88-        </div>\n89-      </div>\n90-\n91-      <ol className=\"theory__formulas\">\n92-        {theory.formulas.map((f) => (\n93-          <li key={f.formula.L}>\n94-            <span className=\"mono theory__math\">{n(f.formula)}</span>\n95-            <span>{t(n(f.text))}</span>\n96-          </li>\n97-        ))}\n98-      </ol>\n99-\n100-      <div\n101-        className=\"theory__versions\"\n102-        role=\"list\"\n103-        aria-label={t({ en: 'Versions of the links theory', ru: 'Версии теории связей' })}\n104-      >\n105-        {theory.versions.map((v) => (\n106-          <article key={v.version} className=\"version\" role=\"listitem\">\n107-            <span className=\"version__number mono\">{v.version}</span>\n108-            <h3>\n109-              <a href={v.url} target=\"_blank\" rel=\"noopener noreferrer\" lang={v.lang}>\n110-                {v.title}\n111-              </a>\n112-            </h3>\n113-            <span className=\"muted\">\n114-              {t(v.status)} · {t(LANGUAGE_NAMES[v.lang])} ·{' '}\n115-              <a href={v.pdf} target=\"_blank\" rel=\"noopener noreferrer\">\n116-                PDF\n42:export function parseCode(text) {\n43-  const digits = String(text ?? '').replace(/[\\s._-]/g, '');\n44-  if (!/^\\d+$/.test(digits) || digits.length % 2) return null;\n45-  const links = digits.match(/../g).map((pair) => [Number(pair[0]), Number(pair[1])]);\n46-  return check(links).links ? encode(links) : null;\n47-}\n48-\n49-/** The N-ary number \"0120₃\" (or \"0120\", \"0120_3\"); its base, if written, must be n + 1. */\n50-export function parseNumber(text) {\n51-  const raw = String(text).trim();\n52-  const suffix = raw.match(/(?:([₀-₉]+)|_(\\d+))$/);\n53-  const base = suffix ? Number(fromSubscripts(suffix[1] || suffix[2])) : null;\n54-  const digits = raw.slice(0, suffix ? suffix.index : raw.length).replace(/[\\s.-]/g, '');\n55-  if (!/^\\d+$/.test(digits))\n56-    return fail('Write the digits of the number, e.g. 0120₃.', 'Запишите цифры числа, например 0120₃.');\n57-  if (digits.length % 2)",
