[2026-04-14T08:00:55.021Z] [INFO]     "originalFile": "use crate::Link;\nuse data::{Flow, LinkType};\nuse std::marker::PhantomData;\n\npub trait Handler<T: LinkType>: FnMut(Link<T>, Link<T>) -> Flow {\n    fn fuse(self) -> Fuse<T, Self>\n    where\n        Self: Sized,\n    {\n        Fuse::new(self)\n    }\n}\n\nimpl<T: LinkType, All: FnMut(Link<T>, Link<T>) -> Flow> Handler<T> for All {}\n\npub struct Fuse<T: LinkType, H: Handler<T>> {\n    handler: H,\n    done: bool,\n    _marker: PhantomData<fn(T)>,\n}\n\nimpl<T: LinkType, F: FnMut(Link<T>, Link<T>) -> Flow> Fuse<T, F> {\n    pub fn new(handler: F) -> Self {\n        Self {\n            handler,\n            done: false,\n            _marker: PhantomData,\n        }\n    }\n}\n\nimpl<T: LinkType, H: Handler<T>> From<H> for Fuse<T, H> {\n    fn from(handler: H) -> Self {\n        Self::new(handler)\n    }\n}\n\nimpl<T: LinkType, H: Handler<T>> FnOnce<(Link<T>, Link<T>)> for Fuse<T, H> {\n    type Output = Flow;\n\n    extern \"rust-call\" fn call_once(mut self, args: (Link<T>, Link<T>)) -> Self::Output {\n        (self.handler)(args.0, args.1)\n    }\n}\n\nimpl<T: LinkType, H: Handler<T>> FnMut<(Link<T>, Link<T>)> for Fuse<T, H> {\n    extern \"rust-call\" fn call_mut(&mut self, args: (Link<T>, Link<T>)) -> Self::Output {\n        if self.done {\n            Flow::Break\n        } else {\n            let result = (self.handler)(args.0, args.1);\n            if result.is_break() {\n                self.done = true;\n                Flow::Break\n            } else {\n                Flow::Continue\n            }\n        }\n    }\n}\n"
[2026-04-14T08:00:55.021Z] [INFO]   }
