[2026-07-19T12:51:00.670Z] [INFO]         "content": "196\t  });\n197\t}\n198\tprocess.stdout.write('READY\\\\n');\n199\tsetInterval(() => {}, 1000); // keep process alive until signalled\n200\t`;\n201\t  await writeFile(harnessPath, harness, 'utf-8');\n202\t\n203\t  async function runDelegationCase(delegate) {\n204\t    return await new Promise(resolve => {\n205\t      const child = spawn(process.execPath, [harnessPath], {\n206\t        stdio: ['ignore', 'pipe', 'pipe'],\n207\t        env: { ...process.env, DELEGATE: delegate ? '1' : '0' },\n208\t      });\n209\t      let stdout = '';\n210\t      child.stdout.on('data', d => {\n211\t        stdout += d.toString();\n212\t        if (stdout.includes('READY') && !child.__signalled) {\n213\t          child.__signalled = true;\n214\t          // Send SIGINT directly to the harness process (simulates CTRL+C to it).\n215\t          setTimeout(() => {\n216\t            try {\n217\t              child.kill('SIGINT');\n218\t            } catch {\n219\t              /* ignore */\n220\t            }\n221\t          }, 100);\n222\t        }\n223\t      });\n224\t      child.on('close', code => resolve({ code, stdout }));\n225\t    });\n226\t  }\n227\t\n228\t  const delegated = await runDelegationCase(true);\n229\t  assert(delegated.code === 0, 'delegated harness exits 0 (external graceful handler owns exit)', `Got code ${delegated.code}, stdout=${JSON.stringify(delegated.stdout)}`);\n230\t  assert(delegated.stdout.includes('EXTERNAL_HANDLER_DONE'), 'delegated harness runs the external handler to completion');\n231\t  assert(!delegated.stdout.includes('❌ Interrupted (CTRL+C)'), 'delegated harness does NOT print the global \"Interrupted (CTRL+C)\" message');\n232\t\n233\t  const def = await runDelegationCase(false);\n234\t  assert(def.code === 130, 'non-delegated harness exits 130 via the global SIGINT handler (default behavior preserved)', `Got code ${def.code}, stdout=${JSON.stringify(def.stdout)}`);\n235\t  assert(def.stdout.includes('Interrupted (CTRL+C)'), 'non-delegated harness prints the global \"Interrupted (CTRL+C)\" message');\n236\t\n237\t  await rm(tmp, { recursive: true, force: true });\n238\t}\n239\t\n240\t// ═══════════════════════════════════════════════════════════════════\n241\t// Test Suite 5 (integration): detached child survives a process-group SIGINT\n242\t// ═══════════════════════════════════════════════════════════════════\n243\tconsole.log('\\n🧪 Test Suite 5: integration — detached solve survives a group SIGINT');\n244\tconsole.log('─'.repeat(60));\n245\t\n246\t{\n247\t  const tmp = await mkdtemp(join(tmpdir(), 'hive-1823-detach-'));\n248\t  const childPath = join(tmp, 'detach-child.mjs');\n249\t  const harnessPath = join(tmp, 'detach-harness.mjs');\n250\t\n251\t  // Child writes COMPLETED on natural finish, INTERRUPTED if it receives SIGINT.\n252\t  const childScript = `\n253\timport { writeFileSync } from 'node:fs';\n254\tconst marker = process.argv[2];\n255\tprocess.on('SIGINT', () => { try { writeFileSync(marker, 'INTERRUPTED'); } catch {} process.exit(1); });\n256\tsetTimeout(() => { try { writeFileSync(marker, 'COMPLETED'); } catch {} process.exit(0); }, 1500);\n257\t`;\n258\t  await writeFile(childPath, childScript, 'utf-8');\n259\t\n260\t  // Harness spawns the child (detached controlled by env) and waits for it (graceful: ignore SIGINT).\n261\t  const harnessScript = `\n262\timport { spawn } from 'node:child_process';\n263\tconst DETACHED = process.env.DETACHED === '1';\n264\tconst marker = process.env.MARKER;\n265\tconst child = spawn(process.execPath, [${JSON.stringify(childPath)}, marker], {\n266\t  stdio: ['ignore', 'pipe', 'pipe'],\n267\t  detached: DETACHED,\n268\t});\n269\tchild.on('close', code => { process.stdout.write('CHILD_CLOSED:' + code + '\\\\n'); process.exit(0); });\n270\t// Graceful: on SIGINT we do NOT exit; we keep waiting for the child to finish naturally.\n271\tprocess.on('SIGINT', () => { process.stdout.write('HARNESS_SIGINT\\\\n'); });\n272\tprocess.stdout.write('READY\\\\n');\n273\tsetInterval(() => {}, 1000);\n274\t`;\n275\t  await writeFile(harnessPath, harnessScript, 'utf-8');\n276\t\n277\t  async function runDetachCase(detached) {\n278\t    const marker = join(tmp, `marker-${detached ? 'detached' : 'attached'}.txt`);\n279\t    return await new Promise(resolve => {\n280\t      // Spawn the harness as its OWN process-group leader so we can signal the whole group,\n281\t      // exactly like a terminal/screen delivers SIGINT to its foreground process group.\n282\t      const harness = spawn(process.execPath, [harnessPath], {\n283\t        stdio: ['ignore', 'pipe', 'pipe'],\n284\t        env: { ...process.env, DETACHED: detached ? '1' : '0', MARKER: marker },\n285\t        detached: true,\n286\t      });\n287\t      let stdout = '';\n288\t      harness.stdout.on('data', d => {\n289\t        stdout += d.toString();\n290\t        if (stdout.includes('READY') && !harness.__signalled) {\n291\t          harness.__signalled = true;\n292\t          setTimeout(() => {\n293\t            try {\n294\t              // Negative PID → signal the entire harness process group (terminal-like).\n295\t              process.kill(-harness.pid, 'SIGINT');\n296\t            } catch {\n297\t              /* ignore */\n298\t            }\n299\t          }, 150);\n300\t        }\n301\t      });\n302\t      harness.on('close', async () => {\n303\t        let markerContent = '';\n304\t        try {\n305\t          markerContent = existsSync(marker) ? await readFileMaybe(marker, 'utf-8') : '';\n306\t        } catch {\n307\t          /* ignore */\n308\t        }\n309\t        resolve({ stdout, marker: markerContent });\n310\t      });\n311\t    });\n312\t  }\n313\t\n314\t  const detached = await runDetachCase(true);\n315\t  assert(detached.marker === 'COMPLETED', 'detached child finishes naturally despite group SIGINT (the fix)', `marker=${JSON.stringify(detached.marker)}, stdout=${JSON.stringify(detached.stdout)}`);\n316\t\n317\t  const attached = await runDetachCase(false);\n318\t  assert(attached.marker === 'INTERRUPTED', 'non-detached child IS interrupted by the group SIGINT (reproduces the bug)', `marker=${JSON.stringify(attached.marker)}, stdout=${JSON.stringify(attached.stdout)}`);\n319\t\n320\t  await rm(tmp, { recursive: true, force: true });\n321\t}\n322\t\n323\t// ═══════════════════════════════════════════════════════════════════\n324\t// Test Suite 6 (unit): createShutdownManager runtime behavior with mocks\n325\t// ═══════════════════════════════════════════════════════════════════"
