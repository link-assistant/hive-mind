solveCommand, args, {\n00658|                 stdio: ['pipe', 'pipe', 'pipe'],\n00659|                 env: process.env,\n00660|                 // Issue #1823: run solve in its own process group so a terminal SIGINT (or the\n00661|                 // \\003 `$ --stop`/screen injects) hits only hive, not solve+codex. hive instead\n00662|                 // forwards a controlled SIGTERM (see gracefulShutdown). stdio stays piped and we\n00663|                 // must NOT unref() — hive keeps waiting. See docs/case-studies/issue-1823.\n00664|                 detached: true,\n00665|               });\n00666|               // Issue #1823: register the in-flight child for optional force-kill on a 2nd signal\n00667|               activeSolveChildren.add(child);\n00668|               // Issue #2160: start collecting the workspaces this worker owns so the disk guard\n00669|               // (running in the other workers) never reclaims a directory that is still in use.\n00670|               const ownedWorkspaces = new Set();\n00671|               workerWorkspaces.set(workerId, ownedWorkspaces);\n00672|               log(`   🧒 Spawned ${solveCommand} worker-${workerId} (pid ${child.pid}, detached process group)`, { verbose: true }).catch(() => {});\n00673|               // Handle stdout data - stream output in real-time\n00674|               child.stdout.on('data', data => {\n00675|                 const lines = data.toString().split('\\n');\n00676|                 for (const line of lines) {\n00677|                   if (line.trim()) {\n00678|                     for (const workspacePath of extractSolverWorkspacePaths(line)) ownedWorkspaces.add(workspacePath);\n00679|                     // Issue #2161: solve prints SUBSCRIPTION_BLOCKED_MARKER on a terminal\n00680|                     // account block. Seen here, it stops the whole hive (see noteSubscriptionBlock).\n00681|                     if (line.includes(SUBSCRIPTION_BLOCKED_MARKER)) noteSubscriptionBlock(workerId, line