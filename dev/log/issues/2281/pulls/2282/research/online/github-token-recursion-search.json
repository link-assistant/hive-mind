indices":[53,59],"text":"Create"},{"indices":[56,57],"text":"a"},{"indices":[65,68],"text":"new"},{"indices":[69,77],"text":"workflow"},{"indices":[95,103],"text":"workflow"},{"indices":[109,110],"text":"a"}],"property":"content","type":"FileContent"},{"fragment":"\n   If you need to refer to a repository's default branch, you can use the `$default-branch` placeholder. When a workflow is created the placeholder will be automatically replaced with the name of the repository's default branch.\n","matches":[{"indices":[28,29],"text":"a"},{"indices":[46,47],"text":"a"},{"indices":[53,54],"text":"a"},{"indices":[64,65],"text":"a"},{"indices":[80,81],"text":"a"},{"indices":[113,121],"text":"workflow"},{"indices":[125,131],"text":"create"},{"indices":[149,153],"text":"will"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/actions/how-tos/reuse-automations/create-workflow-templates.md"},{"path":"content/actions/how-tos/manage-runners/self-hosted-runners/use-in-a-workflow.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"\n{% data reusables.actions.actions-tab-new-runners-note %}\n","matches":[{"indices":[5,6],"text":"a"},{"indices":[7,8],"text":"a"},{"indices":[13,14],"text":"a"},{"indices":[19,20],"text":"a"},{"indices":[27,28],"text":"a"},{"indices":[36,37],"text":"a"},{"indices":[39,42],"text":"new"},{"indices":[43,46],"text":"run"},{"indices":[51,54],"text":"not"}],"property":"content","type":"FileContent"},{"fragment":"\nTo create individual self-hosted runners without the default labels, pass the `--no-default-labels` flag when you create the runner.\n","matches":[{"indices":[4,10],"text":"create"},{"indices":[34,37],"text":"run"},{"indices":[115,121],"text":"create"},{"indices":[126,129],"text":"run"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/actions/how-tos/manage-runners/self-hosted-runners/use-in-a-workflow.md"},{"path":"content/actions/tutorials/create-actions/create-a-javascript-action.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"\nOnce you complete this project, you should understand how to build your own JavaScript action and test it in a workflow.\n","matches":[{"indices":[112,120],"text":"workflow"}],"property":"content","type":"FileContent"},{"fragment":"\nGitHub Actions provide context information about the webhook event, Git refs, workflow, action, and the person who triggered the workflow. To access the context information, you can use the `github` package. The action you'll write will print the webhook event payload to the log.\n","matches":[{"indices":[79,87],"text":"workflow"},{"indices":[130,138],"text":"workflow"},{"indices":[233,237],"text":"will"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/actions/tutorials/create-actions/create-a-javascript-action.md"},{"path":"content/actions/tutorials/use-containerized-services/create-a-docker-container-action.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"\nOnce you complete this project, you should understand how to build your own Docker container action and test it in a workflow.\n","matches":[{"indices":[51,52],"text":"a"},{"indices":[88,89],"text":"a"},{"indices":[94,95],"text":"a"},{"indices":[101,102],"text":"a"},{"indices":[116,117],"text":"a"},{"indices":[118,126],"text":"workflow"}],"property":"content","type":"FileContent"},{"fragment":"\n{% data variables.product.prodname_dotcom %} will build an image from your `Dockerfile`, and run commands in a new container using this image.\n","matches":[{"indices":[46,50],"text":"will"},{"indices":[94,97],"text":"run"},{"indices":[112,115],"text":"new"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/actions/tutorials/use-containerized-services/create-a-docker-container-action.md"},{"path":"content/actions/how-tos/monitor-workflows/use-workflow-run-logs.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"{% data reusables.repositories.navigate-to-workflow %}\n{% data reusables.repositories.view-run %}\n{% data reusables.repositories.navigate-to-job %}","matches":[{"indices":[43,51],"text":"workflow"},{"indices":[91,94],"text":"run"}],"property":"content","type":"FileContent"},{"fragment":"\nYou can use `grep` to search the log. For example, this command will return all log entries that contain the word `error`.\n","matches":[{"indices":[65,69],"text":"will"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/actions/how-tos/monitor-workflows/use-workflow-run-logs.md"},{"path":"content/actions/how-tos/write-workflows/choose-what-workflows-do/run-job-variations.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"\nFor reference information and examples, see [AUTOTITLE](/actions/reference/workflows-and-actions/workflow-syntax#jobsjob_idstrategymatrix).\n","matches":[{"indices":[76,84],"text":"workflow"},{"indices":[98,106],"text":"workflow"}],"property":"content","type":"FileContent"},{"fragment":"\nThis will result in six jobs with the following matrix combinations.\n","matches":[{"indices":[6,10],"text":"will"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/actions/how-tos/write-workflows/choose-what-workflows-do/run-job-variations.md"},{"path":"data/reusables/actions/workflow-basic-example-and-explanation.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"\nYour new {% data variables.product.prodname_actions %} workflow file is now installed in your repository and will run automatically each time someone pushes a change to the repository. To see the details about a workflow's execution history, see [Viewing the activity for a workflow run](#viewing-the-activity-for-a-workflow-run).\n","matches":[{"indices":[6,9],"text":"new"},{"indices":[14,15],"text":"a"},{"indices":[16,17],"text":"a"},{"indices":[19,20],"text":"a"},{"indices":[22,23],"text":"a"},{"indices":[41,42],"text":"a"},{"indices":[45,46],"text":"a"},{"indices":[56,64],"text":"workflow"},{"indices":[81,82],"text":"a"},{"indices":[106,107],"text":"a"},{"indices":[110,114],"text":"will"},{"indices":[115,118],"text":"run"},{"indices":[119,120],"text":"a"},{"indices":[124,125],"text":"a"},{"indices":[128,129],"text":"a"},{"indices":[134,135],"text":"a"},{"indices":[158,159],"text":"a"},{"indices":[213,221],"text":"workflow"},{"indices":[275,283],"text":"workflow"},{"indices":[284,287],"text":"run"},{"indices":[317,325],"text":"workflow"},{"indices":[326,329],"text":"run"}],"property":"content","type":"FileContent"},{"fragment":"\nTo help you understand how YAML syntax is used to create a workflow file, this section explains each line of the introduction's example:\n","matches":[{"indices":[51,57],"text":"create"},{"indices":[60,68],"text":"workflow"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/data/reusables/actions/workflow-basic-example-and-explanation.md"},{"path":"content/actions/how-tos/manage-workflow-runs/manage-caches.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"   * To search for cache entries used for a specific branch, click the **Branch** dropdown menu and select a branch. The cache list will display all of the caches used for the selected branch.\n   * To search for cache entries with a specific cache key, use the syntax `key: key-name` in the **Filter caches** field. The cache list will display caches from all branches where the key was used.\n","matches":[{"indices":[10,11],"text":"a"},{"indices":[20,21],"text":"a"},{"indices":[42,43],"text":"a"},{"indices":[55,56],"text":"a"},{"indices":[75,76],"text":"a"},{"indices":[96,97],"text":"a"},{"indices":[107,108],"text":"a"},{"indices":[111,112],"text":"a"},{"indices":[122,123],"text":"a"},{"indices":[132,136],"text":"will"},{"indices":[142,143],"text":"a"},{"indices":[145,146],"text":"a"},{"indices":[157,158],"text":"a"},{"indices":[187,188],"text":"a"},{"indices":[203,204],"text":"a"},{"indices":[213,214],"text":"a"},{"indices":[231,232],"text":"a"},{"indices":[331,335],"text":"will"}],"property":"content","type":"FileContent"},{"fragment":"\n          ## Setting this to not fail the workflow while deleting cache keys.\n          set +e","matches":[{"indices":[30,33],"text":"not"},{"indices":[43,51],"text":"workflow"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/actions/how-tos/manage-workflow-runs/manage-caches.md"},{"path":"content/actions/how-tos/administer/control-workflow-execution.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"\n1. **Which organizations or repositories** your protection will target. For example, open source repositories may need tighter restrictions on who can trigger workflows. You can target repositories by factors like visibility, deployment status, or custom property.\n","matches":[{"indices":[60,64],"text":"will"},{"indices":[160,168],"text":"workflow"}],"property":"content","type":"FileContent"},{"fragment":"\nFirst, create a new Actions policy for the account level you're working at.\n","matches":[{"indices":[8,14],"text":"create"},{"indices":[17,20],"text":"new"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/actions/how-tos/administer/control-workflow-execution.md"},{"path":"content/actions/concepts/workflows-and-actions/reusing-workflow-configurations.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"\nReusing workflows avoids duplication. This makes workflows easier to maintain and allows you to create new workflows more quickly by building on the work of others, just as you do with actions. Workflow reuse also promotes best practice by helping you to use workflows that are well designed, have already been tested, and have been proven to be effective. Your organization can build up a library of reusable workflows that can be centrally maintained.\n","matches":[{"indices":[9,17],"text":"workflow"},{"indices":[19,20],"text":"a"},{"indices":[32,33],"text":"a"},{"indices":[45,46],"text":"a"},{"indices":[50,58],"text":"workflow"},{"indices":[61,62],"text":"a"},{"indices":[71,72],"text":"a"},{"indices":[75,76],"text":"a"},{"indices":[79,80],"text":"a"},{"indices":[83,84],"text":"a"},{"indices":[97,103],"text":"create"},{"indices":[100,101],"text":"a"},{"indices":[104,107],"text":"new"},{"indices":[108,116],"text":"workflow"},{"indices":[171,172],"text":"a"},{"indices":[186,187],"text":"a"},{"indices":[195,203],"text":"Workflow"},{"indices":[210,211],"text":"a"},{"indices":[231,232],"text":"a"},{"indices":[260,268],"text":"workflow"},{"indices":[272,273],"text":"a"},{"indices":[275,276],"text":"a"},{"indices":[295,296],"text":"a"},{"indices":[299,300],"text":"a"},{"indices":[303,304],"text":"a"},{"indices":[320,321],"text":"a"},{"indices":[325,326],"text":"a"},{"indices":[366,367],"text":"a"},{"indices":[370,371],"text":"a"},{"indices":[377,378],"text":"a"},{"indices":[389,390],"text":"a"},{"indices":[395,396],"text":"a"},{"indices":[406,407],"text":"a"},{"indices":[411,419],"text":"workflow"},{"indices":[423,424],"text":"a"},{"indices":[427,428],"text":"a"},{"indices":[438,439],"text":"a"},{"indices":[444,445],"text":"a"},{"indices":[448,449],"text":"a"}],"property":"content","type":"FileContent"},{"fragment":"\nA workflow that uses another workflow is referred to as a \"caller\" workflow. The reusable workflow is a \"called\" workflow. One caller workflow can use multiple called workflows. Each called workflow is referenced in a single line. The result is that the caller workflow file may contain just a few lines of YAML, but may perform a large number of tasks when it's run. When you reuse a workflow, the entire called workflow is used, just as if it was part of the caller workflow.\n","matches":[{"indices":[3,11],"text":"workflow"},{"indices":[23,26],"text":"not"},{"indices":[30,38],"text":"workflow"},{"indices":[68,76],"text":"workflow"},{"indices":[91,99],"text":"workflow"},{"indices":[114,122],"text":"workflow"},{"indices":[135,143],"text":"workflow"},{"indices":[168,176],"text":"workflow"},{"indices":[191,199],"text":"workflow"},{"indices":[262,270],"text":"workflow"},{"indices":[364,367],"text":"run"},{"indices":[386,394],"text":"workflow"},{"indices":[414,422],"text":"workflow"},{"indices":[469,477],"text":"workflow"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/actions/concepts/workflows-and-actions/reusing-workflow-configurations.md"},{"path":"content/code-security/how-tos/find-and-fix-code-vulnerabilities/scan-from-vs-code/run-queries-at-scale.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"{% ifversion ghec %}\n* The controller repository must be hosted on the same site as the repositories that you want to analyze using MRVA, that is: {% data variables.product.prodname_dotcom_the_website %} or {% data variables.enterprise.data_residency_domain %}. If you want to run MRVA on {% data variables.enterprise.data_residency %}, see [Changing the {% data variables.product.github %} URL used by the extension](/code-security/how-tos/find-and-fix-code-vulnerabilities/scan-from-vs-code/customize-settings#changing-the-github-url-used-by-the-extension).\n{% endif %}","matches":[{"indices":[277,280],"text":"run"}],"property":"content","type":"FileContent"},{"fragment":"\n1. In the \"Variant Analysis Repositories\" view, click **+** to add a new database.\n","matches":[{"indices":[70,73],"text":"new"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/code-security/how-tos/find-and-fix-code-vulnerabilities/scan-from-vs-code/run-queries-at-scale.md"},{"path":"content/actions/reference/workflows-and-actions/workflow-commands.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"\n## Using workflow commands to access toolkit functions\n","matches":[{"indices":[10,18],"text":"workflow"}],"property":"content","type":"FileContent"},{"fragment":"\nIf you do not need to pass your secret from one job to another job, you can:\n1. Generate the secret (without outputting it).","matches":[{"indices":[11,14],"text":"not"},{"indices":[57,60],"text":"not"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/actions/reference/workflows-and-actions/workflow-commands.md"},{"path":"content/code-security/reference/code-scanning/troubleshoot-analysis-errors/logs-not-detailed-enough.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"\nIf your logs are not detailed enough to troubleshoot a problem, there are several steps you can take to obtain extra information and make logs more useful.\n","matches":[{"indices":[14,15],"text":"a"},{"indices":[18,21],"text":"not"},{"indices":[25,26],"text":"a"},{"indices":[54,55],"text":"a"},{"indices":[71,72],"text":"a"},{"indices":[80,81],"text":"a"},{"indices":[94,95],"text":"a"},{"indices":[98,99],"text":"a"},{"indices":[108,109],"text":"a"},{"indices":[116,117],"text":"a"},{"indices":[124,125],"text":"a"},{"indices":[130,131],"text":"a"},{"indices":[135,136],"text":"a"}],"property":"content","type":"FileContent"},{"fragment":"\nYou can also use the `runner.debug` context to conditionally run steps only when debug logging is enabled. See [AUTOTITLE](/actions/reference/workflows-and-actions/contexts#runner-context).\n","matches":[{"indices":[6,7],"text":"a"},{"indices":[9,10],"text":"a"},{"indices":[23,26],"text":"run"},{"indices":[57,58],"text":"a"},{"indices":[62,65],"text":"run"},{"indices":[101,102],"text":"a"},{"indices":[113,114],"text":"A"},{"indices":[125,126],"text":"a"},{"indices":[143,151],"text":"workflow"},{"indices":[153,154],"text":"a"},{"indices":[157,158],"text":"a"},{"indices":[174,177],"text":"run"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/content/code-security/reference/code-scanning/troubleshoot-analysis-errors/logs-not-detailed-enough.md"},{"path":"src/ghes-releases/scripts/create-enterprise-issue.ts","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"if (!process.env.GITHUB_TOKEN) {\n  throw new Error('Error! You must have a GITHUB_TOKEN set in an .env file to run this script.')\n}","matches":[{"indices":[41,44],"text":"new"},{"indices":[69,70],"text":"a"},{"indices":[73,74],"text":"a"},{"indices":[95,96],"text":"a"},{"indices":[111,114],"text":"run"}],"property":"content","type":"FileContent"},{"fragment":"    console.log(\n      `The ${oldestSupported} deprecation is not until ${deprecationDate}! An issue will be opened when it is ${numberOfDaysBefore} days away.`,\n    )","matches":[{"indices":[62,65],"text":"not"},{"indices":[101,105],"text":"will"}],"property":"content","type":"FileContent"}],"url":"https://github.com/github/docs/blob/95cd2ed6c6fca35f77b696adc05e974885dd98ce/src/ghes-releases/scripts/create-enterprise-issue.ts"},{"path":"content/actions/reference/workflows-and-actions/workflow-syntax.md","repository":{"id":"MDEwOlJlcG9zaXRvcnkxODk2MjE2MDc=","isFork":false,"isPrivate":false,"nameWithOwner":"github/docs","url":"https://github.com/github/docs"},"textMatches":[{"fragment":"shortTitle: Workflow syntax\nintro: A workflow is a configurable automated process made up of one or more jobs. You must create a YAML file to define your workflow configuration.\nredirect_from:","matches":[{"indices":[12,20],"text":"Workflow"},{"indices":[25,26],"text":"a"},{"indices":[35,36],"text":"A"},{"indices":[37,45],"text":"workflow"},{"indices":[49,50],"text":"a"},{"indices":[59,60],"text":"a"},{"indices":[64,65],"text":"a"},{"indices":[69,70],"text":"a"},{"indices":[83,84],"text":"a"},{"indices":[120,126],"text":"create"},