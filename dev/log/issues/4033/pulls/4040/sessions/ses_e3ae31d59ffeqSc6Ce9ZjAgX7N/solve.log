data already calculated for the working\n00657|   // session summary; retain the fallback for callers that do not precompute it.\n00658|   const budgetStatsData =\n00659|     precomputedBudgetStatsData ??\n00660|     (await buildSessionBudgetStatsData({\n00661|       argv,\n00662|       sessionId,\n00663|       tempDir,\n00664|       resultModelUsage,\n00665|       streamTokenUsage,\n00666|       subAgentCalls,\n00667|       pricingInfo,\n00668|     }));\n00669|   try {\n00670|     // Get the current user's GitHub username\n00671|     const userResult = await $(QUIET_PROBE)`gh api user --jq .login`;\n00672| \n00673|     let currentUser = null;\n00674|     if (userResult.code !== 0) {\n00675|       const userError = userResult.stderr?.toString() || '';\n00676|       // Issue #2625: installation tokens (GITHUB_TOKEN) cannot read GET /user;\n00677|       // the PR search does not need a login and comments are matched by app.\n00678|       if (!isIntegrationForbidden(userError)) {\n00679|         throw new Error(`Failed to get current user: ${userError || 'Unknown error'}`);\n00680|       }\n00681|       await log('  ℹ️  Integration token cannot read the authenticated user; matching comments written by the app', { verbose: true });\n00682|     } else {\n00683|       currentUser = userResult.stdout.toString().trim();\n00684|       if (!currentUser) {\n00685|         throw new Error('Unable to determine current GitHub user');\n00686|       }\n00687|     }\n00688| \n00689|     // Search for pull requests created from our branch\n00690|     await log('\\n🔍 Checking for pull requests from branch ' + branchName + '...');\n00691|     // First, get all PRs from our branch\n00692|     // IMPORTANT: Use --state all to find PRs that may have been merged during the session (Issue #1008)\n00693|     // Without --state all, gh pr list only returns OPEN PRs, missing merged ones\n00694|     // Issue #2135: `mirror: false` - the pull requests found are named below.\n00695|     const all