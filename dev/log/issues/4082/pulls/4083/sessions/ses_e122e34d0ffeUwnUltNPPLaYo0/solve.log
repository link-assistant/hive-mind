          try {\\n00377|             const reviewsResult = await quietProbe($)`gh api repos/${owner}/${repo}/pulls/${prNumber}/reviews --paginate`;\\n00378|             if (reviewsResult.code === 0) {\\n00379|               const reviews = JSON.parse(reviewsResult.stdout.toString());\\n00380|               const changesRequestedReviews = reviews.filter(review => review.state === 'CHANGES_REQUESTED' && new Date(review.submitted_at) > lastCommitTime);\\n00381| \\n00382|               if (changesRequestedReviews.length > 0) {\\n00383|                 feedbackLines.push(promptText('prompt.templates.solve-feedback.detectAndCountFeedback.text8', { value1: String(changesRequestedReviews.length) }));\\n00384|                 feedbackDetected = true;\\n00385|                 feedbackSources.push(`Changes requested (${changesRequestedReviews.length})`);\\n00386|               }\\n00387|             }\\n00388|           } catch (error) {\\n00389|             reportError(error, {\\n00390|               context: 'check_pr_reviews',\\n00391|               prNumber,\\n00392|               operation: 'fetch_pr_reviews',\\n00393|             });\\n00394|             if (argv.verbose) {\\n00395|               await log(`Warning: Could not check PR reviews: ${cleanErrorMessage(error)}`, { level: 'warning' });\\n00396|             }\\n00397|           }\\n00398| \\n00399|           // Handle --continue-only-on-feedback option\\n00400|           if (argv.continueOnlyOnFeedback) {\\n00401|             if (feedbackDetected) {\\n00402|               await log('✅ continue-only-on-feedback: Feedback detected, continuing...');\\n00403|               await log(formatAligned('📋', 'Feedback sources:', feedbackSources.join(', '), 2));\\n00404|             } else {\\n00405|               await log('❌ continue-only-on-feedback: No feedback detected since last commit');\\n00406|               await log('   This option requires any of the following to proceed:');\\n00407|               await log('   