591: used by armory to show progress bar animation.\n01293| func get_weapon_single_condition_progress(weapon_id: String) -> float:\n01294| \tfor condition_key in UNLOCK_CONDITIONS:\n01295| \t\tvar condition: Dictionary = UNLOCK_CONDITIONS[condition_key]\n01296| \t\tif weapon_id in condition.get(\"weapons\", []):\n01297| \t\t\treturn 1.0 if is_condition_key_met(condition_key) else 0.0\n01298| \treturn -1.0\n01299| \n01300| \n01301| ## Get the single-level condition progress for a grenade type (0.0 or 1.0, binary).\n01302| ## Returns -1.0 if no single-level condition applies.\n01303| ## Issue #1591: used by armory to show progress bar animation.\n01304| func get_grenade_single_condition_progress(grenade_type: int) -> float:\n01305| \tfor condition_key in UNLOCK_CONDITIONS:\n01306| \t\tvar condition: Dictionary = UNLOCK_CONDITIONS[condition_key]\n01307| \t\tif grenade_type in condition.get(\"grenades\", []):\n01308| \t\t\treturn 1.0 if is_condition_key_met(condition_key) else 0.0\n01309| \treturn -1.0\n01310| \n01311| \n01312| ## Get the single-level condition progress for an active item type (0.0 or 1.0, binary).\n01313| ## Returns -1.0 if no single-level condition applies.\n01314| ## Issue #1591: used by armory to show progress bar animation.\n01315| func get_active_item_single_condition_progress(item_type: int) -> float:\n01316| \tfor condition_key in UNLOCK_CONDITIONS:\n01317| \t\tvar condition: Dictionary = UNLOCK_CONDITIONS[condition_key]\n01318| \t\tif item_type in condition.get(\"active_items\", []):\n01319| \t\t\treturn 1.0 if is_condition_key_met(condition_key) else 0.0\n01320| \treturn -1.0\n01321| \n01322| \n01323| ## Get the best unlock condition progress for a weapon across all condition types (0.0–1.0).\n01324| ## Returns -1.0 if this weapon has no quantifiable unlock condition at all.\n01325| ## Issue #1591: unified function used by armory to show progress bar animation for all types.\n01326| func get_weapon_unlock_progress(weapon_id: String) -> float:\