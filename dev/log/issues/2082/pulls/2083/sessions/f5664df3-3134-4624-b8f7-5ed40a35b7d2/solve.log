[2026-07-19T12:57:25.657Z] [INFO]           "command": "python3 - <<'PY'\nimport re\n# job -> timeout, chosen from observed maxima (see commit message) with headroom\nVALUES = {\n 'cleanup': 15,\n 'detect-changes': 10, 'version-check': 10, 'changeset-check': 10,\n 'test-compilation': 15, 'lint': 15, 'check-file-line-limits': 10,\n 'test-suites': 30, 'test-execution': 20, 'memory-check-linux': 20,\n 'validate-docs': 15, 'docker-pr-check': 30, 'helm-pr-check': 20,\n 'release': 30, 'docker-publish-merge': 30, 'docker-publish-dind-merge': 30,\n 'helm-release': 20, 'instant-release': 30,\n 'docker-publish-instant-merge': 30, 'docker-publish-dind-instant-merge': 30,\n 'helm-release-instant': 20, 'changeset-pr': 15,\n}\nfor path in ('.github/workflows/release.yml', '.github/workflows/cleanup-test-repos.yml'):\n    lines = open(path).read().split('\\n')\n    out, i, added = [], 0, []\n    current = None\n    while i < len(lines):\n        line = lines[i]\n        m = re.match(r'^  ([A-Za-z_][A-Za-z0-9_-]*):\\s*$', line)\n        if m and m.group(1) in VALUES:\n            current = m.group(1)\n        elif re.match(r'^\\S', line):\n            current = None\n        out.append(line)\n        # insert right after the job's runs-on line\n        if current and re.match(r'^    runs-on:', line):\n            out.append(f'    timeout-minutes: {VALUES[current]}')\n            added.append(current)\n            current = None\n        i += 1\n    open(path, 'w').write('\\n'.join(out))\n    print(path, '->', len(added), 'jobs:', ', '.join(added))\nPY\nnode tests/ci-workflow-timeouts-2082.test.mjs",
