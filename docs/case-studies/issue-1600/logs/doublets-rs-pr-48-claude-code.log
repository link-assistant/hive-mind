[2026-04-14T07:54:43.752Z] [INFO]         "content": "1\t#!/usr/bin/env node\n2\t\n3\t/**\n4\t * Parse changelog fragments and determine version bump type\n5\t *\n6\t * This script reads changeset fragments from changelog.d/ and determines\n7\t * the version bump type based on the frontmatter in each fragment.\n8\t *\n9\t * Fragment format:\n10\t * ---\n11\t * bump: patch|minor|major\n12\t * ---\n13\t *\n14\t * ### Added\n15\t * - Your changes here\n16\t *\n17\t * Usage: node scripts/get-bump-type.mjs [--default <patch|minor|major>]\n18\t *\n19\t * Uses link-foundation libraries:\n20\t * - use-m: Dynamic package loading without package.json dependencies\n21\t * - lino-arguments: Unified configuration from CLI args, env vars, and .lenv files\n22\t */\n23\t\n24\timport { readFileSync, readdirSync, existsSync, appendFileSync } from 'fs';\n25\timport { join } from 'path';\n26\t\n27\t// Load use-m dynamically\n28\tconst { use } = eval(\n29\t  await (await fetch('https://unpkg.com/use-m/use.js')).text()\n30\t);\n31\t\n32\t// Import lino-arguments for CLI argument parsing\n33\tconst { makeConfig } = await use('lino-arguments');\n34\t\n35\t// Parse CLI arguments\n36\tconst config = makeConfig({\n37\t  yargs: ({ yargs, getenv }) =>\n38\t    yargs\n39\t      .option('default', {\n40\t        type: 'string',\n41\t        default: getenv('DEFAULT_BUMP', 'patch'),\n42\t        describe: 'Default bump type if no fragments specify one',\n43\t        choices: ['major', 'minor', 'patch'],\n44\t      }),\n45\t});\n46\t\n47\tconst { default: defaultBump } = config;\n48\t\n49\tconst CHANGELOG_DIR = 'changelog.d';\n50\t\n51\t// Bump type priority (higher = more significant)\n52\tconst BUMP_PRIORITY = {\n53\t  patch: 1,\n54\t  minor: 2,\n55\t  major: 3,\n56\t};\n57\t\n58\t/**\n59\t * Parse frontmatter from a markdown file\n60\t * @param {string} content - File content\n61\t * @returns {{bump?: string, content: string}}\n62\t */\n63\tfunction parseFrontmatter(content) {\n64\t  const frontmatterMatch = content.match(/^---\\s*\\n([\\s\\S]*?)\\n---\\s*\\n([\\s\\S]*)$/);\n65\t\n66\t  if (!frontmatterMatch) {\n67\t    return { content };\n68\t  }\n69\t\n70\t  const frontmatter = frontmatterMatch[1];\n71\t  const body = frontmatterMatch[2];\n72\t\n73\t  // Parse YAML-like frontmatter (simple key: value format)\n74\t  const data = {};\n75\t  for (const line of frontmatter.split('\\n')) {\n76\t    const match = line.match(/^\\s*(\\w+)\\s*:\\s*(.+?)\\s*$/);\n77\t    if (match) {\n78\t      data[match[1]] = match[2];\n79\t    }\n80\t  }\n81\t\n82\t  return { ...data, content: body };\n83\t}\n84\t\n85\t/**\n86\t * Get all changelog fragments and determine bump type\n87\t * @returns {{bumpType: string, fragmentCount: number}}\n88\t */\n89\tfunction determineBumpType() {\n90\t  if (!existsSync(CHANGELOG_DIR)) {\n91\t    console.log(`No ${CHANGELOG_DIR} directory found`);\n92\t    return { bumpType: defaultBump, fragmentCount: 0 };\n93\t  }\n94\t\n95\t  const files = readdirSync(CHANGELOG_DIR)\n96\t    .filter((f) => f.endsWith('.md') && f !== 'README.md')\n97\t    .sort();\n98\t\n99\t  if (files.length === 0) {\n100\t    console.log('No changelog fragments found');\n101\t    return { bumpType: defaultBump, fragmentCount: 0 };\n102\t  }\n103\t\n104\t  let highestPriority = 0;\n105\t  let highestBumpType = defaultBump;\n106\t\n107\t  for (const file of files) {\n108\t    const content = readFileSync(join(CHANGELOG_DIR, file), 'utf-8');\n109\t    const { bump } = parseFrontmatter(content);\n110\t\n111\t    if (bump && BUMP_PRIORITY[bump]) {\n112\t      const priority = BUMP_PRIORITY[bump];\n113\t      if (priority > highestPriority) {\n114\t        highestPriority = priority;\n115\t        highestBumpType = bump;\n116\t      }\n117\t      console.log(`Fragment ${file}: bump=${bump}`);\n118\t    } else {\n119\t      console.log(`Fragment ${file}: no bump specified, using default`);\n120\t    }\n121\t  }\n122\t\n123\t  return { bumpType: highestBumpType, fragmentCount: files.length };\n124\t}\n125\t\n126\t/**\n127\t * Append to GitHub Actions output file\n128\t * @param {string} key\n129\t * @param {string} value\n130\t */\n131\tfunction setOutput(key, value) {\n132\t  const outputFile = process.env.GITHUB_OUTPUT;\n133\t  if (outputFile) {\n134\t    appendFileSync(outputFile, `${key}=${value}\\n`);\n135\t  }\n136\t  // Also log for visibility\n137\t  console.log(`Output: ${key}=${value}`);\n138\t}\n139\t\n140\ttry {\n141\t  const { bumpType, fragmentCount } = determineBumpType();\n142\t\n143\t  console.log(`\\nDetermined bump type: ${bumpType} (from ${fragmentCount} fragment(s))`);\n144\t\n145\t  setOutput('bump_type', bumpType);\n146\t  setOutput('fragment_count', String(fragmentCount));\n147\t  setOutput('has_fragments', fragmentCount > 0 ? 'true' : 'false');\n148\t\n149\t} catch (error) {\n150\t  console.error('Error:', error.message);\n151\t  process.exit(1);\n152\t}\n153\t"
