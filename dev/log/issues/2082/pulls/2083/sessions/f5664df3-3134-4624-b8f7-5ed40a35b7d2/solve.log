[2026-07-19T13:00:40.502Z] [INFO]         "content": "1\t#!/usr/bin/env bash\n2\t# test-auto-fork-option.sh\n3\t#\n4\t# Tests that the --auto-fork flag is correctly recognised and propagated by\n5\t# solve.mjs, hive.mjs, and start-screen.mjs.\n6\t#\n7\t# Usage:\n8\t#   bash scripts/test-auto-fork-option.sh\n9\t#\n10\t# Exit code 0 = all --auto-fork tests pass; non-zero = unexpected failure.\n11\t\n12\tset -euo pipefail\n13\t\n14\techo \"Testing --auto-fork option with dry-run mode...\"\n15\t\n16\techo \"\"\n17\techo \"Testing solve.mjs with --auto-fork and --dry-run...\"\n18\ttimeout 10s ./src/solve.mjs https://github.com/test/repo/issues/1 --auto-fork --dry-run --skip-tool-check 2>&1 | tee solve_auto_fork.log || true\n19\tif grep -qE \"(auto-fork|Auto-fork)\" solve_auto_fork.log; then\n20\t  echo \"solve.mjs recognizes --auto-fork flag\"\n21\telse\n22\t  echo \"Could not verify --auto-fork flag in solve output\"\n23\tfi\n24\t\n25\techo \"\"\n26\techo \"Testing hive.mjs with --auto-fork and --dry-run...\"\n27\ttimeout 30s ./src/hive.mjs https://github.com/test/repo --auto-fork --dry-run --skip-tool-check --once --max-issues 1 2>&1 | tee hive_auto_fork.log || true\n28\tif grep -qE \"(auto-fork|Auto-fork)\" hive_auto_fork.log; then\n29\t  echo \"hive.mjs recognizes --auto-fork flag\"\n30\telse\n31\t  echo \"Could not verify --auto-fork flag in hive output\"\n32\tfi\n33\t\n34\techo \"\"\n35\techo \"Testing deprecated start-screen.mjs accepts --auto-fork without opening a screen...\"\n36\tNODE_BIN=\"${NODE_BIN:-$(command -v node)}\"\n37\tNO_SCREEN_PATH=\"$(dirname \"${NODE_BIN}\")\"\n38\tPATH=\"${NO_SCREEN_PATH}\" \"${NODE_BIN}\" ./src/start-screen.mjs solve https://github.com/test/repo/issues/1 --auto-fork --dry-run 2>&1 | tee start_screen_auto_fork.log || true\n39\tif grep -qE \"(GNU Screen is not installed|screen.*not.*installed)\" start_screen_auto_fork.log && ! grep -q \"Unknown option\" start_screen_auto_fork.log; then\n40\t  echo \"start-screen.mjs accepts --auto-fork flag without creating a legacy screen\"\n41\telse\n42\t  echo \"Could not verify start-screen flag acceptance\"\n43\tfi\n44\t\n45\techo \"\"\n46\techo \"All --auto-fork option tests completed\"\n47\t"
