0\t  replyTo = null,\n61\t}) => ({\n62\t  id: `msg:${source}:${externalId}`,\n63\t  tokens: ['message', source, externalId],\n64\t  children: [\n65\t    `sender:${source}:${sender}`,\n66\t    `chat:${source}:${chat}`,\n67\t    `body:${source}:${externalId}`,\n68\t    `ts:${source}:${externalId}`,\n69\t    ...(replyTo ? [`replyto:${source}:${replyTo}`] : []),\n70\t  ],\n71\t  body,\n72\t  timestamp,\n73\t  sender,\n74\t  chat,\n75\t  replyTo,\n76\t});\n77\t\n78\texport const importInto = async (store, source, archive) => {\n79\t  const adapter = getSource(source);\n80\t  const messages = await adapter.parseArchive(archive);\n81\t  for (const m of messages) {\n82\t    await store.put(m);\n83\t  }\n84\t  return messages.length;\n85\t};\n86\t"
