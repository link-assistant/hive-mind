[2026-11-25T13:27:33.343Z] [INFO]       "output": "<file>\n00001| #!/usr/bin/env bash\n00002| \n00003| # Keep the complete program in one shell command so Bash reads the whole file\n00004| # before an action can run, including when the entry point is piped from curl.\n00005| exec bash -c \"$(cat <<'HIVE_MANAGER_PROGRAM'\n00006| set -eo pipefail\n00007| \n00008| fail() {\n00009|   printf 'hive-manager: %s\\n' \"$*\" >&2\n00010|   exit 1\n00011| }\n00012| \n00013| require() {\n00014|   command -v \"$1\" >/dev/null || fail \"Required command: $1\"\n00015| }\n00016| \n00017| need_value() {\n00018|   [[ ${2-} ]] || fail \"$1 requires a value\"\n00019| }\n00020| \n00021| usage() {\n00022|   cat <<'HELP'\n00023| Usage: hive-manager [--host HOST] [SSH options] COMMAND [ARGS]\n00024| \n00025|   deploy                Configure, deploy and maintain a Hive Mind instance\n00026|   auth                  Sign in to Claude, Codex or GitHub without opening the agent UI\n00027|   cleanup               Reclaim stale task state, processes and Docker resources\n00028|   configure-claude      Apply or verify Hive Mind Claude settings\n00029|   audit-config          Check global agent settings and optionally repair them\n00030|   screens               List, attach to or close finished Screen sessions\n00031|   models                Inspect the live model catalogue\n00032|   tasks                 Inspect or recover start-command task executions\n00033|   archive-session       Sanitize a session file and write it to stdout\n00034|   archive-sessions      Stage sanitized sessions associated with a public repository\n00035|   archive-publish       Publish a reviewed session archive to GitHub\n00036|   archive-overview      Render a source inventory from local archive manifests\n00037|   proxy-test            Verify Telegram text and media on a client network\n00038|   proxy-pcap            Summarize and compare bounded proxy packet captures\n00039|   close-linked-issues   Reconcile issues linked from merged pull requests\n00040| \n00041| SSH options (before COMMAND):\n00042|   --host [USER@]HOST    Use an OpenSSH destination or SSH config alias\n00043|   --jump HOSTS         Comma-separated OpenSSH jump hosts (-J)\n00044|   --ssh-config FILE    Read an alternate SSH configuration (-F)\n00045|   --ssh-option OPTION  Pass an OpenSSH option (-o), repeatable\n00046|   --ssh-port PORT      SSH port (-p)\n00047|   --tty                Request a terminal for interactive remote commands\n00048| \n00049| HIVE_MANAGER_PACKAGE_VERSION     Select the host maintenance package, including over SSH.\n00050| HIVE_MANAGER_PACKAGE_DIAGNOSTICS=1  Report host package selection on stderr.\n00051| Run hive-manager deploy --help for deployment options.\n00052| HELP\n00053| }\n00054| \n00055| deploy_usage() {\n00056|   cat <<'HELP'\n00057| Usage: hive-manager deploy [OPTIONS] ACTION [ARGS]\n00058| \n00059|   prepare               Pull the selected image before a rollout\n00060|   apply | update        Deploy or replace the instance, keeping a rollback\n00061|   rollback              Switch back to the previous container\n00062|   recover               Complete or undo an interrupted rollout\n00063|   auto-fix              Preview, apply or check profile-scoped operations recovery\n00064|   status | logs         Show instance status or stream Docker logs\n00065|   start | stop | restart\n00066|                         Control the instance\n00067|   remove                Remove a stopped container and retain its state\n00068|   exec [--] COMMAND     Run a command as box in the instance\n00069|   auth PROVIDER [login|status]\n00070|                         Sign in or check login in the instance\n00071|   update-dependencies   Preview or apply Bun global dependency updates as box\n00072|   global-tools          Audit or quarantine shared Claude and Codex extensions\n00073|   tool-services         Check or stop idle vendor helper processes\n00074|   doctor                Check host disk space and instance/runtime status\n00075|   diagnose [--since TIME | --task UUID [--attempt NUMBER]] [--resources] [--process PID]\n00076|                         Show host resources, container exit facts and optional journal evidence\n00077|   disk [--budget SECONDS | --docker-summary]\n00078|                         Report host storage and per-task Docker writable layers\n00079|   cleanup --scoped      Preview or apply detached host and task cache cleanup\n00080|   backup [--output FILE|-]\n00081|                         Save a private archive of deployment state\n00082|   backup --plan [SOURCES] | backup --plan-file FILE [--output FILE|-]\n00083|                         Review and stream a selected private backup bundle\n00084|   restore [--input FILE|-]\n00085|                         Extract an archive into a new state directory\n00086|   restore --bundle [--input FILE|-]\n00087|                         Verify and restore a private bundle to a new directory\n00088|   reboot --confirm      Reboot the deployment host\n00089|   docker-service        Check or start Docker, or enable daemon live restore\n00090|   proxy                 Manage an optional Telegram MTProto proxy\n00091|   compose ARGS          Run Docker Compose on the target (supports -f, --env-file)\n00092|   helm ARGS             Run Helm on the target (uses its kubeconfig)\n00093|   cleanup | configure-claude | audit-config | screens | models | tasks\n00094|   archive-session | archive-sessions | archive-publish | archive-overview | proxy-test | proxy-pcap | close-linked-issues\n00095|                         Run a maintenance command inside the instance\n00096| \n00097| Options (before ACTION):\n00098|   --profile FILE        Read target deployment options as key=value lines\n00099|   --name NAME           Container name (default: hive-mind)\n00100|   --state-dir PATH      Persistent state (default: ~/.hive-mind on the target)\n00101|   --variant plain|dind  Image variant (default: plain)\n00102|   --image IMAGE         Override the image tag or digest\n00103|   --env-file PATH       Private Docker environment file on the target\n00104|   --bot-config PATH     Private Telegram LINO configuration on the target\n00105|   --tool-policy PATH    Global tool policy JSON on the Docker host\n00106|   --docker-socket PATH  Connect plain mode to the specified host Docker socket\n00107|                         or use it for host image passthrough in dind mode\n00108|   --adopt               Allow replacement of a container created outside the manager\n00109|   --setup               Keep the container running for interactive setup\n00110|   --no-pull             Use the locally available image during apply\n00111|   --dry-run             Print the apply plan without changing the target\n00112|   --tty                 Allocate a terminal for Docker exec and inside commands\n00113| \n00114| Apply and update also accept -- COMMAND [ARGS] as the container startup command.\n00115| HELP\n00116| }\n00117| \n00118| # OpenSSH passes its command through the account's shell. Use POSIX single\n00119| # quoting for every word, including the program. Stdin remains available for\n00120| # commands such as restore, or for an interactive session.\n00121| shell_quote() {\n00122|   local escaped=${1//\\'/\\'\\\\\\'\\'}\n00123|   printf \"'%s'\" \"$escaped\"\n00124| }\n00125| \n00126| over_ssh() {\n00127|   require ssh\n00128|   [[ $host =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.@:+-]*$ || $host =~ ^:[a-fA-F0-9:]+$ ]] || fail \"Invalid SSH destination: $host\"\n00129|   local remote='exec' word\n00130|   if [[ $package_version || ${HIVE_MANAGER_PACKAGE_DIAGNOSTICS:-} ]]; then\n00131|     remote+=' env'\n00132|     if [[ $package_version ]]; then remote+=\" $(shell_quote \"HIVE_MANAGER_PACKAGE_VERSION=$package_version\")\"; fi\n00133|     if [[ ${HIVE_MANAGER_PACKAGE_DIAGNOSTICS:-} ]]; then\n00134|       remote+=\" $(shell_quote \"HIVE_MANAGER_PACKAGE_DIAGNOSTICS=$HIVE_MANAGER_PACKAGE_DIAGNOSTICS\")\"\n00135|     fi\n00136|   fi\n00137|   remote+=' bash -c'\n00138|   for word in \"$BASH_EXECUTION_STRING\" hive-manager \"$@\"; do\n00139|     remote+=\" $(shell_quote \"$word\")\"\n00140|   done\n00141|   exec ssh \"${ssh_options[@]}\" \"$ssh_terminal\" -- \"$host\" \"$remote\"\n00142| }\n00143| maintenance_spec() {\n00144|   case \"$1\" in\n00145|     cleanup|hive-cleanup) bin=hive-cleanup; module=cleanup.mjs ;;\n00146|     deploy-storage) bin=hive-manager; module=hive-manager/storage/main.mjs ;;\n00147|     deploy-auto-fix) bin=hive-manager; module=hive-manager/auto-fix/main.mjs ;;\n00148|     configure-claude) bin=configure-claude; module=configure-claude.mjs ;;\n00149|     screens|hive-screens) bin=hive-screens; module=hive-screens.mjs ;;\n00150|     models|hive-models) bin=hive-models; module=hive-models.mjs ;;\n00151|     archive-session) bin=hive-manager; module=hive-manager/archive/session.mjs ;;\n00152|     archive-sessions) bin=hive-manager; module=hive-manager/archive/sessions.mjs ;;\n00153|     archive-publish) bin=hive-manager; module=hive-manager/archive/publish.mjs ;;\n00154|     archive-overview) bin=hive-manager; module=hive-manager/archive/overview.mjs ;;\n00155|     proxy-test) bin=hive-manager; module=hive-manager/proxy/test.mjs ;;\n00156|     proxy-pcap) bin=hive-manager; module=hive-manager/proxy/pcap.mjs ;;\n00157|     proxy-legacy) bin=hive-manager; module=hive-manager/proxy/legacy.mjs ;;\n00158|     audit-config) bin=hive-manager; module=hive-manager/audit-config.mjs ;;\n00159|     update-dependencies) bin=hive-manager; module=hive-manager/maintenance/update-dependencies.mjs ;;\n00160|     task-report) bin=hive-manager; module=hive-manager/task/report.mjs ;;\n00161|     task-report-batch) bin=hive-manager; module=hive-manager/task/report-batch.mjs ;;\n00162|     task-check-browser) bin=hive-manager; module=hive-manager/task/check-browser.mjs ;;\n00163|     task-check-uploads) bin=hive-manager; module=hive-manager/task/check-uploads.mjs ;;\n00164|     task-recover-failed) bin=hive-manager; module=hive-manager/task/recover-failed.mjs ;;\n00165|     task-recover-queue) bin=hive-manager; module=hive-manager/task/recover-queue.mjs ;;\n00166|     task-repair-records) bin=hive-manager; module=hive-manager/task/repair-records.mjs ;;\n00167|     task-lifecycle) bin=hive-manager; module=hive-manager/task/lifecycle.mjs ;;\n00168|     close-linked-issues) bin=close-linked-issues; module=close-linked-issues.mjs ;;\n00169|     *) return 1 ;;\n00170|   esac\n00171| }\n00172| package_source() {\n00173|   local entry=${1:-$0} link source_dir\n00174|   if [[ $entry != */* ]]; then\n00175|     entry=$(command -v hive-manager) || return 1\n00176|   fi\n00177|   while [[ -L $entry ]]; do\n00178|     link=$(readlink \"$entry\") || return 1\n00179|     case \"$link\" in\n00180|       /*) entry=$link ;;\n00181|       *) entry=${entry%/*}/$link ;;\n00182|     esac\n00183|   done\n00184|   source_dir=${entry%/*}\n00185|   if [[ $entry == */hive-manager/cli.sh ]]; then\n00186|     source_dir=${source_dir%/*}\n00187|   fi\n00188|   [[ -f $source_dir/../package.json && -f $source_dir/hive.mjs ]] || return 1\n00189|   cd -- \"$…e>",
