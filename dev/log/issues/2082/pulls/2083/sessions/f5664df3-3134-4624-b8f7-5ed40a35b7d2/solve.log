[2026-07-19T12:27:45.791Z] [INFO]         "content": "1\t#!/usr/bin/env node\n2\timport { ensureUseM } from '../src/use-m-bootstrap.lib.mjs';\n3\t\n4\t/**\n5\t * Helm chart release script\n6\t * Usage: node scripts/helm-release.mjs --release-version <version>\n7\t *   release-version: Version number (e.g., 1.0.0)\n8\t *\n9\t * This script packages and publishes the Helm chart to the gh-pages branch.\n10\t * It expects Helm to be installed and Git to be configured.\n11\t *\n12\t * Uses link-foundation libraries:\n13\t * - use-m: Dynamic package loading without package.json dependencies\n14\t * - command-stream: Modern shell command execution with streaming support\n15\t * - lino-arguments: Unified configuration from CLI args, env vars, and .lenv files\n16\t */\n17\t\n18\timport { readFileSync, writeFileSync } from 'fs';\n19\t\n20\t// Load use-m dynamically\n21\tconst use = await ensureUseM();\n22\t\n23\t// Import link-foundation libraries\n24\tconst { $ } = await use('command-stream');\n25\tconst { makeConfig } = await use('lino-arguments');\n26\t\n27\t// Parse CLI arguments using lino-arguments\n28\t// Note: Using --release-version instead of --version to avoid conflict with yargs' built-in --version flag\n29\tconst config = makeConfig({\n30\t  yargs: ({ yargs, getenv }) =>\n31\t    yargs\n32\t      .option('release-version', {\n33\t        type: 'string',\n34\t        default: getenv('VERSION', ''),\n35\t        describe: 'Version number (e.g., 1.0.0)',\n36\t      })\n37\t      .option('helm-repo-url', {\n38\t        type: 'string',\n39\t        default: getenv('HELM_REPO_URL', 'https://link-assistant.github.io/hive-mind'),\n40\t        describe: 'Helm repository URL',\n41\t      })\n42\t      .option('github-actor', {\n43\t        type: 'string',\n44\t        default: getenv('GITHUB_ACTOR', 'github-actions'),\n45\t        describe: 'GitHub username for Git commits',\n46\t      }),\n47\t});\n48\t\n49\tconst { releaseVersion: version, helmRepoUrl, githubActor } = config;\n50\t\n51\tif (!version) {\n52\t  console.error('Error: Version is required');\n53\t  console.error('Usage: node scripts/helm-release.mjs --release-version <version>');\n54\t  process.exit(1);\n55\t}\n56\t\n57\tconst CHART_PATH = 'helm/hive-mind/Chart.yaml';\n58\t\n59\ttry {\n60\t  console.log(`Releasing Helm chart version ${version}...`);\n61\t\n62\t  // Configure Git\n63\t  await $`git config user.name \"${githubActor}\"`;\n64\t  await $`git config user.email \"${githubActor}@users.noreply.github.com\"`;\n65\t\n66\t  // Update Chart.yaml with new version\n67\t  console.log(`Updating Chart.yaml to version ${version}...`);\n68\t  let chartContent = readFileSync(CHART_PATH, 'utf8');\n69\t  chartContent = chartContent.replace(/^appVersion: .*/m, `appVersion: \"${version}\"`);\n70\t  chartContent = chartContent.replace(/^version: .*/m, `version: ${version}`);\n71\t  writeFileSync(CHART_PATH, chartContent);\n72\t  console.log('Updated Chart.yaml:');\n73\t  console.log(readFileSync(CHART_PATH, 'utf8'));\n74\t\n75\t  // Lint the chart\n76\t  console.log('');\n77\t  console.log('Linting Helm chart...');\n78\t  await $`helm lint helm/hive-mind`;\n79\t\n80\t  // Package the chart\n81\t  console.log('');\n82\t  console.log('Packaging Helm chart...');\n83\t  await $`mkdir -p .helm-packages`;\n84\t  await $`helm package helm/hive-mind -d .helm-packages`;\n85\t  await $`ls -la .helm-packages/`;\n86\t\n87\t  // Ensure gh-pages branch exists\n88\t  console.log('');\n89\t  console.log('Checking gh-pages branch...');\n90\t  const branchCheckResult = await $`git ls-remote --exit-code --heads origin gh-pages`.run({ capture: true });\n91\t\n92\t  if (branchCheckResult.code !== 0) {\n93\t    console.log('Creating gh-pages branch...');\n94\t    await $`git checkout --orphan gh-pages`;\n95\t    await $`git reset --hard`;\n96\t    await $`git commit --allow-empty -m \"Initialize gh-pages branch for Helm charts\"`;\n97\t    await $`git push origin gh-pages`;\n98\t    await $`git check