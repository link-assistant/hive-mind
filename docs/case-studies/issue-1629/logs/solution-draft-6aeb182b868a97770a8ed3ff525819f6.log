iculty → unlock Experimental Sample (Issue #1426)\\n00148| \\t\\t\\\"weapons\\\": [],\\n00149| \\t\\t\\\"grenades\\\": [],\\n00150| \\t\\t\\\"active_items\\\": [18]  # ActiveItemManager.ActiveItemType.EXPERIMENTAL_SAMPLE = 18\\n00151| \\t}\\n00152| ]\\n00153| \\n00154| ## Kill-based unlock conditions: unlocks that require accumulating a stat in GameManager.\\n00155| ## Each entry has:\\n00156| ##   - \\\"stat\\\": The GameManager variable to read (e.g. \\\"kills_without_laser_sight\\\")\\n00157| ##   - \\\"min_kills\\\": The minimum value of the stat required\\n00158| ##   - \\\"weapons\\\": List of weapon IDs to unlock\\n00159| ##   - \\\"grenades\\\": List of grenade type ints to unlock\\n00160| ##   - \\\"active_items\\\": List of active item type ints to unlock\\n00161| ## Issue #1196: добавь условие разблокировки предмета Лазерный прицел\\n00162| ## Issue #1346: добавь условие разблокировки предмета Хорошая Мелкая Моторика\\n00163| ## Issue #1389: update unlock conditions\\n00164| const KILL_UNLOCK_CONDITIONS: Array[Dictionary] = [\\n00165| \\t{\\n00166| \\t\\t# 400 kills without Laser Sight → unlock Laser Sight (Issue #1196, updated by Issue #1589)\\n00167| \\t\\t\\\"stat\\\": \\\"kills_without_laser_sight\\\",\\n00168| \\t\\t\\\"min_kills\\\": 400,\\n00169| \\t\\t\\\"weapons\\\": [],\\n00170| \\t\\t\\\"grenades\\\": [],\\n00171| \\t\\t\\\"active_items\\\": [9]  # ActiveItemManager.ActiveItemType.LASER_SIGHT = 9\\n00172| \\t},\\n00173| \\t{\\n00174| \\t\\t# 650 shots with shotgun, sniper rifle, or revolver → unlock Fine Motor Skills (Issue #1346, Issue #1053 req.2)\\n00175| \\t\\t\\\"stat\\\": \\\"shots_fired_special_weapons\\\",\\n00176| \\t\\t\\\"min_kills\\\": 650,\\n00177| \\t\\t\\\"weapons\\\": [],\\n00178| \\t\\t\\\"grenades\\\": [],\\n00179| \\t\\t\\\"active_items\\\": [19]  # ActiveItemManager.ActiveItemType.FINE_MOTOR_SKILLS = 19\\n00180| \\t},\\n00181| \\t{\\n00182| \\t\\t# 100 total deaths → unlock Armored Skin (Issue #1389)\\n00183| \\t\\t\\\"stat\\\": \\\"total_deaths\\\",\\n00184| \\t\\t\\\"min_kills\\\": 100,\\n00185| \\t\\t\\\"weapons\\\": [],\\n00186| \\t\\t\\\"grenades\\\": [],\\n00187| \\t\\t\\\"active_items\\\": [13]  # ActiveItemManager.ActiveItemType.ARMORED_SKIN = 13\\n00188| \\t},\\n00189| \\t{\\n00190| \\t\\t# 1 level completed without damage → unlock Combat Disposition (Issue #1389)\\n00191| \\t\\t\\\"stat\\\": \\\"no_damage_levels_completed\\\",\\n00192| \\t\\t\\\"min_kills\\\": 1,\\n00193| \\t\\t\\\"weapons\\\": [],\\n00194| \\t\\t\\\"grenades\\\": [],\\n00195| \\t\\t\\\"active_items\\\": [17]  # ActiveItemManager.ActiveItemType.COMBAT_DISPOSITION = 17\\n00196| \\t},\\n00197| \\t{\\n00198| \\t\\t# 7 levels completed at rank A or higher → unlock Breaker Bullets (Issue #1589 req.3)\\n00199| \\t\\t\\\"stat\\\": \\\"levels_completed_rank_a_or_higher\\\",\\n00200| \\t\\t\\\"min_kills\\\": 7,\\n00201| \\t\\t\\\"weapons\\\": [],\\n00202| \\t\\t\\\"grenades\\\": [],\\n00203| \\t\\t\\\"active_items\\\": [6]  # ActiveItemManager.ActiveItemType.BREAKER_BULLETS = 6\\n00204| \\t},\\n00205| \\t{\\n00206| \\t\\t# 50 kills through walls (any weapon) → unlock Drilling Bullets (Issue #1624 req.3)\\n00207| \\t\\t\\\"stat\\\": \\\"kills_through_wall\\\",\\n00208| \\t\\t\\\"min_kills\\\": 50,\\n00209| \\t\\t\\\"weapons\\\": [],\\n00210| \\t\\t\\\"grenades\\\": [],\\n00211| \\t\\t\\\"active_items\\\": [15]  # ActiveItemManager.ActiveItemType.DRILLING_BULLETS = 15\\n00212| \\t},\\n00213| \\t{\\n00214| \\t\\t# Complete any level with silenced pistol → unlock Auto Reload (Issue #1624 req.2)\\n00215| \\t\\t\\\"stat\\\": \\\"levels_completed_with_silenced_pistol\\\",\\n00216| \\t\\t\\\"min_kills\\\": 1,\\n00217| \\t\\t\\\"weapons\\\": [],\\n00218| \\t\\t\\\"grenades\\\": [],\\n00219| \\t\\t\\\"active_items\\\": [14]  # ActiveItemManager.ActiveItemType.AUTO_RELOAD = 14\\n00220| \\t}\\n00221| ]\\n00222| \\n00223| ## Multi-level unlock conditions: unlocks that require ALL listed levels to be completed at min_rank.\\n00224| ## Each entry has:\\n00225| ##   - \\\"levels\\\": Array of level paths, each with its own \\\"min_rank\\\"\\n00226| ##   - \\\"weapons\\\": List of weapon IDs to unlock\\n00227| ##   - \\\"grenades\\\": List of grenade type ints to unlock\\n00228| ##   - \\\"active_items\\\": List of active item type ints to unlock\\n00229| ## Issue #1000: req.5 and req.8\\n00230| const MULTI_UNLOCK_CONDITIONS: Array[Dictionary] = [\\n00231| \\t{\\n00232| \\t\\t# Beach S + Building S → Invisibility (Issue #1000 req.5)\\n00233| \\t\\t\\\"levels\\\": [\\n00234| \\t\\t\\t{\\\"path\\\": \\\"res://scenes/levels/BeachLevel.tscn\\\", \\\"min_rank\\\": \\\"S\\\"},\\n00235| \\t\\t\\t{\\\"path\\\": \\\"res://scenes/levels/BuildingLevel.tscn\\\", \\\"min_rank\\\": \\\"S\\\"}\\n00236| \\t\\t],\\n00237| \\t\\t\\\"weapons\\\": [],\\n00238| \\t\\t\\\"grenades\\\": [],\\n00239| \\t\\t\\\"active_items\\\": [5]  # ActiveItemManager.ActiveItemType.INVISIBILITY_SUIT = 5\\n00240| \\t},\\n00241| \\t{\\n00242| \\t\\t# Labyrinth S + Building S + Polygon S + Castle S + Double Corridor S → Homing Bullets (Issue #1000 req.8)\\n00243| \\t\\t\\\"levels\\\": [\\n00244| \\t\\t\\t{\\\"path\\\": \\\"res://scenes/levels/LabyrinthLevel.tscn\\\", \\\"min_rank\\\": \\\"S\\\"},\\n00245| \\t\\t\\t{\\\"path\\\": \\\"res://scenes/levels/BuildingLevel.tscn\\\", \\\"min_rank\\\": \\\"S\\\"},\\n00246| \\t\\t\\t{\\\"path\\\": \\\"res://scenes/levels/TestTier.tscn\\\", \\\"min_rank\\\": \\\"S\\\"},\\n00247| \\t\\t\\t{\\\"path\\\": \\\"res://scenes/levels/CastleLevel.tscn\\\", \\\"min_rank\\\": \\\"S\\\"},\\n00248| \\t\\t\\t{\\\"path\\\": \\\"res://scenes/levels/RevolverLevel.tscn\\\", \\\"min_rank\\\": \\\"S\\\"}\\n00249| \\t\\t],\\n00250| \\t\\t\\\"weapons\\\": [],\\n00251| \\t\\t\\\"grenades\\\": [],\\n00252| \\t\\t\\\"active_items\\\": [2]  # ActiveItemManager.ActiveItemType.HOMING_BULLETS = 2\\n00253| \\t}\\n00254| ]\\n00255| \\n00256| ## Signal emitted when any item is unlocked via a level condition.\\n00257| signal items_unlocked_by_condition(level_path: String)\\n00258| \\n00259| ## Signal emitted when a kill-based unlock condition becomes available.\\n00260| signal items_unlocked_by_kill_condition\\n00261| \\n00262| \\n00263| func _ready() -> void:\\n00264| \\t# Connect to ProgressManager to check conditions whenever progress is updated\\n00265| \\tvar progress_manager: Node = get_node_or_null(\\\"/root/ProgressManager\\\")\\n00266| \\tif progress_manager and progress_manager.has_signal(\\\"progress_updated\\\"):\\n00267| \\t\\tprogress_manager.progress_updated.connect(_on_progress_updated)\\n00268| \\t# Connect to GameManager to check kill-based conditions whenever a qualifying kill is made\\n00269| \\tvar game_manager: Node = get_node_or_null(\\\"/root/GameManager\\\")\\n00270| \\tif game_manager:\\n00271| \\t\\tif game_manager.has_signal(\\\"kills_without_laser_sight_updated\\\"):\\n00272| \\t\\t\\tgame_manager.kills_without_laser_sight_updated.connect(_on_kills_without_laser_sight_updated)\\n00273| \\t\\tif game_manager.has_signal(\\\"shots_fired_special_weapons_updated\\\"):\\n00274| \\t\\t\\tgame_manager.shots_fired_special_weapons_updated.connect(_on_shots_fired_special_weapons_updated)\\n00275| \\t\\tif game_manager.has_signal(\\\"total_deaths_updated\\\"):\\n00276| \\t\\t\\tgame_manager.total_deaths_updated.connect(_on_total_deaths_updated)\\n00277| \\t\\tif game_manager.has_signal(\\\"no_damage_levels_completed_updated\\\"):\\n00278| \\t\\t\\tgame_manager.no_damage_levels_completed_updated.connect(_on_no_damage_levels_completed_updated)\\n00279| \\t\\tif game_manager.has_signal(\\\"levels_completed_rank_a_or_higher_updated\\\"):\\n00280| \\t\\t\\tgame_manager.levels_completed_rank_a_or_higher_updated.connect(_on_levels_completed_rank_a_or_higher_updated)\\n00281| \\t\\tif game_manager.has_signal(\\\"kills_through_wall_updated\\\"):\\n00282| \\t\\t\\tgame_manager.kills_through_wall_updated.connect(_on_kills_through_wall_updated)\\n00283| \\t\\tif game_manager.has_signal(\\\"levels_completed_with_silenced_pistol_updated\\\"):\\n00284| \\t\\t\\tgame_manager.levels_completed_with_silenced_pistol_updated.connect(_on_levels_completed_with_silenced_pistol_updated)\\n00285| \\t# Reset condition-gated items to locked state first (in case old save data has them incorrectly\\n00286| \\t# marked as unlocked), then re-apply earned unlocks from progress. This ensures the unlock\\n00287| \\t# state is always consistent with actual level completion progress.\\n00288| \\t# Note: deferred so PersistManager has already loaded its saved state before we reset.\\n00289| \\tcall_deferred(\\\"_reset_and_apply_all_unlocks\\\")\\n00290| \\t_log(\\\"UnlockManager ready\\\")\\n00291| \\n00292| \\n00293| ## Called when ProgressManager emits progress_updated after a level is completed.\\n00294| ## Checks if any unlock conditions are now satisfied (items turn gold in armory).\\n00295| ## Note: items are NOT auto-unlocked here — the player must hold LMB on the gold\\n00296| ## slot in the armory to actually unlock them.\\n00297| func _on_progress_updated(level_path: String, difficulty_name: String) -> void:\\n00298| \\t# Notify that conditions may have changed so armory can refresh gold highlights.\\n00299| \\t# Check single-level conditions (any key whose scene path matches this level).\\n00300| \\tfor condition_key in UNLOCK_CONDITIONS:\\n00301| \\t\\tif _extract_scene_path(condition_key) == level_path and is_condition_key_met(condition_key):\\n00302| \\t\\t\\titems_unlocked_by_condition.emit(level_path)\\n00303| \\t\\t\\t_log(\\\"Condition met for level: %s — items now available to unlock in armory\\\" % level_path)\\n00304| \\t\\t\\tbreak\\n00305| \\t# Check multi-level conditions.\\n00306| \\tfor multi_condition in MULTI_UNLOCK_CONDITIONS:\\n00307| \\t\\tfor level_entry in multi_condition.get(\\\"levels\\\", []):\\n00308| \\t\\t\\tif level_entry.get(\\\"path\\\", \\\"\\\") == level_path:\\n00309| \\t\\t\\t\\tif is_multi_condition_met(multi_condition):\\n00310| \\t\\t\\t\\t\\titems_unlocked_by_condition.emit(level_path)\\n00311| \\t\\t\\t\\t\\t_log(\\\"Multi-condition met involving level: %s\\\" % level_path)\\n00312| \\t\\t\\t\\tbreak\\n00313| \\t# Check all-difficulties conditions.\\n00314| \\tif is_all_difficulties_condition_met():\\n00315| \\t\\titems_unlocked_by_condition.emit(level_path)\\n00316| \\t\\t_log(\\\"All-difficulties condition met — Experimental Sample now available to unlock in armory\\\")\\n00317| \\n00318| \\n00319| ## Called when GameManager emits kills_without_laser_sight_updated.\\n00320| ## Checks if any kill-based unlock conditions are now satisfied (items turn gold in armory).\\n00321| func _on_kills_without_laser_sight_updated(_new_count: int) -> void:\\n00322| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n00323| \\t\\tif is_kill_condition_met(kill_condition):\\n00324| \\t\\t\\titems_unlocked_by_kill_condition.emit()\\n00325| \\t\\t\\t_log(\\\"Kill condition met — items now available to unlock in armory\\\")\\n00326| \\t\\t\\tbreak\\n00327| \\n00328| \\n00329| ## Called when GameManager emits shots_fired_special_weapons_updated.\\n00330| ## Checks if any shot-based unlock conditions (stored in KILL_UNLOCK_CONDITIONS) are now satisfied.\\n00331| ## Issue #1346.\\n00332| func _on_shots_fired_special_weapons_updated(_new_count: int) -> void:\\n00333| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n00334| \\t\\tif kill_condition.get(\\\"stat\\\", \\\"\\\") == \\\"shots_fired_special_weapons\\\" and is_kill_condition_met(kill_condition):\\n00335| \\t\\t\\titems_unlocked_by_kill_condition.emit()\\n00336| \\t\\t\\t_log(\\\"Shot condition met — Fine Motor Skills now available to unlock in armory\\\")\\n00337| \\t\\t\\tbreak\\n00338| \\n00339| \\n00340| ## Called when GameManager emits total_deaths_updated.\\n00341| ## Checks if the Armored Skin death-based unlock condition is now satisfied.\\n00342| ## Issue #1389.\\n00343| func _on_total_deaths_updated(_new_count: int) -> void:\\n00344| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n00345| \\t\\tif kill_condition.get(\\\"stat\\\", \\\"\\\") == \\\"total_deaths\\\" and is_kill_condition_met(kill_condition):\\n00346| \\t\\t\\titems_unlocked_by_kill_condition.emit()\\n00347| \\t\\t\\t_log(\\\"Death condition met — Armored Skin now available to unlock in armory\\\")\\n00348| \\t\\t\\tbreak\\n00349| \\n00350| \\n00351| ## Called when GameManager emits no_damage_levels_completed_updated.\\n00352| ## Checks if the Combat Disposition no-damage-level condition is now satisfied.\\n00353| ## Issue #1389.\\n00354| func _on_no_damage_levels_completed_updated(_new_count: int) -> void:\\n00355| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n00356| \\t\\tif kill_condition.get(\\\"stat\\\", \\\"\\\") == \\\"no_damage_levels_completed\\\" and is_kill_condition_met(kill_condition):\\n00357| \\t\\t\\titems_unlocked_by_kill_condition.emit()\\n00358| \\t\\t\\t_log(\\\"No-damage level condition met — Combat Disposition now available to unlock in armory\\\")\\n00359| \\t\\t\\tbreak\\n00360| \\n00361| \\n00362| ## Called when GameManager emits levels_completed_rank_a_or_higher_updated.\\n00363| ## Checks if the Breaker Bullets rank-A condition is now satisfied.\\n00364| ## Issue #1589.\\n00365| func _on_levels_completed_rank_a_or_higher_updated(_new_count: int) -> void:\\n00366| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n00367| \\t\\tif kill_condition.get(\\\"stat\\\", \\\"\\\") == \\\"levels_completed_rank_a_or_higher\\\" and is_kill_condition_met(kill_condition):\\n00368| \\t\\t\\titems_unlocked_by_kill_condition.emit()\\n00369| \\t\\t\\t_log(\\\"Rank-A level condition met — Breaker Bullets now available to unlock in armory\\\")\\n00370| \\t\\t\\tbreak\\n00371| \\n00372| \\n00373| ## Called when GameManager emits kills_through_wall_updated.\\n00374| ## Checks if the Drilling Bullets wall-kill condition is now satisfied.\\n00375| ## Issue #1624.\\n00376| func _on_kills_through_wall_updated(_new_count: int) -> void:\\n00377| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n00378| \\t\\tif kill_condition.get(\\\"stat\\\", \\\"\\\") == \\\"kills_through_wall\\\" and is_kill_condition_met(kill_condition):\\n00379| \\t\\t\\titems_unlocked_by_kill_condition.emit()\\n00380| \\t\\t\\t_log(\\\"Wall-kill condition met — Drilling Bullets now available to unlock in armory\\\")\\n00381| \\t\\t\\tbreak\\n00382| \\n00383| \\n00384| ## Called when GameManager emits levels_completed_with_silenced_pistol_updated.\\n00385| ## Checks if the Auto Reload silenced-pistol level condition is now satisfied.\\n00386| ## Issue #1624.\\n00387| func _on_levels_completed_with_silenced_pistol_updated(_new_count: int) -> void:\\n00388| \\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\n00389| \\t\\tif kill_condition.get(\\\"stat\\\", \\\"\\\") == \\\"levels_completed_with_silenced_pistol\\\" and is_kill_condition_met(kill_condition):\\n00390| \\t\\t\\titems_unlocked_by_kill_condition.emit()\\n00391| \\t\\t\\t_log(\\\"Silenced-pistol level condition met — Auto Reload now available to unlock in armory\\\")\\n00392| \\t\\t\\tbreak\\n00393| \\n00394| \\n00395| ## Get the best rank for a level across all difficulties.\\n00396| ## @param level_path: The scene file path of the level.\\n00397| ## @return: The best rank string, or \\\"\\\" if never completed.\\n00398| func _get_best_rank_any_difficulty(level_path: String) -> String:\\n00399| \\tvar progress_manager: Node = get_node_or_null(\\\"/root/ProgressManager\\\")\\n00400| \\tif not progress_manager:\\n00401| \\t\\treturn \\\"\\\"\\n00402| \\n00403| \\tvar best_rank: String = \\\"\\\"\\n00404| \\tfor difficulty_name in _get_all_difficulty_names():\\n00405| \\t\\tvar rank: String = progress_manager.get_best_rank(level_path, difficulty_name)\\n00406| \\t\\tif not rank.is_empty() and _is_rank_better(rank, best_rank):\\n00407| \\t\\t\\tbest_rank = rank\\n00408| \\n00409| \\treturn best_rank\\n00410| \\n00411| \\n00412| ## Check if a rank meets or exceeds the minimum rank requirement.\\n00413| ## @param rank: The rank to check.\\n00414| ## @param min_rank: The minimum rank required.\\n00415| ## @return: true if rank is >= min_rank.\\n00416| func _is_rank_sufficient(rank: String, min_rank: String) -> bool:\\n00417| \\tif min_rank == \\\"F\\\":\\n00418| \\t\\t# F or higher means any completed run counts\\n00419| \\t\\treturn not rank.is_empty()\\n00420| \\treturn not _is_rank_better(min_rank, rank)  # min_rank is not better than rank => rank >= min_rank\\n00421| \\n00422| \\n00423| ## Compare two ranks. Returns true if new_rank is strictly better than old_rank.\\n00424| func _is_rank_better(new_rank: String, old_rank: String) -> bool:\\n00425| \\tif old_rank.is_empty():\\n00426| \\t\\treturn true\\n00427| \\tvar new_index: int = RANK_ORDER.find(new_rank)\\n00428| \\tvar old_index: int = RANK_ORDER.find(old_rank)\\n00429| \\tif new_index == -1:\\n00430| \\t\\treturn false\\n00431| \\tif old_index == -1:\\n00432| \\t\\treturn true\\n00433| \\treturn new_index > old_index\\n00434| \\n00435| \\n00436| ## Extract the actual scene path from a condition key.\\n00437| ## Keys may have a rank suffix like \\\"res://scenes/levels/BuildingLevel.tscn:S\\\".\\n00438| ## Returns the scene path part only.\\n00439| func _extract_scene_path(condition_key: String) -> String:\\n00440| \\t# Strip \\\":RANK\\\" suffix if present (the suffix won't start with \\\"res://\\\")\\n00441| \\tvar last_colon: int = condition_key.rfind(\\\":\\\")\\n00442| \\tif last_colon > 0 and not condition_key.substr(0, last_colon).ends_with(\\\"//\\\"):\\n00443| \\t\\t# The suffix is a rank like \\\":S\\\", \\\":D\\\", etc. (short, no slashes)\\n00444| \\t\\tvar suffix: String = condition_key.substr(last_colon + 1)\\n00445| \\t\\tif suffix in RANK_ORDER:\\n00446| \\t\\t\\treturn condition_key.substr(0, last_colon)\\n00447| \\treturn condition_key\\n00448| \\n00449| \\n00450| ## Check if a specific condition key's unlock condition is currently met (for UI highlighting).\\n00451| ## @param condition_key: The key in UNLOCK_CONDITIONS (may have rank suffix).\\n00452| ## @return: true if the condition has been met (item can be unlocked).\\n00453| func is_condition_key_met(condition_key: String) -> bool:\\n00454| \\tif condition_key not in UNLOCK_CONDITIONS:\\n00455| \\t\\treturn false\\n00456| \\tvar condition: Dictionary = UNLOCK_CONDITIONS[condition_key]\\n00457| \\tvar min_rank: String = condition.get(\\\"min_rank\\\", \\\"D\\\")\\n00458| \\tvar scene_path: String = _extract_scene_path(condition_key)\\n00459| \\tvar best_rank: String = _get_best_rank_any_difficulty(scene_path)\\n00460| \\treturn _is_rank_sufficient(best_rank, min_rank)\\n00461| \\n00462| \\n00463| ## Check if a specific level's unlock condition is currently met (for UI highlighting).\\n00464| ## Checks all condition keys that match this level path.\\n00465| ## @param level_path: The scene file path of the level.\\n00466| ## @return: true if any condition for this level has been met.\\n00467| func is_level_condition_met(level_path: String) -> bool:\\n00468| \\tfor condition_key in UNLOCK_CONDITIONS:\\n00469| \\t\\tif _extract_scene_path(condition_key) == level_path:\\n00470| \\t\\t\\tif is_condition_key_met(condition_key):\\n00471| \\t\\t\\t\\treturn true\\n00472| \\treturn false\\n00473| \\n00474| \\n00475| ## Check if a multi-level condition is currently met (all levels at required rank).\\n00476| ## @param multi_condition: A dictionary from MULTI_UNLOCK_CONDITIONS.\\n00477| ## @return: true if all levels meet their minimum rank requirement.\\n00478| func is_multi_condition_met(multi_condition: Dictionary) -> bool:\\n00479| \\tfor level_entry in multi_condition.get(\\\"levels\\\", []):\\n00480| \\t\\tvar path: String = level_entry.get(\\\"path\\\", \\\"\\\")\\n00481| \\t\\tvar min_rank: String = level_entry.get(\\\"min_rank\\\", \\\"D\\\")\\n00482| \\t\\tvar best_rank: String = _get_best_rank_any_difficulty(path)\\n00483| \\t\\tif not _is_rank_sufficient(best_rank, min_rank):\\n00484| \\t\\t\\treturn false\\n00485| \\treturn true\\n00486| \\n00487| \\n00488| ## Check if the all-difficulties unlock condition is currently met.\\n00489| ## The condition is met when at least one level has been completed on every available difficulty.\\n00490| ## @return: true if at least one level has been completed on each difficulty.\\n00491| func is_all_difficulties_condition_met() -> bool:\\n00492| \\tvar progress_manager: Node = get_node_or_null(\\\"/root/ProgressManager\\\")\\n00493| \\tif not progress_manager:\\n00494| \\t\\treturn false\\n00495| \\tfor difficulty_name in _get_all_difficulty_names():\\n00496| \\t\\tvar found: bool = false\\n00497| \\t\\tfor key in progress_manager.get_all_progress():\\n00498| \\t\\t\\t# Key format: \\\"level_path:difficulty_name\\\"\\n00499| \\t\\t\\tif key.ends_with(\\\":\\\" + difficulty_name):\\n00500| \\t\\t\\t\\tfound = true\\n00501| \\t\\t\\t\\tbreak\\n00502| \\t\\tif not found:\\n00503| \\t\\t\\treturn false\\n00504| \\treturn true\\n00505| \\n00506| \\n00507| ## Check if a kill-based unlock condition is currently met.\\n00508| ## @param kill_condition: A dictionary from KILL_UNLOCK_CONDITIONS.\\n00509| ## @return: true if the qualifying kill count meets or exceeds min_kills.\\n00510| func is_kill_condition_met(kill_condition: Dictionary) -> bool:\\n00511| \\tvar game_manager: Node = get_node_or_null(\\\"/root/GameManager\\\")\\n00512| \\tif not game_manager:\\n00513| \\t\\treturn false\\n00514| \\tvar stat: String = kill_condition.get(\\\"stat\\\", \\\"\\\")\\n00515| \\tvar min_kills: int = kill_condition.get(\\\"min_kills\\\", 0)\\n00516| \\tif stat.is_empty():\\n00517| \\t\\treturn false\\n00518| \\tvar current_kills: int = game_manager.get(stat) if game_manager.get(stat) != null else 0\\n00519| \\treturn current_kills >= min_kills\\n00520| \\n00521| \\n00522| ## Get all weapon IDs that are unlockable via level conditions (have a condition defined).\\n00523| ## @return: Array of weapon IDs 