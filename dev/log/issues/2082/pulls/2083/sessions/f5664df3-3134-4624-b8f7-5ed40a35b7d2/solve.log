[2026-07-19T12:49:31.398Z] [INFO]         "content": "1\t/**\n2\t * Classify npm publish failures and build actionable guidance.\n3\t *\n4\t * Why this exists (issue #2028, CI run 29035249489):\n5\t *   `scripts/publish-to-npm.mjs` used to run `await $\\`npm run changeset:publish\\``\n6\t *   and treat the *absence of a thrown error* as success. command-stream's `$`\n7\t *   does NOT throw on a non-zero exit code (documented in\n8\t *   docs/dependencies-research/command-stream-issues/issue-10-git-push-silent-failure.mjs),\n9\t *   so a failed publish was reported as `published=true`. In run 29035249489 the\n10\t *   underlying `npm publish --provenance` crashed with\n11\t *   \"Cannot find module 'sigstore'\" (npm 12.0.0 regression, npm/cli#9722),\n12\t *   `changeset publish` printed \"packages failed to publish\", yet the release job\n13\t *   went green and the downstream Docker jobs waited 5 minutes for a version that\n14\t *   was never published. This module gives the publish script reliable,\n15\t *   content-based failure detection instead of relying on a throw that never\n16\t *   happens.\n17\t *\n18\t * Ported and adapted from\n19\t * link-foundation/js-ai-driven-development-pipeline-template (PR #77, PR #116).\n20\t */\n21\t\n22\t// Substrings that indicate a publish failure in the combined stdout/stderr of\n23\t// `npm run changeset:publish`. Matched case-insensitively. `changeset publish`\n24\t// swallows npm's non-zero exit for individual packages, so scanning the output\n25\t// is the most reliable failure signal.\n26\texport const FAILURE_PATTERNS = [\n27\t  'packages failed to publish',\n28\t  'error occurred while publishing',\n29\t  'npm error code e',\n30\t  'npm error 404',\n31\t  'npm error 401',\n32\t  'npm error 403',\n33\t  'access token expired',\n34\t  'eneedauth',\n35\t  // npm 12.0.0 provenance regression (npm/cli#9722): the publish crashes inside\n36\t  // libnpmpublish with `Cannot find module 'sigstore'` / MODULE_NOT_FOUND.\n37\t  'cannot find module',\n38\t  'module_not_found',\n39\t];\n40\t\n41\t/**\n42\t * Detect whether changeset/npm publish output indicates a failure.\n43\t * @param {string} output - Combined stdout and stderr (and/or error message).\n44\t * @returns {string|null} - The matched failure pattern, or null if none.\n45\t */\n46\texport function detectPublishFailure(output) {\n47\t  const lowerOutput = String(output || '').toLowerCase();\n48\t  for (const pattern of FAILURE_PATTERNS) {\n49\t    if (lowerOutput.includes(pattern)) {\n50\t      return pattern;\n51\t    }\n52\t  }\n53\t  return null;\n54\t}\n55\t\n56\t// Failures caused by authentication / registry configuration. Retrying these is\n57\t// pointless and only hides the real cause behind a generic\n58\t// \"Failed to publish after N attempts\" message.\n59\texport const NON_RETRYABLE_PATTERNS = ['npm error 404', 'npm error 401', 'npm error 403', 'e404', 'e401', 'e403', 'access token expired', 'eneedauth', 'you must be logged in', 'unable to authenticate'];\n60\t\n61\t/**\n62\t * Determine whether a detected failure is caused by authentication / registry\n63\t * configuration (and therefore should not be retried).\n64\t * @param {string} output - Combined stdout and stderr (and/or error message).\n65\t * @returns {boolean}\n66\t */\n67\texport function isNonRetryableFailure(output) {\n68\t  const lowerOutput = String(output || '').toLowerCase();\n69\t  return NON_RETRYABLE_PATTERNS.some(pattern => lowerOutput.includes(pattern));\n70\t}\n71\t\n72\t/**\n73\t * Build an actionable, human-readable explanation for an authentication /\n74\t * registry-configuration publish failure (most commonly an E404 on the very\n75\t * first publish of a brand-new package via OIDC trusted publishing).\n76\t * @param {string} packageName - The package that failed to publish.\n77\t * @returns {string}\n78\t */\n79\texport function buildAuthFailureGuidance(packageName) {\n80\t  return [\n81\t    '',\n82\t    '=== NPM PUBLISH AUTHENTICATION / REGISTRY FAILURE ===',\n83\t    '',\n84\t    `Failed to publish ${packageName}. This is an authentication or registry`,\n85\t    'configuration error, not a transient one, so it was not retried.',\n86\t    '',\n87\t    'Most common cause: the FIRST publish of a brand-new package via npm OIDC',\n88\t    'trusted publishing returns \"E404 Not Found - PUT\". npm cannot bootstrap a',\n89\t    'new package with trusted publishing alone, because a trusted publisher can',\n90\t    'only be configured for a package that already exists on the registry.',\n91\t    '',\n92\t    'SOLUTION (choose one):',\n93\t    '  1. Bootstrap the first release with a classic automation token:',\n94\t    '     - Create a granular/automation token on npmjs.com with publish access.',\n95\t    '     - Add it as the repository secret NPM_TOKEN.',\n96\t    '     - The release workflow passes it as NODE_AUTH_TOKEN automatically, so',\n97\t    '       the next run will publish the initial version.',\n98\t    '  2. After the package exists, configure OIDC trusted publishing on',\n99\t    '     npmjs.com (Package settings -> Trusted publishing) so future releases',\n100\t    '     need no token at all. The NPM_TOKEN secret then becomes optional.',\n101\t    '',\n102\t    'See: https://docs.npmjs.com/trusted-publishers',\n103\t    '',\n104\t  ].join('\\n');\n105\t}\n106\t"
