footprint at zero. The Docker images in `docker/` simply run\n33\t * `node bin/meta-sovereign serve`.\n34\t */\n35\t\n36\timport http from 'node:http';\n37\timport path from 'node:path';\n38\timport { promises as fs } from 'node:fs';\n39\timport { fileURLToPath } from 'node:url';\n40\timport {\n41\t  createDualStore,\n42\t  createLinoTextStore,\n43\t  createDoubletsStore,\n44\t} from '../storage/index.js';\n45\timport { listSources } from '../sources/index.js';\n46\timport { json } from './util.js';\n47\timport { handleDerivedRoutes } from './routes-derived.js';\n48\timport { handleMutatingRoutes } from './routes-mutating.js';\n49\t\n50\tconst here = path.dirname(fileURLToPath(import.meta.url));\n51\tconst webRoot = path.resolve(here, '..', 'web');\n52\t\n53\tconst MIME = {\n54\t  '.html': 'text/html; charset=utf-8',\n55\t  '.js': 'application/javascript; charset=utf-8',\n56\t  '.css': 'text/css; charset=utf-8',\n57\t  '.json': 'application/json; charset=utf-8',\n58\t  '.svg': 'image/svg+xml',\n59\t};\n60\t\n61\tconst serveStatic = async (res, filePath) => {\n62\t  try {\n63\t    const buf = await fs.readFile(filePath);\n64\t    const ext = path.extname(filePath).toLowerCase();\n65\t    res.writeHead(200, {\n66\t      'content-type': MIME[ext] ?? 'application/octet-stream',\n67\t    });\n68\t    res.end(buf);\n69\t    return true;\n70\t  } catch {\n71\t    return false;\n72\t  }\n73\t};\n74\t\n75\tconst handleStatic = async (req, res, p) => {\n76\t  if (req.method !== 'GET') {\n77\t    return false;\n78\t  }\n79\t  if (p === '/' || p === '/index.html') {\n80\t    return serveStatic(res, path.join(webRoot, 'index.html'));\n81\t  }\n82\t  if (/^\\/[a-zA-Z0-9._-]+\\.(js|css|svg)$/.test(p)) {\n83\t    return serveStatic(res, path.join(webRoot, p.slice(1)));\n84\t  }\n85\t  return false;\n86\t};\n87\t\n88\tconst route = async (store, req, res) => {\n89\t  const url = new URL(req.url, 'http://localhost');\n90\t  const p = url.pathname;\n91\t  if (await handleStatic(req, res, p)) {\n92\t    return;\n93\t  }\n94\t  if (p === '/sources' && req.method === 'GET') {\n95\t    return json(res, 200, listSources());\n96\t  }\n97\t  if (await handleMutatingRoutes(store, req, res, p)) {\n98\t    return;\n99\t  }\n100\t  if (await handleDerivedRoutes(store, req, res, p, url)) {\n101\t    return;\n102\t  }\n103\t  return json(res, 404, { error: 'unknown route' });\n104\t};\n105\t\n106\texport const startServer = async ({\n107\t  port = 0,\n108\t  storeDir = '.meta-sovereign',\n109\t  store: providedStore,\n110\t} = {}) => {\n111\t  let store = providedStore;\n112\t  if (!store) {\n113\t    await fs.mkdir(storeDir, { recursive: true });\n114\t    const text = await createLinoTextStore(path.join(storeDir, 'data.lino'));\n115\t    const binary = await createDoubletsStore(path.join(storeDir, 'data.bin'));\n116\t    store = createDualStore({ binary, text });\n117\t  }\n118\t  const server = http.createServer((req, res) => {\n119\t    route(store, req, res).catch((err) =>\n120\t      json(res, 500, { error: err.message })\n121\t    );\n122\t  });\n123\t  await new Promise((resolve) => server.listen(port, '127.0.0.1', resolve));\n124\t  return {\n125\t    port: server.address().port,\n126\t    store,\n127\t    close: () =>\n128\t      new Promise((resolve) => {\n129\t        server.close(() => resolve());\n130\t      }),\n131\t  };\n132\t};\n133\t"
