        "content": "1\t#!/usr/bin/env node\n2\t\n3\t/**\n4\t * Bundled model catalogue for hive-mind.\n5\t *\n6\t * The alias maps, defaults and capability lists that ship with an installation,\n7\t * with no behaviour attached: every function that maps, validates or describes a\n8\t * model lives in ./index.mjs, which re-exports this module so the public surface\n9\t * is unchanged.\n10\t *\n11\t * Split out of ./index.mjs when the new-model additions of issue #2202 pushed it\n12\t * over the 1350-line early-warning threshold of\n13\t * scripts/check-file-line-limits.sh, following the extraction precedent of issue\n14\t * #2198. Keeping the catalogue in a leaf module also gives the live catalogue\n15\t * (issue #2202) one obvious thing to merge against: this file is the \"bundled\n16\t * with the installation\" half of that merge.\n17\t *\n18\t * @see https://github.com/link-assistant/hive-mind/issues/1473\n19\t * @see https://github.com/link-assistant/hive-mind/issues/2202\n20\t */\n21\t\n22\timport { FORMAL_AI_MODEL_ALIAS, FORMAL_AI_PROVIDER_MODEL_ID } from '../formal-ai-model.lib.mjs';\n23\t\n24\tconst formalAiNativeModelAliases = {\n25\t  [FORMAL_AI_MODEL_ALIAS]: FORMAL_AI_MODEL_ALIAS,\n26\t  [FORMAL_AI_PROVIDER_MODEL_ID]: FORMAL_AI_MODEL_ALIAS,\n27\t};\n28\t\n29\tconst formalAiProviderModelAliases = {\n30\t  [FORMAL_AI_MODEL_ALIAS]: FORMAL_AI_PROVIDER_MODEL_ID,\n31\t  [FORMAL_AI_PROVIDER_MODEL_ID]: FORMAL_AI_PROVIDER_MODEL_ID,\n32\t};\n33\t// Claude models (Anthropic API)\n34\t// Updated for Opus 4.5/4.6/4.7/4.8/5/5.5, Sonnet 4.6/5, and Fable 5/5.1 / Mythos 5/5.1 support\n35\t// (Issue #1221, Issue #1238, Issue #1329, Issue #1433, Issue #1620, Issue #1832, Issue #1875, Issue #2003, Issue #2096, Issue #2202, Issue #2290)\n36\texport const claudeModels = {\n37\t  ...formalAiNativeModelAliases,\n38\t  sonnet: 'claude-sonnet-5', // Sonnet 5 (Issue #2003)\n39\t  // Compatibility mapping for metadata and validation. Execution preserves the\n40\t  // vendor-managed rolling alias so the default advances beyond this snapshot.\n41\t  opus: 'claude-opus-5', // Rolling default at execution time (Issue #2096, #2290)\n42\t  haiku: 'claude-haiku-4-5-20251001', // Haiku 4.5\n43\t  'haiku-3-5': 'claude-3-5-haiku-20241022', // Haiku 3.5\n44\t  'haiku-3': 'claude-3-haiku-20240307', // Haiku 3\n45\t  opusplan: 'opusplan', // Special mode: Opus for planning, Sonnet for execution (Issue #1223)\n46\t  // Claude Fable 5.1 — the current Mythos-class flagship; Fable 5 moved to the\n47\t  // legacy list when 5.1 shipped, so the bare `fable` alias follows the vendor\n48\t  // (same precedent as `opus` → Opus 5 in Issue #2096) while `fable-5` stays\n49\t  // pinned for anyone who asked for that exact generation (Issue #2202)\n50\t  fable: 'claude-fable-5-1', // Fable 5.1 alias (Issue #2202)\n51\t  'fable-5-1': 'claude-fable-5-1', // Fable 5.1 short alias (Issue #2202)\n52\t  'claude-fable-5-1': 'claude-fable-5-1', // Fable 5.1 full ID (Issue #2202)\n53\t  // Claude Fable 5 — Anthropic's most capable widely released (Mythos-class) model, GA 2026-06-09 (Issue #1875)\n54\t  'fable-5': 'claude-fable-5', // Fable 5 short alias\n55\t  'claude-fable-5': 'claude-fable-5', // Fable 5 full ID\n56\t  // Claude Mythos 5.1 — Fable 5.1's capabilities without safety classifiers; invite only (Project Glasswing) (Issue #2202)\n57\t  'mythos-5-1': 'claude-mythos-5-1', // Mythos 5.1 short alias (Issue #2202)\n58\t  'claude-mythos-5-1': 'claude-mythos-5-1', // Mythos 5.1 full ID (Issue #2202)\n59\t  // Claude Mythos 5 — shares Fable 5's capabilities without safety classifiers; limited availability (Project Glasswing) (Issue #1875)\n60\t  'mythos-5': 'claude-mythos-5', // Mythos 5 short alias\n61\t  'claude-mythos-5': 'claude-mythos-5', // Mythos 5 full ID\n62\t  // Shorter version aliases (Issue #1221, Issue #1329 - PR comment feedback)\n63\t  'sonnet-5': 'claude-sonnet-5', // Sonnet 5 short alias (Issue #2003)\n64\t  'sonnet-4-6': 'claude-sonnet-4-6', // Sonnet 4.6 short alias (Issue #1329)\n65\t  'opus-5-5': 'claude-opus-5-5', // Opus 5.5 pinned alias (Issue #2290)\n66\t  'opus-5': 'claude-opus-5', // Opus 5 short alias (Issue #2096)\n67\t  'opus-4-8': 'claude-opus-4-8', // Opus 4.8 short alias (Issue #1832)\n68\t  'opus-4-7': 'claude-opus-4-7', // Opus 4.7 short alias (backward compatibility)\n69\t  'opus-4-6': 'claude-opus-4-6', // Opus 4.6 short alias (backward compatibility)\n70\t  'opus-4-5': 'claude-opus-4-5-20251101', // Opus 4.5 short alias\n71\t  'sonnet-4-5': 'claude-sonnet-4-5-20250929', // Sonnet 4.5 short alias (backward compatibility)\n72\t  'haiku-4-5': 'claude-haiku-4-5-20251001', // Haiku 4.5 short alias\n73\t  // Version aliases for backward compatibility (Issue #1221, Issue #1329, Issue #1620, Issue #1832, Issue #2096)\n74\t  'claude-opus-5-5': 'claude-opus-5-5', // Opus 5.5 (Issue #2290)\n75\t  'claude-opus-5': 'claude-opus-5', // Opus 5 (Issue #2096)\n76\t  'claude-opus-4-8': 'claude-opus-4-8', // Opus 4.8 (Issue #1832)\n77\t  'claude-opus-4-7': 'claude-opus-4-7', // Opus 4.7 (backward compatibility)\n78\t  'claude-sonnet-5': 'claude-sonnet-5', // Sonnet 5 (Issue #2003)\n79\t  'claude-sonnet-4-6': 'claude-sonnet-4-6', // Sonnet 4.6 (Issue #1329)\n80\t  'claude-opus-4-6': 'claude-opus-4-6', // Opus 4.6 (backward compatibility)\n81\t  'claude-opus-4-5': 'claude-opus-4-5-20251101', // Opus 4.5\n82\t  'claude-sonnet-4-5': 'claude-sonnet-4-5-20250929', // Sonnet 4.5 (backward compatibility)\n83\t  'claude-haiku-4-5': 'claude-haiku-4-5-20251001', // Haiku 4.5\n84\t};\n85\t\n86\t// Agent models (OpenCode API and Kilo Gateway via agent CLI)\n87\t// Issue #1300: Updated free models to match agent PR #191\n88\t// Issue #1543: Added qwen3.6-plus-free (former default) and nemotron-3-super-free per agent PR #234\n89\t// Issue #1563: qwen3.6-plus-free free promotion ended (April 2026), nemotron-3-super-free is now default per agent PR #243\n90\texport const agentModels = {\n91\t  ...formalAiProviderModelAliases,\n92\t  // OpenCode Zen free models (current)\n93\t  grok: 'opencode/grok-code',\n94\t  'grok-code': 'opencode/grok-code',\n95\t  'grok-code-fast-1': 'opencode/grok-code',\n96\t  'big-pickle': 'opencode/big-pickle',\n97\t  'gpt-5-nano': 'opencode/gpt-5-nano',\n98\t  'minimax-m2.5-free': 'opencode/minimax-m2.5-free', // Upgraded from M2.1 (Issue #1391)\n99\t  'nemotron-3-super-free': 'opencode/nemotron-3-super-free', // Default: NVIDIA hybrid Mamba-Transformer (Issue #1563)\n100\t  // Kilo Gateway free models (Issue #1282, updated in #1300)\n101\t  // Short names for Kilo-exclusive models (Issue #1300)\n102\t  'glm-5-free': 'kilo/glm-5-free', // Kilo-exclusive\n103\t  'glm-4.5-air-free': 'kilo/glm-4.5-air-free', // Kilo-exclusive: agent-centric model\n104\t  'deepseek-r1-free': 'kilo/deepseek-r1-free', // Kilo-exclusive: reasoning model\n105\t  'giga-potato-free': 'kilo/giga-potato-free', // Kilo-exclusive\n106\t  'trinity-large-preview': 'kilo/trinity-large-preview', // Kilo-exclusive\n107\t  // Full names with kilo/ prefix\n108\t  'kilo/glm-5-free': 'kilo/glm-5-free',\n109\t  'kilo/glm-4.5-air-free': 'kilo/glm-4.5-air-free',\n110\t  'kilo/minimax-m2.5-free': 'kilo/minimax-m2.5-free', // Also on OpenCode Zen\n111\t  'kilo/deepseek-r1-free': 'kilo/deepseek-r1-free',\n112\t  'kilo/giga-potato-free': 'kilo/giga-potato-free',\n113\t  'kilo/trinity-large-preview': 'kilo/trinity-large-preview',\n114\t  // Deprecated free models (kept for backward compatibility)\n115\t  'qwen3.6-plus-free': 'opencode/qwen3.6-plus-free', // Deprecated: free promotion ended April 2026 (Issue #1563)\n116\t  'kimi-k2.5-free': 'opencode/kimi-k2.5-free', // Deprecated: not supported (Issue #1391)\n117\t  'glm-4.7-free': 'opencode/glm-4.7-free', // Deprecated: no longer free\n118\t  'minimax-m2.1-free': 'opencode/minimax-m2.1-free', // Deprecated: replaced by m2.5\n119\t  'kilo/glm-4.7-free': 'kilo/glm-4.7-free', // Deprecated: replaced by glm-4.5-air-free\n120\t  'kilo/kimi-k2.5-free': 'kilo/kimi-k2.5-free', // Deprecated: not recommended\n121\t  'kilo/minimax-m2.1-free': 'kilo/minimax-m2.1-free', // Deprecated: replaced by m2.5\n122\t  // Premium models\n123\t  sonnet: 'anthropic/claude-3-5-sonnet',\n124\t  haiku: 'anthropic/claude-3-5-haiku',\n125\t  opus: 'anthropic/claude-3-opus',\n126\t  'gemini-3-pro': 'google/gemini-3-pro',\n127\t};\n128\t\n129\t// OpenCode models (OpenCode API)\n130\texport const opencodeModels = {\n131\t  ...formalAiProviderModelAliases,\n132\t  gpt4: 'openai/gpt-4',\n133\t  gpt4o: 'openai/gpt-4o',\n134\t  claude: 'anthropic/claude-3-5-sonnet',\n135\t  sonnet: 'anthropic/claude-3-5-sonnet',\n136\t  opus: 'anthropic/claude-3-opus',\n137\t  gemini: 'google/gemini-pro',\n138\t  grok: 'opencode/grok-code',\n139\t  'grok-code': 'opencode/grok-code',\n140\t  'grok-code-fast-1': 'opencode/grok-code',\n141\t};\n142\t\n143\t// Codex models (OpenAI API)\n144\texport const codexModels = {\n145\t  ...formalAiNativeModelAliases,\n146\t  // GPT-6 Sol is the current default, Luna is the smaller tier, and Reserve is\n147\t  // exposed by the Codex CLI catalogue (Issue #2290).\n148\t  'gpt-6.1-sol': 'gpt-6.1-sol',\n149\t  'gpt-6-sol': 'gpt-6-sol',\n150\t  'gpt-6-luna': 'gpt-6-luna',\n151\t  'gpt-reserve': 'gpt-reserve',\n152\t  // GPT-6 Astra — the first GPT-6 model, limited preview from 2026-09-03 (Issue #2202)\n153\t  'gpt-6-astra': 'gpt-6-astra',\n154\t  gpt5: 'gpt-5',\n155\t  'gpt-5': 'gpt-5',\n156\t  'gpt-5.5': 'gpt-5.5',\n157\t  'gpt-5.5-mini': 'gpt-5.5-mini',\n158\t  'gpt-5.5-nano': 'gpt-5.5-nano',\n159\t  'gpt-5.6-sol': 'gpt-5.6-sol',\n160\t  'gpt-5.6-terra': 'gpt-5.6-terra',\n161\t  'gpt-5.6-luna': 'gpt-5.6-luna',\n162\t  'gpt-5.6-cyber': 'gpt-5.6-cyber', // Daybreak-program security model (Issue #2202)\n163\t  'gpt-5.4': 'gpt-5.4',\n164\t  'gpt-5.4-mini': 'gpt-5.4-mini',\n165\t  'gpt-5.4-nano': 'gpt-5.4-nano',\n166\t  'gpt-5.2': 'gpt-5.2',\n167\t  'gpt-5.2-codex': 'gpt-5.2-codex',\n168\t  'gpt-5.3-codex': 'gpt-5.3-codex',\n169\t  'gpt-5.3-codex-spark': 'gpt-5.3-codex-spark',\n170\t  'gpt-5.1-codex-max': 'gpt-5.1-codex-max',\n171\t  // Daybreak aliases already advertised by the installed Codex CLI (Issue #2202)\n172\t  'gpt-daybreak-blue-latest': 'gpt-daybreak-blue-latest',\n173\t  'gpt-daybreak-red-latest': 'gpt-daybreak-red-latest',\n174\t  'openai.gpt-5.5': 'openai.gpt-5.5',\n175\t  'openai.gpt-5.4': 'openai.gpt-5.4',\n176\t  'openai.gpt-5.6-sol': 'openai.gpt-5.6-sol',\n177\t  'openai.gpt-5.6-terra': 'openai.gpt-5.6-terra',\n178\t  'openai.gpt-5.6-luna': 'openai.gpt-5.6-luna',\n179\t  'codex-auto-review': 'codex-auto-review',\n180\t  'o3-mini': 'o3-mini',\n181\t  gpt4: 'gpt-4',\n182\t  'gpt-4': 'gpt-4',\n183\t  gpt4o: 'gpt-4o',\n184\t  'gpt-4o': 'gpt-4o',\n185\t};\n186\t\n187\tconst CODEX_GENERATION_ALIAS_PATTERN = /^gpt-(\\d+(?:\\.\\d+)?)-(sol|terra|luna)$/;\n188\tconst OPENAI_MODEL_PREFIX_PATTERN = /^openai([/.])/;\n189\t\n190\t/**\n191\t * Resolve sol/terra/luna to the newest generation that contains the complete\n192\t * alias family. A complete family prevents a partially rolled-out catalog from\n193\t * moving only some aliases to a newer generation.\n194\t */\n195\texport const getLatestCodexGenerationAliases = (models = codexModels) => {\n196\t  const generations = new Map();\n197\t\n198\t  for (const modelId of Object.values(models)) {\n199\t    const bareModelId = modelId.replace(OPENAI_MODEL_PREFIX_PATTERN, '');\n200\t    const match = bareModelId.match(CODEX_GENERATION_ALIAS_PATTERN);\n201\t    if (!match) continue;\n202\t\n203\t    const [, generation, alias] = match;\n204\t    if (!generations.has(generation)) generations.set(generation, {});\n205\t    generations.get(generation)[alias] = bareModelId;\n206\t  }\n207\t\n208\t  const latestCompleteGeneration = [...generations.entries()].filter(([, aliases]) => ['sol', 'terra', 'luna'].every(alias => aliases[alias])).sort(([left], [right]) => right.localeCompare(left, undefined, { numeric: true }))[0];\n209\t\n210\t  return latestCompleteGeneration?.[1] || {};\n211\t};\n212\tconst getCodexModelVariants = () => {\n213\t  const bareModels = [...new Set(Object.values(codexModels).map(modelId => modelId.replace(OPENAI_MODEL_PREFIX_PATTERN, '')))];\n214\t  const aliases = getLatestCodexGenerationAliases();\n215\t  const variants = { ...codexModels, ...aliases };\n216\t\n217\t  for (const [name, modelId] of Object.entries({ ...Object.fromEntries(bareModels.map(modelId => [modelId, modelId])), ...aliases })) {\n218\t    variants[`openai/${name}`] = `openai/${modelId}`;\n219\t    variants[`openai.${name}`] = `openai.${modelId}`;\n220\t  }\n221\t\n222\t  return variants;\n223\t};\n224\t\n225\texport const CODEX_MODEL_VARIANTS = getCodexModelVariants();\n226\t\n227\t// Qwen Code models\n228\texport const qwenModels = {\n229\t  ...formalAiNativeModelAliases,\n230\t  qwen: 'qwen3-coder-plus',\n231\t  'qwen-coder': 'qwen3-coder-plus',\n232\t  qwen3: 'qwen3-coder-plus',\n233\t  'qwen3-coder': 'qwen3-coder',\n234\t  'qwen3-coder-plus': 'qwen3-coder-plus',\n235\t  'qwen3-coder-flash': 'qwen3-coder-flash',\n236\t  'qwen3.6-plus': 'qwen3.6-plus',\n237\t  'qwen3.6-coder-plus': 'qwen3.6-coder-plus',\n238\t};\n239\t\n240\t// Gemini models (Google Gemini CLI)\n241\t// Keep aliases aligned with the Gemini CLI model aliases documented in\n242\t// docs/cli/cli-reference.md: auto, pro, flash, and flash-lite.\n243\texport const geminiModels = {\n244\t  ...formalAiNativeModelAliases,\n245\t  auto: 'auto',\n246\t  gemini: 'gemini-2.5-flash',\n247\t  flash: 'gemini-2.5-flash',\n248\t  '2.5-flash': 'gemini-2.5-flash',\n249\t  pro: 'gemini-2.5-pro',\n250\t  '2.5-pro': 'gemini-2.5-pro',\n251\t  lite: 'gemini-2.5-flash-lite',\n252\t  '2.5-lite': 'gemini-2.5-flash-lite',\n253\t  'flash-lite': 'gemini-2.5-flash-lite',\n254\t  '3-flash': 'gemini-3-flash-preview',\n255\t  '3-pro': 'gemini-3-pro-preview',\n256\t  'gemini-flash': 'gemini-2.5-flash',\n257\t  'gemini-pro': 'gemini-2.5-pro',\n258\t  'gemini-2.5-flash': 'gemini-2.5-flash',\n259\t  'gemini-2.5-pro': 'gemini-2.5-pro',\n260\t  'gemini-2.5-flash-lite': 'gemini-2.5-flash-lite',\n261\t  'gemini-3-flash-preview': 'gemini-3-flash-preview',\n262\t  'gemini-3-pro-preview': 'gemini-3-pro-preview',\n263\t};\n264\t\n265\t// Default model for each tool (Issue #1473: centralized to avoid scattered hardcoded defaults)\n266\texport const defaultModels = {\n267\t  claude: 'opus', // Rolling Claude Code alias; direct execution intentionally does not pin it to this catalogue snapshot (Issue #2290)\n268\t  agent: 'nemotron-3-super-free', // Issue #1563: changed from qwen3.6-plus-free (free promotion ended) per agent PR #243\n269\t  opencode: 'grok-code-fast-1',\n270\t  codex: 'gpt-6-sol', // Issue #2290: GPT-6 Sol is the Codex default; runtime discovers newer Sol generations and falls back against the installed catalogue\n271\t  qwen: 'qwen3-coder-plus',\n272\t  gemini: 'flash',\n273\t};\n274\t\n275\t// Models that support 1M token context window via [1m] suffix (Issue #1221, Issue #1238, Issue #1329, Issue #1832)\n276\t// See: https://code.claude.com/docs/en/model-config\n277\texport const MODELS_SUPPORTING_1M_CONTEXT = [\n278\t  'claude-fable-5-1', // Fable 5.1 — 1M context by default (Issue #2202)\n279\t  'claude-mythos-5-1', // Mythos 5.1 — 1M context by default (Issue #2202)\n280\t  'fable-5-1', // Fable 5.1 short alias (Issue #2202)\n281\t  'mythos-5-1', // Mythos 5.1 short alias (Issue #2202)\n282\t  'claude-fable-5', // Fable 5 — 1M context by default (Issue #1875)\n283\t  'claude-mythos-5', // Mythos 5 — 1M context by default (Issue #1875)\n284\t  'fable', // Fable alias — now resolves to Fable 5.1 (Issue #2202)\n285\t  'fable-5', // Fable 5 short alias (Issue #1875)\n286\t  'mythos-5', // Mythos 5 short alias (Issue #1875)\n287\t  'claude-opus-4-8', // Opus 4.8 (Issue #1832)\n288\t  'claude-opus-4-7', // Opus 4.7 (Issue #1620)\n289\t  'claude-opus-4-6',\n290\t  'claude-opus-4-5-20251101',\n291\t  'claude-sonnet-5', // Sonnet 5 — 1M context (Issue #2003)\n292\t  'claude-sonnet-4-6', // Sonnet 4.6 (Issue #1329)\n293\t  'claude-sonnet-4-5-20250929',\n294\t  'claude-sonnet-4-5',\n295\t  'claude-opus-5', // Opus 5 — 1M context (Issue #2096)\n296\t  'claude-opus-5-5', // Opus 5.5 — 1M context (Issue #2290)\n297\t  'sonnet', // Now maps to Sonnet 5 (Issue #2003)\n298\t  'sonnet-5', // Short alias (Issue #2003)\n299\t  'sonnet-4-6', // Short alias (Issue #1329)\n300\t  'opus', // Now maps to Opus 5 (Issue #2096)\n301\t  'opus-5', // Short alias (Issue #2096)\n302\t  'opus-5-5', // Pinned Opus 5.5 alias (Issue #2290)\n303\t  'opus-4-8', // Short alias (Issue #1832)\n304\t  'opus-4-7', // Short alias (Issue #1620)\n305\t  'opus-4-6', // Short alias (Issue #1221 - PR comment feedback)\n306\t  'opus-4-5', // Short alias (Issue #1238)\n307\t  'sonnet-4-5', // Short alias (Issue #1221 - PR comment feedback)\n308\t];\n309\t\n310\t// Free model to base model mapping for pricing lookup (Issue #1250, Issue #1473)\n311\t// Free models like \"kimi-k2.5-free\" should use pricing from base model \"kimi-k2.5\"\n312\texport const freeToBaseModelMap = {\n313\t  'kimi-k2.5-free': 'kimi-k2.5',\n314\t  'glm-4.7-free': 'glm-4.7',\n315\t  'minimax-m2.1-free': 'minimax-m2.1',\n316\t  'minimax-m2.5-free': 'minimax-m2.5',\n317\t  'qwen3.6-plus-free': 'qwen3.6-plus', // Issue #1543\n318\t  'nemotron-3-super-free': 'nemotron-3-super', // Issue #1543\n319\t  'glm-5-free': 'glm-5',\n320\t  'glm-4.5-air-free': 'glm-4.5-air',\n321\t  'deepseek-r1-free': 'deepseek-r1',\n322\t  'giga-potato-free': 'giga-potato',\n323\t  'trinity-large-preview-free': 'trinity-large-preview',\n324\t};\n325\t\n326\t// ─── VALIDATION-EXTENDED MODEL MAPS ──────────────────────────────────────────\n327\t// These extend the base maps with full model ID identity entries for validation\n328\t// (e.g., 'claude-sonnet-4-5-20250929' → 'claude-sonnet-4-5-20250929')\n329\t// so that full model IDs are also accepted as valid inputs\n330\texport const CLAUDE_MODELS = {\n331\t  ...claudeModels,\n332\t  'claude-fable-5-1': 'claude-fable-5-1', // Fable 5.1 full ID (Issue #2202)\n333\t  'claude-mythos-5-1': 'claude-mythos-5-1', // Mythos 5.1 full ID (Issue #2202)\n334\t  'claude-fable-5': 'claude-fable-5', // Fable 5 full ID (Issue #1875)\n335\t  'claude-mythos-5': 'claude-mythos-5', // Mythos 5 full ID (Issue #1875)\n336\t  'claude-opus-5-5': 'claude-opus-5-5', // Opus 5.5 full ID (Issue #2290)\n337\t  'claude-opus-5': 'claude-opus-5', // Opus 5 full ID (Issue #2096)\n338\t  'claude-opus-4-8': 'claude-opus-4-8', // Opus 4.8 full ID (Issue #1832)\n339\t  'claude-opus-4-7': 'claude-opus-4-7', // Opus 4.7 full ID (Issue #1620)\n340\t  'claude-sonnet-4-5-20250929': 'claude-sonnet-4-5-20250929',\n341\t  'claude-opus-4-5-20251101': 'claude-opus-4-5-20251101',\n342\t  'claude-haiku-4-5-20251001': 'claude-haiku-4-5-20251001',\n343\t  'claude-3-5-haiku-20241022': 'claude-3-5-haiku-20241022',\n344\t  'claude-3-haiku-20240307': 'claude-3-haiku-20240307',\n345\t};\n346\t\n347\texport const OPENCODE_MODELS = {\n348\t  ...opencodeModels,\n349\t  'openai/gpt-4': 'openai/gpt-4',\n350\t  'openai/gpt-4o': 'openai/gpt-4o',\n351\t  'anthropic/claude-3-5-sonnet': 'anthropic/claude-3-5-sonnet',\n352\t  'anthropic/claude-3-opus': 'anthropic/claude-3-opus',\n353\t  'google/gemini-pro': 'google/gemini-pro',\n354\t  'opencode/grok-code': 'opencode/grok-code',\n355\t};\n356\t\n357\texport const CODEX_MODELS = {\n358\t  ...CODEX_MODEL_VARIANTS,\n359\t  'gpt-6-sol': 'gpt-6-sol', // Issue #2290\n360\t  'gpt-6-luna': 'gpt-6-luna', // Issue #2290\n361\t  'gpt-reserve': 'gpt-reserve', // Issue #2290\n362\t  'gpt-6-astra': 'gpt-6-astra', // Issue #2202\n363\t  'gpt-5': 'gpt-5',\n364\t  'gpt-5.5': 'gpt-5.5',\n365\t  'gpt-5.5-mini': 'gpt-5.5-mini',\n366\t  'gpt-5.5-nano': 'gpt-5.5-nano',\n367\t  'gpt-5.6-sol': 'gpt-5.6-sol',\n368\t  'gpt-5.6-terra': 'gpt-5.6-terra',\n369\t  'gpt-5.6-luna': 'gpt-5.6-luna',\n370\t  'gpt-5.6-cyber': 'gpt-5.6-cyber', // Issue #2202\n371\t  'gpt-5.4': 'gpt-