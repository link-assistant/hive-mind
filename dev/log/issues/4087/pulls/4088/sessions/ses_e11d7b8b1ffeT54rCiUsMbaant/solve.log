00516|                 const ciLine = noCiConfigured ? '- No CI/CD checks are configured for this repository' : noCiTriggered ? (workflowRunConclusions ? `- CI workflows completed without executing (${workflowRunConclusions})` : '- CI workflows exist but were not triggered for this commit') : '- All CI checks have passed';\n00517|                 // Issue #2144: a closed/unavailable linked issue does not stop this\n00518|                 // mode, but it is worth stating in the comment so the reader knows\n00519|                 // why no automatic merge will follow.\n00520|                 const issueLine =\n00521|                   issueMergeBlockers.length > 0\n00522|                     ? `\\n\\nNote: ${issueMergeBlockers.map(b => b.message).join(' ')} ${issueMergeBlockers\n00523|                         .map(b => b.resolution)\n00524|                         .filter(Boolean)\n00525|                         .join(' ')}`\n00526|                     : '';\n00527|                 // Issue #2492: \"uncommitted\" is what was checked (\"pending\" read broader), and the\n00528|                 // mode footer is gone - the comment is short and states checked facts only.\n00529|                 const commentBody = `## ✅ ${READY_TO_MERGE_MARKER}\\n\\nThis pull request is now ready to be merged:\\n${ciLine}\\n- No merge conflicts\\n- No uncommitted changes${issueLine}`;\n00530|                 // Issue #1625: Track this comment ID so it can't falsely count as an AI-authored comment\n00531|                 await postTrackedComment({ $, owner, repo, targetNumber: prNumber, body: commentBody });\n00532|                 readyToMergeCommentPosted = true;\n00533|               }\n00534|             } else {\n00535|               await log(formatAligned('', `Skipping duplicate \"${READY_TO_MERGE_MARKER}\" comment (already posted this session)`, '', 2));\n00536|             }\n00537|           } catch {\n00538|             // Don't fail if comment posting fails\n00539|           }\n00540|           return { success: true, reason: 'mergeable', latestSessionId, latestAnthropicCost };\n00541|         }\n00542|       }\n00543|       // Determine if we need to restart\n00544|       let shouldRestart = false;\n00545|       let restartReason = '';\n00546|       let feedbackLines = [];\n00547|       // Reason 1: New comments from non-bot users\n00548|       if (hasNewComments) {\n00549|         shouldRestart = true;\n00550|         restartReason = `New comment(s) from non-bot user(s): ${comments.map(c => c.user?.login).join(', ')}`;\n00551|         feedbackLines.push(promptText('prompt.templates.solve-auto-merge.watchUntilMergeable.text1'));\n00552|         for (const comment of comments) {\n00553|           feedbackLines.push(`  - ${comment.user?.login}: \"${comment.body?.substring(0, 100)}${comment.body?.length > 100 ? '...' : ''}\"`);\n00554|         }\n00555|         feedbackLines.push('');\n00556|         feedbackLines.push(promptText('prompt.templates.solve-auto-merge.watchUntilMergeable.text2'));\n00557|       }\n00558| \n00559|       // Issue #2119: Reason 1a: the pull request does not change anything yet.\n00560|       if (isEmptyPullRequest) {\n00561|         shouldRestart = true;\n00562|         restartReason = restartReason ? `${restartReason}; ${emptyPullRequestBlocker}` : emptyPullRequestBlocker;\n00563|         feedbackLines.push(promptText('prompt.templates.solve-auto-merge.watchUntilMergeable.text3', { emptyPullRequestBlocker: String(emptyPullRequestBlocker) }));\n00564|         feedbackLines.push('');\n00565|         feedbackLines.push(promptText('prompt.templates.solve-auto-merge.watchUntilMergeable.text4'));\n00566|       }\n00567|       // Issue #2312: Reason 1c: the last working session left the draft on purpose\n00568|       // (the empty diff is already reported above).\n00569|       if (deliberateDraft && !(deliberateDraft.kind === 'no_changes' && isEmptyPullRequest)) {\n00570|         const draftFeedback = buildDeliberateDraftFeedback(deliberateDraft);\n00571|         shouldRestart = true;\n00572|         restartReason = restartReason ? `${restartReason}; ${draftFeedback.restartReason}` : draftFeedback.restartReason;\n00573|         feedbackLines.push(...draftFeedback.feedbackLines);\n00574|       }\n00575|       // Issue #2007: Reason 1b: Issue title/description edited by the user.\n00576|       if (hasIssueMetadataChanges) {\n00577|         shouldRestart = true;\n00578|         const changedFields = issueMetadataChanges.map(c => (c.field === 'title' ? 'title' : 'description')).join(' and ');\n00579|         restartReason = restartReason ? `${restartReason}; Issue ${changedFields} edited` : `Issue ${changedFields} edited`;\n00580|         feedbackLines.push(promptText('prompt.templates.solve-auto-merge.watchUntilMergeable.text5', { changedFields: String(changedFields) }));\n00581|         for (const change of issueMetadataChanges) {\n00582|           const label = change.field === 'title' ? 'Issue title' : 'Issue description';\n00583|           const updated = String(change.to ?? '');\n00584|           feedbackLines.push(promptText('prompt.templates.solve-auto-merge.watchUntilMergeable.text6', { label: String(label), value2: String(updated.substring(0, 200)), value3: String(updated.length > 200 ? '...' : '') }));\n00585|         }\n00586|         feedbackLines.push('');\n00587|         feedbackLines.push(promptText('prompt.templates.solve-auto-merge.watchUntilMergeable.text7'));\n00588|       }\n00589|       // Issue #1314: a billing limit is checked before regular CI failures,\n00590|       // because it needs a human, not an AI restart.\n00591|       const billingBlocker = blockers.find(b => b.type === 'billing_limit');\n00592|       if (billingBlocker) {\n00593|         const billing = await handleBillingLimitBlocker({ blocker: billingBlocker, owner, repo, prNumber, $, log, formatAligned, postComment: postTrackedComment, reportError, backoffSeconds: currentBackoffSeconds, verbose: argv.verbose });\n00594|         currentBackoffSeconds = billing.backoffSeconds;\n00595|         if (billing.stopped) return { success: false, reason: 'billing_limit', latestSessionId, latestAnthropicCost };\n00596|       }\n00597|       // Issue #1314: Handle cancelled CI/CD checks - re-trigger them instead of restarting AI\n00598|       // Cancelled checks (e.g., manually cancelled, cancelled by another workflow) should be\n00599|       // re-triggered automatically. We should NOT restart the AI for these.\n00600|       const cancelledBlocker = blockers.find(b => b.type === 'ci_cancelled');\n00601|       // Issue #1952: When a genuine CI failure coexists with cancelled checks, the result is a\n00602|       // failure (\"if we still have other fails in the CI/CD checks - it is fail\"). Defer to the\n00603|       // ci_failure path (which restarts the AI) instead of attempting a re-trigger and then\n00604|       // stopping for human review — the latter posted a misleading \"Cancelled CI/CD Requires\n00605|       // Review\" comment even though real failures needed fixing.\n00606|       const ciFailureBlocker = blockers.find(b => b.type === 'ci_failure');\n00607|       if (cancelledBlocker && !billingBlocker && !ciFailureBlocker) {\n00608|         await log('');\n00609|         await log(formatAligned('🔄', 'CANCELLED CI/CD CHECKS DETECTED', ''));\n00610|         await log(formatAligned('', 'Cancelled checks:', (cancelledBlocker.details || []).join(', '), 2));\n00611| \n00612|         // Attempt to re-trigger the cancelled/stale workflow runs\n00613|         const sha = cancelledBlocker.sha;\n00614|         let runs = [];\n00615|         let retriggerable = [];\n00616|         let rerunTriggered = false;\n00617|         let rerunAttempted = false;\n00618|         const rerunFailures = [];\n00619|         if (sha) {\n00620|           runs = await getWorkflowRunsForSha(owner, repo, sha, argv.verbose);\n00621|           retriggerable = getRetriggerableWorkflowRuns(runs);\n00622|           if (retriggerable.length === 0) {\n00623|             await log(formatAligned('', '⚠️  No cancelled/stale workflow run found for this SHA', '', 2));\n00624|             rerunFailures.push({\n00625|               error: 'No cancelled/stale workflow run was found for this commit SHA.',\n00626|             });\n00627|           }\n00628|           for (const run of retriggerable) {\n00629|             await log(formatAligned('', `Re-triggering workflow \"${run.name}\" (${run.id})...`, '', 2));\n00630|             rerunAttempted = true;\n00631|             const rerunResult = await rerunWorkflowRun(owner, repo, run.id, argv.verbose);\n00632|             if (rerunResult.success) {\n00633|               await log(formatAligned('', `✅ Re-triggered: ${run.name}`, '', 2));\n00634|               rerunTriggered = true;\n00635|             } else {\n00636|               await log(formatAligned('', `⚠️  Could not re-trigger ${run.name}: ${rerunResult.error}`, '', 2));\n00637|               rerunFailures.push({ run, error: rerunResult.error });\n00638|             }\n00639|           }\n00640|           if (rerunTriggered) {\n00641|             await log(formatAligned('⏳', 'Waiting for re-triggered CI to complete...', '', 2));\n00642|             // Don't restart AI - just wait for re-triggered jobs to complete\n00643|             // The next iteration of the loop will check the new status\n00644|           }\n00645|         } else {\n00646|           await log(formatAligned('', '⚠️  Cancelled CI blocker did not include a commit SHA', '', 2));\n00647|           rerunFailures.push({\n00648|             error: 'Cancelled CI blocker did not include a commit SHA, so automatic workflow re-run could not identify the run.',\n00649|           });\n00650|         }\n\n(Output capped at 50 KB. Showing lines 1-650. Use offset=650 to continue.)\n</file>",
