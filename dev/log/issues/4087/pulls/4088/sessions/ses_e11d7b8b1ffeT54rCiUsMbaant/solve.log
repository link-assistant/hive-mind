;\n00622|           if (retriggerable.length === 0) {\n00623|             await log(formatAligned('', '⚠️  No cancelled/stale workflow run found for this SHA', '', 2));\n00624|             rerunFailures.push({\n00625|               error: 'No cancelled/stale workflow run was found for this commit SHA.',\n00626|             });\n00627|           }\n00628|           for (const run of retriggerable) {\n00629|             await log(formatAligned('', `Re-triggering workflow \"${run.name}\" (${run.id})...`, '', 2));\n00630|             rerunAttempted = true;\n00631|             const rerunResult = await rerunWorkflowRun(owner, repo, run.id, argv.verbose);\n00632|             if (rerunResult.success) {\n00633|               await log(formatAligned('', `✅ Re-triggered: ${run.name}`, '', 2));\n00634|               rerunTriggered = true;\n00635|             } else {\n00636|               await log(formatAligned('', `⚠️  Could not re-trigger ${run.name}: ${rerunResult.error}`, '', 2));\n00637|               rerunFailures.push({ run, error: rerunResult.error });\n00638|             }\n00639|           }\n00640|           if (rerunTriggered) {\n00641|             await log(formatAligned('⏳', 'Waiting for re-triggered CI to complete...', '', 2));\n00642|             // Don't restart AI - just wait for re-triggered jobs to complete\n00643|             // The next iteration of the loop will check the new status\n00644|           }\n00645|         } else {\n00646|           await log(formatAligned('', '⚠️  Cancelled CI blocker did not include a commit SHA', '', 2));\n00647|           rerunFailures.push({\n00648|             error: 'Cancelled CI blocker did not include a commit SHA, so automatic workflow re-run could not identify the run.',\n00649|           });\n00650|         }\n\n(Output capped at 50 KB. Showing lines 1-650. Use offset=650 to continue.)\n</file>",
