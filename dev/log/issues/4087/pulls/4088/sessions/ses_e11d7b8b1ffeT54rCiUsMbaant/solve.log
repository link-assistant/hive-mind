048: reset the streak, log why a failing check was ignored\n00423|           const acLabel = consensus.mechanisms.allCommitsCI.skipped ? '' : `, AllCommits=complete(${consensus.mechanisms.allCommitsCI.totalCommits})`;\n00424|           await log(formatAligned('✅', 'All CI mechanisms agree:', `CheckRuns=${consensus.mechanisms.checkRunsAPI.status}, WorkflowRuns=complete(${consensus.mechanisms.workflowRunsAPI.total})${acLabel}, RepoActions=${consensus.mechanisms.repoActions.skipped ? 'skipped' : 'clear'}`, 2));\n00425|         } else if (waitForAllRepoActionsFlag) {\n00426|           // Even with no CI configured, check repo-wide actions for absolute safety\n00427|           const repoRuns = await getAllActiveRepoRuns(owner, repo, argv.verbose);\n00428|           if (repoRuns.hasActiveRuns) {\n00429|             await log(formatAligned('⏳', 'Waiting for repo-wide actions:', `${repoRuns.count} active run(s) in repository`, 2));\n00430|             lastCheckTime = currentTime;\n00431|             const actualWaitSeconds = currentBackoffSeconds;\n00432|             await log(formatAligned('⏱️', 'Next check in:', `${actualWaitSeconds} seconds...`, 2));\n00433|             await log('');\n00434|             await interruptibleSleep(actualWaitSeconds * 1000);\n00435|             continue;\n00436|           }\n00437|         }\n00438|         await log(formatAligned('✅', 'PR IS MERGEABLE!', ''));\n00439|         // Issue #2144: a closed/unavailable linked issue blocks only the\n00440|         // *automatic* merge; the user is asked to reopen it or merge manually.\n00441|         // Issues #2306/#2395: the description can change, so its issue link and\n00442|         // every required closing reference are re-checked right before merging.\n00443|         const mergeBlockers = isAutoMerge ? [...issueMergeBlockers, await ensureIssueLinkBeforeMerge({ owner, repo, issueNumber, prNumber, argv, log }), await checkClosingReferencesBeforeMerge({ owner, repo, issueNumber, prNumber, arg