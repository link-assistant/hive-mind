[2026-07-19T12:50:37.558Z] [INFO]         "content": "1\t/**\n2\t * ESLint rule to prevent event loop leaks from uncleaned timer handles.\n3\t *\n4\t * Motivation (Issue #1346): A floating `setTimeout(reject, 60000)` inside a\n5\t * `Promise.race` loser branch kept the Node.js event loop alive for 60 extra\n6\t * seconds per poll iteration, causing `solve` to hang after the PR was merged.\n7\t *\n8\t * ## What this rule flags\n9\t *\n10\t * 1. **Bare statement-level calls** — `setTimeout(fn, ms);` as a standalone\n11\t *    ExpressionStatement.  The return value is discarded entirely so the timer\n12\t *    can never be cleared.\n13\t *\n14\t * 2. **Reject-timers inside `Promise.race` timeout arms** — the most\n15\t *    dangerous pattern.  When `Promise.race` resolves on the *other* branch,\n16\t *    the rejection timer is still pending and keeps the event loop alive.\n17\t *    If the race is inside a loop (as in waitForCI) a new uncleaned timer\n18\t *    is spawned every iteration.\n19\t *\n20\t *    Pattern:\n21\t *      new Promise((_, reject) => { setTimeout(reject, ms) })\n22\t *      new Promise((_, reject) => { setTimeout(() => reject(new Error()), ms) })\n23\t *\n24\t * ## What this rule ALLOWS (not flagged)\n25\t *\n26\t *   const id = setTimeout(fn, ms);                     // captured → OK\n27\t *   let id; id = setTimeout(fn, ms);                   // captured → OK\n28\t *   clearTimeout(setTimeout(fn, ms));                  // immediately cleared → OK\n29\t *   new Promise(resolve => setTimeout(resolve, ms))    // resolve-only arm → OK\n30\t *      ↑ timer fires once, resolves the Promise, then is GC'd naturally\n31\t */\n32\t\n33\tconst TIMER_FUNCTIONS = new Set(['setTimeout', 'setInterval']);\n34\t\n35\t/**\n36\t * Returns true if the CallExpression's return value is captured.\n37\t */\n38\tfunction isAssigned(callNode) {\n39\t  const parent = callNode.parent;\n40\t  if (!parent) return false;\n41\t  // const id = setTimeout(...)  →  VariableDeclarator\n42\t  if (parent.type === 'VariableDeclarator' && parent.init === callNode) return true;\n43\t  // id = setTimeout(...)  →  AssignmentExpression\n44\t  if (parent.type === 'AssignmentExpression' && parent.right === callNode) return true;\n45\t  // clearTimeout(setTimeout(...))  →  argument to clear function\n46\t  if (parent.type === 'CallExpression') {\n47\t    const callee = parent.callee;\n48\t    if (callee.type === 'Identifier' && (callee.name === 'clearTimeout' || callee.name === 'clearInterval')) {\n49\t      return true;\n50\t    }\n51\t  }\n52\t  return false;\n53\t}\n54\t\n55\t/**\n56\t * Returns true if the CallExpression is a direct ExpressionStatement —\n57\t * i.e. the result is completely discarded at statement level.\n58\t */\n59\tfunction isExpressionStatement(callNode) {\n60\t  return callNode.parent && callNode.parent.type === 'ExpressionStatement';\n61\t}\n62\t\n63\t/**\n64\t * Returns true if this setTimeout/setInterval call is inside a\n65\t * `new Promise(executor)` constructor AND the callback passed to the timer\n66\t * invokes the `reject` parameter of the executor (not just `resolve`).\n67\t *\n68\t * These are the dangerous cases: when the other branch of Promise.race wins,\n69\t * the reject timer is still pending and keeps the event loop alive.\n70\t *\n71\t * Flagged patterns:\n72\t *   new Promise((resolve, reject) => { setTimeout(reject, ms) })\n73\t *   new Promise((_, reject) => { setTimeout(() => reject(new Error()), ms) })\n74\t *\n75\t * Not flagged (resolve-only):\n76\t *   new Promise(resolve => { setTimeout(resolve, ms) })\n77\t *   new Promise((resolve) => { setTimeout(resolve, ms) })\n78\t */\n79\tfunction isRejectTimerInPromise(callNode) {\n80\t  // Walk up to find the enclosing new Promise(executor) node\n81\t  let node = callNode.parent;\n82\t  let executorNode = null;\n83\t\n84\t  while (node) {\n85\t    if (node.type === 'NewExpression' && node.callee && node.callee.type === 'Identifier' && node.callee.name === 'Promise' && node.arguments.length >= 1) {\n86\t      executorNode = node.arguments[0];\n87\t      break;\n88\t    }\n89\t    node = node.parent;\n90\t  }\n91\t\n92\t  if (!executorNode) return false;\n93\t\n94\t  // Get the executor parameters: (resolve, reject) or (_, reject) etc.\n95\t  const params = executorNode.params || [];\n96\t  if (params.length < 2) return false; // only a resolve param — no reject\n97\t\n98\t  const rejectParam = params[1];\n99\t  if (!rejectParam || rejectParam.type !== 'Identifier') return false;\n100\t  const rejectName = rejectParam.name;\n101\t\n102\t  // Check if the first argument to setTimeout invokes reject:\n103\t  const timerCallback = callNode.arguments[0];\n104\t  if (!timerCallback) return false;\n105\t\n106\t  // Case 1: setTimeout(reject, ms) — direct reference to reject param\n107\t  if (timerCallback.type === 'Identifier' && timerCallback.name === rejectName) {\n108\t    return true;\n109\t  }\n110\t\n111\t  // Case 2: setTimeout(() => reject(...), ms) or setTimeout(() => { reject(...); }, ms)\n112\t  if (timerCallback.type === 'ArrowFunctionExpression' || timerCallback.type === 'FunctionExpression') {\n113\t    return bodyCallsIdentifier(timerCallback.body, rejectName);\n114\t  }\n115\t\n116\t  return false;\n117\t}\n118\t\n119\t/**\n120\t * Recursively checks whether a function body AST node contains a call to\n121\t * the identifier with the given `name`.\n122\t */\n123\tfunction bodyCallsIdentifier(node, name) {\n124\t  if (!node) return false;\n125\t  if (node.type === 'CallExpression') {\n126\t    if (node.callee.type === 'Identifier' && node.callee.name === name) return true;\n127\t  }\n128\t  for (const key of Object.keys(node)) {\n129\t    if (key === 'parent') continue;\n130\t    const child = node[key];\n131\t    if (child && typeof child === 'object') {\n132\t      if (Array.isArray(child)) {\n133\t        for (const item of child) {\n134\t          if (item && typeof item.type === 'string' && bodyCallsIdent