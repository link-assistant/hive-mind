[2026-11-26T20:39:29.028Z] [INFO]       "output": "<file>\n00001| /** Admit and install the native executable from this package's build outputs.\n00002|  *\n00003|  * The executables ship in per-platform variant versions of this same package\n00004|  * (`<version>-native-codex-<platform>`), installed as the optional dependency\n00005|  * alias `<name>-native-codex-<platform>`: both platforms in one tarball exceeded\n00006|  * npm's publish size limit (E413, issue #4050). This package's recipe stays the\n00007|  * trust anchor, and the variant must be the exact immutable version published\n00008|  * with this package. See src/native-codex/PACKAGES.md.\n00009|  */\n00010| import fs from 'node:fs/promises';\n00011| import { constants } from 'node:fs';\n00012| import { createRequire } from 'node:module';\n00013| import path from 'node:path';\n00014| import { createHash } from 'node:crypto';\n00015| import { fileURLToPath } from 'node:url';\n00016| import { isDeepStrictEqual } from 'node:util';\n00017| \n00018| const bundled = fileURLToPath(new URL('./native-codex/', import.meta.url));\n00019| const packageRoot = fileURLToPath(new URL('../', import.meta.url));\n00020| const refusal = () => new Error('The pinned native Codex runtime could not be verified; installation and execution were refused.');\n00021| const hash = bytes => createHash('sha256').update(bytes).digest('hex');\n00022| const identity = info => `${info.dev}:${info.ino}`;\n00023| const revision = info => `${identity(info)}:${info.size}:${info.mtimeNs}:${info.ctimeNs}`;\n00024| // Off by default: refusals never name paths. HIVE_MIND_NATIVE_CODEX_DEBUG=1 adds\n00025| // the phase and the error code, e.g. MODULE_NOT_FOUND for a missing variant.\n00026| const debug = (phase, error) => {\n00027|   if (process.env.HIVE_MIND_NATIVE_CODEX_DEBUG === '1') console.error(`[native-codex] Refused during ${phase}${error?.code ? ` (${error.code})` : ''}.`);\n00028| };\n00029| const safeName = name => typeof name === 'string' && name.length > 0 && !name.includes('\\\\') && !name.includes('\\0') && !path.posix.isAbsolute(name) && name.split('/').every(part => part && part !== '.' && part !== '..');\n00030| \n00031| async function read(file, { max = 4194304, size, digest, metadata = true, executable = false } = {}) {\n00032|   const descriptor = await fs.open(file, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);\n00033|   try {\n00034|     const before = await descriptor.stat({ bigint: true });\n00035|     if (!before.isFile() || before.nlink !== 1n || before.size <= 0n || before.size > BigInt(max) || (size !== undefined && before.size !== BigInt(size)) || (executable && !(before.mode & 0o111n))) throw refusal();\n00036|     const checksum = createHash('sha256');\n00037|     const buffer = Buffer.alloc(65536);\n00038|     const chunks = [];\n00039|     let header;\n00040|     let total = 0;\n00041|     while (true) {\n00042|       const { bytesRead } = await descriptor.read(buffer, 0, buffer.length, null);\n00043|       if (!bytesRead) break;\n00044|       total += bytesRead;\n00045|       if (total > max || BigInt(total) > before.size) throw refusal();\n00046|       if (!header) header = Buffer.from(buffer.subarray(0, Math.min(64, bytesRead)));\n00047|       checksum.update(buffer.subarray(0, bytesRead));\n00048|       if (metadata) chunks.push(Buffer.from(buffer.subarray(0, bytesRead)));\n00049|     }\n00050|     const observed = checksum.digest('hex');\n00051|     if (BigInt(total) !== before.size || (digest && digest !== observed) || revision(before) !== revision(await descriptor.stat({ bigint: true })) || revision(before) !== revision(await fs.lstat(file, { bigint: true }))) throw refusal();\n00052|     return { bytes: metadata ? Buffer.concat(chunks) : undefined, digest: observed, header, size: total };\n00053|   } finally {\n00054|     await descriptor.close();\n00055|   }\n00056| }\n00057| \n00058| async function directory(root) {\n00059|   if (typeof root !== 'string' || !path.isAbsolute(root) || path.normalize(root) !== root || (await fs.realpath(root)) !== root) throw refusal();\n00060|   const info = await fs.lstat(root, { bigint: true });\n00061|   if (!info.isDirectory() || info.isSymbolicLink()) throw refusal();\n00062|   return identity(info);\n00063| }\n00064| \n00065| function sourceDigest(files) {\n00066|   const sorted = Object.fromEntries(\n00067|     Object.keys(files)\n00068|       .sort()\n00069|       .map(name => [name, { bytes: files[name].bytes, sha256: files[name].sha256 }])\n00070|   );\n00071|   return hash(Buffer.from(JSON.stringify(sorted)));\n00072| }\n00073| \n00074| async function recipe(platform) {\n00075|   const selected = `linux-${process.arch}`;\n00076|   if (process.platform !== 'linux' || !['linux-x64', 'linux-arm64'].includes(selected) || platform !== selected) throw refusal();\n00077|   const input = await read(path.join(bundled, 'recipe.json'));\n00078|   const data = JSON.parse(input.bytes);\n00079|   if (data.schema !== 1 || data.version !== '0.164.0' || data.profile !== 'release' || !data.targets[platform] || !Number.isSafeInteger(data.maxBinaryBytes) || data.maxBinaryBytes <= 0 || data.maxBinaryBytes > 402653184) throw refusal();\n00080|   const files = new Set(['codex', 'manifest.json', 'source.json', 'recipe.json']);\n00081|   for (const name of Object.keys(data.licenses)) {\n00082|     if (!safeName(name) || !/^[a-f0-9]{64}$/u.test(data.licenses[name])) throw refusal();\n00083|     files.add(`licenses/${name}`);\n00084|   }\n00085|   return { data, digest: input.digest, files, platform };\n00086| }\n00087| \n00088| async function entries(root, files) {\n00089|   const directories = new Set();\n00090|   for (const name of files) {\n00091|     let parent = path.posix.dirname(name);\n00092|     while (parent !== '.') {\n00093|       directories.add(parent);\n00094|       parent = path.posix.dirname(parent);\n00095|     }\n00096|   }\n00097|   const seen = new Set();\n00098|   async function visit(relative = '') {\n00099|     const children = await fs.readdir(path.join(root, relative), { withFileTypes: true });\n00100|     if (children.length > files.size + directories.size) throw refusal();\n00101|     for (const child of children) {\n00102|       const name = relative ? `${relative}/${child.name}` : child.name;\n00103|       if (child.isDirectory() && directories.has(name)) await visit(name);\n00104|       else if (child.isFile() && files.has(name)) seen.add(name);\n00105|       else throw refusal();\n00106|     }\n00107|   }\n00108|   await visit();\n00109|   if (!isDeepStrictEqual(seen, files)) throw refusal();\n00110| }\n00111| \n00112| async function verify(root, prepared, expectedManifest) {\n00113|   const rootIdentity = await directory(root);\n00114|   await entries(root, prepared.files);\n00115|   const manifestInput = await read(path.join(root, 'manifest.json'), { digest: expectedManifest });\n00116|   const manifest = JSON.parse(manifestInput.bytes);\n00117|   const { data, platform } = prepared;\n00118|   const source = JSON.parse((await read(path.join(root, 'source.json'), { digest: manifest.sourceSha256 })).bytes);\n00119|   const target = data.targets[platform];\n00120|   if (manifest.schema !== 1 || manifest.version !== data.version || manifest.platform !== platform || manifest.target !== target.target || manifest.upstreamCommit !== data.upstreamCommit || manifest.recipeSha256 !== prepared.digest || !isDeepStrictEqual(manifest.cargoEnvironment, data.cargoEnvironment) || !isDeepStrictEqual(manifest.licenses, data.licenses)) throw refusal();\n00121|   if (source.schema !== 1 || source.recipeSha256 !== prepared.digest || source.upstreamCommit !== data.upstreamCommit || !isDeepStrictEqual(source.cargoEnvironment, data.cargoEnvironment) || sourceDigest(source.sourceFiles) !== data.sourceInventorySha256 || source.compiler !== manifest.compiler || !source.compiler.startsWith(`rustc ${data.rustToolchain} `) || !source.compiler.split('\\n').includes(`host: ${target.target}`)) throw refusal();\n00122|   await read(path.join(root, 'recipe.json'), { digest: prepared.digest });\n00123|   const binary = manifest.binary;\n00124|   if (!binary || !Number.isSafeInteger(binary.bytes) || binary.bytes <= 0 || !/^[a-f0-9]{64}$/u.test(binary.sha256)) throw refusal();\n00125|   const inspected = await read(path.join(root, 'codex'), { max: data.maxBinaryBytes, size: binary.bytes, digest: binary.sha256, metadata: false, executable: true });\n00126|   const header = inspected.header;\n00127|   if (header?.length !== 64 || !header.subarray(0, 7).equals(Buffer.from([127, 69, 76, 70, 2, 1, 1])) || ![2, 3].includes(header.readUInt16LE(16)) || header.readUInt16LE(18) !== target.elfMachine) throw refusal();\n00128|   for (const [name, digest] of Object.entries(data.licenses)) await read(path.join(root, 'licenses', name), { digest });\n00129|   if ((await directory(root)) !== rootIdentity) throw refusal();\n00130|   return { root, entrypoint: path.join(root, 'codex'), version: data.version, platform, manifestSha256: manifestInput.digest };\n00131| }\n00132| \n00133| /** The variant package directory for `platform`, installed beside this package. */\n00134| export function nativeCodexPackageName(name, platform) {\n00135|   return `${name}-native-codex-${platform}`;\n00136| }\n00137| \n00138| export function nativeCodexPackageVersion(version, platform) {\n00139|   return `${version}-native-codex-${platform}`;\n00140| }\n00141| \n00142| async function packaged(platform) {\n00143|   const main = JSON.parse((await read(path.join(packageRoot, 'package.json'))).bytes);\n00144|   if (typeof main.name !== 'string' || typeof main.version !== 'string') throw refusal();\n00145|   const manifest = createRequire(import.meta.url).resolve(`${nativeCodexPackageName(main.name, platform)}/package.json`);\n00146|   const variant = JSON.parse((await read(manifest)).bytes);\n00147|   if (variant.name !== main.name || variant.version !== nativeCodexPackageVersion(main.version, platform)) throw refusal();\n00148|   return path.join(path.dirname(manifest), 'runtime', platform);\n00149| }\n00150| \n00151| async function bundle(platform) {\n00152|   const prepared = await recipe(platform);\n00153|   const root = await packaged(platform);\n00154|   return { prepared, verified: await verify(root, prepared) };\n00155| }\n00156| \n00157| /** The installed generation must match this npm package's admitted manifest. */\n00158| export async function verifyNativeCodexRuntime(root, { platform = `linux-${process.arch}` } = {}) {\n00159|   let phase = 'packaged artifact admission';\n00160|   try {\n00161|     const { prepared, verified } = await bundle(platform);\n00162|     phase = 'installed generation admission';\n00163|     const selected = await fs.realpath(root);\n00164|     return await verify(selected, prepared, verified.manifestSha256);\n00165|   } catch (error) {\n00166|     debug(phase, error);\n00167|     throw refusal();\n00168|   }\n00169| }\n00170| \n00171| async function copy(source, target, mode, max) {\n00172|   const input = await fs.open(source, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);\n00173|   let output;\n00174|   try {\n00175|     const before = await input.stat({ bigint: true });\n00176|     if (!before.isFile() || before.nlink !== 1n || before.size <= 0n || before.size > BigInt(max)) throw refusal();\n00177|     output = await fs.open(target, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW, mode);\n00178|     const buffer = Buffer.alloc(65536);\n00179|     let total = 0;\n00180|     while (true) {\n00181|       const { bytesRead } = await input.read(buffer, 0, buffer.length, null);\n00182|       if (!bytesRead) break;\n00183|       total += bytesRead;\n00184|       if (BigInt(total) > before.size) throw refusal();\n00185|       let written = 0;\n00186|       while (written < bytesRead) {\n00187|         const result = await output.write(buffer, written, bytesRead - written, null);\n00188|         if (!result.bytesWritten) throw refusal();\n00189|         written += result.bytesWritten;\n00190|       }\n00191|     }\n00192|     if (BigInt(total) !== before.size || revision(before) !== revision(await input.stat({ bigint: true }))) throw refusal();\n00193|     await output.sync();\n00194|   } finally {\n00195|     await input.close();\n00196|     if (output) await output.close();\n00197|   }\n00198| }\n00199| \n00200| /** Installation owns its package/output directory exclusively. Publish a new\n00201|  * private generation only after all copied native bytes and notices verify.\n00202|  */\n00203| export async function installNativeCodexRuntime({ destination, platform = `linux-${process.arch}` } = {}) {\n00204|   let generation;\n00205|   let published = false;\n00206|   let phase = 'packaged artifact admission';\n00207|   try {\n00208|     const { prepared, verified } = await bundle(platform);\n00209|     phase = 'destination admission';\n00210|     if (typeof destination !== 'string' || !path.isAbsolute(destination) || path.normalize(destination) !== destination) throw refusal();\n00211|     const parent = path.dirname(destination);\n00212|     const parentIdentity = await directory(parent);\n00213|     const existing = await fs.lstat(destination).catch(error => {\n00214|       if (error.code !== 'ENOENT') throw error;\n00215|       return null;\n00216|     });\n00217|     if (existing) return await verify(await fs.realpath(destination), prepared, verified.manifestSha256);\n00218|     generation = await fs.mkdtemp(path.join(parent, '.hive-native-codex-'));\n00219|     phase = 'native generation copy';\n00220|     for (const name of prepared.files) {\n00221|       const target = path.join(generation, name);\n00222|       await fs.mkdir(path.dirname(target), { recursive: true, mode: 0o755 });\n00223|       await copy(path.join(verified.root, name), target, name === 'codex' ? 0o755 : 0o644, name === 'codex' ? prepared.data.maxBinaryBytes : 4194304);\n00224|     }\n00225|     phase = 'complete generation admission';\n00226|     const installed = await verify(generation, prepared, verified.manifestSha256);\n00227|     if ((await directory(parent)) !== parentIdentity) throw refusal();\n00228|     phase = 'exclusive generation publication';\n00229|     await fs.symlink(path.basename(generation), destination, 'dir');\n00230|     published = true;\n00231|     return installed;\n00232|   } catch (error) {\n00233|     debug(phase, error);\n00234|     throw refusal();\n00235|   } finally {\n00236|     if (generation && !published)\n00237|       await fs.rm(generation, { recursive: true, force: true }).catch(() => {\n00238|         throw refusal();\n00239|       });\n00240|   }\n00241| }\n\n(End of file - total 241 lines)\n</file>",
