[2026-10-24T14:59:22.557Z] [INFO]         "content": "src/components/PageCards.jsx:3:import Glyph from './Glyph';\nsrc/components/PageCards.jsx:13:            <Glyph code={p.glyph} size={56} />\nsrc/components/NetworkGallery.jsx:14:import Glyph from './Glyph';\nsrc/components/NetworkGallery.jsx:39:export default function NetworkGallery({ initial = 2 }) {\nsrc/components/NetworkGallery.jsx:132:            <Glyph code={code} size={64} />\nsrc/components/MetaTheory.jsx:6:import Glyph from './Glyph';\nsrc/components/MetaTheory.jsx:34:        <Glyph code={code} size={96} title={`${t({ en: 'Network of', ru: 'Сеть из' })} ${links}: ${code}`} />\nsrc/visuals/rain.js:13:import { glyphPaths, SIZE } from '../links/glyph';\nsrc/visuals/rain.js:30:    paths = glyphPaths(decode(code)).map(({ d, color }) => ({ path: new Path2D(d), color }));\nsrc/components/Glyph.jsx:2:import { glyphPaths, SIZE, STROKE } from '../links/glyph';\nsrc/components/Glyph.jsx:9:export default function Glyph({ code, size = 48, title = null, className = 'glyph' }) {\nsrc/components/Glyph.jsx:21:        {glyphPaths(decode(code)).map(({ d, color }, i) => (\nsrc/pages/ArtPage.jsx:3:import NetworkGallery from '../components/NetworkGallery';\nsrc/pages/ArtPage.jsx:122:        <NetworkGallery />\nsrc/pages/AssociativePage.jsx:1:import Glyph from '../components/Glyph';\nsrc/pages/AssociativePage.jsx:60:                <Glyph code={layer.glyph} size={44} />\nsrc/links/glyph.js:166:export function glyphPaths(links) {\nsrc/links/glyph.js:180:export function glyphSvg(links, size = SIZE) {\nsrc/links/glyph.js:181:  const paths = glyphPaths(links)\nsrc/pages/ResearchPage.jsx:3:import NetworkGallery from '../components/NetworkGallery';\nsrc/pages/ResearchPage.jsx:303:        <NetworkGallery />\n#!/usr/bin/env bash\n# Fails when a tracked source, style, markdown or workflow file exceeds\n# 1500 lines, and warns above 1350 lines. Collected data (docs/ case\n# studies, dev/log), lock files and generated JSON are not checked.\n# Adapted from link-foundation/js-ai-driven-development-pipeline-template.\nset -euo pipefail\n\nLIMIT=1500\nWARN_THRESHOLD=1350\nCHECKED=0\nFAILED=0\n\nwhile IFS= read -r file; do\n  [ -f \"$file\" ] || continue\n  lines=$(wc -l < \"$file\")\n  CHECKED=$((CHECKED + 1))\n  if [ \"$lines\" -gt \"$LIMIT\" ]; then\n    echo \"::error file=$file::$file has $lines lines (limit $LIMIT)\"\n    FAILED=1\n  elif [ \"$lines\" -gt \"$WARN_THRESHOLD\" ]; then\n    echo \"::warning file=$file::$file has $lines lines (warning threshold $WARN_THRESHOLD, limit $LIMIT)\"\n  fi\ndone < <(git ls-files -- '*.js' '*.jsx' '*.cjs' '*.mjs' '*.css' '*.md' '*.yml' '*.yaml' '*.sh' \\\n  ':!:docs/**' ':!:dev/**')\n\nif [ \"$CHECKED\" -eq 0 ]; then\n  echo \"::error::No files were checked; the file size gate is broken.\"\n  exit 2\nfi\necho \"Checked $CHECKED files against the $LIMIT-line limit.\"\nexit \"$FAILED\"\n// Pages of the site. Each one is a separate Vite entry (see vite.config.js),\n// so it is a real URL that works without JavaScript routing on GitHub Pages.\n// Texts are `{ en, ru }` objects, translated with useLang().t.\nexport const PAGES = [\n  {\n    id: 'home',\n    href: '/',\n    label: { en: 'CV', ru: 'Резюме' },\n    title: { en: 'Biography & CV', ru: 'Биография и резюме' },\n    glyph: '11',\n    summary: { en: 'The one-page CV.', ru: 'Резюме на одной странице.' },\n  },\n  {\n    id: 'experience',\n    href: '/experience/',\n    label: { en: 'Experience', ru: 'Опыт' },\n    title: { en: 'Experience by role', ru: 'Опыт по должностям' },\n    glyph: '11 12 33',\n    summary: {\n      en: 'Only the experience relevant to a position: ML / AI, DevOps, lead, CTO, backend, full-stack, Rust, .NET and more.',\n      ru: 'Только опыт, нужный для выбранной должности: ML / AI, DevOps, руководитель, CTO, бэкенд, фулстек, Rust, .NET и другие.',\n    },\n  },\n  {\n    id: 'repositories',\n    href: '/repositories/',\n    label: { en: 'Repositories', ru: 'Репозитории' },\n    title: { en: 'All repositories', ru: 'Все репозитории' },\n    glyph: '12 21',\n    summary: {\n      en: 'Every original repository, how it is useful in each field, and the best examples per IT profession.',\n      ru: 'Все собственные репозитории, их польза в каждой области и лучшие примеры для каждой ИТ-профессии.',\n    },\n  },\n  {\n    id: 'research',\n    href: '/research/',\n    label: { en: 'Research', ru: 'Исследования' },\n    title: { en: 'Research & theory', ru: 'Исследования и теория' },\n    glyph: '11 22 12',\n    summary: {\n      en: 'The links meta-theory, the problem solving algorithm, P vs NP, TSP, physics and data science on laws.',\n      ru: 'Метатеория связей, алгоритм решения задач, P vs NP, задача коммивояжёра, физика и анализ данных законов.',\n    },\n  },\n  {\n    id: 'associative',\n    href: '/associative/',\n    label: { en: 'Associative stack', ru: 'Ассоциативный стек' },\n    title: { en: 'Associative technologies', ru: 'Ассоциативные технологии' },\n    glyph: '12 23 31',\n    summary: {\n      en: 'The associative stack in development since 2010: theory, notation, storage, platform and AI on top.',\n      ru: 'Ассоциативный стек, который развивается с 2010 года: теория, нотация, хранилище, платформа и ИИ поверх них.',\n    },\n  },\n  {\n    id: 'art',\n    href: '/art/',\n    label: { en: 'Art & other', ru: 'Искусство и др.' },\n    title: { en: 'Art & other projects', ru: 'Искусство и другие проекты' },\n    glyph: '11 21 31 41',\n    summary: {\n      en: 'Visual, audio and game experiments, projects that do not fit other categories, and all link symbols.',\n      ru: 'Визуальные, звуковые и игровые эксперименты, проекты вне других категорий и все символы связей.',\n    },\n  },\n  {\n    id: 'blog',\n    href: '/blog/',\n    label: { en: 'Blog', ru: 'Блог' },\n    title: { en: 'Blog', ru: 'Блог' },\n    glyph: '12 23 34 41',\n    summary: {\n      en: 'One deduplicated feed of X, VK and Telegram posts, archived with full formatting.',\n      ru: 'Единая лента постов из X, VK и Telegram без дублей, сохранённая с полным форматированием.',\n    },\n  },\n];\n\nexport const pageById = (id) => PAGES.find((p) => p.id === id);\nimport { StrictMode } from 'react';\nimport { createRoot } from 'react-dom/client';\nimport '../index.css';\n\n/** Renders a page component into #root; every HTML entry of the site calls it once. */\nexport function mount(Page) {\n  createRoot(document.getElementById('root')).render(\n    <StrictMode>\n      <Page />\n    </StrictMode>,\n  );\n}\nimport { mount } from './mount';\nimport ArtPage from './ArtPage';\n\nmount(ArtPage);\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\" />\n    <link rel=\"alternate icon\" href=\"/favicon.ico\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"theme-color\" content=\"#070b14\" />\n    <meta name=\"color-scheme\" content=\"dark light\" />\n    <meta name=\"author\" content=\"Konstantin Diachenko\" />\n    <meta\n      name=\"description\"\n      content=\"Visual, audio and game experiments, every symbol of 1–4 links, and projects that fit no other category.\"\n    />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:title\" content=\"Art & other projects — Konstantin Diachenko (konard)\" />\n    <meta\n      property=\"og:description\"\n      content=\"Visual, audio and game experiments, every symbol of 1–4 links, and projects that fit no other category.\"\n    />\n    <meta property=\"og:url\" content=\"https://konard.github.io/art/\" />\n    <meta property=\"og:image\" content=\"https://avatars.githubusercontent.com/u/1431904?v=4\" />\n    <meta property=\"profile:username\" content=\"konard\" />\n    <meta name=\"twitter:card\" content=\"summary\" />\n    <meta name=\"twitter:site\" content=\"@drakonard\" />\n    <link rel=\"canonical\" href=\"https://