0796|   state_path=$(cd -- \\\"$state_dir\\\" && pwd -P)\\n00797|   output_dir=${output%/*}\\n00798|   output_dir=$(cd -- \\\"${output_dir:-/}\\\" && pwd -P)\\n00799|   [[ \\\"$output_dir/\\\" != \\\"$state_path/\\\"* ]] || fail \\\"Choose an archive outside the state directory\\\"\\n00800|   (\\n00801|     umask 077\\n00802|     part=$(mktemp \\\"$output.part.XXXXXX\\\")\\n00803|     trap 'rm -f -- \\\"$part\\\"' EXIT\\n00804|     tar -czf \\\"$part\\\" -C \\\"$state_dir\\\" .\\n00805|     ln -T -- \\\"$part\\\" \\\"$output\\\"\\n00806|   )\\n00807|   printf '%s\\\\n' \\\"$output\\\"\\n00808| }\\n00809| \\n00810| restore_state() {\\n00811|   local input=- stage\\n00812|   if (( $# )); then\\n00813|     [[ $# == 2 && $1 == --input ]] || fail \\\"Usage: deploy restore [--input FILE|-]\\\"\\n00814|     input=$2\\n00815|   fi\\n00816|   lock_deployment\\n00817|   [[ ! -e $state_dir && ! -L $state_dir ]] || fail \\\"Restore requires a new state directory: $state_dir\\\"\\n00818|   (\\n00819|     umask 077\\n00820|     stage=$(mktemp -d \\\"$state_dir.part.XXXXXX\\\")\\n00821|     trap 'rm -rf -- \\\"$stage\\\"' EXIT\\n00822|     tar -xzf \\\"$input\\\" -C \\\"$stage\\\"\\n00823|     # Rename without replacing a directory created since the initial check.\\n00824|     mv -nT -- \\\"$stage\\\" \\\"$state_dir\\\"\\n00825|     [[ ! -e $stage ]] || fail \\\"State directory already exists: $state_dir\\\"\\n00826|   )\\n00827|   printf 'Restored %s\\\\n' \\\"$state_dir\\\"\\n00828| }\\n00829| \\n00830| private_backup() {\\n00831|   local action=$1\\n00832|   shift\\n00833|   if [[ ${1-} != --help && ${1-} != -h ]]; then lock_deployment; fi\\n00834|   (run_host_python backup/main.py \\\"$action\\\" \\\"$name\\\" \\\"$state_dir\\\" \\\"$@\\\")\\n00835| }\\n00836| \\n00837| deploy_status() {\\n00838|   docker container inspect --format '{{.Name}} {{.State.Status}} image={{or (index .Config.Labels \\\"io.github.link-assistant.hive-manager.image\\\") .Config.Image}}{{if .State.Health}} health={{.State.Health.Status}}{{end}}' \\\"$name\\\"\\n00839| }\\n00840| \\n00841| doctor() {\\n00842|   local probe_path=$state_dir\\n00843|   while [[ ! -d $probe_path && $probe_path != / ]]; do\\n00844|     probe_path=${probe_path%/*}\\n00845|     probe_path=${probe_path:-/}\\n00846|   done\\n00847|   df -h -- \\\"$probe_path\\\"\\n00848|   docker version --format 'Docker server {{.Server.Version}}'\\n00849|   deploy_status\\n00850|   if container_running \\\"$name\\\"; then\\n00851|     docker exec --user box \\\"$name\\\" bash -c '\\n00852|       set -e\\n00853|       hive_source=$(readlink -f \\\"$(command -v hive)\\\")\\n00854|       hive --version\\n00855|       verifier=${hive_source%/*}/verify-agent-runtime.mjs\\n00856|       if [[ -f $verifier ]]; then exec node \\\"$verifier\\\"; fi\\n00857|     '\\n00858|   fi\\n00859| }\\n00860| \\n00861| sample_container_process() {\\n00862|   docker exec --user box -i \\\"$name\\\" bash -s -- \\\"$1\\\" <<'PROCESS_SAMPLE'\\n00863| set -o pipefail\\n00864| proc=/proc/$1\\n00865| process_start() {\\n00866|   awk '{ sub(/^.*\\\\) /, \\\"\\\"); print $20 }' \\\"$proc/stat\\\" 2>/dev/null\\n00867| }\\n00868| \\n00869| socket_sample() {\\n00870|   timeout 4 python3 -I - \\\"$proc/fd\\\" <<'UNIX_QUEUES'\\n00871| import errno\\n00872| import itertools\\n00873| import os\\n00874| import re\\n00875| import socket\\n00876| import struct\\n00877| import sys\\n00878| from functools import lru_cache\\n00879| \\n00880| # Linux uapi/linux/{netlink,sock_diag,unix_diag}.h. Query socket inodes\\n00881| # individually so the sample reads only the selected process and its peers.\\n00882| NETLINK_SOCK_DIAG = 4\\n00883| SOCK_DIAG_BY_FAMILY = 20\\n00884| NLM_F_REQUEST = 1\\n00885| NLMSG_ERROR = 2\\n00886| UDIAG_SHOW_PEER, UDIAG_SHOW_RQLEN = 0x04, 0x10\\n00887| UNIX_DIAG_PEER, UNIX_DIAG_RQLEN = 2, 4\\n00888| TCP_ESTABLISHED = 1\\n00889| NO_COOKIE = [REDACTED]\\n00890| header = struct.Struct(\\\"=IHHII\\\")\\n00891| message = struct.Struct(\\\"=BBBBIII\\\")\\n00892| attribute = struct.Struct(\\\"=HH\\\")\\n00893| \\n00894| @lru_cache(maxsize=1024)\\n00895| def queues(inode):\\n00896|     request = struct.pack(\\\"=BBHIIIII\\\", socket.AF_UNIX, 0, 0, 0, inode,\\n00897|                           UDIAG_SHOW_PEER | UDIAG_SHOW_RQLEN, NO_COOKIE, NO_COOKIE)\\n00898|     diagnostic.send(header.pack(header.size + len(request), SOCK_DIAG_BY_FAMILY, NLM_F_REQUEST, 1, 0) + request)\\n00899|     response, (sender, groups) = diagnostic.recvfrom(4096)\\n00900|     length, kind, _, sequence, _ = header.unpack_from(response)\\n00901|     if sender or groups or sequence != 1 or not header.size <= length <= len(response):\\n00902|         raise ValueError(\\\"Invalid socket diagnostic response\\\")\\n00903|     if kind == NLMSG_ERROR:\\n00904|         error, = struct.unpack_from(\\\"=i\\\", response, header.size)\\n00905|         if error == -errno.ENOENT:\\n00906|             return None\\n00907|         raise OSError(-error, \\\"Unix socket diagnostic query failed\\\")\\n00908|     family, socket_type, state, _, reported_inode, _, _ = message.unpack_from(response, header.size)\\n00909|     if (kind, family, reported_inode) != (SOCK_DIAG_BY_FAMILY, socket.AF_UNIX, inode):\\n00910|         raise ValueError(\\\"Unexpected socket diagnostic response\\\")\\n00911|     if socket_type != socket.SOCK_STREAM or state != TCP_ESTABLISHED:\\n00912|         return None\\n00913|     peer, counters = None, None\\n00914|     offset = header.size + message.size\\n00915|     while offset + attribute.size <= length:\\n00916|         size, tag = attribute.unpack_from(response, offset)\\n00917|         if size < attribute.size or offset + size > length:\\n00918|             raise ValueError(\\\"Invalid socket diagnostic attribute\\\")\\n00919|         value = offset + attribute.size\\n00920|         if tag == UNIX_DIAG_PEER and size == attribute.size + 4:\\n00921|             peer, = struct.unpack_from(\\\"=I\\\", response, value)\\n00922|         if tag == UNIX_DIAG_RQLEN and size == attribute.size + 8:\\n00923|             counters = struct.unpack_from(\\\"=II\\\", response, value)\\n00924|         offset += (size + 3) & ~3\\n00925|     return (*counters, peer) if counters else None\\n00926| \\n00927| try:\\n00928|     with socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_SOCK_DIAG) as diagnostic, os.scandir(sys.argv[1]) as descriptors:\\n00929|         diagnostic.settimeout(1)\\n00930|         diagnostic.connect((0, 0))\\n00931|         for descriptor in itertools.islice(descriptors, 512):\\n00932|             try:\\n00933|                 target = os.readlink(descriptor.path)\\n00934|             except FileNotFoundError:\\n00935|                 continue\\n00936|             match = re.fullmatch(r\\\"socket:\\\\[(\\\\d+)\\\\]\\\", target)\\n00937|             if not match:\\n00938|                 continue\\n00939|             inode = int(match[1])\\n00940|             if not 0 < inode <= 0xFFFFFFFF:\\n00941|                 continue\\n00942|             result = queues(inode)\\n00943|             if result:\\n00944|                 received, sent, peer = result\\n00945|                 peer_queues = queues(peer) if peer else None\\n00946|                 print(inode, descriptor.name, received, sent, peer_queues[1] if peer_queues else \\\"unknown\\\")\\n00947| except (OSError, ValueError, struct.error):\\n00948|     sys.exit(1)\\n00949| UNIX_QUEUES\\n00950| }\\n00951| \\n00952| started=$(process_start)\\n00953| if [[ ! $started ]]; then\\n00954|   printf 'Process %s is unavailable in the container\\\\n' \\\"$1\\\" >&2\\n00955|   exit 1\\n00956| fi\\n00957| socket_evidence=false\\n00958| if command -v python3 >/dev/null && command -v timeout >/dev/null && first_queues=$(socket_sample); then socket_evidence=true; fi\\n00959| first_io=$(cat \\\"$proc/io\\\" 2>/dev/null)\\n00960| sleep 2\\n00961| last_io=$(cat \\\"$proc/io\\\" 2>/dev/null)\\n00962| if $socket_evidence && ! last_queues=$