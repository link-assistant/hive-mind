name()\\\\n01059| \\\\tvar min_rank: String = condition.get(\\\\\\\"min_rank\\\\\\\", \\\\\\\"D\\\\\\\")\\\\n01060| \\\\tif min_rank == \\\\\\\"F\\\\\\\":\\\\n01061| \\\\t\\\\treturn tr(\\\\\\\"UNLOCK_COND_COMPLETE_LEVEL\\\\\\\") % level_name\\\\n01062| \\\\treturn tr(\\\\\\\"UNLOCK_COND_COMPLETE_LEVEL_AT_RANK\\\\\\\") % [level_name, min_rank]\\\\n01063| \\\\n01064| \\\\n01065| ## Build a description string for a MULTI_UNLOCK_CONDITIONS entry.\\\\n01066| func _build_multi_level_description(multi_condition: Dictionary) -> String:\\\\n01067| \\\\tvar parts: Array[String] = []\\\\n01068| \\\\tfor level_entry in multi_condition.get(\\\\\\\"levels\\\\\\\", []):\\\\n01069| \\\\t\\\\tvar path: String = level_entry.get(\\\\\\\"path\\\\\\\", \\\\\\\"\\\\\\\")\\\\n01070| \\\\t\\\\tvar min_rank: String = level_entry.get(\\\\\\\"min_rank\\\\\\\", \\\\\\\"S\\\\\\\")\\\\n01071| \\\\t\\\\tvar name_key: String = _LEVEL_NAME_KEYS.get(path, \\\\\\\"\\\\\\\")\\\\n01072| \\\\t\\\\tvar level_name: String = tr(name_key) if name_key != \\\\\\\"\\\\\\\" else path.get_file().get_basename()\\\\n01073| \\\\t\\\\tparts.append(\\\\\\\"%s %s\\\\\\\" % [level_name, min_rank])\\\\n01074| \\\\treturn tr(\\\\\\\"UNLOCK_COND_COMPLETE_MULTI\\\\\\\") % \\\\\\\" + \\\\\\\".join(parts)\\\\n01075| \\\\n01076| \\\\n01077| ## Build a description string for a KILL_UNLOCK_CONDITIONS entry.\\\\n01078| func _build_kill_condition_description(kill_condition: Dictionary) -> String:\\\\n01079| \\\\tvar stat: String = kill_condition.get(\\\\\\\"stat\\\\\\\", \\\\\\\"\\\\\\\")\\\\n01080| \\\\tvar min_kills: int = kill_condition.get(\\\\\\\"min_kills\\\\\\\", 0)\\\\n01081| \\\\tif stat == \\\\\\\"shots_fired_special_weapons\\\\\\\":\\\\n01082| \\\\t\\\\treturn tr(\\\\\\\"UNLOCK_COND_SHOTS_SPECIAL_WEAPONS\\\\\\\") % min_kills\\\\n01083| \\\\tif stat == \\\\\\\"total_deaths\\\\\\\":\\\\n01084| \\\\t\\\\treturn tr(\\\\\\\"UNLOCK_COND_TOTAL_DEATHS\\\\\\\") % min_kills\\\\n01085| \\\\tif stat == \\\\\\\"no_damage_levels_completed\\\\\\\":\\\\n01086| \\\\t\\\\treturn tr(\\\\\\\"UNLOCK_COND_NO_DAMAGE_LEVELS\\\\\\\") % min_kills\\\\n01087| \\\\tif stat == \\\\\\\"levels_completed_rank_a_or_higher\\\\\\\":\\\\n01088| \\\\t\\\\treturn tr(\\\\\\\"UNLOCK_COND_RANK_A_LEVELS\\\\\\\") % min_kills\\\\n01089| \\\\tif stat == \\\\\\\"kills_through_wall\\\\\\\":\\\\n01090| \\\\t\\\\treturn tr(\\\\\\\"UNLOCK_COND_WALL_KILLS\\\\\\\") % min_kills\\\\n01091| \\\\tif stat == \\\\\\\"levels_completed_with_silenced_pistol\\\\\\\":\\\\n01092| \\\\t\\\\treturn tr(\\\\\\\"UNLOCK_COND_SILENCED_PISTOL_LEVEL\\\\\\\")\\\\n01093| \\\\treturn tr(\\\\\\\"UNLOCK_COND_KILLS_NO_LASER\\\\\\\") % min_kills\\\\n01094| \\\\n01095| \\\\n01096| ## Get the kill-based unlock condition progress for a weapon (0.0–1.0).\\\\n01097| ## Returns -1.0 if no kill-based condition applies (e.g., level-based unlock).\\\\n01098| ## Returns a value in [0.0, 1.0] clamped to the condition's min_kills threshold.\\\\n01099| ## Issue #1591: used by the armory to show progress bar animation.\\\\n01100| func get_weapon_kill_condition_progress(weapon_id: String) -> float:\\\\n01101| \\\\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\\\n01102| \\\\t\\\\tif weapon_id in kill_condition.get(\\\\\\\"weapons\\\\\\\", []):\\\\n01103| \\\\t\\\\t\\\\tvar game_manager: Node = get_node_or_null(\\\\\\\"/root/GameManager\\\\\\\")\\\\n01104| \\\\t\\\\t\\\\tif not game_manager:\\\\n01105| \\\\t\\\\t\\\\t\\\\treturn 0.0\\\\n01106| \\\\t\\\\t\\\\tvar stat: String = kill_condition.get(\\\\\\\"stat\\\\\\\", \\\\\\\"\\\\\\\")\\\\n01107| \\\\t\\\\t\\\\tvar min_kills: int = kill_condition.get(\\\\\\\"min_kills\\\\\\\", 1)\\\\n01108| \\\\t\\\\t\\\\tvar current: int = game_manager.get(stat) if game_manager.get(stat) != null else 0\\\\n01109| \\\\t\\\\t\\\\treturn clampf(float(current) / float(min_kills), 0.0, 1.0)\\\\n01110| \\\\treturn -1.0\\\\n01111| \\\\n01112| \\\\n01113| ## Get the kill-based unlock condition progress for a grenade type (0.0–1.0).\\\\n01114| ## Returns -1.0 if no kill-based condition applies.\\\\n01115| ## Issue #1591: used by the armory to show progress bar animation.\\\\n01116| func get_grenade_kill_condition_progress(grenade_type: int) -> float:\\\\n01117| \\\\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\\\n01118| \\\\t\\\\tif grenade_type in kill_condition.get(\\\\\\\"grenades\\\\\\\", []):\\\\n01119| \\\\t\\\\t\\\\tvar game_manager: Node = get_node_or_null(\\\\\\\"/root/GameManager\\\\\\\")\\\\n01120| \\\\t\\\\t\\\\tif not game_manager:\\\\n01121| \\\\t\\\\t\\\\t\\\\treturn 0.0\\\\n01122| \\\\t\\\\t\\\\tvar stat: String = kill_condition.get(\\\\\\\"stat\\\\\\\", \\\\\\\"\\\\\\\")\\\\n01123| \\\\t\\\\t\\\\tvar min_kills: int = kill_condition.get(\\\\\\\"min_kills\\\\\\\", 1)\\\\n01124| \\\\t\\\\t\\\\tvar current: int = game_manager.get(stat) if game_manager.get(stat) != null else 0\\\\n01125| \\\\t\\\\t\\\\treturn clampf(float(current) / float(min_kills), 0.0, 1.0)\\\\n01126| \\\\treturn -1.0\\\\n01127| \\\\n01128| \\\\n01129| ## Get the kill-based unlock condition progress for an active item type (0.0–1.0).\\\\n01130| ## Returns -1.0 if no kill-based condition applies.\\\\n01131| ## Issue #1591: used by the armory to show progress bar animation.\\\\n01132| func get_active_item_kill_condition_progress(item_type: int) -> float:\\\\n01133| \\\\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\\\n01134| \\\\t\\\\tif item_type in kill_condition.get(\\\\\\\"active_items\\\\\\\", []):\\\\n01135| \\\\t\\\\t\\\\tvar game_manager: Node = get_node_or_null(\\\\\\\"/root/GameManager\\\\\\\")\\\\n01136| \\\\t\\\\t\\\\tif not game_manager:\\\\n01137| \\\\t\\\\t\\\\t\\\\treturn 0.0\\\\n01138| \\\\t\\\\t\\\\tvar stat: String = kill_condition.get(\\\\\\\"stat\\\\\\\", \\\\\\\"\\\\\\\")\\\\n01139| \\\\t\\\\t\\\\tvar min_kills: int = kill_condition.get(\\\\\\\"min_kills\\\\\\\", 1)\\\\n01140| \\\\t\\\\t\\\\tvar current: int = game_manager.get(stat) if game_manager.get(stat) != null else 0\\\\n01141| \\\\t\\\\t\\\\treturn clampf(float(current) / float(min_kills), 0.0, 1.0)\\\\n01142| \\\\treturn -1.0\\\\n01143| \\\\n01144| \\\\n01145| ## Get the kill-based unlock condition current and max counts for a weapon.\\\\n01146| ## Returns {\\\\\\\"current\\\\\\\": int, \\\\\\\"max\\\\\\\": int} if a kill condition applies, or {} otherwise.\\\\n01147| ## Issue #1591: used by the armory tooltip to show progress numbers.\\\\n01148| func get_weapon_kill_condition_counts(weapon_id: String) -> Dictionary:\\\\n01149| \\\\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\\\n01150| \\\\t\\\\tif weapon_id in kill_condition.get(\\\\\\\"weapons\\\\\\\", []):\\\\n01151| \\\\t\\\\t\\\\tvar game_manager: Node = get_node_or_null(\\\\\\\"/root/GameManager\\\\\\\")\\\\n01152| \\\\t\\\\t\\\\tif not game_manager:\\\\n01153| \\\\t\\\\t\\\\t\\\\treturn {}\\\\n01154| \\\\t\\\\t\\\\tvar stat: String = kill_condition.get(\\\\\\\"stat\\\\\\\", \\\\\\\"\\\\\\\")\\\\n01155| \\\\t\\\\t\\\\tvar min_kills: int = kill_condition.get(\\\\\\\"min_kills\\\\\\\", 1)\\\\n01156| \\\\t\\\\t\\\\tvar current: int = game_manager.get(stat) if game_manager.get(stat) != null else 0\\\\n01157| \\\\t\\\\t\\\\treturn {\\\\\\\"current\\\\\\\": mini(current, min_kills), \\\\\\\"max\\\\\\\": min_kills}\\\\n01158| \\\\treturn {}\\\\n01159| \\\\n01160| \\\\n01161| ## Get the kill-based unlock condition current and max counts for a grenade type.\\\\n01162| ## Returns {\\\\\\\"current\\\\\\\": int, \\\\\\\"max\\\\\\\": int} if a kill condition applies, or {} otherwise.\\\\n01163| ## Issue #1591: used by the armory tooltip to show progress numbers.\\\\n01164| func get_grenade_kill_condition_counts(grenade_type: int) -> Dictionary:\\\\n01165| \\\\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\\\n01166| \\\\t\\\\tif grenade_type in kill_condition.get(\\\\\\\"grenades\\\\\\\", []):\\\\n01167| \\\\t\\\\t\\\\tvar game_manager: Node = get_node_or_null(\\\\\\\"/root/GameManager\\\\\\\")\\\\n01168| \\\\t\\\\t\\\\tif not game_manager:\\\\n01169| \\\\t\\\\t\\\\t\\\\treturn {}\\\\n01170| \\\\t\\\\t\\\\tvar stat: String = kill_condition.get(\\\\\\\"stat\\\\\\\", \\\\\\\"\\\\\\\")\\\\n01171| \\\\t\\\\t\\\\tvar min_kills: int = kill_condition.get(\\\\\\\"min_kills\\\\\\\", 1)\\\\n01172| \\\\t\\\\t\\\\tvar current: int = game_manager.get(stat) if game_manager.get(stat) != null else 0\\\\n01173| \\\\t\\\\t\\\\treturn {\\\\\\\"current\\\\\\\": mini(current, min_kills), \\\\\\\"max\\\\\\\": min_kills}\\\\n01174| \\\\treturn {}\\\\n01175| \\\\n01176| \\\\n01177| ## Get the kill-based unlock condition current and max counts for an active item type.\\\\n01178| ## Returns {\\\\\\\"current\\\\\\\": int, \\\\\\\"max\\\\\\\": int} if a kill condition applies, or {} otherwise.\\\\n01179| ## Issue #1591: used by the armory tooltip to show progress numbers.\\\\n01180| func get_active_item_kill_condition_counts(item_type: int) -> Dictionary:\\\\n01181| \\\\tfor kill_condition in KILL_UNLOCK_CONDITIONS:\\\\n01182| \\\\t\\\\tif item_type in kill_condition.get(\\\\\\\"active_items\\\\\\\", []):\\\\n01183| \\\\t\\\\t\\\\tvar game_manager: Node = get_node_or_null(\\\\\\\"/root/GameManager\\\\\\\")\\\\n01184| \\\\t\\\\t\\\\tif not game_manager:\\\\n01185| \\\\t\\\\t\\\\t\\\\treturn {}\\\\n01186| \\\\t\\\\t\\\\tvar stat: String = kill_condition.get(\\\\\\\"stat\\\\\\\", \\\\\\\"\\\\\\\")\\\\n01187| \\\\t\\\\t\\\\tvar min_kills: int = kill_condition.get(\\\\\\\"min_kills\\\\\\\", 1)\\\\n01188| \\\\t\\\\t\\\\tvar current: int = game_manager.get(stat) if game_manager.get(stat) != null else 0\\\\n01189| \\\\t\\\\t\\\\treturn {\\\\\\\"current\\\\\\\": mini(current, min_kills), \\\\\\\"max\\\\\\\": min_kills}\\\\n01190| \\\\treturn {}\\\\n01191| \\\\n01192| \\\\n01193| ## Get the fraction of levels satisfied in a multi-level condition (0.0–1.0).\\\\n01194| ## Internal helper for get_*_multi_condition_progress.\\\\n01195| ## Issue #1591: used by armory to show progress bar for multi-level conditions.\\\\n01196| func _get_multi_condition_progress(multi_condition: Dictionary) -> float:\\\\n01197| \\\\tvar levels: Array = multi_condition.get(\\\\\\\"levels\\\\\\\", [])\\\\n01198| \\\\tif levels.is_empty():\\\\n01199| \\\\t\\\\treturn 0.0\\\\n01200| \\\\tvar completed: int = 0\\\\n01201| \\\\tfor level_entry in levels:\\\\n01202| \\\\t\\\\tvar path: String = level_entry.get(\\\\\\\"path\\\\\\\", \\\\\\\"\\\\\\\")\\\\n01203| \\\\t\\\\tvar min_rank: String = level_entry.get(\\\\\\\"min_rank\\\\\\\", \\\\\\\"D\\\\\\\")\\\\n01204| \\\\t\\\\tvar best_rank: String = _get_best_rank_any_difficulty(path)\\\\n01205| \\\\t\\\\tif _is_rank_sufficient(best_rank, min_rank):\\\\n01206| \\\\t\\\\t\\\\tcompleted += 1\\\\n01207| \\\\treturn float(completed) / float(levels.size())\\\\n01208| \\\\n01209| \\\\n01210| ## Get the fraction of difficulties on which at least one level has been completed (0.0–1.0).\\\\n01211| ## Internal helper for get_*_all_difficulties_progress.\\\\n01212| ## Issue #1591: used by armory to show progress bar for all-difficulties conditions.\\\\n01213| func _get_all_difficulties_progress() -> float:\\\\n01214| \\\\tvar progress_manager: Node = get_node_or_null(\\\\\\\"/root/ProgressManager\\\\\\\")\\\\n01215| \\\\tif not progress_manager:\\\\n01216| \\\\t\\\\treturn 0.0\\\\n01217| \\\\tvar all_difficulties: Array[String] = _get_all_difficulty_names()\\\\n01218| \\\\tvar total: int = all_difficulties.size()\\\\n01219| \\\\tif total == 0:\\\\n01220| \\\\t\\\\treturn 0.0\\\\n01221| \\\\tvar completed: int = 0\\\\n01222| \\\\tfor difficulty_name in all_difficulties:\\\\n01223| \\\\t\\\\tfor key in progress_manager.get_all_progress():\\\\n01224| \\\\t\\\\t\\\\tif key.ends_with(\\\\\\\":\\\\\\\" + difficulty_name):\\\\n01225| \\\\t\\\\t\\\\t\\\\tcompleted += 1\\\\n01226| \\\\t\\\\t\\\\t\\\\tbreak\\\\n01227| \\\\treturn float(completed) / float(total)\\\\n01228| \\\\n01229| \\\\n01230| ## Get the multi-level condition progress for a weapon (0.0–1.0).\\\\n01231| ## Returns -1.0 if no multi-level condition applies.\\\\n01232| ## Issue #1591: used by armory to show progress bar animation.\\\\n01233| func get_weapon_multi_condition_progress(weapon_id: String) -> float:\\\\n01234| \\\\tfor multi_condition in MULTI_UNLOCK_CONDITIONS:\\\\n01235| \\\\t\\\\tif weapon_id in multi_condition.get(\\\\\\\"weapons\\\\\\\", []):\\\\n01236| \\\\t\\\\t\\\\treturn _get_multi_condition_progress(multi_condition)\\\\n01237| \\\\treturn -1.0\\\\n01238| \\\\n01239| \\\\n01240| ## Get the multi-level condition progress for a grenade type (0.0–1.0).\\\\n01241| ## Returns -1.0 if no multi-level condition applies.\\\\n01242| ## Issue #1591: used by armory to show progress bar animation.\\\\n01243| func get_grenade_multi_condition_progress(grenade_type: int) -> float:\\\\n01244| \\\\tfor multi_condition in MULTI_UNLOCK_CONDITIONS:\\\\n01245| \\\\t\\\\tif grenade_type in multi_condition.get(\\\\\\\"grenades\\\\\\\", []):\\\\n01246| \\\\t\\\\t\\\\treturn _get_multi_condition_progress(multi_condition)\\\\n01247| \\\\treturn -1.0\\\\n01248| \\\\n01249| \\\\n01250| ## Get the multi-level condition progress for an active item type (0.0–1.0).\\\\n01251| ## Returns -1.0 if no multi-level condition applies.\\\\n01252| ## Issue #1591: used by armory to show progress bar animation.\\\\n01253| func get_active_item_multi_condition_progress(item_type: int) -> float:\\\\n01254| \\\\tfor multi_condition in MULTI_UNLOCK_CONDITIONS:\\\\n01255| \\\\t\\\\tif item_type in multi_condition.get(\\\\\\\"active_items\\\\\\\", []):\\\\n01256| \\\\t\\\\t\\\\treturn _get_multi_condition_progress(multi_condition)\\\\n01257| \\\\treturn -1.0\\\\n01258| \\\\n01259| \\\\n01260| ## Get the all-difficulties condition progress for a weapon (0.0–1.0).\\\\n01261| ## Returns -1.0 if no all-difficulties condition applies.\\\\n01262| ## Issue #1591: used by armory to show progress bar animation.\\\\n01263| func get_weapon_all_difficulties_progress(weapon_id: String) -> float:\\\\n01264| \\\\tfor all_diff_condition in ALL_DIFFICULTIES_UNLOCK_CONDITIONS:\\\\n01265| \\\\t\\\\tif weapon_id in all_diff_condition.get(\\\\\\\"weapons\\\\\\\", []):\\\\n01266| \\\\t\\\\t\\\\treturn _get_all_difficulties_progress()\\\\n01267| \\\\treturn -1.0\\\\n01268| \\\\n01269| \\\\n01270| ## Get the all-difficulties condition progress for a grenade type (0.0–1.0).\\\\n01271| ## Returns -1.0 if no all-difficulties condition applies.\\\\n01272| ## Issue #1591: used by armory to show progress bar animation.\\\\n01273| func get_grenade_all_difficulties_progress(grenade_type: int) -> float:\\\\n01274| \\\\tfor all_diff_condition in ALL_DIFFICULTIES_UNLOCK_CONDITIONS:\\\\n01275| \\\\t\\\\tif grenade_type in all_diff_condition.get(\\\\\\\"grenades\\\\\\\", []):\\\\n01276| \\\\t\\\\t\\\\treturn _get_all_difficulties_progress()\\\\n01277| \\\\treturn -1.0\\\\n01278| \\\\n01279| \\\\n01280| ## Get the all-difficulties condition progress for an active item type (0.0–1.0).\\\\n01281| ## Returns -1.0 if no all-difficulties condition applies.\\\\n01282| ## Issue #1591: used by armory to show progress bar animation.\\\\n01283| func get_active_item_all_difficulties_progress(item_type: int) -> float:\\\\n01284| \\\\tfor all_diff_condition in ALL_DIFFICULTIES_UNLOCK_CONDITIONS:\\\\n01285| \\\\t\\\\tif item_type in all_diff_condition.get(\\\\\\\"active_items\\\\\\\", []):\\\\n01286| \\\\t\\\\t\\\\treturn _get_all_difficulties_progress()\\\\n01287| \\\\treturn -1.0\\\\n01288| \\\\n01289| \\\\n01290| ## Get the single-level condition progress for a weapon (0.0 or 1.0, binary).\\\\n01291| ## Returns -1.0 if no single-level condition applies.\\\\n01292| ## Issue #1591: used by armory to show progress bar animation.\\\\n01293| func get_weapon_single_condition_progress(weapon_id: String) -> float:\\\\n01294| \\\\tfor condition_key in UNLOCK_CONDITIONS:\\\\n01295| \\\\t\\\\tvar condition: Dictionary = UNLOCK_CONDITIONS[condition_key]\\\\n01296| \\\\t\\\\tif weapon_id in condition.get(\\\\\\\"weapons\\\\\\\", []):\\\\n01297| \\\\t\\\\t\\\\treturn 1.0 if 