[2026-07-19T13:07:25.779Z] [INFO]           "+# Exit code 0 = all --auto-fork tests pass; non-zero = a check failed.",
[2026-07-19T13:07:25.779Z] [INFO]           "+#",
[2026-07-19T13:07:25.779Z] [INFO]           "+# History (issue #2082): every check here used to print \"Could not verify ...\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+# on failure and carry on to exit 0, so the job was green whatever happened. It",
[2026-07-19T13:07:25.779Z] [INFO]           "+# was not hypothetical — the dry-run checks below need ~30s to reach the marker",
[2026-07-19T13:07:25.779Z] [INFO]           "+# they grep for, and were being killed by a `timeout 10s`, so the greps had been",
[2026-07-19T13:07:25.779Z] [INFO]           "+# failing on every run. Both halves are fixed: the timeouts are realistic and a",
[2026-07-19T13:07:25.779Z] [INFO]           "+# failed check now fails the script.",
[2026-07-19T13:07:25.779Z] [INFO]           " ",
[2026-07-19T13:07:25.779Z] [INFO]           " set -euo pipefail",
[2026-07-19T13:07:25.779Z] [INFO]           " ",
[2026-07-19T13:07:25.779Z] [INFO]           "-echo \"Testing --auto-fork option with dry-run mode...\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+# The dry-run checks below exercise the real CLI, which makes several GitHub API",
[2026-07-19T13:07:25.779Z] [INFO]           "+# calls before it reaches the auto-fork decision. Measured at ~32s; allow 3x.",
[2026-07-19T13:07:25.779Z] [INFO]           "+DRY_RUN_TIMEOUT=\"${DRY_RUN_TIMEOUT:-120s}\"",
[2026-07-19T13:07:25.779Z] [INFO]           " ",
[2026-07-19T13:07:25.779Z] [INFO]           "+failed=0",
[2026-07-19T13:07:25.779Z] [INFO]           "+",
[2026-07-19T13:07:25.779Z] [INFO]           "+# Assert that a log file contains a pattern, without aborting the whole run on",
[2026-07-19T13:07:25.779Z] [INFO]           "+# the first failure — reporting every broken check at once is more useful than",
[2026-07-19T13:07:25.779Z] [INFO]           "+# stopping at the first.",
[2026-07-19T13:07:25.779Z] [INFO]           "+#",
[2026-07-19T13:07:25.779Z] [INFO]           "+# Usage: assert_log_matches <description> <regex> <logfile>",
[2026-07-19T13:07:25.779Z] [INFO]           "+assert_log_matches() {",
[2026-07-19T13:07:25.779Z] [INFO]           "+  local description=\"$1\" pattern=\"$2\" logfile=\"$3\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+  if grep -qE \"$pattern\" \"$logfile\"; then",
[2026-07-19T13:07:25.779Z] [INFO]           "+    echo \"PASS: $description\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+  else",
[2026-07-19T13:07:25.779Z] [INFO]           "+    echo \"FAIL: $description\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+    echo \"  expected output matching: $pattern\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+    echo \"  ---- last 20 lines of $logfile ----\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+    tail -20 \"$logfile\" | sed 's/^/  /'",
[2026-07-19T13:07:25.779Z] [INFO]           "+    echo \"  ----------------------------------\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+    failed=1",
[2026-07-19T13:07:25.779Z] [INFO]           "+  fi",
[2026-07-19T13:07:25.779Z] [INFO]           "+}",
[2026-07-19T13:07:25.779Z] [INFO]           "+",
[2026-07-19T13:07:25.779Z] [INFO]           "+echo \"Testing --auto-fork option...\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+",
[2026-07-19T13:07:25.779Z] [INFO]           "+# 1. The flag is recognised at all. This is hermetic and fast: it needs no",
[2026-07-19T13:07:25.779Z] [INFO]           "+#    network, so it still reports precisely if the dry-run checks below break for",
[2026-07-19T13:07:25.779Z] [INFO]           "+#    environmental reasons.",
[2026-07-19T13:07:25.779Z] [INFO]           " echo \"\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+echo \"Checking that --auto-fork is a documented option...\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+timeout 60s ./src/solve.mjs --help >solve_help.log 2>&1",
[2026-07-19T13:07:25.779Z] [INFO]           "+assert_log_matches \"solve.mjs documents --auto-fork\" -- \"solve_help.log\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+assert_log_matches \"solve.mjs documents --auto-fork\" \"auto-fork\" \"solve_help.log\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+",
[2026-07-19T13:07:25.779Z] [INFO]           "+timeout 60s ./src/hive.mjs --help >hive_help.log 2>&1",
[2026-07-19T13:07:25.779Z] [INFO]           "+assert_log_matches \"hive.mjs documents --auto-fork\" \"auto-fork\" \"hive_help.log\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+",
[2026-07-19T13:07:25.779Z] [INFO]           "+# 2. The flag reaches the auto-fork decision at runtime. The command exits",
[2026-07-19T13:07:25.779Z] [INFO]           "+#    non-zero (the fixture repository does not exist), which is expected and not",
[2026-07-19T13:07:25.779Z] [INFO]           "+#    what is under test, hence `|| true` — the assertion is on the output.",
[2026-07-19T13:07:25.779Z] [INFO]           "+echo \"\"",
[2026-07-19T13:07:25.779Z] [INFO]           " echo \"Testing solve.mjs with --auto-fork and --dry-run...\"",
[2026-07-19T13:07:25.779Z] [INFO]           "-timeout 10s ./src/solve.mjs https://github.com/test/repo/issues/1 --auto-fork --dry-run --skip-tool-check 2>&1 | tee solve_auto_fork.log || true",
[2026-07-19T13:07:25.779Z] [INFO]           "-if grep -qE \"(auto-fork|Auto-fork)\" solve_auto_fork.log; then",
[2026-07-19T13:07:25.779Z] [INFO]           "-  echo \"solve.mjs recognizes --auto-fork flag\"",
[2026-07-19T13:07:25.779Z] [INFO]           "-else",
[2026-07-19T13:07:25.779Z] [INFO]           "-  echo \"Could not verify --auto-fork flag in solve output\"",
[2026-07-19T13:07:25.779Z] [INFO]           "-fi",
[2026-07-19T13:07:25.779Z] [INFO]           "+timeout \"$DRY_RUN_TIMEOUT\" ./src/solve.mjs https://github.com/test/repo/issues/1 --auto-fork --dry-run --skip-tool-check 2>&1 | tee solve_auto_fork.log || true",
[2026-07-19T13:07:25.779Z] [INFO]           "+assert_log_matches \"solve.mjs acts on --auto-fork\" \"([Aa]uto-fork)\" \"solve_auto_fork.log\"",
[2026-07-19T13:07:25.779Z] [INFO]           " ",
[2026-07-19T13:07:25.779Z] [INFO]           " echo \"\"",
[2026-07-19T13:07:25.779Z] [INFO]           " echo \"Testing hive.mjs with --auto-fork and --dry-run...\"",
[2026-07-19T13:07:25.779Z] [INFO]           "-timeout 30s ./src/hive.mjs https://github.com/test/repo --auto-fork --dry-run --skip-tool-check --once --max-issues 1 2>&1 | tee hive_auto_fork.log || true",
[2026-07-19T13:07:25.779Z] [INFO]           "-if grep -qE \"(auto-fork|Auto-fork)\" hive_auto_fork.log; then",
[2026-07-19T13:07:25.779Z] [INFO]           "-  echo \"hive.mjs recognizes --auto-fork flag\"",
[2026-07-19T13:07:25.779Z] [INFO]           "-else",
[2026-07-19T13:07:25.779Z] [INFO]           "-  echo \"Could not verify --auto-fork flag in hive output\"",
[2026-07-19T13:07:25.779Z] [INFO]           "-fi",
[2026-07-19T13:07:25.779Z] [INFO]           "+timeout \"$DRY_RUN_TIMEOUT\" ./src/hive.mjs https://github.com/test/repo --auto-fork --dry-run --skip-tool-check --once --max-issues 1 2>&1 | tee hive_auto_fork.log || true",
[2026-07-19T13:07:25.779Z] [INFO]           "+assert_log_matches \"hive.mjs acts on --auto-fork\" \"([Aa]uto-fork)\" \"hive_auto_fork.log\"",
[2026-07-19T13:07:25.779Z] [INFO]           " ",
[2026-07-19T13:07:25.779Z] [INFO]           "+# 3. The deprecated entry point still accepts the flag rather than rejecting it",
[2026-07-19T13:07:25.779Z] [INFO]           "+#    as unknown.",
[2026-07-19T13:07:25.779Z] [INFO]           " echo \"\"",
[2026-07-19T13:07:25.779Z] [INFO]           " echo \"Testing deprecated start-screen.mjs accepts --auto-fork without opening a screen...\"",
[2026-07-19T13:07:25.779Z] [INFO]           " NODE_BIN=\"${NODE_BIN:-$(command -v node)}\"",
[2026-07-19T13:07:25.779Z] [INFO]           " NO_SCREEN_PATH=\"$(dirname \"${NODE_BIN}\")\"",
[2026-07-19T13:07:25.779Z] [INFO]           " PATH=\"${NO_SCREEN_PATH}\" \"${NODE_BIN}\" ./src/start-screen.mjs solve https://github.com/test/repo/issues/1 --auto-fork --dry-run 2>&1 | tee start_screen_auto_fork.log || true",
[2026-07-19T13:07:25.779Z] [INFO]           "-if grep -qE \"(GNU Screen is not installed|screen.*not.*installed)\" start_screen_auto_fork.log && ! grep -q \"Unknown option\" start_screen_auto_fork.log; then",
[2026-07-19T13:07:25.779Z] [INFO]           "-  echo \"start-screen.mjs accepts --auto-fork flag without creating a legacy screen\"",
[2026-07-19T13:07:25.779Z] [INFO]           "-else",
[2026-07-19T13:07:25.779Z] [INFO]           "-  echo \"Could not verify start-screen flag acceptance\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+assert_log_matches \"start-screen.mjs reports screen is unavailable rather than failing on the flag\" \"(GNU Screen is not installed|screen.*not.*installed)\" \"start_screen_auto_fork.log\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+",
[2026-07-19T13:07:25.779Z] [INFO]           "+if grep -q \"Unknown option\" start_screen_auto_fork.log; then",
[2026-07-19T13:07:25.779Z] [INFO]           "+  echo \"FAIL: start-screen.mjs rejected --auto-fork as an unknown option\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+  failed=1",
[2026-07-19T13:07:25.779Z] [INFO]           " fi",
[2026-07-19T13:07:25.779Z] [INFO]           " ",
[2026-07-19T13:07:25.779Z] [INFO]           " echo \"\"",
[2026-07-19T13:07:25.779Z] [INFO]           "-echo \"All --auto-fork option tests completed\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+if [ \"$failed\" -ne 0 ]; then",
[2026-07-19T13:07:25.779Z] [INFO]           "+  echo \"--auto-fork option tests FAILED\"",
[2026-07-19T13:07:25.779Z] [INFO]           "+  exit 1",
[2026-07-19T13:07:25.779Z] [INFO]           "+fi",
[2026-07-19T13:07:25.779Z] [INFO]           "+",
[2026-07-19T13:07:25.779Z] [INFO]           "+echo \"All --auto-fork option tests passed\""
[2026-07-19T13:07:25.779Z] [INFO]         ]
[2026-07-19T13:07:25.779Z] [INFO]       }
[2026-07-19T13:07:25.779Z] [INFO]     ],
[2026-07-19T13:07:25.779Z] [INFO]     "originalFile": "#!/usr/bin/env bash\n# test-auto-fork-option.sh\n#\n# Tests that the --auto-fork flag is correctly recognised and propagated by\n# solve.mjs, hive.mjs, and start-screen.mjs.\n#\n# Usage:\n#   bash scripts/test-auto-fork-option.sh\n#\n# Exit code 0 = all --auto-fork tests pass; non-zero = unexpected failure.\n\nset -euo pipefail\n\necho \"Testing --auto-fork option with dry-run mode...\"\n\necho \"\"\necho \"Testing solve.mjs with --auto-fork and --dry-run...\"\ntimeout 10s ./src/solve.mjs https://github.com/test/repo/issues/1 --auto-fork --dry-run --skip-tool-check 2>&1 | tee solve_auto_fork.log || true\nif grep -qE \"(auto-fork|Auto-fork)\" solve_auto_fork.log; then\n  echo \"solve.mjs recognizes --auto-fork flag\"\nelse\n  echo \"Could not verify --auto-fork flag in solve output\"\nfi\n\necho \"\"\necho \"Testing hive.mjs with --auto-fork and --dry-run...\"\ntimeout 30s ./src/hive.mjs https://github.com/test/repo --auto-fork --dry-run --skip-tool-check --once --max-issues 1 2>&1 | tee hive_auto_fork.log || true\nif grep -qE \"(auto-fork|Auto-fork)\" hive_auto_fork.log; then\n  echo \"hive.mjs recognizes --auto-fork flag\"\nelse\n  echo \"Could not verify --auto-fork flag in hive output\"\nfi\n\necho \"\"\necho \"Testing deprecated start-screen.mjs accepts --auto-fork without opening a screen...\"\nNODE_BIN=\"${NODE_BIN:-$(command -v node)}\"\nNO_SCREEN_PATH=\"$(dirname \"${NODE_BIN}\")\"\nPATH=\"${NO_SCREEN_PATH}\" \"${NODE_BIN}\" ./src/start-screen.mjs solve https://github.com/test/repo/issues/1 --auto-fork --dry-run 2>&1 | tee start_screen_auto_fork.log || true\nif grep -qE \"(GNU Screen is not installed|screen.*not.*installed)\" start_screen_auto_fork.log && ! grep -q \"Unknown option\" start_screen_auto_fork.log; then\n  echo \"start-screen.mjs accepts --auto-fork flag without creating a legacy screen\"\nelse\n  echo \"Could not verify start-screen flag acceptance\"\nfi\n\necho \"\"\necho \"All --auto-fork option tests completed\"\n",
[2026-07-19T13:07:25.779Z] [INFO]     "userModified": false
[2026-07-19T13:07:25.779Z] [INFO]   }
[2026-07-19T13:07:25.779Z] [INFO] }
