t\t\t# Set the CurrentWeapon reference in C# Player\n01872| \t\t\tif _player.has_method(\"EquipWeapon\"):\n01873| \t\t\t\t_player.EquipWeapon(m16)\n01874| \t\t\telif _player.get(\"CurrentWeapon\") != null:\n01875| \t\t\t\t_player.CurrentWeapon = m16\n01876| \n01877| \t\t\t# Reduce M16 ammunition by half for Building level (issue #413)\n01878| \t\t\t# In Power Fantasy mode, apply ammo multiplier (issue #501)\n01879| \t\t\tvar base_magazines: int = 2\n01880| \t\t\tvar difficulty_manager: Node = get_node_or_null(\"/root/DifficultyManager\")\n01881| \t\t\tif difficulty_manager:\n01882| \t\t\t\tvar ammo_multiplier: int = difficulty_manager.get_ammo_multiplier()\n01883| \t\t\t\tif ammo_multiplier > 1:\n01884| \t\t\t\t\tbase_magazines *= ammo_multiplier\n01885| \t\t\t\t\tprint(\"BuildingLevel: Power Fantasy mode - M16 magazines multiplied by %dx\" % ammo_multiplier)\n01886| \t\t\tif m16.has_method(\"ReinitializeMagazines\"):\n01887| \t\t\t\tm16.ReinitializeMagazines(base_magazines, true)\n01888| \t\t\t\tprint(\"BuildingLevel: M16 magazines reinitialized to %d\" % base_magazines)\n01889| \n01890| \t\t\tprint(\"BuildingLevel: M16 Assault Rifle equipped successfully\")\n01891| \t\telse:\n01892| \t\t\tpush_error(\"BuildingLevel: Failed to load AssaultRifle scene!\")\n01893| \t# If AK + GL is selected, swap weapons\n01894| \telif selected_weapon_id == \"ak_gl\":\n01895| \t\t# Remove the default MakarovPM\n01896| \t\tvar makarov = _player.get_node_or_null(\"MakarovPM\")\n01897| \t\tif makarov:\n01898| \t\t\tmakarov.queue_free()\n01899| \t\t\tprint(\"BuildingLevel: Removed default MakarovPM\")\n01900| \n01901| \t\t# Load and add the AKGL\n01902| \t\tvar akgl_scene = load(\"res://scenes/weapons/csharp/AKGL.tscn\")\n01903| \t\tif akgl_scene:\n01904| \t\t\tvar akgl = akgl_scene.instantiate()\n01905| \t\t\takgl.name = \"AKGL\"\n01906| \t\t\t_player.add_child(akgl)\n01907| \n01908| \t\t\t# Set the CurrentWeapon reference in C# Player\n01909| \t\t\tif _player.has_method(\"EquipWeapon\"):\n01910| \t\t\t\t_player.EquipWeapon(akgl)\n01911| \t\t\telif _player.get(\"CurrentWeapon\") != null:\n01912| \t\t\t\t_player.CurrentWeapon = akgl\n01913| \n01914| \t\t\t# Reduce AKGL ammunition by half for Building level (Issue #949)\n01915| \t\t\t# Same as M16: base_magazines = 2 gives 30+30 ammo instead of 30+90\n01916| \t\t\t# In Power Fantasy mode, apply ammo multiplier\n01917| \t\t\tvar base_magazines: int = 2\n01918| \t\t\tvar difficulty_manager: Node = get_node_or_null(\"/root/DifficultyManager\")\n01919| \t\t\tif difficulty_manager:\n01920| \t\t\t\tvar ammo_multiplier: int = difficulty_manager.get_ammo_multiplier()\n01921| \t\t\t\tif ammo_multiplier > 1:\n01922| \t\t\t\t\tbase_magazines *= ammo_multiplier\n01923| \t\t\t\t\tprint(\"BuildingLevel: Power Fantasy mode - AKGL magazines multiplied by %dx\" % ammo_multiplier)\n01924| \t\t\tif akgl.has_method(\"ReinitializeMagazines\"):\n01925| \t\t\t\takgl.ReinitializeMagazines(base_magazines, true)\n01926| \t\t\t\tprint(\"BuildingLevel: AKGL magazines reinitialized to %d\" % base_magazines)\n01927| \n01928| \t\t\tprint(\"BuildingLevel: AK + GL equipped successfully\")\n01929| \t\telse:\n01930| \t\t\tpush_error(\"BuildingLevel: Failed to load AKGL scene!\")\n01931| \t# If Revolver is selected, swap weapons\n01932| \telif selected_weapon_id == \"revolver\":\n01933| \t\tvar makarov = _player.get_node_or_null(\"MakarovPM\")\n01934| \t\tif makarov:\n01935| \t\t\tmakarov.queue_free()\n01936| \t\t\tprint(\"BuildingLevel: Removed default MakarovPM\")\n01937| \n01938| \t\tvar revolver_scene = load(\"res://scenes/weapons/csharp/Revolver.tscn\")\n01939| \t\tif revolver_scene:\n01940| \t\t\tvar revolver = revolver_scene.instantiate()\n01941| \t\t\trevolver.name = \"Revolver\"\n01942| \t\t\t_player.add_child(revolver)\n01943| \n01944| \t\t\tif _player.has_method(\"EquipWeapon\"):\n01945| \t\t\t\t_player.EquipWeapon(revolver)\n01946| \t\t\telif _player.get(\"CurrentWeapon\") != null:\n01947| \t\t\t\t_player.CurrentWeapon = revolver\n01948| \n01949| \t\t\tprint(\"BuildingLevel: RSh-12 Revolver equipped successfully\")\n01950| \t\telse:\n01951| \t\t\tpush_error(\"BuildingLevel: Failed to load Revolver scene!\")\n01952| \t# For Makarov PM, it's already in the scene\n01953| \telse:\n01954| \t\tvar makarov = _player.get_node_or_null(\"MakarovPM\")\n01955| \t\tif makarov and _player.get(\"CurrentWeapon\") == null:\n01956| \t\t\tif _player.has_method(\"EquipWeapon\"):\n01957| \t\t\t\t_player.EquipWeapon(makarov)\n01958| \t\t\telif _player.get(\"CurrentWeapon\") != null:\n01959| \t\t\t\t_player.CurrentWeapon = makarov\n01960| \n01961| \t\t\t# Configure 2.5x ammo for MakarovPM (Issue #636)\n01962| \t\t\t_configure_makarov_pm_ammo(makarov)\n01963| \n01964| \n01965| ## Handle W key shortcut for Watch Replay when score is shown (Issue #807: check experimental setting).\n01966| func _unhandled_input(event: InputEvent) -> void:\n01967| \tif not _score_shown:\n01968| \t\treturn\n01969| \n01970| \tif event is InputEventKey and event.pressed and not event.echo:\n01971| \t\tif event.keycode == KEY_W:\n01972| \t\t\t# Issue #807: Only trigger replay if enabled in experimental settings\n01973| \t\t\tvar experimental_settings: Node = get_node_or_null(\"/root/ExperimentalSettings\")\n01974| \t\t\tif experimental_settings and experimental_settings.has_method(\"is_replay_enabled\") and experimental_settings.is_replay_enabled():\n01975| \t\t\t\t_on_watch_replay_pressed()\n01976| \n01977| \n01978| ## Called when the Watch Replay button is pressed (or W key).\n01979| func _on_watch_replay_pressed() -> void:\n01980| \t_log_to_file(\"Watch Replay triggered\")\n01981| \tvar replay_manager: Node = _get_or_create_replay_manager()\n01982| \tif replay_manager and replay_manager.has_method(\"HasReplay\") and replay_manager.HasReplay():\n01983| \t\tif replay_manager.has_method(\"StartPlayback\"):\n01984| \t\t\treplay_manager.StartPlayback(self)\n01985| \telse:\n01986| \t\t_log_to_file(\"Watch Replay: no replay data available\")\n01987| \n01988| \n01989| ## Called when the Restart button is pressed.\n01990| func _on_restart_pressed() -> void:\n01991| \t_log_to_file(\"Restart button pressed\")\n01992| \tif GameManager:\n01993| \t\tGameManager.restart_scene()\n01994| \telse:\n01995| \t\tget_tree().reload_current_scene()\n01996| \n01997| \n01998| ## Called when the Next Level button is pressed (Issue #568).\n01999| func _on_next_level_pressed(level_path: String) -> void:\n02000| \t_log_to_file(\"Next Level button pressed: %s\" % level_path)\n\n(File has more lines. Use 'offset' parameter to read beyond line 2000)\n</file>",
