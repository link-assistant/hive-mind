t isLocalScript = commandName.endsWith('.mjs');\\n00113|     const solveCommand = isLocalScript ? './solve.mjs' : 'solve';\\n00114|     // Repository-by-repository fallback lives in its own module so hive.mjs stays\\n00115|     // under the 1350-line early-warning threshold (issue #2175, warning from #1593).\\n00116|     // Issue #2615: queue + sub-issue/dependency relations gate, kept out of hive.mjs for line limits.\\n00117|     const { IssueQueue } = await import('./hive.issue-queue.lib.mjs');\\n00118|     const { createIssueRelationsGate, createIssueRelationsFetcher, createGhGraphQLRunner } = await import('./hive.issue-relations.lib.mjs');\\n00119|     const { githubLimits } = await import('./config.lib.mjs');\\n00120|     const repositoryFallbackLib = await import('./hive.repository-fallback.lib.mjs');\\n00121|     const runReport = new HiveRunReport();\\n00122|     const fetchIssuesFromRepositories = repositoryFallbackLib.createRepositoryIssueFetcher({ log, cleanErrorMessage, tryFetchIssuesWithGraphQL, execGhWithRetry, fetchAllIssuesWithPagination, reportError, onFetchError: error => runReport.recordError(error) });\\n00123|     // Configure command line arguments - GitHub URL as positional argument\\n00124|     const rawArgs = normalizeCliArgs(hideBin(process.argv));\\n00125|     // Use .parse() instead of .argv to ensure .strict() mode works correctly\\n00126|     // When you use .argv, strict mode doesn't trigger properly\\n00127|     // See: https://github.com/yargs/yargs/issues - .strict() only works with .parse()\\n00128|     let argv;\\n00129|     // Temporarily suppress stderr to prevent yargs from printing error messages\\n00130|     // We'll handle error reporting ourselves\\n00131|     const originalStderrWrite = process.stderr.write;\\n00132|     let stderrBuffer = '';\\n00133|     process.stderr.write = function (chunk, encoding, callback) {\\n00134|       // Capture stderr output instead of writing it\\n00135|       stderrBuffer += chunk.toString