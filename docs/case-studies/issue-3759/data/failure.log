nk is\n * one continuous line in its own colour. `code` is a network code such as\n * '00 11' (link 1 = (1: 0 0), link 2 = (2: 1 1)); 0 is the zero link.\n */\nexport default function Glyph({ code, size = 48, title = null, className = 'glyph' }) {\n  return (\n    <svg\n      className={className}\n      viewBox={`0 0 ${SIZE} ${SIZE}`}\n      width={size}\n      height={size}\n      role={title ? 'img' : undefined}\n      aria-label={title || undefined}\n      aria-hidden={title ? undefined : 'true'}\n    >\n      <g fill=\"none\" strokeWidth={STROKE} strokeLinecap=\"round\" strokeLinejoin=\"round\">\n        {glyphPaths(decode(code)).map(({ d, color }, i) => (\n          <path key={i} d={d} stroke={color} data-link={i + 1} />\n        ))}\n      </g>\n    </svg>\n  );\n}\n.stack__head p {\n  margin: 0;\n  font-size: 0.9rem;\n}\n\n.stack__index .chip {\n  text-decoration: none;\n}\n\n.stack__layer {\n  scroll-margin-top: 5rem;\n}\n\n/* ---------- Link symbols ---------- */\n\n.symbols__tabs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n  margin-bottom: 1rem;\n}\n\n.symbols__tabs .button {\n  gap: 0.5rem;\n}\n\n.symbols__tabs .button[aria-pressed='true'] {\n  border-color: var(--accent);\n  background: color-mix(in srgb, var(--accent) 18%, transparent);\n}\n\n.symbols__formula {\n  display: grid;\n  gap: 0.15rem;\n  margin: 0 0 1rem;\n}\n\n.symbols__formula dt {\n  color: var(--muted);\n  font-size: 0.68rem;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.symbols__formula dd {\n  margin: 0 0 0.35rem;\n}\n\n.symbols__legend {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.25rem 1rem;\n  font-size: 0.85rem;\n}\n\n/* The legend colours are inline styles (the dark-theme link colours of glyph.js). */\n.symbols__legend span:nth-child(1) {\n  color: var(--link-1) !important;\n}\n\n.symbols__legend span:nth-child(2) {\n  color: var(--link-2) !important;\n}\n\n.symbols__legend span:nth-child(3) {\n  color: var(--link-3) !important;\n}\n\n.symbols__legend span:nth-child(4) {\n  color: var(--link-4) !important;\n}\n\n.symbols__grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));\n  gap: 0.4rem;\n  margin: 0 0 1rem;\n  padding: 0;\n  list-style: none;\n}\n\n.symbols__grid li {\n  display: grid;\n  justify-items: center;\n  padding: 0.3rem 0.2rem 0.4rem;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: rgb(var(--panel-rgb) / calc(0.8 * var(--glass-level, 0.4)));\n  color: var(--accent);\n}\n\n.symbols__grid li:hover {\n  border-color: var(--accent);\n  color: var(--text);\n}\n\n.symbols__grid svg {\n  width: 64px;\n  height: 64px;\n}\n\n.symbols__grid span {\n  font-size: 0.6rem;\n  color: var(--muted);\n  white-space: nowrap;\n}\n\n/* ---------- Blog ---------- */\n\n.posts {\n  display: grid;\nsrc/skins.glass.css:54:      .symbols__grid li,\nsrc/skins.glass.css:94:      .symbols__grid li,\nsrc/skins.liquid.css:104:    .symbols__grid li,\nsrc/skins.liquid.css:152:    .symbols__grid li,\nsrc/skins.future.css:290:    .symbols__grid li,\nsrc/skins.future.css:358::root[data-skin-name='futuristic'] :is(.symbols__grid li, .theory__formulas li, .page-stats li) {",
