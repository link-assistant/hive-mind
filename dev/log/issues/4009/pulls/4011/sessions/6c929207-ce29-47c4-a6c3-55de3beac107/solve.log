te_regular_atomic(path, updated, identity, expected_sha=None):\n    if len(updated) > MAXIMUM_FILE_BYTES:\n        raise ValueError('\\''owned_write_limit'\\'')\n    temporary = root / ('\\''.formal-ai-source-'\\'' + secrets.token_hex(12))\n    try:\n        with open(temporary, '\\''xb'\\'') as stream:\n            if stream.write(updated) != len(updated):\n                raise OSError('\\''owned_write_incomplete'\\'')\n            if identity is not None:\n                os.fchmod(stream.fileno(), stat.S_IMODE(identity[4]))\n            stream.flush()\n            os.fsync(stream.fileno())\n        if identity is None:\n            if path.exists() or path.is_symlink():\n                raise ValueError('\\''owned_write_identity_changed'\\'')\n        else:\n            current_bytes, current_identity = read_regular(path, MAXIMUM_FILE_BYTES)\n            if identity != current_identity:\n                raise ValueError('\\''owned_write_identity_changed'\\'')\n            if expected_sha is not None and hashlib.sha256(current_bytes).hexdigest() != expected_sha:\n                raise ValueError('\\''owned_write_preimage_changed'\\'')\n        os.replace(temporary, path)\n    finally:\n        if temporary.exists():\n            temporary.unlink()\n\n\ndef placeholder_content_matches(data, issue, branch):\n    if not data:\n        return True\n    if not isinstance(issue, str) or not isinstance(branch, str) or len(data) > 1024:\n        return False\n    import re\n    import datetime\n    match = re.fullmatch(r'\\''# \\.gitkeep file auto-generated at ([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z) for PR creation at branch (issue-[1-9][0-9]*-[A-Za-z0-9-]+) for issue (https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*)'\\'', data.decode('\\''utf-8'\\'', '\\''strict'\\''))\n    if match is None or match[2] != branch or match[3] != issue:\n        return False\n    if not branch.startswith('\\''issue-'\\'' + issue.rsplit('\\''/'\\'', 1)[1] + '\\''-'\\''):\n        return False\n    try:\n        datetime.datetime.fromisoformat(match[1].replace('\\''Z'\\'', '\\''+00:00'\\''))\n    except ValueError:\n        return False\n    return True\n\nif len(plan['\\''files'\\'']) > 256 or len(plan['\\''outputs'\\'']) > 256:\n    raise ValueError('\\''hygiene_plan_limit'\\'')\noutputs = {}\nfor entry in plan['\\''outputs'\\'']:\n    outputs.setdefault(entry['\\''output'\\''], []).append(entry['\\''source'\\''])\nignored = []\nplaceholders = []\nfor value in plan['\\''files'\\'']:\n    path = owned_path(value)\n    if not path.exists():\n        if value in plan.get('\\''placeholders'\\'', []):\n            raise ValueError('\\''placeholder_disappeared'\\'')\n        continue\n    data, identity = read_regular(path, MAXIMUM_FILE_BYTES)\n    sources = outputs.get(value)\n    if value in plan.get('\\''placeholders'\\'', []):\n        if not placeholder_content_matches(data, plan.get('\\''placeholder-issue'\\''), plan.get('\\''placeholder-branch'\\'')) or not plan.get('\\''source-paths'\\''):\n            raise ValueError('\\''placeholder_content_changed'\\'')\n        if data.decode('\\''utf-8'\\'', '\\''strict'\\'') != plan.get('\\''placeholder-sources'\\'', {}).get(value):\n            raise ValueError('\\''placeholder_preimage_changed'\\'')\n        for source in plan['\\''source-paths'\\'']:\n            source_bytes, _ = read_regular(owned_path(source), MAXIMUM_FILE_BYTES)\n            if not source_bytes:\n                raise ValueError('\\''placeholder_missing_replacement_source'\\'')\n            source_bytes.decode('\\''utf-8'\\'', '\\''strict'\\'')\n        placeholders.append((path, identity, data))\n    elif sources is not None:\n        owners = [source for source in sources if source != value and owned_path(source).exists()]\n        if len(set(owners)) != 1:\n            raise ValueError('\\''missing_or_ambiguous_compiler_source_owner'\\'')\n        source_path = owned_path(owners[0