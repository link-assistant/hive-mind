rl":"https://api.github.com/users/konard/repos","events_url":"https://api.github.com/users/konard/events{/privacy}","received_events_url":"https://api.github.com/users/konard/received_events","type":"User","user_view_type":"public","site_admin":false},"active_lock_reason":null,"merged":false,"mergeable":true,"rebaseable":true,"mergeable_state":"unstable","merged_by":null,"comments":20,"review_comments":0,"maintainer_can_modify":false,"commits":18,"additions":6847,"deletions":125,"changed_files":85}{"url":"https://api.github.com/repos/link-foundation/meta-sovereign/issues/1","repository_url":"https://api.github.com/repos/link-foundation/meta-sovereign","labels_url":"https://api.github.com/repos/link-foundation/meta-sovereign/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/link-foundation/meta-sovereign/issues/1/comments","events_url":"https://api.github.com/repos/link-foundation/meta-sovereign/issues/1/events","html_url":"https://github.com/link-foundation/meta-sovereign/issues/1","id":4363467725,"node_id":"I_kwDOSRd4l88AAAABBBU7zQ","number":1,"title":"Prototype version 0.0.1","user":{"login":"konard","id":1431904,"node_id":"MDQ6VXNlcjE0MzE5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1431904?v=4","gravatar_id":"","url":"https://api.github.com/users/konard","html_url":"https://github.com/konard","followers_url":"https://api.github.com/users/konard/followers","following_url":"https://api.github.com/users/konard/following{/other_user}","gists_url":"https://api.github.com/users/konard/gists{/gist_id}","starred_url":"https://api.github.com/users/konard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/konard/subscriptions","organizations_url":"https://api.github.com/users/konard/orgs","repos_url":"https://api.github.com/users/konard/repos","events_url":"https://api.github.com/users/konard/events{/privacy}","received_events_url":"https://api.github.com/users/konard/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10836356173,"node_id":"LA_kwDOSRd4l88AAAACheWsTQ","url":"https://api.github.com/repos/link-foundation/meta-sovereign/labels/documentation","name":"documentation","color":"0075ca","default":true,"description":"Improvements or additions to documentation"},{"id":10836356184,"node_id":"LA_kwDOSRd4l88AAAACheWsWA","url":"https://api.github.com/repos/link-foundation/meta-sovereign/labels/enhancement","name":"enhancement","color":"a2eeef","default":true,"description":"New feature or request"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-05-01T07:59:27Z","updated_at":"2026-05-01T08:40:44Z","closed_at":null,"assignee":null,"author_association":"MEMBER","type":{"id":22969357,"node_id":"IT_kwDOCoAzvc4BXnwN","name":"Feature","description":"A request, idea, or new functionality","color":"blue","created_at":"2024-07-20T19:06:39Z","updated_at":"2024-10-08T23:47:30Z","is_enabled":true},"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Personal meta profile sovereign system, that is fully local, and respects users privacy and helps to actually own and control his data about his network of contacts, connections and partners.\n\nFeatures:\n- Import/export with unified database and external services (via API and bulk export archive files)\n- Import/export with unified database and .lino files\n- Unified database is stored as both in binary form and text form, for reliability and express export\n- Regular backups of unified database in archive target folder\n- Unified chat UI to support chats in all external services\n- Auto-completion in chat UI based on previous messages from yourself in history\n- Operator UI, that automatically switches between chats/contexts, allowing to focus on efficient manual processing of each unread message based on ideas from https://github.com/link-assistant/operator\n- Patterns editor - allow to automatically infer/constract/simplify/generalize regular expressions and PEGs to match multiple messages. User can use one or multiple messages, and fuzzy search to find candidates from the history, once found user can select to add them pattern to match wider range of messages.\n- Reply message variation group editor, we should use fuzzy search to extract typical replies to the same question or message from the history of own messages, user can add manually as many variations as he wants.\n- Automated scripts, that handle typical messages like hi/hello, thank you, and so on. UI should be similar to n8n, with dependencies between patterns and reply variations. That should visualize typical dialogs tree from history, so that user can configure how to automatically control multi stage conversations, when multiple questions need to be asked once previous answers are gotten. So routing talking, first contact, knowing each other can be automated. It should be run in fully automated more or semi automated mode. In semi automated mode user can see that system detected some condition it can react to, and either manually select reply variation or confirm random selections as it would in fully automated mode.\n- We should be able to use pattern matching on multiple messages, to scan conversations for personal private facts we got to know about each user, to help the user remember all facts where discussed in the each conversation without looking too much at it, saving time. All personal data captured from conversation automatically should be shown in form `question - answer`, for both sides you and your chat partner. For chats with multiple users we should be able to see what questions was answered by each chat participant.\n- CRM features like ability to see in one place what we know about our contacts/friends in one place, ability cross reference, intersect sets of chats, groups, communites, and facts to select target audience and send them all hi/hello or stickers, to start massive manual conversations with only relevant and target audience\n- Ability to search locally for people, communities, companies, messages, chats, with configurable parameters\n- Unified broadcasing UI to support public posting on walls/public posts in all services\n- Profile sync in all services\n- Resumes sync in all services\n- External services support: VK, Telegram, X, WhatsApp, Facebook, Linked-In, career.habr.com, hh.ru, superjob.ru\n- Fully open-source and public domain requiring no trust\n- Every function and feature should be importable as npm library\n- NPM library should contain CLI interface, and electron desktop interface, ability to start web server to connect to local storage\n- All clients should allow sync of the data between them using WebRTC mapped to localstorage or any configurable endpoint, if user wants to host it in the internet to simplify the access from small devices like mobile phones, with ability to work with full local database in personal cloud.\n- Docker microservice for WebRTC server and for web server.\n- We should be able to do universal Links access interface in both server and client. On client like web it should combine access to local cache of data, and direct server access. On server it should combine access to both read and write at the same time to binary storage (link-cli/doublets-rs) and text storage (links notation).\n- We should use JavaScript on server and client and all UI apps with React.js, with Rust + WebAssembly for heavy workloads.\n- We should also have a version of server and microservice fully written in only Rust, but as well in JavaScript.\n- Application should use all the best practices from https://developer.apple.com/design/human-interface-guidelines, https://design.google, and Microsoft design guildelines.\n- The code should be written in simple way with no premature optimizations \n- All code should be documented with automated API documentation generation\n- We should cover all tests fully with unit, integration, and e2e tests using http://github.com/link-foundation/browser-commander\n\nFor all data exchanges and local text data-source (we should prefer indented format to minimize brackets/parentheses):\n- https://github.com/link-foundation/links-notation\n- https://github.com/link-foundation/lino-objects-codec\n\nFor all binary data in mobile, web, desktop, and in CLI/service (if any packages are not ready yet, we can use dependencies on source code directly):\n- http://github.com/link-foundation/link-cli\n- http://github.com/linksplatform/doublets-rs\n- http://github.com/linksplatform/doublets-web\n\nFor CLI arguments and configuration:\n- https://github.com/link-foundation/lino-arguments\n\nFor cross-platform apps (iOS, Android, Electron):\n- http://github.com/deep-foundation/sdk\n\nWe should reuse all features from:\n- https://github.com/konard/broadcast\n- https://github.com/konard/vk-bot\n- https://github.com/konard/vk\n- https://github.com/konard/vk-export\n- https://github.com/konard/vk-browser\n- https://github.com/konard/telegram-bot\n- https://github.com/konard/follow\n- https://github.com/konard/github-pages-telegram-mini-app\n- https://github.com/konard/telegramify-markdown\n\nChat UI quality as in:\n- https://github.com/drklo/telegram\n- https://github.com/telegramdesktop/tdesktop\n\nAutomated messaging scripts network UI quality as in:\n- https://n8n.io\n\nUse all the best practices from CI/CD templates (check full file tree to compare for all GitHub workflow and CI/CD scripts file), if the same issue is found in template report issue also in templates:\n- https://github.com/link-foundation/js-ai-driven-development-pipeline-template\n- https://github.com/link-foundation/rust-ai-driven-development-pipeline-template\n\nWe should compare all files, so we don't have more CI/CD errors in the future and reuse all the best practices from these templates.\n\nWe need to collect data related about the issue to this repository, make sure we compile that data to `./docs/case-studies/issue-{id}` folder, and use it to do deep case study analysis (also make sure to search online for additional facts and data), list of each and all requirements from the issue, and propose possible solutions and solution plans for each requirement (we should also check known existing components/libraries, that solve similar problem or can help in solutions).\n\nPlease plan and execute everything in a single pull request, you have unlimited time and context, as context autocompacts and you can continue indefinetely, do as much as possible in one go, until it is each and every requirement fully addressed, and everything is totally done.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/link-foundation/meta-sovereign/issues/1/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/link-foundation/meta-sovereign/issues/1/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}{"id":1226274967,"node_id":"R_kgDOSRd4lw","name":"meta-sovereign","full_name":"link-foundation/meta-sovereign","private":false,"owner":{"login":"link-foundation","id":176174013,"node_id":"O_kgDOCoAzvQ","avatar_url":"https://avatars.githubusercontent.com/u/176174013?v=4","gravatar_id":"","url":"https://api.github.com/users/link-foundation","html_url":"https://github.com/link-foundation","followers_url":"https://api.github.com/users/link-foundation/followers","following_url":"https://api.github.com/users/link-foundation/following{/other_user}","gists_url":"https://api.github.com/users/link-foundation/gists{/gist_id}","starred_url":"https://api.github.com/users/link-foundation/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/link-foundation/subscriptions","organizations_url":"https://api.github.com/users/link-foundation/orgs","