[2026-04-14T07:54:43.470Z] [INFO]         "content": "1\t#!/usr/bin/env node\n2\t\n3\t/**\n4\t * Check for files exceeding the maximum allowed line count\n5\t * Exits with error code 1 if any files exceed the limit\n6\t *\n7\t * Uses link-foundation libraries:\n8\t * - use-m: Dynamic package loading without package.json dependencies\n9\t */\n10\t\n11\timport { readFileSync, readdirSync, statSync } from 'fs';\n12\timport { join, relative, extname } from 'path';\n13\t\n14\tconst MAX_LINES = 1000;\n15\tconst FILE_EXTENSIONS = ['.rs'];\n16\tconst EXCLUDE_PATTERNS = ['target', '.git', 'node_modules'];\n17\t\n18\t/**\n19\t * Check if a path should be excluded\n20\t * @param {string} path\n21\t * @returns {boolean}\n22\t */\n23\tfunction shouldExclude(path) {\n24\t  return EXCLUDE_PATTERNS.some((pattern) => path.includes(pattern));\n25\t}\n26\t\n27\t/**\n28\t * Recursively find all Rust files in a directory\n29\t * @param {string} directory\n30\t * @returns {string[]}\n31\t */\n32\tfunction findRustFiles(directory) {\n33\t  const files = [];\n34\t\n35\t  function walkDir(dir) {\n36\t    const entries = readdirSync(dir, { withFileTypes: true });\n37\t\n38\t    for (const entry of entries) {\n39\t      const fullPath = join(dir, entry.name);\n40\t\n41\t      if (shouldExclude(fullPath)) {\n42\t        continue;\n43\t      }\n44\t\n45\t      if (entry.isDirectory()) {\n46\t        walkDir(fullPath);\n47\t      } else if (entry.isFile() && FILE_EXTENSIONS.includes(extname(entry.name))) {\n48\t        files.push(fullPath);\n49\t      }\n50\t    }\n51\t  }\n52\t\n53\t  walkDir(directory);\n54\t  return files;\n55\t}\n56\t\n57\t/**\n58\t * Count lines in a file\n59\t * @param {string} filePath\n60\t * @returns {number}\n61\t */\n62\tfunction countLines(filePath) {\n63\t  const content = readFileSync(filePath, 'utf-8');\n64\t  return content.split('\\n').length;\n65\t}\n66\t\n67\ttry {\n68\t  const cwd = process.cwd();\n69\t  console.log(`\\nChecking Rust files for maximum ${MAX_LINES} lines...\\n`);\n70\t\n71\t  const files = findRustFiles(cwd);\n72\t  const violations = [];\n73\t\n74\t  for (const file of files) {\n75\t    const lineCount = countLines(file);\n76\t    if (lineCount > MAX_LINES) {\n77\t      violations.push({\n78\t        file: relative(cwd, file),\n79\t        lines: lineCount,\n80\t      });\n81\t    }\n82\t  }\n83\t\n84\t  if (violations.length === 0) {\n85\t    console.log('All files are within the line limit\\n');\n86\t    process.exit(0);\n87\t  } else {\n88\t    console.log('Found files exceeding the line limit:\\n');\n89\t    for (const violation of violations) {\n90\t      console.log(\n91\t        `  ${violation.file}: ${violation.lines} lines (exceeds ${MAX_LINES})`\n92\t      );\n93\t    }\n94\t    console.log(`\\nPlease refactor these files to be under ${MAX_LINES} lines\\n`);\n95\t    process.exit(1);\n96\t  }\n97\t} catch (error) {\n98\t  console.error('Error:', error.message);\n99\t  process.exit(1);\n100\t}\n101\t"
