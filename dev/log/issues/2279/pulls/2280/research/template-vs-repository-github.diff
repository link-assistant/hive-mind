+version: 2
+
+# Keep supported ecosystems in one reviewable update. The release workflow's
+# dependency-freshness job covers use-m pins and setup-action inputs that
+# Dependabot cannot update by itself.
+multi-ecosystem-groups:
+  all-dependencies:
+    schedule:
+      interval: daily
+
+updates:
+  - package-ecosystem: npm
+    directory: /
+    patterns: ['*']
+    multi-ecosystem-group: all-dependencies
+    # Issue #2264 requires the freshness gate and update PR to converge on the
+    # same newest release. GitHub otherwise delays version updates by 3 days.
+    cooldown:
+      exclude: ['*']
+
+  - package-ecosystem: github-actions
+    directory: /
+    patterns: ['*']
+    multi-ecosystem-group: all-dependencies
+    cooldown:
+      exclude: ['*']
+
+  - package-ecosystem: docker
+    directories:
+      - /
+      - /coolify
+      - /experiments/solve-dockerize
+    patterns: ['*']
+    multi-ecosystem-group: all-dependencies
+    cooldown:
+      exclude: ['*']
+
+  - package-ecosystem: docker-compose
+    directories:
+      - /
+      - /coolify
+    patterns: ['*']
+    multi-ecosystem-group: all-dependencies
+    cooldown:
+      exclude: ['*']
+
+  - package-ecosystem: helm
+    directory: /helm/hive-mind
+    patterns: ['*']
+    multi-ecosystem-group: all-dependencies
+    cooldown:
+      exclude: ['*']
diff -ruN /tmp/js-ai-driven-development-pipeline-template-2279/.github/workflows/cleanup-test-repos.yml .github/workflows/cleanup-test-repos.yml
--- /tmp/js-ai-driven-development-pipeline-template-2279/.github/workflows/cleanup-test-repos.yml	1970-01-01 00:00:00.000000000 +0000
+++ .github/workflows/cleanup-test-repos.yml	2026-09-21 07:03:34.029803181 +0000
@@ -0,0 +1,70 @@
+name: Cleanup Test Repositories
+
+on:
+  workflow_dispatch:
+    inputs:
+      dry_run:
+        description: 'Dry run mode - shows what would be deleted without actually deleting'
+        required: false
+        type: boolean
+        default: false
+
+# Least privilege by default (zizmor excessive-permissions): `read-all` also
+# grants read access to actions, packages, security events and more. This
+# workflow only needs to check out the repository; every deletion it performs
+# goes through TEST_GITHUB_USER_REPO_DELETION_TOKEN, not GITHUB_TOKEN.
+permissions:
+  contents: read
+
+env:
+  GIT_CONFIG_COUNT: '1'
+  GIT_CONFIG_KEY_0: init.defaultBranch
+  GIT_CONFIG_VALUE_0: main
+
+jobs:
+  cleanup:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    env:
+      GH_TOKEN: ${{ secrets.TEST_GITHUB_USER_REPO_DELETION_TOKEN }}
+
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v7
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v7
+        with:
+          node-version: 24.x
+
+      - name: Configure GitHub CLI authentication
+        run: |
+          echo "Checking GitHub authentication status..."
+          gh auth status
+          echo ""
+          echo "Refreshing GitHub token with delete_repo scope..."
+          gh auth refresh -h github.com -s delete_repo
+
+      - name: Run cleanup script
+        run: |
+          echo "Starting test repository cleanup..."
+          echo ""
+
+          if [ "${{ inputs.dry_run }}" = "true" ]; then
+            echo "Running in DRY RUN mode..."
+            ./cleanup-test-repos.mjs --skip-archived --dry-run
+          else
+            echo "Running in FORCE mode (will delete repositories)..."
+            ./cleanup-test-repos.mjs --skip-archived --force
+          fi
+
+      - name: Summary
+        if: always()
+        run: |
+          echo ""
+          echo "Cleanup workflow completed!"
+          if [ "${{ inputs.dry_run }}" = "true" ]; then
+            echo "Mode: DRY RUN (no repositories were deleted)"
+          else
+            echo "Mode: FORCE (repositories were deleted)"
+          fi
