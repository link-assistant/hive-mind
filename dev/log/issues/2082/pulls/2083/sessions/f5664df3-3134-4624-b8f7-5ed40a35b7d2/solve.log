e a previous attempt partially succeeded.');\n154\t\n155\t      // Check if the remote version is already the expected bump\n156\t      const remoteVersion = await getVersion('remote');\n157\t      console.log(`Remote version: ${remoteVersion}`);\n158\t\n159\t      // Check if there are changesets to process\n160\t      const changesetCount = countChangesets();\n161\t\n162\t      if (changesetCount === 0) {\n163\t        console.log('No changesets to process and remote has advanced.');\n164\t        console.log('Assuming version bump was already completed in a previous attempt.');\n165\t        setOutput('version_committed', 'false');\n166\t        setOutput('already_released', 'true');\n167\t        setOutput('new_version', remoteVersion);\n168\t        return;\n169\t      } else {\n170\t        console.log('Rebasing on remote main to incorporate changes...');\n171\t        await $`git rebase origin/main`;\n172\t      }\n173\t    }\n174\t\n175\t    // Get current version before bump\n176\t    const oldVersion = await getVersion();\n177\t    console.log(`Current version: ${oldVersion}`);\n178\t\n179\t    if (mode === 'instant') {\n180\t      console.log('Running instant version bump...');\n181\t      // Run instant version bump script\n182\t      // Rely on command-stream's auto-quoting for proper argument handling\n183\t      if (description) {\n184\t        await $`node scripts/instant-version-bump.mjs --bump-type ${bumpType} --description ${description}`;\n185\t      } else {\n186\t        await $`node scripts/instant-version-bump.mjs --bump-type ${bumpType}`;\n187\t      }\n188\t    } else {\n189\t      console.log('Running changeset version...');\n190\t      // Run changeset version to bump versions and update CHANGELOG\n191\t      await $`npm run changeset:version`;\n192\t\n193\t      // Synchronize package-lock.json to match updated package.json version\n194\t      console.log('Synchronizing package-lock.json...');\n195\t      await $`npm install --package-lock-only`;\n196\t    }\n197\t\n198\t    // Get new version after bump\n199\t    const newVersion = await getVersion();\n200\t    console.log(`New version: ${newVersion}`);\n201\t    setOutput('new_version', newVersion);\n202\t\n203\t    // Check if there are changes to commit\n204\t    const statusResult = await $`git status --porcelain`.run({ capture: true });\n205\t    const status = statusResult.stdout.trim();\n206\t\n207\t    if (status) {\n208\t      console.log('Changes detected, committing...');\n209\t\n210\t      // Stage all changes (package.json, package-lock.json, CHANGELOG.md, deleted changesets)\n211\t      await $`git add -A`;\n212\t\n213\t      // Commit with version number as message\n214\t      const commitMessage = newVersion;\n215\t      const escapedMessage = commitMessage.replace(/\"/g, '\\\\\"');\n216\t      await $`git commit -m \"${escapedMessage}\"`;\n217\t\n218\t      // Push directly to main\n219\t      await $`git push origin main`;\n220\t\n221\t      console.log('Version bump committed and pushed to main');\n222\t      setOutput('version_committed', 'true');\n223\t    } else {\n224\t      console.log('No changes to commit');\n225\t      setOutput('version_committed', 'false');\n226\t    }\n227\t  } catch (error) {\n228\t    console.error('Error:', error.message);\n229\t    process.exit(1);\n230\t  }\n231\t}\n232\t\n233\tmain();\n234\t"
