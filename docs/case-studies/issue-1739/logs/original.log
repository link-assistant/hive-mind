{
  "type": "user",
  "message": {
    "role": "user",
    "content": [
      {
        "tool_use_id": "toolu_015KYf9ZJn1x7H2TFntKvnK8",
        "type": "tool_result",
        "content": "1\t/**\n2\t * Local web server (R-F4) + universal links HTTP surface (R-F8) + UI (R-F1).\n3\t *\n4\t * Endpoints:\n5\t *   GET  /                       -> SPA shell (src/web/index.html)\n6\t *   GET  /app.js, /app.css       -> SPA assets\n7\t *   GET  /links                  -> list all links\n8\t *   GET  /links/:id              -> read one\n9\t *   PUT  /links                  -> upsert (body = link JSON)\n10\t *   DEL  /links/:id              -> delete\n11\t *   GET  /sources                -> list message-source adapters\n12\t *   GET  /api/contacts           -> contacts derived from messages\n13\t *   GET  /api/patterns           -> persisted patterns (id starts with `pattern:`)\n14\t *   POST /api/patterns/infer     -> { examples } -> { regex }\n15\t *   GET  /api/graphs             -> persisted automation graphs\n16\t *   PUT  /api/graphs             -> upsert graph (body = graph JSON)\n17\t *   GET  /api/status             -> store stats + verify diff count\n18\t *\n19\t * Implemented with Node's built-in `http` module to keep the dependency\n20\t * footprint at zero. The Docker images in `docker/` simply run\n21\t * `node bin/meta-sovereign serve`.\n22\t */\n23\t\n24\timport http from 'node:http';\n25\timport path from 'node:path';\n26\timport { promises as fs } from 'node:fs';\n27\timport { fileURLToPath } from 'node:url';\n28\timport {\n29\t  createDualStore,\n30\t  createLinoTextStore,\n31\t  createDoubletsStore,\n32\t} from '../storage/index.js';\n33\timport { listSources } from '../sources/index.js';\n34\timport { inferRegex, simplifyRegex } from '../patterns/index.js';\n35\t\n36\tconst here = path.dirname(fileURLToPath(import.meta.url));\n37\tconst webRoot = path.resolve(here, '..', 'web');\n38\t\n39\tconst MIME = {\n40\t  '.html': 'text/html; charset=utf-8',\n41\t  '.js': 'application/javascript; charset=utf-8',\n42\t  '.css': 'text/css; charset=utf-8',\n43\t  '.json': 'application/json; charset=utf-8',\n44\t  '.svg': 'image/svg+xml',\n45\t};\n46\t\n47\tconst json = (res, status, body) => {\n48\t  res.writeHead(status, { 'content-type': 'application/json' });\n49\t  res.end(JSON.stringify(body));\n50\t};\n51\t\n52\tconst readBody = (req) =>\n53\t  new Promise((resolve, reject) => {\n54\t    const chunks = [];\n55\t    req.on('data', (c) => chunks.push(c));\n56\t    req.on('end', () => {\n57\t      try {\n58\t        resolve(JSON.parse(Buffer.concat(chunks).toString('utf8') || '{}'));\n59\t      } catch (err) {\n60\t        reject(err);\n61\t      }\n62\t    });\n63\t    req.on('error', reject);\n64\t  });\n65\t\n66\tconst serveStatic = async (res, filePath) => {\n67\t  try {\n68\t    const buf = await fs.readFile(filePath);\n69\t    const ext = path.extname(filePath).toLowerCase();\n70\t    res.writeHead(200, {\n71\t      'content-type': MIME[ext] ?? 'application/octet-stream',\n72\t    });\n73\t    res.end(buf);\n74\t    return true;\n75\t  } catch {\n76\t    return false;\n77\t  }\n78\t};\n79\t\n80\tconst aggregateContacts = (links) => {\n81\t  const messages = links.filter((l) => l.id?.startsWith('msg:'));\n82\t  const byContact = new Map();\n83\t  for (const m of messages) {\n84\t    if (!m.sender) {\n85\t      continue;\n86\t    }\n87\t    const entry = byContact.get(m.sender) ?? {\n88\t      id: m.sender,\n89\t      networks: new Set(),\n90\t      messageCount: 0,\n91\t    };\n92\t    entry.networks.add(m.source);\n93\t    entry.messageCount += 1;\n94\t    byContact.set(m.sender, entry);\n95\t  }\n96\t  return [...byContact.values()].map((c) => ({\n97\t    ...c,\n98\t    networks: [...c.networks],\n99\t  }));\n100\t};\n101\t\n102\tconst handleStatic = async (req, res, p) => {\n103\t  if (req.method !== 'GET') {\n104\t    return false;\n105\t  }\n106\t  if (p === '/' || p === '/index.html') {\n107\t    return serveStatic(res, path.join(webRoot, 'index.html'));\n108\t  }\n109\t  if (/^\\/[a-zA-Z0-9._-]+\\.(js|css|svg)$/.test(p)) {\n110\t    return serveStatic(res, path.join(webRoot, p.slice(1)));\n111\t  }\n112\t  return false;\n113\t};\n114\t\n115\tconst handleLinks = async (store, req, res, p) => {\n116\t  if (p === '/links' && req.method === 'GET') {\n117\t    json(res, 200, await store.query());\n118\t    return true;\n119\t  }\n120\t  if (p === '/links' && req.method === 'PUT') {\n121\t    const link = await readBody(req);\n122\t    await store.put(link);\n123\t    json(res, 200, link);\n124\t    return true;\n125\t  }\n126\t  const m = p.match(/^\\/links\\/(.+)$/);\n127\t  if (m && req.method === 'GET') {\n128\t    const link = await store.get(decodeURIComponent(m[1]));\n129\t    link ? json(res, 200, link) : json(res, 404, { error: 'not found' });\n130\t    return true;\n131\t  }\n132\t  if (m && req.method === 'DELETE') {\n133\t    const ok = await store.delete(decodeURIComponent(m[1]));\n134\t    json(res, ok ? 200 : 404, { ok });\n135\t    return true;\n136\t  }\n137\t  return false;\n138\t};\n139\t\n140\tconst handlePatterns = async (store, req, res, p) => {\n141\t  if (p === '/api/patterns' && req.method === 'GET') {\n142\t    const all = await store.query();\n143\t    json(\n144\t      res,\n145\t      200,\n146\t      all.filter((l) => l.id?.startsWith('pattern:'))\n147\t    );\n148\t    return true;\n149\t  }\n150\t  if (p === '/api/patterns/infer' && req.method === 'POST') {\n151\t    const { examples } = await readBody(req);\n152\t    const regex = simplifyRegex(inferRegex(examples ?? []));\n153\t    json(res, 200, { regex: regex.source, flags: regex.flags });\n154\t    return true;\n155\t  }\n156\t  return false;\n157\t};\n158\t\n159\tconst handleGraphs = async (store, req, res, p) => {\n160\t  if (p === '/api/graphs' && req.method === 'GET') {\n161\t    const all = await store.query();\n162\t    json(\n163\t      res,\n164\t      200,\n165\t      all.filter((l) => l.id?.startsWith('graph:'))\n166\t    );\n167\t    return true;\n168\t  }\n169\t  if (p === '/api/graphs' && req.method === 'PUT') {\n170\t    const graph = await readBody(req);\n171\t    if (!graph.id?.startsWith('graph:')) {\n172\t      json(res, 400, { error: 'graph.id must start with \"graph:\"' });\n173\t      return true;\n174\t    }\n175\t    await store.put(graph);\n176\t    json(res, 200, graph);\n177\t    return true;\n178\t  }\n179\t  return false;\n180\t};\n181\t\n182\tconst handleStatus = async (store, res) => {\n183\t  const all = await store.query();\n184\t  const diffs = (await store.verify?.()) ?? [];\n185\t  json(res, 200, {\n186\t    links: all.length,\n187\t    messages: all.filter((l) => l.id?.startsWith('msg:')).length,\n188\t    patterns: all.filter((l) => l.id?.startsWith('pattern:')).length,\n189\t    graphs: all.filter((l) => l.id?.startsWith('graph:')).length,\n190\t    verifyDiffs: diffs.length,\n191\t  });\n192\t};\n193\t\n194\tconst route = async (store, req, res) => {\n195\t  const url = new URL(req.url, 'http://localhost');\n196\t  const p = url.pathname;\n197\t\n198\t  if (await handleStatic(req, res, p)) {\n199\t    return;\n200\t  }\n201\t  if (p === '/sources' && req.method === 'GET') {\n202\t    return json(res, 200, listSources());\n203\t  }\n204\t  if (await handleLinks(store, req, res, p)) {\n205\t    return;\n206\t  }\n207\t  if (p === '/api/contacts' && req.method === 'GET') {\n208\t    return json(res, 200, aggregateContacts(await store.query()));\n209\t  }\n210\t  if (await handlePatterns(store, req, res, p)) {\n211\t    return;\n212\t  }\n213\t  if (await handleGraphs(store, req, res, p)) {\n214\t    return;\n215\t  }\n216\t  if (p === '/api/status' && req.method === 'GET') {\n217\t    return handleStatus(store, res);\n218\t  }\n219\t  return json(res, 404, { error: 'unknown route' });\n220\t};\n221\t\n222\texport const startServer = async ({\n223\t  port = 0,\n224\t  storeDir = '.meta-sovereign',\n225\t  store: providedStore,\n226\t} = {}) => {\n227\t  let store = providedStore;\n228\t  if (!store) {\n229\t    await fs.mkdir(storeDir, { recursive: true });\n230\t    const text = await createLinoTextStore(path.join(storeDir, 'data.lino'));\n231\t    const binary = await createDoubletsStore(path.join(storeDir, 'data.bin'));\n232\t    store = createDualStore({ binary, text });\n233\t  }\n234\t\n235\t  const server = http.createServer((req, res) => {\n236\t    route(store, req, res).catch((err) =>\n237\t      json(res, 500, { error: err.message })\n238\t    );\n239\t  });\n240\t  await new Promise((resolve) => server.listen(port, '127.0.0.1', resolve));\n241\t  const actualPort = server.address().port;\n242\t  return {\n243\t    port: actualPort,\n244\t    store,\n245\t    close: () =>\n246\t      new Promise((resolve) => {\n247\t        server.close(() => resolve());\n248\t      }),\n249\t  };\n250\t};\n251\t"
      }
    ]
  },
