ts(index))\n254\t    }\n255\t\n256\t    fn get_link(&self, index: T) -> Option<Link<T>>;\n257\t\n258\t    fn delete_all(&mut self) -> Result<(), Error<T>>\n259\t    where\n260\t        Self: Sized,\n261\t    {\n262\t        // delete all links while self.count() != T::funty(0)\n263\t        let mut count = self.count();\n264\t        while count != T::funty(0) {\n265\t            self.delete(count)?;\n266\t            count = self.count();\n267\t        }\n268\t        Ok(())\n269\t    }\n270\t\n271\t    fn delete_query_with<F, R>(\n272\t        &mut self,\n273\t        query: impl ToQuery<T>,\n274\t        handler: F,\n275\t    ) -> Result<(), Error<T>>\n276\t    where\n277\t        F: FnMut(Link<T>, Link<T>) -> R,\n278\t        R: Try<Output = ()>,\n279\t        Self: Sized,\n280\t    {\n281\t        let query = query.to_query();\n282\t        let len = self.count_by(query.to_query()).as_usize();\n283\t        let mut vec = Vec::with_capacity(len);\n284\t\n285\t        self.each_by(query, |link| {\n286\t            vec.push(link.index);\n287\t            Flow::Continue\n288\t        });\n289\t\n290\t        let mut handler = Fuse::new(handler);\n291\t        for index in vec.into_iter().rev() {\n292\t            self.delete_with(index, &mut handler)?;\n293\t        }\n294\t        Ok(())\n295\t    }\n296\t\n297\t    fn delete_usages_with<F, R>(&mut self, index: T, handler: F) -> Result<(), Error<T>>\n298\t    where\n299\t        F: FnMut(Link<T>, Link<T>) -> R,\n300\t        R: Try<Output = ()>,\n301\t        Self: Sized,\n302\t    {\n303\t        let any = self.constants().any;\n304\t        let mut to_delete = Vec::with_capacity(\n305\t            self.count_by([any, index, any]).as_usize()\n306\t                + self.count_by([any, any, index]).as_usize(),\n307\t        );\n308\t        self.each_by([any, index, any], |link| {\n309\t            if link.index != index {\n310\t                to_delete.push(link.index);\n311\t            }\n312\t            Flow