\n  gap: 0.25rem;\n}\n\n.notation label {\n  color: var(--text-2);\n  font-size: 0.85rem;\n}\n\n.notation input,\n.notation textarea,\n.looks input,\n.network-share__url input {\n  width: 100%;\n  min-width: 0;\n  box-sizing: border-box;\n  padding: 0.45rem 0.6rem;\n  border: 1px solid var(--border-strong);\n  border-radius: 8px;\n  background: var(--surface);\n  color: var(--text);\n  font: inherit;\n  font-size: 0.95rem;\n}\n\n.notation textarea {\n  resize: vertical;\n}\n\n.notation input:focus-visible,\n.notation textarea:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 1px;\n}\n\n.notation.is-invalid input,\n.notation.is-invalid textarea {\n  border-color: var(--accent-3);\n}\n\n.notation__hint {\n  color: var(--muted);\n  font-size: 0.78rem;\n}\n\n.notation__error {\n  color: var(--accent-3);\n  font-size: 0.8rem;\n}\n\n/* ---------- Links one by one ---------- */\n\n.links-table__scroll {\n  overflow-x: auto;\n}\n\n.links-table table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 0.85rem;\n}\n\n.links-table th,\n.links-table td {\n  padding: 0.3rem 0.35rem;\n  border-top: 1px solid var(--border);\n  text-align: left;\n  white-space: nowrap;\n}\n\n.links-table thead th {\n  border-top: 0;\n  color: var(--text-2);\n  font-weight: 500;\n}\n\n.links-table__swatch {\n  display: inline-block;\n  width: 0.7rem;\n  height: 0.7rem;\n  margin-right: 0.4rem;\n  border-radius: 50%;\n  vertical-align: -0.05em;\n}\n\n.links-table select,\n.links-table input[type='number'] {\n  padding: 0.25rem 0.35rem;\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  background: var(--surface);\n  color: var(--text);\n  font: inherit;\n}\n\n.links-table input[type='number'] {\n  width: 4.2rem;\n}\n\n.links-table input[type='color'] {\n  width: 2.2rem;\n  height: 1.6rem;\n  padding: 0;\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  background: none;\n}\n\n/* ---------- Looks and options of the picture ---------- */\n\n.looks {\n  display: grid;\n  gap: 0.8rem;\n  margin-top: 1.2rem;\n}\n\n.looks__row,\n.looks__saved,\n.looks__list {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.4rem;\n}\n\n.looks__saved input {\n  width: auto;\n  flex: 0 1 16rem;\n}\n\n.looks__size select {\n  padding: 0.3rem 0.5rem;\n  border: 1px solid var(--border-strong);\n  border-radius: 8px;\n  background: var(--surface);\n  color: var(--text);\n  font: inherit;\n}\n\n.looks__list {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.looks__list li {\n  display: flex;\n  align-items: center;\n  gap: 0.2rem;\n}\n\n.network__styles {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));\n  align-items: start;\n  gap: 1rem;\n  margin-top: 1.2rem;\n}\n\n/* A text option takes the place of a select. */\n.setting__input input[type='text'] {\n  flex: 1;\n  min-width: 0;\n  padding: 0.35rem 0.5rem;\n  border: 1px solid var(--border-strong);\n  border-radius: 8px;\n  background: var(--surface);\n  color: var(--text);\n  font: inherit;\n}\n\n/* ---------- Save and share ---------- */\n\n.network-share {\n  display: grid;\n  gap: 0.2rem;\n}\n\n.network-share .network__actions:first-child {\n  margin-top: 0;\n}\n\n.network-share .muted {\n  margin: 0.5rem 0 0;\n  font-size: 0.82rem;\n}\n\n.network-share__url {\n  display: grid;\n  gap: 0.25rem;\n  margin: 0.8rem 0 0;\n  font-size: 0.85rem;\n  color: var(--text-2);\n}\n\n.network-share__targets {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.35rem;\n  margin: 0.8rem 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.network-share__status {\n  min-height: 1.2em;\n  margin: 0.4rem 0 0;\n  color: var(--accent);\n  font-size: 0.85rem;\n}\n\n@media (max-width: 900px) {\n  .network__layout {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  /* On a narrow screen the picture is a small sticky strip above the editors. */\n  .network__view {\n    position: static;\n  }\n\n  .network__preview {\n    max-width: 28rem;\n    margin: 0 auto;\n  }\n}\n"
