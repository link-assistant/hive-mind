        "content": "1\t// meta-sovereign web UI — minimal SPA backed by the local HTTP server.\n2\t// All state lives in the local store (R-A2/A3); this client is a thin view.\n3\t\n4\tconst root = document.getElementById('root');\n5\tconst nav = document.querySelector('.topbar nav');\n6\t\n7\tconst api = {\n8\t  links: () => fetch('/links').then((r) => r.json()),\n9\t  put: (link) =>\n10\t    fetch('/links', {\n11\t      method: 'PUT',\n12\t      headers: { 'content-type': 'application/json' },\n13\t      body: JSON.stringify(link),\n14\t    }).then((r) => r.json()),\n15\t  del: (id) =>\n16\t    fetch(`/links/${encodeURIComponent(id)}`, { method: 'DELETE' }).then((r) =>\n17\t      r.json()\n18\t    ),\n19\t  sources: () => fetch('/sources').then((r) => r.json()),\n20\t  contacts: () => fetch('/api/contacts').then((r) => r.json()),\n21\t  patterns: () => fetch('/api/patterns').then((r) => r.json()),\n22\t  inferRegex: (examples) =>\n23\t    fetch('/api/patterns/infer', {\n24\t      method: 'POST',\n25\t      headers: { 'content-type': 'application/json' },\n26\t      body: JSON.stringify({ examples }),\n27\t    }).then((r) => r.json()),\n28\t  graphs: () => fetch('/api/graphs').then((r) => r.json()),\n29\t  saveGraph: (g) =>\n30\t    fetch('/api/graphs', {\n31\t      method: 'PUT',\n32\t      headers: { 'content-type': 'application/json' },\n33\t      body: JSON.stringify(g),\n34\t    }).then((r) => r.json()),\n35\t  status: () => fetch('/api/status').then((r) => r.json()),\n36\t};\n37\t\n38\tconst h = (tag, attrs = {}, children = []) => {\n39\t  const el = document.createElement(tag);\n40\t  for (const [k, v] of Object.entries(attrs)) {\n41\t    if (k === 'on') {\n42\t      for (const [evt, fn] of Object.entries(v)) {\n43\t        el.addEventListener(evt, fn);\n44\t      }\n45\t    } else if (k === 'class') {\n46\t      el.className = v;\n47\t    } else if (v !== false && v !== null && v !== undefined) {\n48\t      el.setAttribute(k, v);\n49\t    }\n50\t  }\n51\t  for (const c of [].concat(children)) {\n52\t    if (c === null || c === undefined) {\n53\t      continue;\n54\t    }\n55\t    el.append(typeof c === 'string' ? document.createTextNode(c) : c);\n56\t  }\n57\t  return el;\n58\t};\n59\t\n60\tconst views = {\n61\t  async chat() {\n62\t    const links = await api.links();\n63\t    const messages = links.filter((l) => l.id?.startsWith('msg:'));\n64\t    const chats = [...new Set(messages.map((m) => `${m.source}:${m.chat}`))];\n65\t    let active = chats[0];\n66\t\n67\t    const wrap = h('div', { class: 'chat' });\n68\t    const aside = h('aside', {}, [\n69\t      h('div', { style: 'padding: 0.4rem; opacity: 0.7' }, 'Chats'),\n70\t      ...chats.map((c) =>\n71\t        h(\n72\t          'button',\n73\t          {\n74\t            class: c === active ? 'active' : '',\n75\t            on: {\n76\t              click: () => {\n77\t                active = c;\n78\t                render();\n79\t              },\n80\t            },\n81\t          },\n82\t          c\n83\t        )\n84\t      ),\n85\t    ]);\n86\t    const stream = h('div', { class: 'stream' });\n87\t    wrap.append(aside, stream);\n88\t\n89\t    const render = () => {\n90\t      stream.innerHTML = '';\n91\t      for (const m of messages.filter(\n92\t        (m) => `${m.source}:${m.chat}` === active\n93\t      )) {\n94\t        stream.append(\n95\t          h('div', { class: 'msg' }, [\n96\t            h('div', { class: 'meta' }, `${m.sender} • ${m.timestamp ?? ''}`),\n97\t            h('div', {}, m.body ?? ''),\n98\t          ])\n99\t        );\n100\t      }\n101\t    };\n102\t    render();\n103\t    return wrap;\n104\t  },\n105\t\n106\t  async contacts() {\n107\t    const contacts = await api.contacts();\n108\t    return h('div', {}, [\n109\t      h('h2', {}, 'Contacts'),\n110\t      h('table', {}, [\n111\t        h('thead', {}, [\n112\t          h('tr', {}, [\n113\t            h('th', {}, 'Identity'),\n114\t            h('th', {}, 'Networks'),\n115\t          