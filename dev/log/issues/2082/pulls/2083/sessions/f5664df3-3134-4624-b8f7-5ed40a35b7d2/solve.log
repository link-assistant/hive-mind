[2026-07-19T12:50:49.076Z] [INFO]         "content": "160\trunTest('Issue #1571: autoContinueWhenLimitResets should await child exit (never return early)', async () => {\n161\t  // This test verifies the concept that the function should block until child exits\n162\t  // In practice, the function calls process.exit() via child.on('close'),\n163\t  // so it never returns to the caller.\n164\t  //\n165\t  // We simulate this by checking that the await on the close event properly blocks:\n166\t  let functionReturned = false;\n167\t  let childExited = false;\n168\t\n169\t  // Simulate the awaited promise pattern\n170\t  const promise = new Promise(resolve => {\n171\t    // Simulate child.on('close', ...)\n172\t    setTimeout(() => {\n173\t      childExited = true;\n174\t      // In real code: process.exit(code); resolve();\n175\t      resolve();\n176\t    }, 10);\n177\t  });\n178\t\n179\t  // Before the promise resolves, functionReturned should still be false\n180\t  const checker = new Promise(resolve => {\n181\t    setTimeout(() => {\n182\t      // At 5ms, the child hasn't exited yet\n183\t      assertFalse(childExited, 'Child should not have exited yet at 5ms');\n184\t      assertFalse(functionReturned, 'Function should not have returned yet');\n185\t      resolve();\n186\t    }, 5);\n187\t  });\n188\t\n189\t  await checker;\n190\t  await promise;\n191\t  functionReturned = true;\n192\t\n193\t  assertTrue(childExited, 'Child should have exited');\n194\t  assertTrue(functionReturned, 'Function should have returned after child exited');\n195\t});\n196\t\n197\t// === Summary ===\n198\t\n199\tconsole.log('\\n' + '='.repeat(60));"
[2026-07-19T12:50:49.076Z] [INFO]       }
