  }\n114\t    unsafe {\n115\t        let link_base_part = this.get_base_part(link);\n116\t        if link_base_part > base {\n117\t            each_usages_core(this, base, this.get_left_or_default(link), handler)?;\n118\t        } else if link_base_part < base {\n119\t            each_usages_core(this, base, this.get_right_or_default(link), handler)?;\n120\t        } else {\n121\t            handler(this.get_link_value(link))?;\n122\t            each_usages_core(this, base, this.get_left_or_default(link), handler)?;\n123\t            each_usages_core(this, base, this.get_right_or_default(link), handler)?;\n124\t        }\n125\t    }\n126\t    Flow::Continue\n127\t}\n128\t\n129\timpl<T: LinkType> LinksTree<T> for LinksTargetsRecursionlessSizeBalancedTree<T> {\n130\t    fn count_usages(&self, link: T) -> T {\n131\t        unsafe {\n132\t            let mut root = self.get_tree_root();\n133\t            let total = self.get_size(root);\n134\t            let mut total_right_ignore = T::funty(0);\n135\t            while root != T::funty(0) {\n136\t                let base = self.get_base_part(root);\n137\t                if base <= link {\n138\t                    root = self.get_right_or_default(root);\n139\t                } else {\n140\t                    total_right_ignore += self.get_right_size(root) + T::funty(1);\n141\t                    root = self.get_left_or_default(root);\n142\t                }\n143\t            }\n144\t            root = self.get_tree_root();\n145\t            let mut total_left_ignore = T::funty(0);\n146\t            while root != T::funty(0) {\n147\t                let base = self.get_base_part(root);\n148\t                if base >= link {\n149\t                    root = self.get_left_or_default(root);\n150\t                } else {\n151\t                    total_left_ignore += self.get_left_size(root) + T::funty(1);\n152\t                    root = self.get_right_or_default(root);\n153\t                }\n154\t            }\n155\t            total - total_right_ignore - total_left_ignore\n156\t        }\n157\t    }\n158\t\n159\t    fn search(&self, source: T, target: T) -> T {\n160\t        unsafe {\n161\t            let mut root = self.get_tree_root();\n162\t            while root != T::funty(0) {\n163\t                let root_link = self.get_link(root);\n164\t                let root_source = root_link.source;\n165\t                let root_target = root_link.target;\n166\t                if self.first_is_to_the_left_of_second_4(source, target, root_source, root_target) {\n167\t                    root = self.get_left_or_default(root);\n168\t                } else if self.first_is_to_the_right_of_second_4(\n169\t                    source,\n170\t                    target,\n171\t                    root_source,\n172\t                    root_target,\n173\t                ) {\n174\t                    root = self.get_right_or_default(root);\n175\t                } else {\n176\t                    return root;\n177\t                }\n178\t            }\n179\t            T::funty(0)\n180\t        }\n181\t    }\n182\t\n183\t    fn each_usages<H: FnMut(Link<T>) -> Flow + ?Sized>(&self, root: T, handler: &mut H) -> Flow {\n184\t        each_usages_core(self, root, self.get_tree_root(), handler)\n185\t    }\n186\t\n187\t    fn detach(&mut self, root: &mut T, index: T) {\n188\t        unsafe { NoRecurSzbTree::detach(self, root as *mut _, index) }\n189\t    }\n190\t\n191\t    fn attach(&mut self, root: &mut T, index: T) {\n192\t        unsafe { NoRecurSzbTree::attach(self, root as *mut _, index) }\n193\t    }\n194\t}\n195\t\n196\timpl<T: LinkType> UnitUpdateMem<T> for LinksTargetsRecursionlessSizeBalancedTree<T> {\n197\t    fn update_mem(&mut self, mem: NonNull<[LinkPart<T>]>) {\n198\t        self.base.mem = mem;\n199\t    }\n200\t}\n201\t\n202\timpl<T: LinkType> LinkRecursionlessSizeBalancedTreeBaseAbstract<T>\n203\t    for LinksTargetsRecursionlessSizeBalancedTree<T>\n204\t{\n205\t    fn get_heade