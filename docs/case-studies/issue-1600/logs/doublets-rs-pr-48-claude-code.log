\t        self.each_core(handler, &query.to_query()[..])\n467\t    }\n468\t\n469\t    fn update_links(\n470\t        &mut self,\n471\t        query: &[T],\n472\t        change: &[T],\n473\t        handler: WriteHandler<'_, T>,\n474\t    ) -> Result<Flow, LinksError<T>> {\n475\t        let index = query[0];\n476\t        let source = change[1];\n477\t        let target = change[2];\n478\t        let old_source = source;\n479\t        let old_target = target;\n480\t\n481\t        let link = self.try_get_link(index)?;\n482\t\n483\t        if link.source != T::funty(0) {\n484\t            // SAFETY: Here index detach from sources\n485\t            // by default source is zero\n486\t            unsafe {\n487\t                self.detach_source(index);\n488\t            }\n489\t        }\n490\t        if link.target != T::funty(0) {\n491\t            // SAFETY: Here index detach from targets\n492\t            // by default target is zero\n493\t            unsafe {\n494\t                self.detach_target(index);\n495\t            }\n496\t        }\n497\t\n498\t        let place = self.mut_link_part(index);\n499\t        place.source = source;\n500\t        place.target = target;\n501\t        let place = place.clone();\n502\t\n503\t        if place.source != T::funty(0) {\n504\t            // SAFETY: Here index attach to sources\n505\t            unsafe {\n506\t                self.attach_source(index);\n507\t            }\n508\t        }\n509\t        if place.target != T::funty(0) {\n510\t            // SAFETY: Here index attach to targets\n511\t            unsafe {\n512\t                self.attach_target(index);\n513\t            }\n514\t        }\n515\t\n516\t        Ok(handler(\n517\t            Link::new(index, old_source, old_target),\n518\t            Link::new(index, source, target),\n519\t        ))\n520\t    }\n521\t\n522\t    fn delete_links(\n523\t        &mut self,\n524\t        query: &[T],\n525\t        handler: WriteHandler<'_, T>,\n526\t    ) -> Result<