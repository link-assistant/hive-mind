[2026-10-24T15:04:12.303Z] [INFO]                 " // they meet, and the finished drawing is scaled into a SIZE × SIZE box.",
[2026-10-24T15:04:12.303Z] [INFO]                 "+//",
[2026-10-24T15:04:12.303Z] [INFO]                 "+// Every number of the drawing is a `shape` option (issue #17), so the editor",
[2026-10-24T15:04:12.303Z] [INFO]                 "+// of /network/ can change the angle at which a link comes to another link,",
[2026-10-24T15:04:12.303Z] [INFO]                 "+// the shapes of its start, end and middle, and turn each end on its own. The",
[2026-10-24T15:04:12.303Z] [INFO]                 "+// defaults in SHAPE draw exactly the symbols of the gallery and the rain.",
[2026-10-24T15:04:12.303Z] [INFO]                 " ",
[2026-10-24T15:04:12.303Z] [INFO]                 " export const SIZE = 100;",
[2026-10-24T15:04:12.303Z] [INFO]                 " export const STROKE = 2.4;",
[2026-10-24T15:04:12.303Z] [INFO]                 "-/** One colour per real link: link 1, 2, 3, 4. */",
[2026-10-24T15:04:12.303Z] [INFO]                 "-export const COLORS = ['#22d3ee', '#c084fc', '#f472b6', '#facc15'];",
[2026-10-24T15:04:12.303Z] [INFO]                 "+/** The most links a symbol draws: a code has one digit per reference, so its base n + 1 is at most 10. */",
