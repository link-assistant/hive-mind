               // header.reserved = T::try_from(reserved / Self::DATA_SIZE).unwrap()\n719\t                header.reserved = T::try_from(reserved).expect(\"always ok\");\n720\t            }\n721\t            let header = self.mut_header();\n722\t            header.allocated += T::funty(1);\n723\t            free = header.allocated;\n724\t        } else {\n725\t            self.unused.detach(free);\n726\t        }\n727\t\n728\t        self.resolve_danglind_external(free);\n729\t\n730\t        Ok(handler(\n731\t            Link::nothing(),\n732\t            Link::new(free, T::funty(0), T::funty(0)),\n733\t        ))\n734\t    }\n735\t\n736\t    fn each_links(&self, query: &[T], handler: ReadHandler<'_, T>) -> Flow {\n737\t        self.try_each_by_core(handler, query)\n738\t    }\n739\t\n740\t    fn update_links(\n741\t        &mut self,\n742\t        query: &[T],\n743\t        change: &[T],\n744\t        handler: WriteHandler<'_, T>,\n745\t    ) -> Result<Flow, LinksError<T>> {\n746\t        let index = query[0];\n747\t        let new_source = change[1];\n748\t        let new_target = change[2];\n749\t\n750\t        let link = self.try_get_link(index)?;\n751\t\n752\t        if link.source != T::funty(0) {\n753\t            // SAFETY: Here index attach to source\n754\t            unsafe {\n755\t                if self.is_virtual(link.source) {\n756\t                    self.detach_external_source(index);\n757\t                } else if Self::USE_LIST {\n758\t                    // self.sources_list.attach_as_last(source, index);\n759\t                    todo!()\n760\t                } else {\n761\t                    self.detach_internal_source(link.source, index);\n762\t                }\n763\t            }\n764\t        }\n765\t\n766\t        if link.target != T::funty(0) {\n767\t            // SAFETY: Here index attach to target\n768\t            unsafe {\n769\t                if self.is_virtual(link.target) {\n770\t                    self.detach_external_target(index);\n771\t                } else {\n772\t                    self.detach_internal_target(link.target, index);\n773\t                }\n774\t            }\n775\t        }\n776\t\n777\t        let virtual_source = self.is_virtual(new_source);\n778\t        let virtual_target = self.is_virtual(new_target);\n779\t        let place = self.mut_data_part(index);\n780\t        place.source = new_source;\n781\t        place.target = new_target;\n782\t        let place = place.clone();\n783\t\n784\t        if place.source != T::funty(0) {\n785\t            // SAFETY: Here index attach to source\n786\t            unsafe {\n787\t                if virtual_source {\n788\t                    self.attach_external_source(index);\n789\t                } else if Self::USE_LIST {\n790\t                    // self.sources_list.attach_as_last(source, index);\n791\t                    todo!()\n792\t                } else {\n793\t                    self.attach_internal_source(place.source, index);\n794\t                }\n795\t            }\n796\t        }\n797\t\n798\t        if place.target != T::funty(0) {\n799\t            // SAFETY: Here index attach to target\n800\t            unsafe {\n801\t                if virtual_target {\n802\t                    self.attach_external_target(index);\n803\t                } else {\n804\t                    self.attach_internal_target(place.target, index);\n805\t                }\n806\t            }\n807\t        }\n808\t\n809\t        Ok(handler(link, Link::new(index, place.source, place.target)))\n810\t    }\n811\t\n812\t    fn delete_links(\n813\t        &mut self,\n814\t        query: &[T],\n815\t        handler: WriteHandler<'_, T>,\n816\t    ) -> Result<Flow, LinksError<T>> {\n817\t        let index = query[0];\n818\t        let link = self.try_get_link(index)?;\n819\t\n820\t        self.resolve_danglind_internal(index);\n821\t\n822\t        self.update(index, T::funty(0), T::funty(0))?;\n823\t\n824\t        // TODO: move to `delete_cor