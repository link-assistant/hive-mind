[2026-07-19T12:51:19.346Z] [INFO]         "content": "44\tconsole.log('\\n📋 Issue #2072: /merge cancellation latency Tests\\n');\n45\t\n46\tawait asyncTest('cancellableSleep returns as soon as isCancelled flips mid-sleep', async () => {\n47\t  let cancelled = false;\n48\t  setTimeout(() => {\n49\t    cancelled = true;\n50\t  }, 150);\n51\t\n52\t  const startedAt = Date.now();\n53\t  const result = await cancellableSleep(LONG_DELAY_MS, () => cancelled);\n54\t  const elapsed = Date.now() - startedAt;\n55\t\n56\t  assert.equal(result.cancelled, true, 'Should report cancelled');\n57\t  assert.ok(elapsed < MAX_CANCEL_LATENCY_MS, `Should abort the sleep promptly, took ${elapsed}ms of ${LONG_DELAY_MS}ms`);\n58\t});\n59\t\n60\tawait asyncTest('cancellableSleep returns immediately when already cancelled', async () => {\n61\t  const startedAt = Date.now();\n62\t  const result = await cancellableSleep(LONG_DELAY_MS, () => true);\n63\t  const elapsed = Date.now() - startedAt;\n64\t\n65\t  assert.equal(result.cancelled, true, 'Should report cancelled');\n66\t  assert.ok(elapsed < 100, `Should not sleep at all when cancelled up front, took ${elapsed}ms`);\n67\t});\n68\t\n69\tawait asyncTest('cancellableSleep still sleeps the full delay when not cancelled', async () => {\n70\t  const startedAt = Date.now();\n71\t  const result = await cancellableSleep(300, () => false);\n72\t  const elapsed = Date.now() - startedAt;\n73\t\n74\t  assert.equal(result.cancelled, false, 'Should not report cancelled');\n75\t  assert.ok(elapsed >= 250, `Should sleep the requested delay, took only ${elapsed}ms`);\n76\t});\n77\t\n78\tawait asyncTest('MergeQueueProcessor.sleep aborts when cancel() is called', async () => {\n79\t  // sleep() is the single cancellable primitive for the queue: every wait routes\n80\t  // through it, so this covers all stages of /merge at once.\n81\t  const processor = new MergeQueueProcessor({ owner: 'test-owner', repo: 'test-repo' });\n82\t  setTimeout(() => processor.cancel(), 150);\n83\t\n84\t  const startedAt = Date.now();\n85\t  await processor.sleep(LONG_DELAY_MS);\n86\t  const elapsed = Date.now() - startedAt;\n87\t\n88\t  assert.ok(elapsed < MAX_CANCEL_LATENCY_MS, `sleep() should return on cancel, took ${elapsed}ms of ${LONG_DELAY_MS}ms`);\n89\t});\n90\t\n91\tawait asyncTest('waitForPRReady stops within ~100ms of cancel despite a 5-minute poll interval', async () => {\n92\t  // Reproduces the reported scenario: /merge parked on a long poll delay keeps\n93\t  // running after Cancel. Uses the real sleep so the delay is genuinely waited on.\n94\t  const processor = new MergeQueueProcessor({ owner: 'test-owner', repo: 'test-repo' });\n95\t  processor.log = () => {};\n96\t  processor.checkPRMergeable = async () => ({ mergeable: false, reason: 'Waiting on checks' });\n97\t\n98\t  const item = { pr: { number: 123 }, status: null, error: null };\n99\t  setTimeout(() => processor.cancel(), 150);\n100\t\n101\t  const startedAt = Date.now();\n102\t  const result = await waitForPRReady(\n103\t    processor,\n104\t    item,\n105\t    { mergeable: false, reason: 'Waiting on checks' },\n106\t    {\n107\t      MergeItemStatus: { CHECKING_CI: 'checking_ci', WAITING_READY: 'waiting_ready' },\n108\t      conflictSkipReason: 'Merge conflict',\n109\t      timeoutMs: 60 * 60 * 1000,\n110\t      pollIntervalMs: 5 * 60 * 1000,\n111\t    }\n112\t  );\n113\t  const elapsed = Date.now() - startedAt;"
