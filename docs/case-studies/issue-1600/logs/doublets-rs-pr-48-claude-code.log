link <= header.allocated\n214\t            && !self.is_unused(link)\n215\t    }\n216\t\n217\t    fn update_mem(&mut self, mem: NonNull<[LinkPart<T>]>) {\n218\t        self.mem_ptr = mem;\n219\t        self.targets.update_mem(mem);\n220\t        self.sources.update_mem(mem);\n221\t        self.unused.update_mem(mem);\n222\t    }\n223\t\n224\t    unsafe fn get_link_unchecked(&self, index: T) -> Link<T> {\n225\t        debug_assert!(self.exists(index));\n226\t\n227\t        let raw = self.get_link_part_unchecked(index);\n228\t        Link::new(index, raw.source, raw.target)\n229\t    }\n230\t\n231\t    fn each_core(&self, handler: ReadHandler<'_, T>, query: &[T]) -> Flow {\n232\t        let constants = self.constants();\n233\t\n234\t        if query.is_empty() {\n235\t            for index in T::funty(1)..=self.get_header().allocated {\n236\t                if let Some(link) = self.get_link(index) {\n237\t                    handler(link)?;\n238\t                }\n239\t            }\n240\t            return Flow::Continue;\n241\t        }\n242\t\n243\t        let any = constants.any;\n244\t        let index = query[constants.index_part.as_usize()];\n245\t\n246\t        if query.len() == 1 {\n247\t            return if index == any {\n248\t                self.each_core(handler, &[])\n249\t            } else if let Some(link) = self.get_link(index) {\n250\t                handler(link)\n251\t            } else {\n252\t                Flow::Continue\n253\t            };\n254\t        }\n255\t\n256\t        if query.len() == 2 {\n257\t            let value = query[1];\n258\t            return if index == any {\n259\t                if value == any {\n260\t                    self.each_core(handler, &[])\n261\t                } else {\n262\t                    self.each_core(handler, &[index, value, any])?;\n263\t                    self.each_core(handler, &[index, any, value])\n264\t                }\n265\t            } else if let Some(link) = self.get_link(index) {\n26