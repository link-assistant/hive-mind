          "old_string": "pub fn parse_lino(text: &str) -> Vec<LinoNode> {\n    let mut root = LinoNode {\n        tokens: Vec::new(),\n        children: Vec::new(),\n    };\n    let mut stack: Vec<(i32, *mut LinoNode)> = vec![(-1, &mut root as *mut _)];\n    for raw in text.lines() {\n        let trimmed = raw.trim();\n        if trimmed.is_empty() || trimmed.starts_with(\"//\") {\n            continue;\n        }\n        let indent = raw.len() - raw.trim_start().len();\n        let depth = (indent / INDENT.len()) as i32;\n        let node = LinoNode {\n            tokens: tokenize(trimmed),\n            children: Vec::new(),\n        };\n        while let Some(&(d, _)) = stack.last() {\n            if d >= depth {\n                stack.pop();\n            } else {\n                break;\n            }\n        }\n        // SAFETY: the pointer in the stack always points at a `LinoNode`\n        // owned by `root`'s subtree; we never alias because we hold one\n        // mutable borrow at a time and pop strictly upward.\n        let parent_ptr = stack.last().unwrap().1;\n        unsafe {\n            (*parent_ptr).children.push(node);\n            let last_ptr = (*parent_ptr).children.last_mut().unwrap() as *mut _;\n            stack.push((depth, last_ptr));\n        }\n    }\n    root.children\n}",
          "new_string": "pub fn parse_lino(text: &str) -> Vec<LinoNode> {\n    // Path-based traversal keeps the implementation safe: the stack\n    // stores indices into successive `children` vectors so we can walk\n    // from the root to the parent without holding raw pointers.\n    let mut root = LinoNode {\n        tokens: Vec::new(),\n        children: Vec::new(),\n    };\n    // (depth, child-index-at-that-depth) pairs.\n    let mut stack: Vec<(i32, usize)> = vec![(-1, 0)];\n    for raw in text.lines() {\n        let trimmed = raw.trim();\n        if trimmed.is_empty() || trimmed.starts_with(\"//\") {\n            continue;\n        }\n        let indent = raw.len() - raw.trim_start().len();\n        let depth = (indent / INDENT.len()) as i32;\n        let node = LinoNode {\n            tokens: tokenize(trimmed),\n            children: Vec::new(),\n        };\n        while stack.last().map(|&(d, _)| d >= depth).unwrap_or(false) {\n            stack.pop();\n        }\n        // Walk from the root through the index path to the parent.\n        let path: Vec<usize> = stack.iter().skip(1).map(|&(_, i)| i).collect();\n        let mut parent: &mut LinoNode = &mut root;\n        for idx in &path {\n            parent = &mut parent.children[*idx];\n        }\n        let new_index = parent.children.len();\n        parent.children.push(node);\n        stack.push((depth, new_index));\n    }\n    root.children\n}"
