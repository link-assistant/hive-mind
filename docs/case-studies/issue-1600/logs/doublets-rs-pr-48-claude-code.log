 new.init()?;\n107\t        }\n108\t        Ok(new)\n109\t    }\n110\t\n111\t    pub fn new(data_mem: MD, index_mem: MI) -> Result<Store<T, MD, MI>, LinksError<T>> {\n112\t        Self::with_constants(data_mem, index_mem, default())\n113\t    }\n114\t\n115\t    fn mut_from_mem<'a, U>(mut ptr: NonNull<[U]>, index: usize) -> Option<&'a mut U> {\n116\t        if index < ptr.len() {\n117\t            // SAFETY: `ptr` is non-dangling slice\n118\t            Some(unsafe {\n119\t                let slice = ptr.as_mut();\n120\t                &mut slice[index]\n121\t            })\n122\t        } else {\n123\t            None\n124\t        }\n125\t    }\n126\t\n127\t    fn get_from_mem<'a, U>(ptr: NonNull<[U]>, index: usize) -> Option<&'a U> {\n128\t        Self::mut_from_mem(ptr, index).map(|v| &*v)\n129\t    }\n130\t\n131\t    fn get_header(&self) -> &LinksHeader<T> {\n132\t        // SAFETY: `LinksHeader` and `IndexPart` layout are equivalent\n133\t        unsafe {\n134\t            Self::get_from_mem(self.index_ptr, 0)\n135\t                .map(|x| transmute(x))\n136\t                .expect(\"Header should be in index memory\")\n137\t        }\n138\t    }\n139\t\n140\t    fn mut_header(&mut self) -> &mut LinksHeader<T> {\n141\t        // SAFETY: `LinksHeader` and `IndexPart` layout are equivalent\n142\t        unsafe {\n143\t            Self::mut_from_mem(self.index_ptr, 0)\n144\t                .map(|x| transmute(x))\n145\t                .expect(\"Header should be in index memory\")\n146\t        }\n147\t    }\n148\t\n149\t    pub fn get_data_part(&self, index: T) -> &DataPart<T> {\n150\t        Self::get_from_mem(self.data_ptr, index.as_usize())\n151\t            .expect(\"Data part should be in data memory\")\n152\t    }\n153\t\n154\t    unsafe fn get_data_unchecked(&self, index: T) -> &DataPart<T> {\n155\t        Self::get_from_mem(self.data_ptr, index.as_usize()).unwrap_unchecked()\n156\t    }\n157\t\n158\t    fn mut_data_part(&mut self, index: T) -> &mut DataPart<T> {\n159\t        Self::mut_from_mem(self.data_ptr, index.as_usize())\n160\t            .expect(\"Data part should be in data memory\")\n161\t    }\n162\t\n163\t    pub fn get_index_part(&self, index: T) -> &IndexPart<T> {\n164\t        Self::get_from_mem(self.index_ptr, index.as_usize())\n165\t            .expect(\"Index part should be in index memory\")\n166\t    }\n167\t\n168\t    fn mut_index_part(&mut self, index: T) -> &mut IndexPart<T> {\n169\t        Self::mut_from_mem(self.index_ptr, index.as_usize())\n170\t            .expect(\"Index part should be in index memory\")\n171\t    }\n172\t\n173\t    unsafe fn mut_source_header_root(&mut self) -> *mut T {\n174\t        &mut self.mut_header().root_as_source\n175\t    }\n176\t\n177\t    unsafe fn mut_target_header_root(&mut self) -> *mut T {\n178\t        &mut self.mut_header().root_as_target\n179\t    }\n180\t\n181\t    unsafe fn mut_source_root(&mut self, link: T) -> *mut T {\n182\t        &mut self.mut_index_part(link).root_as_source\n183\t    }\n184\t\n185\t    unsafe fn mut_target_root(&mut self, link: T) -> *mut T {\n186\t        &mut self.mut_index_part(link).root_as_target\n187\t    }\n188\t\n189\t    unsafe fn detach_internal_source_unchecked(&mut self, root: *mut T, index: T) {\n190\t        self.internal_sources.detach(&mut *root, index);\n191\t    }\n192\t\n193\t    unsafe fn detach_internal_target_unchecked(&mut self, root: *mut T, index: T) {\n194\t        self.internal_targets.detach(&mut *root, index);\n195\t    }\n196\t\n197\t    unsafe fn attach_internal_source_unchecked(&mut self, root: *mut T, index: T) {\n198\t        self.internal_sources.attach(&mut *root, index);\n199\t    }\n200\t\n201\t    unsafe fn attach_internal_target_unchecked(&mut self, root: *mut T, index: T) {\n202\t        self.internal_targets.attach(&mut *root, index);\n203\t    }\n204\t\n205\t    unsafe fn detach_external_source_unchecked(&mut self, root: *mut T, index: T) {\n206\t        self.external_sources.detach(&mut *root, index);\n207\t    }\n208\t\n209\t    unsafe fn detach_external_target_unchecked(&mut self, root: *mut T, index: T) {\n210\t        self.external_targets.detach(&mut *root, index);\n211\t    }\n212\t\n213\t    unsafe fn attach_external_source_unchecked(&mut self, root: *mut T, index: T) {\n214\t        self.external_sources.attach(&mut *root, index);\n215\t    }\n216\t\n217\t    unsafe fn attach_external_target_unchecked(&mut self, root: *mut T, index: T) {\n218\t        self.external_targets.attach(&mut *root, index);\n219\t    }\n220\t\n221\t    unsafe fn detach_internal_source(&mut self, root: T, index: T) {\n222\t        let root = self.mut_source_root(root);\n223\t        self.detach_internal_source_unchecked(root, index);\n224\t    }\n225\t\n226\t    unsafe fn detach_internal_target(&mut self, root: T, index: T) {\n227\t        let root = self.mut_target_root(root);\n228\t        self.detach_internal_target_unchecked(root, index);\n229\t    }\n230\t\n231\t    unsafe fn attach_internal_source(&mut self, root: T, index: T) {\n232\t        let root = self.mut_source_root(root);\n233\t        self.attach_internal_source_unchecked(root, index);\n234\t    }\n235\t\n236\t    unsafe fn attach_internal_target(&mut self, root: T, index: T) {\n237\t        let root = self.mut_target_root(root);\n238\t        self.attach_internal_target_unchecked(root, index);\n239\t    }\n240\t\n241\t    unsafe fn detach_external_source(&mut self, index: T) {\n242\t        let root = self.mut_source_header_root();\n243\t        self.detach_external_source_unchecked(root, index);\n244\t    }\n245\t\n246\t    unsafe fn detach_external_target(&mut self, index: T) {\n247\t        let root = self.mut_target_header_root();\n248\t        self.detach_external_target_unchecked(root, index);\n249\t    }\n250\t\n251\t    unsafe fn attach_external_source(&mut self, index: T) {\n252\t        let root = self.mut_source_header_root();\n253\t        self.attach_external_source_unchecked(root, index);\n254\t    }\n255\t\n256\t    unsafe fn attach_external_target(&mut self, index: T) {\n257\t        let root = self.mut_target_header_root();\n258\t        self.attach_external_target_unchecked(root, index);\n259\t    }\n260\t\n261\t    fn update_mem(&mut self, data: NonNull<[DataPart<T>]>, index: NonNull<[IndexPart<T>]>) {\n262\t        self.data_ptr = data;\n263\t        self.index_ptr = index;\n264\t\n265\t        self.internal_sources.update_mem(data, index);\n266\t        self.external_sources.update_mem(data, index);\n267\t        self.internal_targets.update_mem(data, index);\n268\t        self.external_targets.update_mem(data, index);\n269\t        self.sources_list.update_mem(data, index);\n270\t        self.unused.update_mem(data, index);\n271\t    }\n272\t\n273\t    fn align(mut to_align: usize, target: usize) -> usize {\n274\t        debug_assert!(to_align >= target);\n275\t\n276\t        // TODO: optimize this `if`\n277\t        if to_align % target != 0 {\n278\t            to_align = ((to_align / target) * target) + target;\n279\t        }\n280\t        to_align\n281\t    }\n282\t\n283\t    unsafe fn init(&mut self) -> Result<(), LinksError<T>> {\n284\t        let data = NonNull::from(self.data_mem.alloc(DEFAULT_PAGE_SIZE)?);\n285\t        let index = NonNull::from(self.index_mem.alloc(DEFAULT_PAGE_SIZE)?);\n286\t        self.update_mem(data, index);\n287\t\n288\t        let header = self.get_header().clone();\n289\t        let allocated = header.allocated.as_usize();\n290\t\n291\t        let mut data_capacity = allocated;\n292\t        data_capacity = data_capacity.max(self.data_mem.allocated());\n293\t        data_capacity = data_capacity.max(self.data_step);\n294\t\n295\t        let mut index_capacity = allocated;\n296\t        index_capacity = index_capacity.max(self.index_mem.allocated());\n297\t        index_capacity = index_capacity.max(self.index_step);\n298\t\n299\t        data_capacity = Self::align(data_capacity, self.data_step);\n300\t        index_capacity = Self::align(index_capacity, self.index_step);\n301\t\n302\t        let data = NonNull::from(self.data_mem.alloc(data_capacity)?);\n303\t        let index = NonNull::from(self.index_mem.alloc(index_capacity)?);\n304\t        self.update_mem(data, index);\n305\t\n306\t        self.mut_header().reserved = T::try_from(self.data_mem.allocated() - 1).expect(\"always ok\");\n307\t        Ok(())\n308\t    }\n309\t\n310\t    fn total(&self) -> T {\n311\t        let header = self.get_header();\n312\t        header.allocated - header.free\n313\t    }\n314\t\n315\t    pub fn is_unused(&self, link: T) -> bool {\n316\t        let header = self.get_header();\n317\t        if link <= header.allocated && header.first_free != link {\n318\t            // TODO: May be this check is not needed\n319\t            let index = self.get_index_part(link);\n320\t            let data = self.get_data_part(link);\n321\t            index.size_as_target == T::funty(0) && data.source != T::funty(0)\n322\t        } else {\n323\t            true\n324\t        }\n325\t    }\n326\t\n327\t    //fn is_non_\n328\t\n329\t    pub fn is_virtual(&self, link: T) -> bool {\n330\t        self.is_unused(link)\n331\t    }\n332\t\n333\t    pub fn exists(&self, link: T) -> bool {\n334\t        let constants = self.constants();\n335\t        let header = self.get_header();\n336\t\n337\t        // TODO: use attributes expressions feature\n338\t        // TODO: use `Range::contains`\n339\t        link >= *constants.internal_range.start()\n340\t            && link <= header.allocated\n341\t            && !self.is_unused(link)\n342\t    }\n343\t\n344\t    // SAFETY: must be link exists\n345\t    unsafe fn get_link_unchecked(&self, index: T) -> Link<T> {\n346\t        debug_assert!(self.exists(index));\n347\t\n348\t        let raw = self.get_data_unchecked(index);\n349\t        Link::new(index, raw.source, raw.target)\n350\t    }\n351\t\n352\t    fn try_each_by_core(&self, handler: ReadHandler<'_, T>, query: &[T]) -> Flow {\n353\t        let query = query.to_query();\n354\t\n355\t        if query.is_empty() {\n356\t            for index in T::funty(1)..=self.get_header().allocated {\n357\t                if let Some(link) = self.get_link(index) {\n358\t                    handler(link)?;\n359\t                }\n360\t            }\n361\t            return Flow::Continue;\n362\t        }\n363\t\n364\t        let constants = self.constants.clone();\n365\t        let any = constants.any;\n366\t        let index = query[constants.index_part.as_usize()];\n367\t        if query.len() == 1 {\n368\t            return if index == any {\n369\t                self.try_each_by_core(handler, &[])\n370\t            } else if let Some(link) = self.get_link(index) {\n371\t                handler(link)\n372\t            } else {\n373\t                Flow::Continue\n374\t            };\n375\t        }\n376\t        //\n377\t        if query.len() == 2 {\n378\t            let value = query[1];\n379\t            return if index == any {\n380\t                if value == any {\n381\t                    self.try_each_by_core(handler, &[])\n382\t                } else {\n383\t                    self.try_each_by_core(handler, &[index, value, any])?;\n384\t                    self.try_each_by_core(handler, &[index, any, value])\n385\t                }\n386\t            } else if let Some(link) = self.get_link(index) {\n387\t                if value == any || link.source == value || link.target == value {\n388\t                    handler(link)\n389\t                } else {\n390\t                    Flow::Continue\n391\t                }\n392\t            } else {\n393\t                Flow::Continue\n394\t            };\n395\t        }\n396\t        //\n397\t        if query.len() == 3 {\n398\t            let source = query[constants.source_part.as_usize()];\n399\t            let target = query[constants.target_part.as_usize()];\n400\t            let is_virtual_source = self.is_virtual(source);\n401\t            let is_virtual_target = self.is_virtual(target);\n402\t\n403\t            return if index == any {\n404\t                if (source, target) == (any, any) {\n405\t                    self.try_each_by_core(handler, &[])\n406\t                } else if source == any {\n407\t                    if is_virtual_target {\n408\t                        self.external_targets.each_usages(target, handler)\n409\t                    } else {\n410\t                        self.internal_targets.each_usages(target, handler)\n411\t                    }\n412\t                } else if target == any {\n413\t                    if is_virtual_source {\n414\t                        self.external_sources.each_usages(source, handler)\n415\t                    } else if Self::USE_LIST {\n416\t                        self.sources_list.each_usages(source, handler)\n417\t                    } else {\n418\t                        self.internal_sources.each_usages(source, handler)\n419\t                    }\n420\t                } else {\n421\t                    let link = if true {\n422\t                        if is_virtual_source && is_virtual_target {\n423\t                            self.external_sources.search(source, target)\n424\t                        } else if is_virtual_source {\n425\t                            self.internal_targets.search(source, target)\n426\t                        } else if is_virtual_target {\n427\t                            if Self::USE_LIST {\n428\t                                self.external_sources.search(source, target)\n429\t                            } else {\n430\t                                self.internal_sources.search(source, target)\n431\t                            }\n432\t                        } else if Self::USE_LIST\n433\t                            || self.internal_sources.count_usages(source)\n434\t                                > self.internal_targets.count_usages(target)\n435\t                        {\n436\t                            self.internal_targets.search(source, target)\n437\t                        } else {\n438\t                            self.internal_sources.search(source, target)\n439\t                        }\n440\t                    } else if Self::USE_LIST\n441\t                        || self.internal_sources.count_usages(source)\n442\t                            > self.internal_targets.count_usages(target)\n443\t                    {\n444\t                        self.internal_targets.search(source, target)\n445\t                    } else {\n446\t                        self.internal_sources.search(source, target)\n447\t                    };\n448\t                    return if link == constants.null {\n449\t                        Flow::Continue\n450\t                    } else {\n451\t                        // SAFETY: link 100% exists\n452\t                        let link = unsafe { self.get_link(link).unwrap_unchecked() };\n453\t                        handler(link)\n454\t                    };\n455\t                }\n456\t            } else if let Some(link) = self.get_link(index) {\n457\t                if (source, target) == (any, any) {\n458\t                    handler(link)\n459\t                } else if source != any && target != any {\n460\t                    if (link.source, link.target) == (source, target) {\n461\t                        handler(link)\n462\t                    } else {\n463\t                        Flow::Continue\n464\t                    }\n465\t                } else if source == any {\n466\t                    if link.target == target {\n467\t                        handler(link)\n468\t                    } else {\n469\t                        Flow::Continue\n470\t                    }\n471\t                } else if target == any {\n472\t                    if link.source == source {\n473\t                        handler(link)\n474\t                    } else {\n475\t                        Flow::Continue\n476\t                    }\n477\t                } else {\n478\t                    Flow::Continue\n479\t                }\n480\t            } else {\n481\t                Flow::Continue\n482\t            };\n483\t        }\n484\t        todo!()\n485\t    }\n486\t\n487\t    fn resolve_danglind_internal(&mut self, index: T) {\n488\t        let any = self.constants.any;\n489\t        for link in self\n490\t            .each_iter([any, index, any])\n491\t            .filter(|link| link.index != index)\n492\t        {\n493\t            unsafe {\n494\t                self.detach_internal_source(index, link.index);\n495\t                self.attach_external_source(link.index);\n496\t            }\n497\t        }\n498\t\n499\t        for link in self\n500\t            .each_iter([any, any, index])\n501\t            .filter(|link| link.index != index)\n502\t            .filter(|link| !link.is_full())\n503\t        {\n504\t            unsafe {\n505\t                self.detach_internal_target(index, link.index);\n506\t                self.attach_external_target(link.index);\n507\t            }\n508\t        }\n509\t    }\n510\t\n511\t    fn resolve_danglind_external(&mut self, free: T) {\n512\t        let any = self.constants().any;\n513\t        for link in self\n514\t            .each_iter([any, free, any])\n515\t            .filter(|link| link.index != free)\n516\t        {\n517\t            unsafe {\n518\t                self.detach_external_source(link.index);\n519\t                self.attach_internal_source(free, link.index);\n520\t            }\n521\t        }\n522\t\n523\t        for link in self\n524\t            .each_iter([any, any, free])\n525\t            .filter(|link| link.index != free)\n526\t            .filter(|link| !link.is_full())\n527\t        {\n528\t            unsafe {\n529\t                self.detach_external_target(link.index);\n530\t                self.attach_internal_target(free, link.index);\n531\t            }\n532\t        }\n533\t    }\n534\t}\n535\t\n536\timpl<\n537\t    T: LinkType,\n538\t    MD: RawMem<DataPart<T>>,\n539\t    MI: RawMem<IndexPart<T>>,\n540\t    IS: SplitTree<T>,\n541\t    ES: SplitTree<T>,\n542\t    IT: SplitTree<T>,\n543\t    ET: SplitTree<T>,\n544\t    UL: SplitList<T>,\n545\t> Links<T> for Store<T, MD, MI, IS, ES, IT, ET, UL>\n546\t{\n547\t    fn constants(&self) -> &LinksConstants<T> {\n548\t        &self.constants\n549\t    }\n550\t\n551\t    fn count_links(&self, query: &[T]) -> T {\n552\t        if query.is_empty() {\n553\t            return self.total();\n554\t        }\n555\t\n556\t        let constants = self.constants();\n557\t        let any = constants.any;\n558\t        let index = query[constants.index_part.as_usize()];\n559\t        if query.len() == 1 {\n560\t            return if index == any {\n561\t                self.total()\n562\t            } else if self.exists(index) {\n563\t                T::funty(1)\n564\t            } else {\n565\t                T::funty(0)\n566\t            };\n567\t        }\n568\t\n569\t        if query.len() == 2 {\n570\t            let value = query[1];\n571\t            let is_virtual_val = self.is_virtual(value);\n572\t\n573\t            return if index == any {\n574\t                if value == any {\n575\t                    self.total()\n576\t                } else if is_virtual_val {\n577\t                    self.external_sources.count_usages(value)\n578\t                        + self.external_targets.count_usages(value)\n579\t                } else if Self::USE_LIST {\n580\t                    self.sources_list.count_usages(value)\n581\t                        + self.internal_targets.count_usages(value)\n582\t                } else {\n583\t                    self.internal_sources.count_usages(value)\n584\t                        + self.internal_targets.count_usages(value)\n585\t                }\n586\t            } else if !self.exists(index) {\n587\t                T::funty(0)\n588\t            } else if value == any {\n589\t                T::funty(1)\n590\t            } else {\n591\t                let stored = self.get_data_part(index);\n592\t                if (stored.source, stored.target) == (value, value) {\n593\t                    T::funty(1)\n594\t                } else {\n595\t                    T::funty(0)\n596\t                }\n597\t            };\n598\t        }\n599\t\n600\t        if query.len() == 3 {\n601\t            let source = query[constants.source_part.as_usize()];\n602\t            let target = query[constants.target_part.as_usize()];\n603\t\n604\t            let is_virtual_source = self.is_virtual(source);\n605\t            let is_virtual_target = self.is_virtual(target);\n606\t\n607\t            return if index == any {\n608\t                if (source, target) == (any, any) {\n609\t                    self.total()\n610\t                } else if source == any {\n611\t                    if is_virtual_target {\n612\t                        self.external_targets.count_usages(target)\n613\t                    } else {\n614\t                        self.internal_targets.count_usages(target)\n615\t                    }\n616\t                } else if is_virtual_source {\n617\t                    self.external_sources.count_usages(source)\n618\t                } else if target == any {\n619\t                    if Self::USE_LIST {\n620\t                        self.sources_list.count_usages(source)\n621\t                    } else {\n622\t                        self.internal_sources.count_usages(source)\n623\t                    }\n624\t                } else {\n625\t                    let link = if true {\n626\t                        if is_virtual_source && is_virtual_target {\n627\t                            self.external_sources.search(source, target)\n628\t                        } else if is_virtual_source {\n629\t                            self.internal_targets.search(source, target)\n630\t                        } else if is_virtual_target {\n631\t                            if Self::USE_LIST {\n632\t                                self.external_sources.search(source, target)\n633\t                            } else {\n634\t                                self.internal_sources.search(source, target)\n635\t                            }\n636\t                        } else if Self::USE_LIST\n637\t                            || self.internal_sources.count_usages(source)\n638\t                                > self.internal_targets.count_usages(target)\n639\t                        {\n640\t                            self.internal_targets.search(source, target)\n641\t                        } else {\n642\t                            self.internal_sources.search(source, target)\n643\t                        }\n644\t                    } else if Self::USE_LIST\n645\t                        || self.internal_sources.count_usages(source)\n646\t                            > self.internal_targets.count_usages(target)\n647\t                    {\n648\t                        self.internal_targets.search(source, target)\n649\t                    } else {\n650\t                        self.internal_sources.search(source, target)\n651\t                    };\n652\t                    return if link == constants.null {\n653\t                        T::funty(0)\n654\t                    } else {\n655\t                        T::funty(1)\n656\t                    };\n657\t                }\n658\t            } else if !self.exists(index) {\n659\t                T::funty(0)\n660\t            } else if (source, target) == (any, any) {\n661\t                T::funty(1)\n662\t            } else {\n663\t                let link = unsafe { self.get_link_unchecked(index) };\n664\t                if source != any && target != any {\n665\t                    if (link.source, link.target) == (source, target) {\n666\t                        T::funty(1)\n667\t                    } else {\n668\t                        T::funt