[2026-07-19T13:21:52.280Z] [INFO]         "content": "1\t#!/usr/bin/env node\n2\t\n3\timport assert from 'node:assert/strict';\n4\timport fs from 'node:fs/promises';\n5\timport path from 'node:path';\n6\t\n7\tconst root = process.cwd();\n8\t\n9\tconst read = file => fs.readFile(path.join(root, file), 'utf-8');\n10\t\n11\tconst dockerfiles = ['Dockerfile', 'Dockerfile.dind', 'coolify/Dockerfile'];\n12\t\n13\tfor (const file of dockerfiles) {\n14\t  const content = await read(file);\n15\t\n16\t  assert.ok(content.includes('ARG HIVE_MIND_VERSION=latest'), `${file} should accept the exact published hive-mind version as a build arg`);\n17\t  assert.ok(content.includes('ENV HIVE_MIND_DOCKER_ISOLATION_IMAGE_TAG=\"${HIVE_MIND_VERSION}\"'), `${file} should bake the published version as the default Docker isolation image tag`);\n18\t  assert.ok(content.includes('bun install -g \"@link-assistant/hive-mind@${HIVE_MIND_VERSION}\"'), `${file} should install the published hive-mind package version`);\n19\t  assert.ok(content.includes('test \"$(hive --version)\" = \"${HIVE_MIND_VERSION}\"'), `${file} should verify the installed hive-mind version when a release version is supplied`);\n20\t  assert.ok(content.includes('configure-claude --settings-path /home/box/.claude/settings.json'), `${file} should invoke the published configure-claude bin`);\n21\t  assert.ok(content.includes('configure-claude --settings-path /home/box/.claude/settings.json --verify'), `${file} should verify the Docker baseline after applying configure-claude`);\n22\t  // PR builds (HIVE_MIND_VERSION=latest) must tolerate a configure-claude that\n23\t  // has not been published yet; release builds (pinned version) must not.\n24\t  assert.ok(/if \\[ \"\\$\\{HIVE_MIND_VERSION\\}\" != \"latest\" \\]/.test(content), `${file} should branch on HIVE_MIND_VERSION so release builds enforce configure-claude strictly`);\n25\t  assert.ok(content.includes('command -v configure-claude'), `${file} should gracefully skip configure-claude when the bin is not yet published (PR builds only)`);\n26\t  assert.ok(!content.includes('/workspace/.hive-mind-bake'), `${file} should not copy repo source into a bake directory`);\n27\t  assert.ok(!content.includes('scripts/configure-claude-quiet-defaults.mjs'), `${file} should not invoke the old repo-local wrapper script`);\n28\t  assert.ok(!content.includes('src/claude-quiet-config.lib.mjs'), `${file} should rely on the published package instead of copying source libs`);\n29\t}\n30\t\n31\tconst releaseYml = await read('.github/workflows/release.yml');\n32\tconst dockerPrStart = releaseYml.indexOf('  docker-pr-check:');\n33\tconst helmPrStart = releaseYml.indexOf('  # === HELM PR CHECK', dockerPrStart);\n34\tconst dockerPrSection = releaseYml.slice(dockerPrStart, helmPrStart);\n35\t\n36\t// PR docker-pr-check must (1) run the release-order contract test AND\n37\t// (2) actually build the Docker image using @link-assistant/hive-mind@latest\n38\t// and run the container verification script.\n39\tassert.ok(dockerPrSection.includes('node tests/test-docker-release-order.mjs'), 'docker-pr-check should run this static release-order contract test');\n40\tassert.ok(dockerPrSection.includes('docker build --progress=plain'), 'docker-pr-check should build the Docker image on PRs');\n41\tassert.ok(dockerPrSection.includes('bash /verify-docker-image.sh'), 'docker-pr-check should run verify-docker-image.sh inside the built image');\n42\t\n43\tassert.ok(releaseYml.includes('docker-publish:\\n    name: Docker Publish'), 'release workflow should keep the normal Docker publish job');\n44\tassert.ok(releaseYml.includes('needs: [release]'), 'docker-publish should depend on the npm release job');\n45\tassert.ok(releaseYml.includes('needs: [instant-release]'), 'instant Docker publish should depend on the instant npm release job');\n46\tassert.ok(releaseYml.includes('node scripts/wait-for-npm.mjs --release-version \"${{ needs.release.outputs.published_version }}\"'), 'release Docker job should wait for the published npm version');\n47\tassert.ok(releaseYml.includes('node scripts/wait-for-npm.mjs --release-version \"${{ needs.instant-release.outputs.published_version }}\"'), 'instant Docker job should wait for the published npm version');\n48\tassert.ok(!/Wait for NPM package availability[\\s\\S]{0,160}\\n\\s+if: matrix\\.platform == 'linux\\/amd64'/.test(releaseYml), 'every Docker matrix build should wait for npm availability');\n49\tassert.ok(releaseYml.includes('HIVE_MIND_VERSION=${{ needs.release.outputs.published_version }}'), 'release Docker build should pass the exact npm version into Docker');\n50\tassert.ok(releaseYml.includes('HIVE_MIND_VERSION=${{ needs.instant-release.outputs.published_version }}'), 'instant Docker build should pass the exact npm version into Docker');\n51\tassert.ok(!releaseYml.includes('pattern: digests-*'), 'normal Docker merge must not download DinD digest artifacts');\n52\tassert.ok(releaseYml.includes('name: hive-mind-digests-${{ matrix.platform =='), 'release Docker artifacts should use the normal image digest namespace');\n53\tassert.ok(releaseYml.includes('pattern: hive-mind-digests-*'), 'release Docker merge should download only normal image digests');\n54\tassert.ok(releaseYml.includes('name: hive-mind-instant-digests-${{ matrix.platform =='), 'instant Docker artifacts should use the normal image digest namespace');\n55\tassert.ok(releaseYml.includes('pattern: hive-mind-instant-digests-*'), 'instant Docker merge should download only normal image digests');\n56\tassert.ok(releaseYml.includes('name: hive-mind-dind-digests-${{ matrix.platform =='), 'release DinD artifacts should use a separate digest namespace');\n57\tassert.ok(releaseYml.includes('pattern: hive-mind-dind-digests-*'), 'release DinD merge should download only DinD digests');\n58\tassert.ok(releaseYml.includes('name: hive-mind-dind-instant-digests-${{ matrix.platform =='), 'instant DinD artifacts should use a separate digest namespace');\n59\tassert.ok(releaseYml.includes('pattern: hive-mind-dind-instant-digests-*'), 'instant DinD merge should download only DinD digests');\n60\t\n61\tconsole.log('Docker release-order contract tests passed');\n62\t"
