[2026-10-24T14:59:58.875Z] [INFO]     "stdout": "// The notation of the links theory (issue #13). The English draft 0.0.2 of\n// link-foundation/meta-theory writes links as L → L²; the draft 0.0.3 renames\n// L (link) to R (reference) and A (association) to L (link), so the formula\n// becomes R → R² (drafts/0.0.3/article/10-changelog.md). The site keeps L → L²\n// by default; the \"theory.notation\" setting switches every formula on it.\nimport { useCallback } from 'react';\nimport { useSettings } from '../settings/store';\n\nexport const NOTATIONS = ['L', 'R'];\n\n/** The formula L → L² (or L ↦ L²) inside a text, in the notation of draft 0.0.3. */\nexport const toReferences = (text) => text.replace(/(^|[^\\p{L}])L ([→↦]) L²/gu, '$1R $2 R²');\n\n/** `text` in the given notation; a `{ L, R }` object picks its variant. */\nexport function notate(text, notation) {\n  if (text && typeof text === 'object' && 'L' in text) return text[notation] ?? text.L;\n  return notation === 'R' && typeof text === 'string' ? toReferences(text) : text;\n}\n\n/** `{ notation, n }`: the chosen notation and `n(text)`, which writes the theory's formulas in it. */\nexport function useNotation() {\n  const notation = useSettings()['theory.notation'];\n  const n = useCallback((text) => notate(text, notation), [notation]);\n  return { notation, n };\n}\n// The links meta-theory (github.com/link-foundation/meta-theory) and the\n// universal problem solving algorithm (github.com/konard/problem-solving).\n// Texts are `{ en, ru }` objects translated with useLang().t; formulas, version\n// titles (titles of the published articles) and repository names stay as they are.\n// Formulas are `{ L, R }`: the notation of draft 0.0.2 (L → L²) and of draft\n// 0.0.3 (R → R²), chosen in the settings (src/links/notation.js, issue #13).\n\nconst ARCHIVED = { en: 'archived article', ru: 'архивная статья' };\nconst DRAFT = { en: 'draft', ru: 'черновик' };\n\nexport const metaTheory = {\n  repo: 'https://github.com/link-foundation/meta-theory',\n  pdfs: 'https://github.com/link-foundation/meta-theory/releases/latest/download/meta-theory-pdfs.zip',\n  tldr: { L: 'L → L²', R: 'R → R²' },\n  summary: {\n    en: 'A theory of everything built from a single concept, the link: an n-tuple of references to links that has its own reference. The goal is a meta-language that can describe philosophy, mathematics, physics and psychology in one formal language, so that every science becomes computable.',\n    ru: 'Теория всего, построенная на единственном понятии — связи: n-кортеже ссылок на связи, у которого есть собственная ссылка. Цель — метаязык, способный описать философию, математику, физику и психологию на одном формальном языке, чтобы любая наука стала вычислимой.',\n  },\n  formulas: [\n    {\n      formula: { L: 'L ⊆ ℕ₀', R: 'R ⊆ ℕ₀' },\n      text: {\n        L: {\n          en: 'references to links (vectors) are natural numbers',\n          ru: 'ссылки на связи (векторы) — натуральные числа',\n        },\n        R: {\n          en: 'references to tuples are natural numbers',\n          ru: 'ссылки на кортежи — натуральные числа',\n        },\n      },\n    },\n    {\n      formula: { L: 'Vₙ = Lⁿ', R: 'Tₙ = Rⁿ' },\n      text: {\n        L: {\n          en: 'all vectors of n references are the Cartesian power of L',\n          ru: 'все векторы из n ссылок — декартова степень L',\n        },\n        R: {\n          en: 'all tuples of n references are the Cartesian power of R',\n          ru: 'все кортежи из n ссылок — декартова степень R',\n        },\n      },\n    },\n    {\n      formula: { L: 'A = L × Vₙ', R: 'L = R × Tₙ' },\n      text: {\n        L: {\n          en: 'an association maps a reference to a vector of references',\n          ru: 'ассоциация сопоставляет ссылке вектор ссылок',\n        },\n        R: {\n          en: 'a link pairs a reference with a tuple of references; a reference is a link of no references, R ⊆ L',\n          ru: 'связь — пара из ссылки и кортежа ссылок; ссылка — связь без ссылок, R ⊆ L',\n        },\n      },\n    },\n    {\n      formula: { L: 'λ: L → L × L', R: 'N²: R → R × R' },\n      text: {\n        en: 'a doublet network gives every link a source and a target',\n        ru: 'сеть дуплетов задаёт каждой связи начало и конец',\n      },\n    },\n    {\n      formula: { L: 'λ: L → L × L × L', R: 'N³: R → R × R × R' },\n      text: { en: 'a triplet network adds a type to every link', ru: 'сеть триплетов добавляет каждой связи тип' },\n    },\n    {\n      formula: { L: 'L → L²', R: 'R → R²' },\n      text: {\n        en: 'one formula is enough: any sequence converts to nested doublets and back (proved in Rocq/Coq)',\n        ru: 'достаточно одной формулы: любая последовательность преобразуется во вложенные дуплеты и обратно (доказано в Rocq/Coq)',\n      },\n    },\n  ],\n  // The doublet network example from the article: 1 → (1,1), 2 → (2,2), 3 → (1,2),\n  // written as a network code (link i is its source and target, 0 is nothing).\n  example: { code: '11 22 12' },\nimport '../App.css';\nimport '../App.sections.css';\nimport '../Layout.css';\nimport '../pages/pages.css';\n// The skins (issue #13) and the technical fonts of the futuristic one.\nimport '@fontsource/orbitron/latin-500.css';\nimport '@fontsource/orbitron/latin-700.css';\nimport '@fontsource/electrolize/latin-400.css';\nimport '@fontsource/chakra-petch/latin-400.css';\nimport '@fontsource/chakra-petch/latin-600.css';\nimport '@fontsource/share-tech-mono/latin-400.css';\nimport '../skins.glass.css';\nimport '../skins.liquid.css';\nimport '../skins.future.css';\n// Responsive and print overrides must come last.\nimport '../App.media.css';\nimport { useEffect, useRef } from 'react';\nimport { motto } from '../data/motto';\nimport { centreCurrent, watchEdges } from './edges';\nimport { PAGES } from '../pages/pages';\nimport { useLang } from '../i18n/prefs';\nimport { useNotation } from '../links/notation';\nimport Cosmos from './Cosmos';\nimport LiquidRefraction from './LiquidRefraction';\nimport PrefSwitches from './PrefSwitches';\nimport Sound from './Sound';\n\n/**\n * Shared frame of every page: the cosmic background, the page navigation\n * (plus optional in-page section links) and the footer with the link to the\n * settings of the background and the skin (issue #13).\n */\nexport default function Layout({ page, sections = null, children, footer = null }) {\n  const { t } = useLang();\n  const { n } = useNotation();\n  const pages = useRef(null);\n  const sectionList = useRef(null);\n  const hasSections = Boolean(sections);\n  // On a narrow screen the lists of pages and sections scroll sideways: show the current\n  // page and fade the edges that have more links behind them.\n  useEffect(() => {\n    if (pages.current) centreCurrent(pages.current);\n    return watchEdges([pages.current, sectionList.current].filter(Boolean));\n  }, [page, hasSections]);\n  return (\n    <div className=\"app\">\n      <Cosmos />\n      <LiquidRefraction />\n      <Sound />\n      <header className=\"topbar\">\n        <div className=\"topbar__row\">\n          <a className=\"nav__brand mono\" href=\"/\">\n            konard<span className=\"nav__cursor\">_</span>\n          </a>\n          <nav className=\"pages\" aria-label=\"Pages\">\n            <ul ref={pages}>\n              {PAGES.map((p) => (\n                <li key={p.id}>\n                  <a href={p.href} aria-current={p.id === page ? 'page' : undefined}>\n                    {t(p.label)}\n                  </a>\n                </li>\n              ))}\n            </ul>\n          </nav>\n          <PrefSwitches />\n        </div>\n        {sections && (\n          <nav className=\"nav\" aria-label=\"Sections\">\n            <a className=\"nav__top mono\" href=\"#top\" aria-label={t({ en: 'Back to top', ru: 'Наверх' })}>\n              ↑\n            </a>\n            <ul ref={sectionList}>\n              {sections.map(([id, label]) => (\n                <li key={id}>\n                  <a href={`#${id}`}>{t(label)}</a>\n                </li>\n              ))}\n            </ul>\n          </nav>\n        )}\n      </header>\n\n      <main>{children}</main>\n\n      <footer className=\"footer\">\n        <span className=\"mono\">{n(motto)}</span>\n        <span>\n          <a className=\"footer__settings\" href=\"/settings/\" aria-current={page === 'settings' ? 'page' : undefined}>\n            {t({ en: 'Settings', ru: 'Настройки' })}\n          </a>{' '}\n          · {footer}\n          {t({ en: 'Background: links of the', ru: 'Фон: связи' })}{' '}\n          <a href=\"https://github.com/link-foundation/meta-theory\" target=\"_blank\" rel=\"noopener noreferrer\">\n            {t({ en: 'links theory', ru: 'теории связей' })}\n          </a>{' '}\n          {t({ en: 'in the', ru: 'в стиле' })}{' '}\n          <a href=\"https://github.com/konard/links-visuals\" target=\"_blank\" rel=\"noopener noreferrer\">\n            links-visuals\n          </a>\n          {t({ en: ' style, raining as in', ru: ', падающие как в' })}{' '}\n          <a href=\"https://github.com/konard/twittermatrix\" target=\"_blank\" rel=\"noopener noreferrer\">\n            twittermatrix\n          </a>{' '}\n          ·{' '}\n          <a href=\"https://github.com/konard/konard.github.io\" target=\"_blank\" rel=\"noopener noreferrer\">\n            {t({ en: 'source', ru: 'исходный код' })}\n          </a>\n        </span>\n      </footer>\n    </div>\n  );\n}\nsrc/index.css:43:  /* Link colours of the symbols (the same as COLORS in src/links/glyph.js). */\nsrc/skins.glass.css:54:      .symbols__grid li,\nsrc/skins.glass.css:94:      .symbols__grid li,\nsrc/skins.future.css:290:    .symbols__grid li,\nsrc/skins.future.css:358::root[data-skin-name='futuristic'] :is(.symbols__grid li, .theory__formulas li, .page-stats li) {\nsrc/pages/pages.css:343:/* ---------- Link symbols ---------- */\nsrc/pages/pages.css:345:.symbols__tabs {\nsrc/pages