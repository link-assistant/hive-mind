        "content": "1\timport { describe, it, expect } from 'test-anywhere';\n2\timport {\n3\t  createPeer,\n4\t  startSyncListener,\n5\t  connectSyncPeer,\n6\t} from '../src/sync/index.js';\n7\timport { createMemoryStore } from '../src/storage/index.js';\n8\t\n9\tdescribe('sync over TCP transport', () => {\n10\t  it('replicates a put from one store to another', async () => {\n11\t    const a = createMemoryStore();\n12\t    const b = createMemoryStore();\n13\t    const peerA = createPeer(a, { node: 'a' });\n14\t    const peerB = createPeer(b, { node: 'b' });\n15\t\n16\t    const listener = await startSyncListener({ port: 0 });\n17\t    const offA = peerA.connect(listener.transport);\n18\t\n19\t    const client = await connectSyncPeer({ port: listener.port });\n20\t    const offB = peerB.connect(client.transport);\n21\t\n22\t    // Subscribe to store B before the put so we get a deterministic\n23\t    // signal when replication arrives — avoids a race against bun's\n24\t    // 5-second test timeout on slower CI runners (notably macOS).\n25\t    const replicatedSignal = new Promise((resolve) => {\n26\t      const off = b.subscribe((event) => {\n27\t        if (event.type === 'put' && event.link.id === 'x') {\n28\t          off();\n29\t          resolve(event.link);\n30\t        }\n31\t      });\n32\t    });\n33\t\n34\t    await a.put({\n35\t      id: 'x',\n36\t      tokens: ['hello'],\n37\t      vc: { a: 1 },\n38\t    });\n39\t\n40\t    const replicated = await replicatedSignal;\n41\t    expect(replicated?.tokens?.[0]).toBe('hello');\n42\t\n43\t    offA();\n44\t    offB();\n45\t    await client.close();\n46\t    await listener.close();\n47\t  });\n48\t});\n49\t"
