if (!before.isFile() || before.nlink !== 1n || before.size <= 0n || before.size > BigInt(max) || (size !== undefined && before.size !== BigInt(size)) || (executable && !(before.mode & 0o111n))) throw refusal();\\n00036|     const checksum = createHash('sha256');\\n00037|     const buffer = Buffer.alloc(65536);\\n00038|     const chunks = [];\\n00039|     let header;\\n00040|     let total = 0;\\n00041|     while (true) {\\n00042|       const { bytesRead } = await descriptor.read(buffer, 0, buffer.length, null);\\n00043|       if (!bytesRead) break;\\n00044|       total += bytesRead;\\n00045|       if (total > max || BigInt(total) > before.size) throw refusal();\\n00046|       if (!header) header = Buffer.from(buffer.subarray(0, Math.min(64, bytesRead)));\\n00047|       checksum.update(buffer.subarray(0, bytesRead));\\n00048|       if (metadata) chunks.push(Buffer.from(buffer.subarray(0, bytesRead)));\\n00049|     }\\n00050|     const observed = checksum.digest('hex');\\n00051|     if (BigInt(total) !== before.size || (digest && digest !== observed) || revision(before) !== revision(await descriptor.stat({ bigint: true })) || revision(before) !== revision(await fs.lstat(file, { bigint: true }))) throw refusal();\\n00052|     return { bytes: metadata ? Buffer.concat(chunks) : undefined, digest: observed, header, size: total };\\n00053|   } finally {\\n00054|     await descriptor.close();\\n00055|   }\\n00056| }\\n00057| \\n00058| async function directory(root) {\\n00059|   if (typeof root !== 'string' || !path.isAbsolute(root) || path.normalize(root) !== root || (await fs.realpath(root)) !== root) throw refusal();\\n00060|   const info = await fs.lstat(root, { bigint: true });\\n00061|   if (!info.isDirectory() || info.isSymbolicLink()) throw refusal();\\n00062|   return identity(info);\\n00063| }\\n00064| \\n00065| function sourceDigest(files) {\\n00066|   const sorted = Object.fromEntries(\\n00067|     Object.keys(files)\\n00068|       .sort()\\n00069|       .map(nam