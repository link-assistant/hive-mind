[2026-10-24T15:14:12.909Z] [INFO]         "content": "// Plural word forms per site language (issue #11).\n// English has two forms (one, other); Russian has three (one, few, many):\n// 1 связь, 2 связи, 5 связей, 21 связь, 11 связей.\nconst rules = new Map();\nconst rule = (lang) => {\n  if (!rules.has(lang)) rules.set(lang, new Intl.PluralRules(lang === 'ru' ? 'ru-RU' : 'en-US'));\n  return rules.get(lang);\n};\n\nconst INDEX = { one: 0, few: 1, many: 2, other: 2 };\n\n/**\n * The word form for `count`: `forms` is `{ en: [one, other], ru: [one, few, many] }`.\n * plural(5, 'ru', { en: ['link', 'links'], ru: ['связь', 'связи', 'связей'] }) → 'связей'.\n */\nexport function plural(count, lang, forms) {\n  const words = forms[lang] ?? forms.en;\n  if (words.length === 2) return rule('en').select(count) === 'one' ? words[0] : words[1];\n  return words[INDEX[rule(lang).select(count)] ?? 2];\n}\n// Number formats per site language ('en' or 'ru'; see src/i18n/prefs.js).\nconst LOCALES = { en: 'en-US', ru: 'ru-RU' };\nconst cache = new Map();\nconst formatter = (lang, options) => {\n  const key = `${lang}:${JSON.stringify(options)}`;\n  if (!cache.has(key)) cache.set(key, new Intl.NumberFormat(LOCALES[lang] || LOCALES.en, options));\n  return cache.get(key);\n};\n\nexport const formatNumber = (value, lang = 'en') => formatter(lang, {}).format(value);\nexport const formatCompact = (value, lang = 'en') =>\n  formatter(lang, { notation: 'compact', maximumFractionDigits: 1 }).format(value);\nexport const formatPercent = (value) => `${(value * 100).toFixed(value < 0.1 ? 1 : 0)}%`;\n\n// Categorical slots validated for the dark surface (#0d1220) with the dataviz\n// palette validator: CVD ΔE ≥ 8.4 on adjacent pairs, contrast ≥ 3:1.\nexport const SERIES = ['#3987e5', '#d95926', '#199e70', '#c98500', '#d55181', '#008300', '#9085e9', '#e66767'];\n  links.forEach(([s, t], i) => {\n    result[perm[i]] = [name(s), name(t)];\n  });\n  return result;\n}\n\n/** The smallest code among all renamings of the real links. */\nexport function canonical(links, perms = permutations(links.length)) {\n  let best = null;\n  for (const perm of perms) {\n    const code = encode(relabel(links, perm));\n    if (best === null || code < best) best = code;\n  }\n  return best;\n}\n\n/**\n * Whether no renaming of the real links gives a smaller code. Works on flat\n * digit arrays and stops at the first difference, so all 390,625 networks\n * of 4 links are checked in a fraction of a second.\n */\nfunction isSmallest(digits, perms, n) {\n  const renamed = new Array(2 * n);\n  for (const perm of perms) {\n    for (let i = 0; i < n; i++) {\n      const s = digits[2 * i];\n      const t = digits[2 * i + 1];\n      renamed[2 * perm[i]] = s === 0 ? 0 : perm[s - 1] + 1;\n      renamed[2 * perm[i] + 1] = t === 0 ? 0 : perm[t - 1] + 1;\n    }\n    for (let k = 0; k < 2 * n; k++) {\n      if (renamed[k] < digits[k]) return false;\n      if (renamed[k] > digits[k]) break;\n    }\n  }\n  return true;\n}\n\nconst cache = new Map();\n\n/** The smallest code of every renaming class of networks with `n` links. */",
