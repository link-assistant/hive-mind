[2026-04-14T08:43:37.120Z] [INFO]         "content": "1\tuse std::fmt::{self, Debug, Formatter};\n2\t\n3\tuse data::{LinkType, Query, ToQuery};\n4\t\n5\t#[derive(Default, Eq, PartialEq, Clone, Hash)]\n6\t#[repr(C)]\n7\tpub struct Link<T: LinkType> {\n8\t    pub index: T,\n9\t    pub source: T,\n10\t    pub target: T,\n11\t}\n12\t\n13\timpl<T: LinkType> Link<T> {\n14\t    #[inline]\n15\t    #[must_use]\n16\t    pub fn nothing() -> Self {\n17\t        Self::default()\n18\t    }\n19\t\n20\t    #[inline]\n21\t    #[must_use]\n22\t    pub const fn new(index: T, source: T, target: T) -> Self {\n23\t        Self {\n24\t            index,\n25\t            source,\n26\t            target,\n27\t        }\n28\t    }\n29\t\n30\t    #[inline]\n31\t    #[must_use]\n32\t    pub const fn point(val: T) -> Self {\n33\t        Self::new(val, val, val)\n34\t    }\n35\t\n36\t    #[inline]\n37\t    pub const fn from_slice(slice: &[T]) -> Self {\n38\t        assert!(slice.len() >= 3);\n39\t\n40\t        // SAFETY: slice has at least 3 elements.\n41\t        unsafe { Self::from_slice_unchecked(slice) }\n42\t    }\n43\t\n44\t    #[inline]\n45\t    #[must_use]\n46\t    pub(crate) const unsafe fn from_slice_unchecked(slice: &[T]) -> Self {\n47\t        match slice {\n48\t            [index, source, target] => Self::new(*index, *source, *target),\n49\t            _ => std::hint::unreachable_unchecked(),\n50\t        }\n51\t    }\n52\t\n53\t    #[inline]\n54\t    #[must_use]\n55\t    pub fn is_null(&self) -> bool {\n56\t        *self == Self::point(T::funty(0))\n57\t    }\n58\t\n59\t    #[inline]\n60\t    #[must_use]\n61\t    pub fn is_full(&self) -> bool {\n62\t        self.index == self.source && self.index == self.target\n63\t    }\n64\t\n65\t    #[inline]\n66\t    #[must_use]\n67\t    pub fn is_partial(&self) -> bool {\n68\t        self.index == self.source || self.index == self.target\n69\t    }\n70\t\n71\t    #[inline]\n72\t    #[must_use]\n73\t    pub const fn as_slice(&self) -> &[T] {\n74\t        // SAFETY: Link is repr(C) and therefore is safe to transmute to a slice\n75\t        unsafe { &*(self as *const Self).cast::<[T; 3]>() }\n76\t    }\n77\t}\n78\t\n79\timpl<T: LinkType> Debug for Link<T> {\n80\t    fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result {\n81\t        write!(f, \"{}: {} {}\", self.index, self.source, self.target)\n82\t    }\n83\t}\n84\t\n85\timpl<T: LinkType> ToQuery<T> for Link<T> {\n86\t    fn to_query(&self) -> Query<'_, T> {\n87\t        self.as_slice().to_query()\n88\t    }\n89\t}\n90\t"
