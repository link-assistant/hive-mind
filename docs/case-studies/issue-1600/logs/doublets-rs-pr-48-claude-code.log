rn Flow::Continue;\n114\t        }\n115\t        let link_base_part = this.get_base_part(link);\n116\t        if link_base_part > base {\n117\t            each_usages_core(this, base, this.get_left_or_default(link), handler)?;\n118\t        } else if link_base_part < base {\n119\t            each_usages_core(this, base, this.get_right_or_default(link), handler)?;\n120\t        } else {\n121\t            handler(this.get_link_value(link))?;\n122\t            each_usages_core(this, base, this.get_left_or_default(link), handler)?;\n123\t            each_usages_core(this, base, this.get_right_or_default(link), handler)?;\n124\t        }\n125\t    }\n126\t    Flow::Continue\n127\t}\n128\t\n129\timpl<T: LinkType> LinksTree<T> for LinksSourcesRecursionlessSizeBalancedTree<T> {\n130\t    fn count_usages(&self, link: T) -> T {\n131\t        unsafe {\n132\t            let mut root = self.get_tree_root();\n133\t            let total = self.get_size(root);\n134\t            let mut total_right_ignore = T::funty(0);\n135\t            while root != T::funty(0) {\n136\t                let base = self.get_base_part(root);\n137\t                if base <= link {\n138\t                    root = self.get_right_or_default(root);\n139\t                } else {\n140\t                    total_right_ignore += self.get_right_size(root) + T::funty(1);\n141\t                    root = self.get_left_or_default(root);\n142\t                }\n143\t            }\n144\t            root = self.get_tree_root();\n145\t            let mut total_left_ignore = T::funty(0);\n146\t            while root != T::funty(0) {\n147\t                let base = self.get_base_part(root);\n148\t                if base >= link {\n149\t                    root = self.get_left_or_default(root);\n150\t                } else {\n151\t                    total_left_ignore += self.get_left_size(root) + T::funty(1);\n152\t                    root = self.get_right_or_default(root);\n153\t                }\n154\t           