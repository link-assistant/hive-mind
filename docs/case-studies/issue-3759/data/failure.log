/section>\n'''\nanchor='            <section id=\"share\" className=\"network__panel\"'\ns=s.replace(anchor,new+anchor)\nopen(p,'w').write(s)\nEOF\ngrep -n \"SECTIONS\" -A8 src/pages/NetworkPage.jsx | head -14",
