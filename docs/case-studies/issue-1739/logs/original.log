        "tool_use_id": "toolu_014w8MgY11eFeQPGutqkydY7",
        "type": "tool_result",
        "content": "1\t/**\n2\t * Browser-commander placeholder e2e (R-F4).\n3\t *\n4\t * The full browser-commander integration awaits the npm package; this\n5\t * test simulates the navigation a real headless browser would perform\n6\t * by exercising every endpoint the SPA's nav buttons trigger when the\n7\t * user clicks them. The contract here is the exact list of `api.*`\n8\t * methods in `src/web/dom.js`. When `browser-commander` lands we\n9\t * replace the fetch calls with `bc.click('[data-view=chat]')`-style\n10\t * commands and these assertions stay valid.\n11\t */\n12\timport { describe, it, expect } from 'test-anywhere';\n13\timport { promises as fs } from 'node:fs';\n14\timport os from 'node:os';\n15\timport path from 'node:path';\n16\timport { startServer } from '../src/server/index.js';\n17\t\n18\tconst seedMessages = async (base) => {\n19\t  const seed = [\n20\t    {\n21\t      id: 'msg:telegram:1',\n22\t      tokens: ['message', 'telegram', '1'],\n23\t      source: 'telegram',\n24\t      sender: 'me',\n25\t      chat: 'general',\n26\t      body: 'where do you live',\n27\t      timestamp: '2024-01-01T00:00:00Z',\n28\t    },\n29\t    {\n30\t      id: 'msg:telegram:2',\n31\t      tokens: ['message', 'telegram', '2'],\n32\t      source: 'telegram',\n33\t      sender: 'alice',\n34\t      chat: 'general',\n35\t      body: 'I live in Berlin',\n36\t      timestamp: '2024-01-01T00:01:00Z',\n37\t    },\n38\t  ];\n39\t  for (const m of seed) {\n40\t    const r = await fetch(`${base}/links`, {\n41\t      method: 'PUT',\n42\t      headers: { 'content-type': 'application/json' },\n43\t      body: JSON.stringify(m),\n44\t    });\n45\t    await r.json();\n46\t  }\n47\t};\n48\t\n49\tdescribe('browser-commander placeholder: drives every SPA nav target', () => {\n50\t  it('serves the SPA shell + every JSON endpoint a nav click triggers', async () => {\n51\t    const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'ms-bc-'));\n52\t    const handle = await startServer({ port: 0, storeDir: dir });\n53\t    const base = `http://127.0.0.1:${handle.port}`;\n54\t    try {\n55\t      // 1. Browser opens \"/\", expects HTML shell with nav buttons.\n56\t      const shellRes = await fetch(`${base}/`);\n57\t      expect(shellRes.status).toBe(200);\n58\t      const shell = await shellRes.text();\n59\t      for (const view of [\n60\t        'chat',\n61\t        'operator',\n62\t        'contacts',\n63\t        'automation',\n64\t        'patterns',\n65\t        'replies',\n66\t        'facts',\n67\t        'audience',\n68\t        'broadcast',\n69\t        'profile',\n70\t        'status',\n71\t      ]) {\n72\t        expect(shell.includes(`data-view=\"${view}\"`)).toBe(true);\n73\t      }\n74\t\n75\t      // 2. SPA bootstraps app.js + app.css.\n76\t      expect((await fetch(`${base}/app.js`)).status).toBe(200);\n77\t      expect((await fetch(`${base}/app.css`)).status).toBe(200);\n78\t\n79\t      // Seed so derived views have something to render.\n80\t      await seedMessages(base);\n81\t\n82\t      // 3. Each nav click triggers its endpoint. Below mirrors the\n83\t      // mapping in src/web/views.js.\n84\t      const clicks = [\n85\t        { view: 'chat', url: '/api/contacts' },\n86\t        { view: 'operator', url: '/links' },\n87\t        { view: 'contacts', url: '/api/contacts' },\n88\t        { view: 'automation', url: '/api/graphs' },\n89\t        { view: 'patterns', url: '/api/patterns' },\n90\t        { view: 'replies', url: '/api/replies' },\n91\t        { view: 'facts', url: '/api/facts' },\n92\t        { view: 'audience', url: '/api/audience?q=network%3Atelegram' },\n93\t        { view: 'profile', url: '/api/profile' },\n94\t        { view: 'status', url: '/api/status' },\n95\t      ];\n96\t      for (const c of clicks) {\n97\t        const r = await fetch(`${base}${c.url}`);\n98\t        expect(r.status).toBe(200);\n99\t        // Force body consumption to avoid Deno's resource leak warning.\n100\t        await r.json();\n101\t      }\n102\t\n103\t      // 4. Composer typing fires autocomplete.\n104\t      const ac = await fetch(`${base}/api/autocomplete?q=where&me=me`);\n105\t      const acBody = await ac.json();\n106\t      expect(Array.isArray(acBody)).toBe(true);\n107\t\n108\t      // 5. Broadcast button posts to every selected network.\n109\t      const bcRes = await fetch(`${base}/api/broadcast`, {\n110\t        method: 'POST',\n111\t        headers: { 'content-type': 'application/json' },\n112\t        body: JSON.stringify({ text: 'hi', networks: ['telegram', 'vk'] }),\n113\t      });\n114\t      const bc = await bcRes.json();\n115\t      expect(bc.networks).toEqual(['telegram', 'vk']);\n116\t    } finally {\n117\t      await handle.close();\n118\t    }\n119\t  });\n120\t});\n121\t"
      }
    ]
