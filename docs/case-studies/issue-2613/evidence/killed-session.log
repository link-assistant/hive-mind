        "content": "});\n\ntest('resolveDefaultFallbackModel returns opus-4-8 for opus alias (bare opus now Opus 5, Issue #2096)', () => {\n  assert.strictEqual(resolveDefaultFallbackModel('claude', 'opus'), 'opus-5', 'opus alias (Opus 5.5) should resolve fallback to opus-5');\n});\n  }\n  assert.deepEqual(chain, ['gpt-5.6-sol', 'gpt-5.6-terra', 'gpt-5.5', 'gpt-5.4', 'gpt-5.2']);\n});\n\ntest('Claude default fallback model resolves from opus to opus-4-8', () => {\n  // Updated for Issue #2096: opus is now claude-opus-5 with fallback to opus-4-8\n  assert.equal(resolveDefaultFallbackModel('claude', 'opus'), 'opus-5');\n});\n\nTesting overload → no --model switch (Issue #1949)\n\n=== 1. Overload (529) is transient, not a capacity error ===\n\n=== 2. Transient errors do NOT switch --model ===\n\n=== 3. Genuine capacity errors still switch (with resolved IDs) ===\n  ❌ \"selected model is at capacity\" switches opus -> fallback\n     Error: argv.model must move to the configured fallback\n+ actual - expected\n\n+ 'opus-5'\n- 'opus-4-8'\n        ^\n\n  ❌ switch warning shows BOTH resolved model IDs (R2)\n     Error: warning must show fallback resolved id, got: 🔀 Switching to fallback model: opus (claude-opus-5-5) -> opus-5 (claude-opus-5)\n\n=== 4. formatModelWithResolvedId renders alias + resolved id ===\n\n=== 5. Multi-level fallback chain walks closest-first ===\n\n=== 6. Retry same model before falling back on capacity ===\n\n============================================================\nResults: 15 passed, 2 failed\n============================================================",
