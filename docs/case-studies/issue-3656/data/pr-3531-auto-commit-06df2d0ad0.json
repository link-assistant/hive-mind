      "blob_url": "https://github.com/link-assistant/hive-mind/blob/06df2d0ad03183f91d5c73c983c6327c39a785be/experiments%2Frun-tests-from.sh",
      "raw_url": "https://github.com/link-assistant/hive-mind/raw/06df2d0ad03183f91d5c73c983c6327c39a785be/experiments%2Frun-tests-from.sh",
      "contents_url": "https://api.github.com/repos/link-assistant/hive-mind/contents/experiments%2Frun-tests-from.sh?ref=06df2d0ad03183f91d5c73c983c6327c39a785be",
      "patch": "@@ -0,0 +1,11 @@\n+#!/usr/bin/env bash\n+# Run the default suite from file N onward (1-based), continuing past failures.\n+# Usage: experiments/run-tests-from.sh N > log\n+start=${1:-1}\n+i=0; fails=()\n+for f in $(node scripts/run-tests.mjs --suite default --list); do\n+  i=$((i+1)); [ \"$i\" -lt \"$start\" ] && continue\n+  echo \"[$i] $f\"\n+  timeout 300 node \"$f\" >/tmp/rt-one.log 2>&1 || { fails+=(\"$f\"); echo \"FAILED: $f\"; tail -40 /tmp/rt-one.log; }\n+done\n+echo \"DONE: ${#fails[@]} failed: ${fails[*]}\""
    }
