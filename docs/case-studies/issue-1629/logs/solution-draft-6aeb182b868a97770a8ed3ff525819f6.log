60| \\n00761| \\n00762| ## Reset all condition-gated items to locked state.\\n00763| ## This undoes any incorrect unlock state that may have been loaded from an old save file,\\n00764| ## ensuring only legitimately earned items remain unlocked (via apply_all_earned_unlocks).\\n00765| func _reset_condition_gated_items() -> void:\\n00766| \\tvar game_manager: Node = get_node_or_null(\\\"/root/GameManager\\\")\\n00767| \\tvar active_item_manager: Node = get_node_or_null(\\\"/root/ActiveItemManager\\\")\\n00768| \\tvar grenade_manager: Node = get_node_or_null(\\\"/root/GrenadeManager\\\")\\n00769| \\n00770| \\tfor condition_key in UNLOCK_CONDITIONS:\\n00771| \\t\\tvar condition: Dictionary = UNLOCK_CONDITIONS[condition_key]\\n00772| \\n00773| \\t\\t# Reset condition-gated weapons\\n00774| \\t\\tif game_manager:\\n00775| \\t\\t\\tfor weapon_id in condition.get(\\\"weapons\\\", []):\\n00776| \\t\\t\\t\\tif weapon_id in game_manager.unlocked_weapons:\\n00777| \\t\\t\\t\\t\\tgame_manager.unlocked_weapons[weapon_id] = false\\n00778| \\n00779| \\t\\t# Reset condition-gated active items\\n00780| \\t\\tif active_item_manager:\\n00781| \\t\\t\\tfor item_type in condition.get(\\\"active_items\\\", []):\\n00782| \\t\\t\\t\\tif item_type in active_item_manager.unlocked_active_items:\\n00783| \\t\\t\\t\\t\\tactive_item_manager.unlocked_active_items[item_type] = false\\n00784| \\n00785| \\t\\t# Reset condition-gated grenades\\n00786| \\t\\tif grenade_manager:\\n00787| \\t\\t\\tfor grenade_type in condition.get(\\\"grenades\\\", []):\\n00788| \\t\\t\\t\\tif grenade_type in grenade_manager.unlocked_grenades:\\n00789| \\t\\t\\t\\t\\tgrenade_manager.unlocked_grenades[grenade_type] = false\\n00790| \\n00791| \\t# Also reset items from multi-level conditions\\n00792| \\tfor multi_condition in MULTI_UNLOCK_CONDITIONS:\\n00793| \\t\\tif game_manager:\\n00794| \\t\\t\\tfor weapon_id in multi_condition.get(\\\"weapons\\\", []):\\n00795| \\t\\t\\t\\tif weapon_id in game_manager.unlocked_weapons