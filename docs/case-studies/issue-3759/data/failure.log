[2026-10-24T15:17:25.370Z] [INFO]           "command": "python3 - <<'EOF'\np='src/pages/pages.css'\ns=open(p).read()\nold=\"\"\".symbols__grid li {\n  display: grid;\n  justify-items: center;\n  padding: 0.3rem 0.2rem 0.4rem;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: rgb(var(--panel-rgb) / calc(0.8 * var(--glass-level, 0.4)));\n  color: var(--accent);\n}\n\n.symbols__grid li:hover {\n  border-color: var(--accent);\n  color: var(--text);\n}\n\n.symbols__grid svg {\n  width: 64px;\n  height: 64px;\n}\n\"\"\"\nnew=\"\"\".symbols__grid li {\n  position: relative;\n  display: grid;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: rgb(var(--panel-rgb) / calc(0.8 * var(--glass-level, 0.4)));\n  color: var(--accent);\n}\n\n.symbols__grid li:hover,\n.symbols__grid li:focus-within {\n  border-color: var(--accent);\n  color: var(--text);\n}\n\n/* The whole card opens the page of the network (issue #17). */\n.symbols__card {\n  display: grid;\n  justify-items: center;\n  padding: 0.3rem 0.2rem 0.4rem;\n  border-radius: inherit;\n  color: inherit;\n  text-decoration: none;\n}\n\n.symbols__card:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n}\n\n.symbols__card svg {\n  width: 64px;\n  height: 64px;\n}\n\n/* The share icon appears on hover (and on keyboard focus, so it can be reached without a mouse). */\n.symbols__share {\n  position: absolute;\n  top: 0.2rem;\n  right: 0.2rem;\n  display: grid;\n  place-items: center;\n  width: 1.6rem;\n  height: 1.6rem;\n  border: 1px solid var(--border);\n  border-radius: 50%;\n  background: rgb(var(--panel-rgb) / 0.85);\n  color: var(--accent);\n  opacity: 0;\n  transition: opacity 0.15s ease;\n}\n\n.symbols__grid li:hover .symbols__share,\n.symbols__share:focus-visible {\n  opacity: 1;\n}\n\n.symbols__share:hover,\n.symbols__share:focus-visible {\n  border-color: var(--accent);\n  color: var(--text);\n}\n\n/* Touch screens have no hover: the icon is always there, but faint. */\n@media (hover: none) {\n  .symbols__share {\n    opacity: 0.7;\n  }\n}\n\"\"\"\nassert old in s\ns=s.replace(old,new)\nopen(p,'w').write(s)\nEOF"
