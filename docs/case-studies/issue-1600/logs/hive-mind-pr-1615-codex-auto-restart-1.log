r usage-limit formatting whenever isUsageLimit=true.\\nlogs.case-study.head.txt:86:- solve.mjs now assigns global.limitResetTime from tool results for auto-continue-limit and PR comments.\\nlogs.src-results-limit.txt:18:// Show session summary and handle limit reached scenarios\\nlogs.src-results-limit.txt:32:      if (argv.autoContinueLimit && global.limitResetTime) {\\nlogs.src-results-limit.txt:33:        await log(`\\\\n🔄 AUTO-CONTINUE ENABLED - Will resume at ${global.limitResetTime}`);\\nlogs.src-results-limit.txt:36:        // Only show resume recommendation if --no-auto-cleanup was passed\\nlogs.src-results-limit.txt:38:          await log('\\\\n🔄 To resume when limit resets, use:\\\\n');\\nlogs.src-results-limit.txt:39:          await log(`./solve.mjs \\\"${issueUrl}\\\" --resume ${sessionId}`);\\nlogs.src-results-limit.txt:41:          if (global.limitResetTime) {\\nlogs.src-results-limit.txt:42:            await log(`\\\\n💡 Or enable auto-continue-limit to wait until ${global.limitResetTime}:\\\\n`);\\nlogs.src-results-limit.txt:43:            await log(`./solve.mjs \\\"${issueUrl}\\\" --resume ${sessionId} --auto-continue-limit`);\\nlogs.src-results-limit.txt:53:      // Show command to resume session in interactive mode only if --no-auto-cleanup was passed\\nlogs.src-results-limit.txt:56:        await log(`   (cd ${tempDir} && claude --resume ${sessionId})`);\\nci-logs/issue-719.json:1:{\\\"assignees\\\":[],\\\"author\\\":{\\\"id\\\":\\\"MDQ6VXNlcjE0MzE5MDQ=\\\",\\\"is_bot\\\":false,\\\"login\\\":\\\"konard\\\",\\\"name\\\":\\\"Konstantin Diachenko\\\"},\\\"body\\\":\\\"```\\\\n[2025-11-12T11:47:04.135Z] [INFO] 📌 Session ID: 019a77e4-0716-7152-8396-b642e26c3e20\\\\n[2025-11-12T11:47:04.163Z] [INFO] {\\\\\\\"type\\\\\\\":\\\\\\\"turn.started\\\\\\\"}\\\\n\\\\n[2025-11-12T11:47:04.639Z] [INFO] {\\\\\\\"type\\\\\\\":\\\\\\\"error\\\\\\\",\\\\\\\"message\\\\\\\":\\\\\\\"You've hit your usage limit. To get more access now, send a request to your admin or try