lf.get_left_size(root) + T::funty(1);\n156\t                    root = self.get_right_or_default(root);\n157\t                }\n158\t            }\n159\t            total - total_right_ignore - total_left_ignore\n160\t        }\n161\t    }\n162\t\n163\t    fn search(&self, source: T, target: T) -> T {\n164\t        unsafe {\n165\t            let mut root = self.get_tree_root();\n166\t            while root != T::funty(0) {\n167\t                let root_link = self.get_data_part(root);\n168\t                let root_source = root_link.source;\n169\t                let root_target = root_link.target;\n170\t                if self.first_is_to_the_left_of_second_4(source, target, root_source, root_target) {\n171\t                    root = self.get_left_or_default(root);\n172\t                } else if self.first_is_to_the_right_of_second_4(\n173\t                    source,\n174\t                    target,\n175\t                    root_source,\n176\t                    root_target,\n177\t                ) {\n178\t                    root = self.get_right_or_default(root);\n179\t                } else {\n180\t                    return root;\n181\t                }\n182\t            }\n183\t            T::funty(0)\n184\t        }\n185\t    }\n186\t\n187\t    fn each_usages<H: FnMut(Link<T>) -> Flow + ?Sized>(&self, root: T, handler: &mut H) -> Flow {\n188\t        each_usages_core(self, root, self.get_tree_root(), handler)\n189\t    }\n190\t\n191\t    fn detach(&mut self, root: &mut T, index: T) {\n192\t        unsafe { NoRecurSzbTree::detach(self, root as *mut _, index) }\n193\t    }\n194\t\n195\t    fn attach(&mut self, root: &mut T, index: T) {\n196\t        unsafe { NoRecurSzbTree::attach(self, root as *mut _, index) }\n197\t    }\n198\t}\n199\t\n200\timpl<T: LinkType> SplitUpdateMem<T> for ExternalTargetsRecursionlessTree<T> {\n201\t    fn update_mem(&mut self, data: NonNull<[DataPart<T>]>, indexes: NonNull<[IndexPart<T>]>) {\n202\t        self.base.indexes = i