prefix)) for prefix in plan['\\''binary-prefixes'\\'']):\n        raise ValueError('\\''unowned_binary_cannot_be_staged'\\'')\n    else:\n        data.decode('\\''utf-8'\\'', '\\''strict'\\'')\n\nexpected = plan['\\''ignored'\\'']\nif ignored != expected:\n    raise ValueError('\\''hygiene_classification_changed'\\'')\nignore_path = owned_path('\\''.gitignore'\\'')\noriginal = b'\\'''\\''\nidentity = None\nif ignore_path.exists():\n    original, identity = read_regular(ignore_path, MAXIMUM_FILE_BYTES)\n\ndef ignore_line(value):\n    escaped = '\\'''\\''.join('\\''\\\\'\\'' + character if character in '\\''\\\\*?[]!# '\\'' else character for character in value)\n    return ('\\''/'\\'' + escaped).encode('\\''utf-8'\\'')\n\nlines = original.splitlines()\nadditions = [ignore_line(value) for value in ignored if ignore_line(value) not in lines]\nif additions:\n    updated = original + (b'\\''\\n'\\'' if original and not original.endswith(b'\\''\\n'\\'') else b'\\'''\\'')\n    updated += b'\\''\\n'\\''.join(additions) + b'\\''\\n'\\''\n    if len(updated) > MAXIMUM_FILE_BYTES:\n        raise ValueError('\\''ignore_file_limit'\\'')\n    write_regular_atomic(ignore_path, updated, identity)\nfor path, identity, expected in placeholders:\n    data, current = read_regular(path, MAXIMUM_FILE_BYTES)\n    if data != expected or current != identity:\n        raise ValueError('\\''placeholder_identity_changed'\\'')\n    path.unlink()\nprint(json.dumps({'\\''ignored'\\'': ignored, '\\''physical_bytes_preserved'\\'': not placeholders, '\\''placeholders_removed'\\'': len(placeholders)}, sort_keys=True))\n' '{\"binary-prefixes\":[\"7f454c46\",\"504b0304\",\"504b0506\",\"cafebabe\",\"cffaedfe\",\"cefaedfe\",\"feedfacf\",\"feedface\",\"4d5a\"],\"empty-evidence-suffixes\":[\"-stream.jsonl\",\"/session-id.txt\"],\"evidence-root\":\"dev/log/self-authored/\",\"files\":[\"Main.kt\",\"ci/test-hello-world.yml\",\"tests/verify-output.sh\",\".gitkeep\"],\"ignored\":[],\"outputs\":[{\"output\":\"m