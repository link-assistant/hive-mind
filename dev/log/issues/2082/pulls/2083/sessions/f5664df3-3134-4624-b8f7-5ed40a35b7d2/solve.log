[2026-07-19T12:49:27.881Z] [INFO]         "content": "1\t#!/usr/bin/env node\n2\t\n3\t/**\n4\t * Publish to npm using OIDC trusted publishing, with reliable failure detection.\n5\t *\n6\t * Usage: node scripts/publish-to-npm.mjs [--should-pull]\n7\t *   --should-pull: Pull latest changes before publishing (used by the release job)\n8\t *\n9\t * Why this was rewritten (issue #2028, CI run 29035249489):\n10\t *   The previous version ran `await $\\`npm run changeset:publish\\`` and treated\n11\t *   the absence of a thrown error as success. command-stream's `$` does NOT throw\n12\t *   on a non-zero exit code (see\n13\t *   docs/dependencies-research/command-stream-issues/), so a failed publish was\n14\t *   reported as `published=true`. On top of that, `changeset publish` can print\n15\t *   \"packages failed to publish\" while still exiting 0. The combination produced\n16\t *   a FALSE POSITIVE release: the job went green, `published_version` was set, and\n17\t *   the downstream Docker \"Wait for NPM package\" jobs then failed after 5 minutes\n18\t *   waiting for a version that was never published.\n19\t *\n20\t * This version:\n21\t *   - Runs commands via child_process.spawn so the real exit code is always\n22\t *     observed (mirrors scripts/npm-install-with-retry.mjs, issue #1903).\n23\t *   - Scans the combined output for known failure patterns, because\n24\t *     `changeset publish` masks the underlying npm exit code.\n25\t *   - Verifies the version is actually live on npm AFTER a \"successful\" publish.\n26\t *   - Fast-fails non-retryable authentication/registry errors with guidance.\n27\t *   - Exposes its core as injectable, testable functions.\n28\t *\n29\t * Uses only Node built-ins so it has no dependency on node_modules state.\n30\t */\n31\t\n32\timport { readFileSync, appendFileSync } from 'node:fs';\n33\timport { spawn } from 'node:child_process';\n34\timport { detectPublishFailure, isNonRetryableFailure, buildAuthFailureGuidance } from './publish-failure-classifier.mjs';\n35\t\n36\texport const PACKAGE_NAME = '@link-assistant/hive-mind';\n37\tconst DEFAULT_MAX_RETRIES = 3;\n38\tconst DEFAULT_RETRY_DELAY_MS = 10000; // 10 seconds\n39\t\n40\t/**\n41\t * Sleep for the specified milliseconds.\n42\t * @param {number} ms\n43\t */\n44\texport function sleep(ms) {\n45\t  return new Promise(resolve => setTimeout(resolve, ms));\n46\t}\n47\t\n48\t/**\n49\t * Run a command, streaming output to the parent stdio while buffering it so the\n50\t * text can be inspected. Always resolves with the real exit code — never throws\n51\t * on a non-zero exit (that silent-failure behaviour is exactly what caused the\n52\t * false-positive release this script now guards against).\n53\t *\n54\t * @param {string} command\n55\t * @param {string[]} args\n56\t * @param {{spawner?: typeof spawn}} [opts]\n57\t * @returns {Promise<{code:number, stdout:string, stderr:string, message:string}>}\n58\t */\n59\texport const runCommand = (command, args, { spawner = spawn } = {}) =>\n60\t  new Promise(resolve => {\n61\t    const child = spawner(command, args, { stdio: ['inherit', 'pipe', 'pipe'] });\n62\t    let stdout = '';\n63\t    let stderr = '';\n64\t    child.stdout?.on('data', chunk => {\n65\t      stdout += chunk.toString();\n66\t      process.stdout.write(chunk);\n67\t    });\n68\t    child.stderr?.on('data', chunk => {\n69\t      stderr += chunk.toString();\n70\t      process.stderr.write(chunk);\n71\t    });\n72\t    child.on('error', error => resolve({ code: 1, stdout, stderr, message: error.message }));\n73\t    child.on('close', code => resolve({ code: code ?? 1, stdout, stderr, message: '' }));\n74\t  });\n75\t\n76\t/**\n77\t * Append a key/value pair to the GitHub Actions output file.\n78\t * @param {string} key\n79\t * @param {string} value\n80\t */\n81\texport function setOutput(key, value, { appender = appendFileSync, env = process.env, logger = console } = {}) {\n82\t  const outputFile = env.GITHUB_OUTPUT;\n83\t  if (outputFile) {\n84\t    logger.log(`Setting GitHub output: ${key}=${value}`);\n85\t    appender(outputFile, `${key}=${value}\\n`);\n86\t    logger.log(`Output written to ${outputFile}`);\n87\t  } else {\n88\t    logger.log(`GITHUB_OUTPUT not set, would have set: ${key}=${value}`);\n89\t  }\n90\t}\n91\t\n92\t/**\n93\t * Decide whether a publish attempt succeeded, given the runner result.\n94\t *\n95\t * A publish is a SUCCESS only when BOTH signals agree:\n96\t *   - the command exited 0, AND\n97\t *   - the combined output contains no known failure pattern.\n98\t *\n99\t * Both checks are required: command-stream never throws on non-zero exit, and\n100\t * `changeset publish` can print a failure while still exiting 0.\n101\t *\n102\t * @param {{code:number, stdout?:string, stderr?:string, message?:string}} result\n103\t * @returns {{ok:boolean, reason?:string, output:string, nonRetryable:boolean}}\n104\t */\n105\texport function analyzePublishResult(result) {\n106\t  const output = `${result.stdout || ''}\\n${result.stderr || ''}\\n${result.message || ''}`;\n107\t  const nonRetryable = isNonRetryableFailure(output);\n108\t\n109\t  if (result.code !== 0) {\n110\t    return { ok: false, reason: `exit code ${result.code}`, output, nonRetryable };\n111\t  }\n112\t\n113\t  const failurePattern = detectPublishFailure(output);\n114\t  if (failurePattern) {\n115\t    return { ok: false, reason: `failure pattern \"${failurePattern}\" in output`, output, nonRetryable };\n116\t  }\n117\t\n118\t  return { ok: true, output, nonRetryable: false };\n119\t}\n120\t\n121\t/**\n122\t * Check whether a specific version is live on the npm registry.\n123\t * @param {(command:string, args:string[]) => Promise<{code:number}>} runner\n124\t * @param {string} version\n125\t * @returns {Promise<boolean>}\n126\t */\n127\texport async function isVersionPublished(runner, version) {\n128\t  const result = await runner('npm', ['view', `${PACKAGE_NAME}@${version}`, 'version']);\n129\t  return result.code === 0;\n130\t}\n131\t\n132\t/**\n133\t * Publish with retries, multi-layer failure detection, and post-publish\n134\t * verification against the registry.\n135\t *\n136\t * @param {object} opts\n137\t * @param {(command:string, args:string[]) => Promise<{code:number, stdout?:string, stderr?:string, message?:string}>} opts.runner\n138\t * @param {string} opts.version\n139\t * @param {number} [opts.maxRetries]\n140\t * @param {number} [opts.retryDelayMs]\n141\t * @param {(ms:number)=>Promise<void>} [opts.sleeper]\n142\t * @param {Console} [opts.logger]\n143\t * @returns {Promise<{ok:boolean, attempt?:number, reason?:string, nonRetryable?:boolean}>}\n144\t */\n145\texport async function publishWithRetry({ runner, version, maxRetries = DEFAULT_MAX_RETRIES, retryDelayMs = DEFAULT_RETRY_DELAY_MS, sleeper = sleep, logger = console }) {\n146\t  let lastReason = 'unknown';\n147\t  for (let attempt = 1; attempt <= maxRetries; attempt++) {\n148\t    logger.log(`Publish attempt ${attempt} of ${maxRetries}...`);\n149\t    const result = await runner('npm', ['run', 'changeset:publish']);\n150\t    const analysis = analyzePublishResult(result);\n151\t\n152\t    if (analysis.ok) {\n153\t      // Never trust the publish command alone — verify the version is really on\n154\t      // the registry. This is the last line of defence against a false-positive\n155\t      // release (the exact failure mode of run 29035249489).\n156\t      logger.log(`Publish command reported success; verifying ${PACKAGE_NAME}@${version} on npm...`);\n157\t      const published = await isVersionPublished(runner, version);\n158\t      if (published) {\n159\t        logger.log(`Verified ${PACKAGE_NAME}@${version} is live on npm`);\n160\t        return { ok: true, attempt };\n161\t      }\n162\t      lastReason = 'post-publish verification failed: version not found on npm';\n163\t      logger.error(`WARNING: ${lastReason}`);\n164\t    } else {\n165\t      lastReason = analysis.reason;\n166\t      logger.error(`Publish attempt ${attempt} failed: ${analysis.reason}`);\n167\t\n168\t      if (analysis.nonRetryable) {\n169\t        logger.error(buildAuthFailureGuidance(PACKAGE_NAME));\n170\t        return { ok: false, attempt, reason: analysis.reason, nonRetryable: true };\n171\t      }\n172\t    }\n173\t\n174\t    if (attempt < maxRetries) {\n175\t      logger.log(`Waiting ${retryDelayMs / 1000}s before retry...`);\n176\t      await sleeper(retryDelayMs);\n177\t    }\n178\t  }\n179\t\n180\t  return { ok: false, reason: lastReason, nonRetryable: false };\n181\t}\n182\t\n183\t/**\n184\t * Read the version to publish from package.json.\n185\t * @param {string} [path]\n186\t * @returns {string}\n187\t */\n188\texport function readCurrentVersion(path = './package.json') {\n189\t  const packageJson = JSON.parse(readFileSync(path, 'utf8'));\n190\t  return packageJson.version;\n191\t}\n192\t\n193\t/**\n194\t * Full publish flow, with injectable dependencies for testing.\n195\t * @param {object} opts\n196\t * @param {(command:string, args:string[]) => Promise<{code:number, stdout?:string, stderr?:string, message?:string}>} opts.runner\n197\t * @param {boolean} opts.shouldPull\n198\t * @param {string} opts.version\n199\t * @param {(key:string, value:string)=>void} [opts.output]\n200\t * @param {(ms:number)=>Promise<void>} [opts.sleeper]\n201\t * @param {Console} [opts.logger]\n202\t * @returns {Promise<{published:boolean, alreadyPublished?:boolean, reason?:string}>}\n203\t */\n204\texport async function runPublishFlow({ runner, shouldPull, version, output = setOutput, sleeper = sleep, logger = console }) {\n205\t  if (shouldPull) {\n206\t    // Pull the changes the version-bump commit just pushed.\n207\t    const pullResult = await runner('git', ['pull', 'origin', 'main']);\n208\t    if (pullResult.code !== 0) {\n209\t      throw new Error(`git pull origin main failed with exit code ${pullResult.code}`);\n210\t    }\n211\t  }\n212\t\n213\t  logger.log(`Current version to publish: ${version}`);\n214\t\n215\t  // Skip publishing if this version is already on npm (idempotent re-runs).\n216\t  logger.log(`Checking if version ${version} is already published...`);\n217\t  if (await isVersionPublished(runner, version)) {\n218\t    logger.log(`Version ${version} is already published to npm`);\n219\t    output('published', 'true');\n220\t    output('published_version', version);\n221\t    output('already_published', 'true');\n222\t    return { published: true, alreadyPublished: true };\n223\t  }\n224\t  logger.log(`Version ${version} not found on npm, proceeding with publish...`);\n225\t\n226\t  const result = await publishWithRetry({ runner, version, sleeper, logger });\n227\t  if (result.ok) {\n228\t    output('published', 'true');\n229\t    output('published_version', version);\n230\t    logger.log(`Published ${PACKAGE_NAME}@${version} to npm`);\n231\t    return { published: true };\n232\t  }\n233\t\n234\t  output('published', 'false');\n235\t  logger.error(`Failed to publish ${PACKAGE_NAME}@${version}: ${result.reason}`);\n236\t  return { published: false, reason: result.reason };\n237\t}\n238\t\n239\tasync function main() {\n240\t  // Parse CLI arguments using lino-arguments (loaded via use-m).\n241\t  const { ensureUseM } = await import('../src/use-m-bootstrap.lib.mjs');\n242\t  const use = await ensureUseM();\n243\t  const { makeConfig } = await use('lino-arguments');\n244\t\n245\t  const config = makeConfig({\n246\t    yargs: ({ yargs, getenv }) =>\n247\t      yargs.option('should-pull', {\n248\t        type: 'boolean',\n249\t        default: getenv('SHOULD_PULL', false),\n250\t        describe: 'Pull latest changes before publishing',\n251\t      }),\n252\t  });\n253\t\n254\t  const version = readCurrentVersion();\n255\t  const { published } = await runPublishFlow({\n256\t    runner: runCommand,\n257\t    shouldPull: config.shouldPull,\n258\t    version,\n259\t  });\n260\t\n261\t  if (!published) {\n262\t    process.exit(1);\n263\t  }\n264\t}\n265\t\n266\tconst isMain = import.meta.url === `file://${process.argv[1]}` || process.argv[1]?.endsWith('publish-to-npm.mjs');\n267\tif (isMain) {\n268\t  main().catch(error => {\n269\t    console.error('Error:', error.message);\n270\t    process.exit(1);\n271\t  });\n272\t}\n273\t"
