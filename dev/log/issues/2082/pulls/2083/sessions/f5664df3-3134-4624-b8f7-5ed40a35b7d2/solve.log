n/**\n * Count changeset files (excluding README.md)\n */\nfunction countChangesets() {\n  try {\n    return readdirSync('.changeset').filter(f => f.endsWith('.md') && f !== 'README.md').length;\n  } catch {\n    return 0;\n  }\n}\n\ntry {\n  await versionAndCommit({\n    mode,\n    bumpType,\n    description,\n    output: setOutput,\n    countChangesets,\n    verbose: isVerbose(),\n  });\n} catch (error) {\n  console.error('Error:', error.message);\n  process.exit(1);\n}\n'''\nopen(p,'w').write(head + tail)\nPY\nnode --check scripts/version-and-commit.mjs && npx eslint scripts/version-and-commit.mjs scripts/version-and-commit.lib.mjs && node tests/version-and-commit-2082.test.mjs && echo OK",
