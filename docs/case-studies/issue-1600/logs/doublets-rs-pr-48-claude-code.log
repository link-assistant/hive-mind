der_root();\n254\t        self.attach_external_source_unchecked(root, index);\n255\t    }\n256\t\n257\t    unsafe fn attach_external_target(&mut self, index: T) {\n258\t        let root = self.mut_target_header_root();\n259\t        self.attach_external_target_unchecked(root, index);\n260\t    }\n261\t\n262\t    fn update_mem(&mut self, data: NonNull<[DataPart<T>]>, index: NonNull<[IndexPart<T>]>) {\n263\t        self.data_ptr = data;\n264\t        self.index_ptr = index;\n265\t\n266\t        self.internal_sources.update_mem(data, index);\n267\t        self.external_sources.update_mem(data, index);\n268\t        self.internal_targets.update_mem(data, index);\n269\t        self.external_targets.update_mem(data, index);\n270\t        self.sources_list.update_mem(data, index);\n271\t        self.unused.update_mem(data, index);\n272\t    }\n273\t\n274\t    fn align(mut to_align: usize, target: usize) -> usize {\n275\t        debug_assert!(to_align >= target);\n276\t\n277\t        // TODO: optimize this `if`\n278\t        if to_align % target != 0 {\n279\t            to_align = ((to_align / target) * target) + target;\n280\t        }\n281\t        to_align\n282\t    }\n283\t\n284\t    unsafe fn init(&mut self) -> Result<(), LinksError<T>> {\n285\t        let data = NonNull::from(crate::mem::resize_mem(\n286\t            &mut self.data_mem,\n287\t            DEFAULT_PAGE_SIZE,\n288\t        )?);\n289\t        let index = NonNull::from(crate::mem::resize_mem(\n290\t            &mut self.index_mem,\n291\t            DEFAULT_PAGE_SIZE,\n292\t        )?);\n293\t        self.update_mem(data, index);\n294\t\n295\t        let header = self.get_header().clone();\n296\t        let allocated = header.allocated.as_usize();\n297\t\n298\t        let mut data_capacity = allocated;\n299\t        data_capacity = data_capacity.max(self.data_mem.allocated().len());\n300\t        data_capacity = data_capacity.max(self.data_step);\n301\t\n302\t        let mut index_capacity = allocated;\n303\t        index_capacity = index_capacity.max(self.index_mem.allocated().len());\n304\t        index_capacity = index_capacity.max(self.index_step);\n305\t\n306\t        data_capacity = Self::align(data_capacity, self.data_step);\n307\t        index_capacity = Self::align(index_capacity, self.index_step);\n308\t\n309\t        let data = NonNull::from(crate::mem::resize_mem(&mut self.data_mem, data_capacity)?);\n310\t        let index = NonNull::from(crate::mem::resize_mem(&mut self.index_mem, index_capacity)?);\n311\t        self.update_mem(data, index);\n312\t\n313\t        self.mut_header().reserved =\n314\t            T::try_from(self.data_mem.allocated().len() - 1).expect(\"always ok\");\n315\t        Ok(())\n316\t    }\n317\t\n318\t    fn total(&self) -> T {\n319\t        let header = self.get_header();\n320\t        header.allocated - header.free\n321\t    }\n322\t\n323\t    pub fn is_unused(&self, link: T) -> bool {\n324\t        let header = self.get_header();\n325\t        if link <= header.allocated && header.first_free != link {\n326\t            // TODO: May be this check is not needed\n327\t            let index = self.get_index_part(link);\n328\t            let data = self.get_data_part(link);\n329\t            index.size_as_target == crate::funty::<T>(0) && data.source != crate::funty::<T>(0)\n330\t        } else {\n331\t            true\n332\t        }\n333\t    }\n334\t\n335\t    //fn is_non_\n336\t\n337\t    pub fn is_virtual(&self, link: T) -> bool {\n338\t        self.is_unused(link)\n339\t    }\n340\t\n341\t    pub fn exists(&self, link: T) -> bool {\n342\t        let constants = self.constants();\n343\t        let header = self.get_header();\n344\t\n345\t        // TODO: use attributes expressions feature\n346\t        // TODO: use `Range::contains`\n347\t        link >= *constants.internal_range.start()\n348\t            && link <= header.allocated\n349\t            && !self.is_unused(link)\n350\t    }\n351\t\n352\t    // SAFETY: must be link exists\n353\t    unsafe fn get_link_unchecked(&self, index: T) -> Link<T> {\n354\t        debug_assert!(self.exists(index));\n355\t\n356\t        let raw = self.get_data_unchecked(index);\n357\t        Link::new(index, raw.source, raw.target)\n358\t    }\n359\t\n360\t    fn try_each_by_core(&self, handler: ReadHandler<'_, T>, query: &[T]) -> Flow {\n361\t        let query = query.to_query();\n362\t\n363\t        if query.is_empty() {\n364\t            let mut index = crate::funty::<T>(1);\n365\t            let allocated = self.get_header().allocated;\n366\t            while index <= allocated {\n367\t                if let Some(link) = self.get_link(index) {\n368\t                    if handler(link).is_break() {\n369\t                        return Flow::Break;\n370\t                    }\n371\t                }\n372\t                index = index + crate::funty::<T>(1);\n373\t            }\n374\t            return Flow::Continue;\n375\t        }\n376\t\n377\t        let constants = self.constants.clone();\n378\t        let any = constants.any;\n379\t        let index = query[constants.index_part.as_usize()];\n380\t        if query.len() == 1 {\n381\t            return if index == any {\n382\t                self.try_each_by_core(handler, &[])\n383\t            } else if let Some(link) = self.get_link(index) {\n384\t                handler(link)\n385\t            } else {\n386\t                Flow::Continue\n387\t            };\n388\t        }\n389\t        //\n390\t        if query.len() == 2 {\n391\t            let value = query[1];\n392\t            return if index == any {\n393\t                if value == any {\n394\t                    self.try_each_by_core(handler, &[])\n395\t                } else {\n396\t                    if self\n397\t                        .try_each_by_core(handler, &[index, value, any])\n398\t                        .is_break()\n399\t                    {\n400\t                        return Flow::Break;\n401\t                    }\n402\t                    self.try_each_by_core(handler, &[index, any, value])\n403\t                }\n404\t            } else if let Some(link) = self.get_link(index) {\n405\t                if value == any || link.source == value || link.target == value {\n406\t                    handler(link)\n407\t                } else {\n408\t                    Flow::Continue\n409\t                }\n410\t            } else {\n411\t                Flow::Continue\n412\t            };\n413\t        }\n414\t        //\n415\t        if query.len() == 3 {\n416\t            let source = query[constants.source_part.as_usize()];\n417\t            let target = query[constants.target_part.as_usize()];\n418\t            let is_virtual_source = self.is_virtual(source);\n419\t            let is_virtual_target = self.is_virtual(target);\n420\t\n421\t            return if index == any {\n422\t                if (source, target) == (any, any) {\n423\t                    self.try_each_by_core(handler, &[])\n424\t                } else if source == any {\n425\t                    if is_virtual_target {\n426\t                        self.external_targets.each_usages(target, handler)\n427\t                    } else {\n428\t                        self.internal_targets.each_usages(target, handler)\n429\t                    }\n430\t                } else if target == any {\n431\t                    if is_virtual_source {\n432\t                        self.external_sources.each_usages(source, handler)\n433\t                    } else if Self::USE_LIST {\n434\t                        self.sources_list.each_usages(source, handler)\n435\t                    } else {\n436\t                        self.internal_sources.each_usages(source, handler)\n437\t                    }\n438\t                } else {\n439\t                    let link = if true {\n440\t                        if is_virtual_source && is_virtual_target {\n441\t                            self.external_sources.search(source, target)\n442\t                        } else if is_virtual_source {\n443\t                            self.internal_targets.search(source, target)\n444\t                        } else if is_virtual_target {\n445\t                            if Self::USE_LIST {\n446\t                                self.external_sources.search(source, target)\n447\t                            } else {\n448\t                                self.internal_sources.search(source, target)\n449\t                            }\n450\t                        } else if Self::USE_LIST\n451\t                            || self.internal_sources.count_usages(source)\n452\t                                > self.internal_targets.count_usages(target)\n453\t                        {\n454\t                            self.internal_targets.search(source, target)\n455\t                        } else {\n456\t                            self.internal_sources.search(source, target)\n457\t                        }\n458\t                    } else if Self::USE_LIST\n459\t                        || self.internal_sources.count_usages(source)\n460\t                            > self.internal_targets.count_usages(target)\n461\t                    {\n462\t                        self.internal_targets.search(source, target)\n463\t                    } else {\n464\t                        self.internal_sources.search(source, target)\n465\t                    };\n466\t                    return if link == constants.null {\n467\t                        Flow::Continue\n468\t                    } else {\n469\t                        // SAFETY: link 100% exists\n470\t                        let link = unsafe { self.get_link(link).unwrap_unchecked() };\n471\t                        handler(link)\n472\t                    };\n473\t                }\n474\t            } else if let Some(link) = self.get_link(index) {\n475\t                if (source, target) == (any, any) {\n476\t                    handler(link)\n477\t                } else if source != any && target != any {\n478\t                    if (link.source, link.target) == (source, target) {\n479\t                        handler(link)\n480\t                    } else {\n481\t                        Flow::Continue\n482\t                    }\n483\t                } else if source == any {\n484\t                    if link.target == target {\n485\t                        handler(link)\n486\t                    } else {\n487\t                        Flow::Continue\n488\t                    }\n489\t                } else if target == any {\n490\t                    if link.source == source {\n491\t                        handler(link)\n492\t                    } else {\n493\t                        Flow::Continue\n494\t                    }\n495\t                } else {\n496\t                    Flow::Continue\n497\t                }\n498\t            } else {\n499\t                Flow::Continue\n500\t            };\n501\t        }\n502\t        todo!()\n503\t    }\n504\t\n505\t    fn resolve_danglind_internal(&mut self, index: T) {\n506\t        let any = self.constants.any;\n507\t        let links: Vec<_> = self\n508\t            .each_iter([any, index, any])\n509\t            .filter(|link| link.index != index)\n510\t            .collect();\n511\t        for link in links {\n512\t            unsafe {\n513\t                self.detach_internal_source(index, link.index);\n514\t                self.attach_external_source(link.index);\n515\t            }\n516\t        }\n517\t\n518\t        let links: Vec<_> = self\n519\t            .each_iter([any, any, index])\n520\t            .filter(|link| link.index != index)\n521\t            .filter(|link| !link.is_full())\n522\t            .collect();\n523\t        for link in links {\n524\t            unsafe {\n525\t                self.detach_internal_target(index, link.index);\n526\t                self.attach_external_target(link.index);\n527\t            }\n528\t        }\n529\t    }\n530\t\n531\t    fn resolve_danglind_external(&mut self, free: T) {\n532\t        let any = self.constants().any;\n533\t        let links: Vec<_> = self\n534\t            .each_iter([any, free, any])\n535\t            .filter(|link| link.index != free)\n536\t            .collect();\n537\t        for link in links {\n538\t            unsafe {\n539\t                self.detach_external_source(link.index);\n540\t                self.attach_internal_source(free, link.index);\n541\t            }\n542\t        }\n543\t\n544\t        let links: Vec<_> = self\n545\t            .each_iter([any, any, free])\n546\t            .filter(|link| link.index != free)\n547\t            .filter(|link| !link.is_full())\n548\t            .collect();\n549\t        for link in links {\n550\t            unsafe {\n551\t                self.detach_external_target(link.index);\n552\t                self.attach_internal_target(free, link.index);\n553\t            }\n554\t        }\n555\t    }\n556\t}\n557\t\n558\timpl<\n559\t        T: LinkType + crate::TreesLinkType,\n560\t        MD: RawMem<Item = DataPart<T>>,\n561\t        MI: RawMem<Item = IndexPart<T>>,\n562\t        IS: SplitTree<T>,\n563\t        ES: SplitTree<T>,\n564\t        IT: SplitTree<T>,\n565\t        ET: SplitTree<T>,\n566\t        UL: SplitList<T>,\n567\t    > Links<T> for Store<T, MD, MI, IS, ES, IT, ET, UL>\n568\t{\n569\t    fn constants(&self) -> &LinksConstants<T> {\n570\t        &self.constants\n571\t    }\n572\t\n573\t    fn count_links(&self, query: &[T]) -> T {\n574\t        if query.is_empty() {\n575\t            return self.total();\n576\t        }\n577\t\n578\t        let constants = self.constants();\n579\t        let any = constants.any;\n580\t        let index = query[constants.index_part.as_usize()];\n581\t        if query.len() == 1 {\n582\t            return if index == any {\n583\t                self.total()\n584\t            } else if self.exists(index) {\n585\t                crate::funty::<T>(1)\n586\t            } else {\n587\t                crate::funty::<T>(0)\n588\t            };\n589\t        }\n590\t\n591\t        if query.len() == 2 {\n592\t            let value = query[1];\n593\t            let is_virtual_val = self.is_virtual(value);\n594\t\n595\t            return if index == any {\n596\t                if value == any {\n597\t                    self.total()\n598\t                } else if is_virtual_val {\n599\t                    self.external_sources.count_usages(value)\n600\t                        + self.external_targets.count_usages(value)\n601\t                } else if Self::USE_LIST {\n602\t                    self.sources_list.count_usages(value)\n603\t                        + self.internal_targets.count_usages(value)\n604\t                } else {\n605\t                    self.internal_sources.count_usages(value)\n606\t                        + self.internal_targets.count_usages(value)\n607\t                }\n608\t            } else if !self.exists(index) {\n609\t                crate::funty::<T>(0)\n610\t            } else if value == any {\n611\t                crate::funty::<T>(1)\n612\t            } else {\n613\t                let stored = self.get_data_part(index);\n614\t                if (stored.source, stored.target) == (value, value) {\n615\t                    crate::funty::<T>(1)\n616\t                } else {\n617\t                    crate::funty::<T>(0)\n618\t                }\n619\t            };\n620\t        }\n621\t\n622\t        if query.len() == 3 {\n623\t            let source = query[constants.source_part.as_usize()];\n624\t            let target = query[constants.target_part.as_usize()];\n625\t\n626\t            let is_virtual_source = self.is_virtual(source);\n627\t            let is_virtual_target = self.is_virtual(target);\n628\t\n629\t            return if index == any {\n630\t                if (source, target) == (any, any) {\n631\t                    self.total()\n632\t                } else if source == any {\n633\t                    if is_virtual_target {\n634\t                        self.external_targets.count_usages(target)\n635\t                    } else {\n636\t                        self.internal_targets.count_usages(target)\n637\t                    }\n638\t                } else if is_virtual_source {\n639\t                    self.external_sources.count_usages(source)\n640\t                } else if target == any {\n641\t                    if Self::USE_LIST {\n642\t                        self.sources_list.count_usages(source)\n643\t                    } else {\n644\t                        self.internal_sources.count_usages(source)\n645\t                    }\n646\t                } else {\n647\t                    let link = if true {\n648\t                        if is_virtual_source && is_virtual_target {\n649\t                            self.external_sources.search(source, target)\n650\t                        } else if is_virtual_source {\n651\t                            self.internal_targets.search(source, target)\n652\t                        } else if is_virtual_target {\n653\t                            if Self::USE_LIST {\n654\t                                self.external_sources.search(source, target)\n655\t                            } else {\n656\t                                self.internal_sources.search(source, target)\n657\t                            }\n658\t                        } else if Self::USE_LIST\n659\t                            || self.internal_sources.count_usages(source)\n660\t                                > self.internal_targets.count_usages(target)\n661\t                        {\n662\t                            self.internal_targets.search(source, target)\n663\t                        } else {\n664\t                            self.internal_sources.search(source, target)\n665\t                        }\n666\t                    } else if Self::USE_LIST\n667\t                        || self.internal_sources.count_usag