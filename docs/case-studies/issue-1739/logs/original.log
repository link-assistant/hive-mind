        "tool_use_id": "toolu_01Aw64cVcf933ZhuFpRFQM8S",
        "type": "tool_result",
        "content": "1\t/**\n2\t * TCP transport for the peer abstraction (R-F5 stand-in).\n3\t *\n4\t * The full WebRTC stack needs an STUN/TURN signalling layer plus\n5\t * `RTCDataChannel`. Until that lands, this adapter speaks newline-\n6\t * delimited JSON over a plain TCP socket — same contract the\n7\t * `loopback` transport uses, but real cross-process. The peer code in\n8\t * `createPeer` does not change; once the WebRTC adapter is ready it\n9\t * plugs in via the same `{ send, onMessage }` interface.\n10\t */\n11\t\n12\timport net from 'node:net';\n13\t\n14\tconst wireSend = (socket, event) => {\n15\t  socket.write(`${JSON.stringify(event)}\\n`);\n16\t};\n17\t\n18\tconst wireRead = (socket, handlers) => {\n19\t  let buf = '';\n20\t  socket.on('data', (chunk) => {\n21\t    buf += chunk.toString('utf8');\n22\t    let nl;\n23\t    while ((nl = buf.indexOf('\\n')) !== -1) {\n24\t      const line = buf.slice(0, nl);\n25\t      buf = buf.slice(nl + 1);\n26\t      if (!line) {\n27\t        continue;\n28\t      }\n29\t      try {\n30\t        const event = JSON.parse(line);\n31\t        for (const h of handlers) {\n32\t          h(event);\n33\t        }\n34\t      } catch {\n35\t        // ignore malformed frames; the peer protocol is fault-tolerant.\n36\t      }\n37\t    }\n38\t  });\n39\t};\n40\t\n41\texport const startSyncListener = ({ port = 0 } = {}) =>\n42\t  new Promise((resolve) => {\n43\t    const handlers = new Set();\n44\t    const sockets = new Set();\n45\t    const server = net.createServer((socket) => {\n46\t      sockets.add(socket);\n47\t      wireRead(socket, handlers);\n48\t      socket.on('close', () => sockets.delete(socket));\n49\t    });\n50\t    server.listen(port, '127.0.0.1', () => {\n51\t      const transport = {\n52\t        send: (event) => {\n53\t          for (const s of sockets) {\n54\t            wireSend(s, event);\n55\t          }\n56\t        },\n57\t        onMessage: (h) => {\n58\t          handlers.add(h);\n59\t          return () => handlers.delete(h);\n60\t        },\n61\t      };\n62\t      resolve({\n63\t        port: server.address().port,\n64\t        transport,\n65\t        close: () =>\n66\t          new Promise((r) => {\n67\t            for (const s of sockets) {\n68\t              s.destroy();\n69\t            }\n70\t            server.close(() => r());\n71\t          }),\n72\t      });\n73\t    });\n74\t  });\n75\t\n76\texport const connectSyncPeer = ({ port, host = '127.0.0.1' } = {}) =>\n77\t  new Promise((resolve, reject) => {\n78\t    const handlers = new Set();\n79\t    const socket = net.createConnection({ port, host }, () => {\n80\t      wireRead(socket, handlers);\n81\t      resolve({\n82\t        transport: {\n83\t          send: (event) => wireSend(socket, event),\n84\t          onMessage: (h) => {\n85\t            handlers.add(h);\n86\t            return () => handlers.delete(h);\n87\t          },\n88\t        },\n89\t        close: () =>\n90\t          new Promise((r) => {\n91\t            socket.end(() => r());\n92\t          }),\n93\t      });\n94\t    });\n95\t    socket.on('error', reject);\n96\t  });\n97\t"
