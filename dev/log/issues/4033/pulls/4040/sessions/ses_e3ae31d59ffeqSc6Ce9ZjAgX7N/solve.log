crets\" summary at the end of each run.\n00036| const { formatSanitizationSummary, sanitizeForPublication, writeSanitizedPublicationFile } = await import('./token-sanitization.lib.mjs');\n00037| // Issue #1745: post-finish retroactive sanitization of bot-authored PR\n00038| // comments and the PR description. This external repair boundary always runs\n00039| // when PR coordinates are available.\n00040| const { runPostFinishSweep } = await import('./post-finish-sanitization-sweep.lib.mjs');\n00041| const { reportPullRequestLinkRepair } = await import('./pr-image-link-repair.lib.mjs'); // issue #2239: repair GitHub file links the tool published against the wrong repository\n00042| \n00043| // Import continuation functions (session resumption, PR detection)\n00044| import * as autoContinue from './solve.auto-continue.lib.mjs';\n00045| const { autoContinueWhenLimitResets } = autoContinue;\n00046| // Import Claude-specific command builders\n00047| // These are used to generate copy-pasteable Claude CLI resume commands for users\n00048| // Pattern: (cd \"/tmp/gh-issue-solver-...\" && claude --resume <session-id>)\n00049| // Two types of resume commands are supported:\n00050| // 1. Interactive resume: Short command that opens interactive mode\n00051| // 2. Autonomous resume: Full command with all flags to run autonomously\n00052| const claudeCommandBuilder = await import('./claude.command-builder.lib.mjs');\n00053| /**\n00054|  * Issue #3922: --auto-restart-until-mergeable never merges, but this line said \"Auto-merge mode\n00055|  * enabled - will attempt to merge\" a second before the monitor announced \"(will NOT auto-merge)\".\n00056|  * @param {{autoMerge?: boolean, autoRestartUntilMergeable?: boolean}} argv\n00057|  * @returns {string}\n00058|  */\n00059| export const describePostSessionMergeWait = argv => (argv?.autoMerge ? '\\n🔄 Auto-merge mode enabled - will merge the pull request once CI passes and it is mergeable' : '\\n🔄 Auto-restart-until-mergeable mode enabled - will keep the pull request mergeable and will NOT merge it (--auto-merge merges)');\n00060| \n00061| export const { buildClaudeResumeCommand, buildClaudeAutonomousResumeCommand, buildClaudeInitialCommand } = claudeCommandBuilder;\n00062| \n00063| // Issue #942: buildSolveResumeCommand lives in its own module so it can be safely\n00064| // imported from tool libraries (claude/codex/gemini) without circular imports.\n00065| import { buildSolveResumeCommand } from './solve.resume-command.lib.mjs';\n00066| import { isCommentByCurrentIdentity, isIntegrationForbidden } from './github-identity.lib.mjs';\n00067| export { buildSolveResumeCommand };\n00068| // Import error handling functions\n00069| // const errorHandlers = await import('./solve.error-handlers.lib.mjs'); // Not currently used\n00070| // Import Sentry integration\n00071| const sentryLib = await import('./sentry.lib.mjs');\n00072| const { reportError } = sentryLib;\n00073| // Import pull request issue-link preservation helpers\n00074| const prIssueLinking = await import('./pr-issue-linking.lib.mjs');\n00075| const { buildIssueReference } = prIssueLinking;\n00076| \n00077| // Issue #2119: the one place that decides whether a pull request changed anything.\n00078| const { formatChangesSection, getPullRequestChangeStats } = await import('./pull-request-changes.lib.mjs');\n00079| const { buildNoChangesNotice, capWorkingSessionSummary, formatWorkingSessionSummaryMarkdown, redactWorkspacePaths, replaceEchoedToolOutputSummary } = await import('./working-session-summary.lib.mjs');\n00080| /**\n00081|  * Placeholder patterns used to detect auto-generated PR content that was not updated by the agent.\n00082|  * These patterns match the initial WIP PR created by solve.auto-pr.lib.mjs.\n00083|  */\n00084| export const PR_TITLE_PLACEHOLDER_PREFIX = '[WIP]';\n00085| \n00086| export const PR_BODY_PLACEHOLDER_PATTERNS = ['_Details will be added as the solution draft is developed..._', '**Work in Progress** - The AI assistant is currently analyzing and implementing the solution draft.', '### 🚧 Status'];\n00087| /**\n00088|  * Check if PR title still contains auto-generated placeholder content\n00089|  * @param {string} title - PR title\n00090|  * @returns {boolean} - true if title has placeholder content\n00091|  */\n00092| export const hasPRTitlePlaceholder = title => {\n00093|   return title && title.startsWith(PR_TITLE_PLACEHOLDER_PREFIX);\n00094| };\n00095| \n00096| /**\n00097|  * Check if PR body still contains auto-generated placeholder content\n00098|  * @param {string} body - PR body\n00099|  * @returns {boolean} - true if body has placeholder content\n00100|  */\n00101| export const hasPRBodyPlaceholder = body => {\n00102|   return body && PR_BODY_PLACEHOLDER_PATTERNS.some(pattern => body.includes(pattern));\n00103| };\n00104| /**\n00105|  * Build a short factual hint for auto-restart when PR title/description was not updated.\n00106|  * Uses neutral, fact-stating language (no forcing words).\n00107|  * @param {boolean} titleNotUpdated - Whether the PR title still has placeholder\n00108|  * @param {boolean} descriptionNotUpdated - Whether the PR description still has placeholder\n00109|  * @returns {string[]} - Array of feedback lines to pass as hint to the restarted session\n00110|  */\n00111| export const buildPRNotUpdatedHint = (titleNotUpdated, descriptionNotUpdated) => {\n00112|   const lines = [];\n00113|   if (titleNotUpdated && descriptionNotUpdated) {\n00114|     lines.push(promptText('prompt.templates.solve-results.buildPRNotUpdatedHint.text1'));\n00115|   } else if (titleNotUpdated) {\n00116|     lines.push(promptText('prompt.templates.solve-results.buildPRNotUpdatedHint.text2'));\n00117|   } else if (descriptionNotUpdated) {\n00118|     lines.push(promptText('prompt.templates.solve-results.buildPRNotUpdatedHint.text3'));\n00119|   }\n00120|   return lines;\n00121| };\n00122| /**\n00123|  * Ensure an existing pull request body contains a GitHub closing keyword for the issue.\n00124|  *\n00125|  * @param {Object} options\n00126|  * @param {string|number} options.prNumber - Pull request number\n00127|  * @param {string|number} options.issueNumber - Issue number to link\n00128|  * @param {string} options.owner - Repository owner\n00129|  * @param {string} options.repo - Repository name\n00130|  * @param {Object} [options.argv] - Parsed CLI arguments\n00131|  * @param {Function} [options.command] - command-stream tagged template\n00132|  * @param {Function} [options.logger] - Logger function\n00133|  * @returns {Promise<{checked: boolean, updated: boolean, body: string, issueRef: string, error?: string}>}\n00134|  */\n00135| export const ensurePullRequestIssueLink = async ({ prNumber, issueNumber, owner, repo, argv = {}, command = $, logger = log }) => {\n00136|   const { repairRequiredIssueLinks } = await import('./pr-issue-link-repair.lib.mjs');\n00137|   // Preserve the existing command-stream injection contract with separate argv.\n00138|   const run = args => {\n00139|     const strings = ['gh ', ...args.slice(1).map(() => ' '), ''];\n00140|     strings.raw = [...strings];\n00141|     return command(strings, ...args);\n00142|   };\n00143|   return repairRequiredIssueLinks({ prNumber, issueNumber, owner, repo, argv, run, logger });\n00144| };\n00145| export const verifyPullRequestIssueLinkAfterAutoRestart = async ({ prNumber, issueNumber, owner, repo, argv = {}, cleanErrorMessage = error => error.message }) => {\n00146|   if (!prNumber) {\n00147|     return { checked: false, updated: false, body: '', issueRef: buildIssueReference({ issueNumber, owner, repo, fork: argv.fork }) };\n00148|   }\n00149| \n00150|   await log('🔗 Verifying PR issue link after auto-restart...');\n00151|   try {\n00152|     return await ensurePullRequestIssueLink({ prNumber, issueNumber, owner, repo, argv });\n00153|   } catch (issueLinkError) {\n00154|     await log(`⚠️  Could not verify PR issue link after auto-restart: ${cleanErrorMessage(issueLinkError)}`, { level: 'warning' });\n00155|     return { checked: false, updated: false, body: '', issueRef: buildIssueReference({ issueNumber, owner, repo, fork: argv.fork }), error: issueLinkError.message };\n00156|   }\n00157| };\n00158| /**\n00159|  * Detect the CLAUDE.md or .gitkeep commit hash from branch structure when not available in session\n00160|  * This handles continue mode where the commit hash was lost between sessions\n00161|  *\n00162|  * Safety checks to prevent Issue #617 (wrong commit revert):\n00163|  * 1. Only look at commits on the PR branch (not default branch commits)\n00164|  * 2. Verify the commit message matches our expected pattern\n00165|  * 3. Verify the commit ONLY adds CLAUDE.md or .gitkeep (no other files changed)\n00166|  * 4. Verify there are additional commits after it (actual work was done)\n00167|  *\n00168|  * @param {string} tempDir - The temporary directory with the git repo\n00169|  * @param {string} branchName - The PR branch name\n00170|  * @returns {string|null} - The detected commit hash or null if not found/safe\n00171|  */\n00172| const detectClaudeMdCommitFromBranch = async (tempDir, branchName) => {\n00173|   try {\n00174|     await log('   Attempting to detect CLAUDE.md or .gitkeep commit from branch structure...', { verbose: true });\n00175|     // First check if CLAUDE.md or .gitkeep exists in current branch\n00176|     const claudeMdExistsResult = await $({ cwd: tempDir })`git ls-files CLAUDE.md 2>&1`;\n00177|     const gitkeepExistsResult = await $({ cwd: tempDir })`git ls-files .gitkeep 2>&1`;\n00178|     const claudeMdExists = claudeMdExistsResult.code === 0 && claudeMdExistsResult.stdout?.toString() && claudeMdExistsResult.stdout.trim();\n00179|     const gitkeepExists = gitkeepExistsResult.code === 0 && gitkeepExistsResult.stdout?.toString() && gitkeepExistsResult.stdout.trim();\n00180| \n00181|     if (!claudeMdExists && !gitkeepExists) {\n00182|       await log('   Neither CLAUDE.md nor .gitkeep exists in current branch', { verbose: true });\n00183|       return null;\n00184|     }\n00185|     // Get the default branch to find the fork point\n00186|     const defaultBranchResult = await $({ cwd: tempDir })`git symbolic-ref refs/remotes/origin/HEAD 2>&1`;\n00187|     let defaultBranch = 'main';\n00188|     if (defaultBranchResult.code === 0 && defaultBranchResult.stdout?.toString()) {\n00189|       const match = defaultBranchResult.stdout.toString().match(/refs\\/remotes\\/origin\\/(.+)/);\n00190|       if (match) {\n00191|         defaultBranch = match[1].trim();\n00192|       }\n00193|     }\n00194|     await log(`   Using default branch: ${defaultBranch}`, { verbose: true });\n00195| \n00196|     // Find the merge base (fork point) between current branch and default branch\n00197|     const mergeBaseResult = await $({ cwd: tempDir })`git merge-base origin/${defaultBranch} HEAD 2>&1`;\n00198|     if (mergeBaseResult.code !== 0 || !mergeBaseResult.stdout?.toString()) {\n00199|       await log('   Could not find merge base, cannot safely detect initial commit', { verbose: true });\n00200|       return null;\n00201|     }\n00202|     const mergeBase = mergeBaseResult.stdout.toString().trim();\n00203|     await log(`   Merge base: ${mergeBase.substring(0, 7)}`, { verbose: true });\n00204|     // Get all commits on the PR branch (commits after the merge base)\n00205|     // Format: hash|message|files_changed\n00206|     const branchCommitsResult = await $({ cwd: tempDir })`git log ${mergeBase}..HEAD --reverse --format=\"%H|%s\" 2>&1`;\n00207|     if (branchCommitsResult.code !== 0 || !branchCommitsResult.stdout?.toString()) {\n00208|       await log('   No commits found on PR branch', { verbose: true });\n00209|       return null;\n00210|     }\n00211|     const branchCommits = branchCommitsResult.stdout.toString().trim().split('\\n').filter(Boolean);\n00212|     if (branchCommits.length === 0) {\n00213|       await log('   No commits found on PR branch', { verbose: true });\n00214|       return null;\n00215|     }\n00216| \n00217|     await log(`   Found ${branchCommits.length} commit(s) on PR branch`, { verbose: true });\n00218|     // Safety check: Must have at least 2 commits (CLAUDE.md commit + actual work)\n00219|     if (branchCommits.length < 2) {\n00220|       await log('   Only 1 commit on branch - not enough commits to safely revert CLAUDE.md', { verbose: true });\n00221|       await log('   (Need at least 2 commits: CLAUDE.md initial + actual work)', { verbose: true });\n00222|       return null;\n00223|     }\n00224| \n00225|     // Get the first commit on the PR branch\n00226|     const firstCommitLine = branchCommits[0];\n00227|     const [firstCommitHash, firstCommitMessage] = firstCommitLine.split('|');\n00228|     await log(`   First commit on branch: ${firstCommitHash.substring(0, 7)} - \"${firstCommitMessage}\"`, {\n00229|       verbose: true,\n00230|     });\n00231| \n00232|     // Safety check: Verify commit message matches expected pattern (CLAUDE.md or .gitkeep)\n00233|     const expectedMessagePatterns = [/^Initial commit with task details/i, /^Add CLAUDE\\.md/i, /^CLAUDE\\.md/i, /^Add \\.gitkeep/i, /\\.gitkeep/i];\n00234|     const messageMatches = expectedMessagePatterns.some(pattern => pattern.test(firstCommitMessage));\n00235|     if (!messageMatches) {\n00236|       await log('   First commit message does not match expected pattern', { verbose: true });\n00237|       await log('   Expected patterns: \"Initial commit with task details...\", \"Add CLAUDE.md\", \".gitkeep\", etc.', {\n00238|         verbose: true,\n00239|       });\n00240|       return null;\n00241|     }\n00242|     // Safety check: Verify the commit ONLY adds CLAUDE.md or .gitkeep file (no other files)\n00243|     const filesChangedResult = await $({\n00244|       cwd: tempDir,\n00245|     })`git diff-tree --no-commit-id --name-only -r ${firstCommitHash} 2>&1`;\n00246|     if (filesChangedResult.code !== 0 || !filesChangedResult.stdout?.toString()) {\n00247|       await log('   Could not get files changed in first commit', { verbose: true });\n00248|       return null;\n00249|     }\n00250| \n00251|     const filesChanged = filesChangedResult.stdout.toString().trim().split('\\n').filter(Boolean);\n00252|     await log(`   Files changed in first commit: ${filesChanged.join(', ')}`, { verbose: true });\n00253|     // Check if CLAUDE.md or .gitkeep is in the files changed\n00254|     const hasClaudeMd = filesChanged.includes('CLAUDE.md');\n00255|     const hasGitkeep = filesChanged.includes('.gitkeep');\n00256|     if (!hasClaudeMd && !hasGitkeep) {\n00257|       await log('   First commit does not include CLAUDE.md or .gitkeep', { verbose: true });\n00258|       return null;\n00259|     }\n00260| \n00261|     const targetFile = hasClaudeMd ? 'CLAUDE.md' : '.gitkeep';\n00262|     // CRITICAL SAFETY CHECK: Only allow revert if the target file is the ONLY file changed\n00263|     // This prevents Issue #617 where reverting a commit deleted .gitignore, LICENSE, README.md\n00264|     if (filesChanged.length > 1) {\n00265|       await log(`   ⚠️  First commit changes more than just ${targetFile} (${filesChanged.length} files)`, {\n00266|         verbose: true,\n00267|       });\n00268|       await log(`   Files: ${filesChanged.join(', ')}`, { verbose: true });\n00269|       await log('   Refusing to revert to prevent data loss (Issue #617 safety)', { verbose: true });\n00270|       return null;\n00271|     }\n00272|     // All safety checks passed!\n00273|     await log(`   ✅ Detected ${targetFile} commit: ${firstCommitHash.substring(0, 7)}`, { verbose: true });\n00274|     await log(`   ✅ Commit only contains ${targetFile} (safe to revert)`, { verbose: true });\n00275|     await log(`   ✅ Branch has ${branchCommits.length - 1} additional commit(s) (work was done)`, { verbose: true });\n00276| \n00277|     return firstCommitHash;\n00278|   } catch (error) {\n00279|     reportError(error, {\n00280|       context: 'detect_initial_commit',\n00281|       tempDir,\n00282|       branchName,\n00283|       operation: 'detect_commit_from_branch_structure',\n00284|     });\n00285|     await log(`   Error detecting initial commit: ${error.message}`, { verbose: true });\n00286|     return null;\n00287|   }\n00288| };\n00289| const wasFileTouchedAfterCommit = async (tempDir, commitHash, fileName) => {\n00290|   const changedCommitsResult = await $({ cwd: tempDir, mirror: false })`git log --format=%H ${commitHash}..HEAD -- ${fileName}`;\n00291|   if (changedCommitsResult.code === 0) {\n00292|     return Boolean(changedCommitsResult.stdout?.trim());\n00293|   }\n00294| \n00295|   if (changedCommitsResult.code !== 0) {\n00296|     await log(`   Could not inspect ${fileName} changes after initial commit`, { verbose: true });\n00297|     await log(`   git log output: ${changedCommitsResult.stderr?.toString() || changedCommitsResult.stdout?.toString() || 'no output'}`, { verbose: true });\n00298|   }\n00299|   return true;\n00300| };\n00301| \n00302| // Revert the CLAUDE.md or .gitkeep commit to restore original state\n00303| export const cleanupClaudeFile = async (tempDir, branchName, claudeCommitHash = null) => {\n00304|   try {\n00305|     // If no commit hash provided, try to detect it from branch structure\n00306|     // This handles continue mode where the hash was lost between sessions\n00307|     if (!claudeCommitHash) {\n00308|       await log('   No initial commit hash from session, attempting to detect from branch...', { verbose: true });\n00309|       claudeCommitHash = await detectClaudeMdCommitFromBranch(tempDir, branchName);\n00310|       if (!claudeCommitHash) {\n00311|         await log('   Could not safely detect initial commit to revert', { verbose: true });\n00312|         return;\n00313|       }\n00314|       await log(`   Detected initial commit: ${claudeCommitHash.substring(0, 7)}`, { verbose: true });\n00315|     }\n00316|     // Determine which file was used based on the commit message or actual files changed\n00317|     // Use %B (full message including body) instead of %s (subject only) to catch \".gitkeep\" in body\n00318|     // Also check the actual files changed as a fallback (Issue #1436)\n00319|     const commitMsgResult = await $({ cwd: tempDir })`git log -1 --format=%B ${claudeCommitHash} 2>&1`;\n00320|     const commitMsg = commitMsgResult.stdout?.trim() || '';\n00321|     let isGitkeepFile = commitMsg.includes('.gitkeep');\n00322| \n00323|     // Fallback: check actual files changed in the commit if message doesn't mention .gitkeep\n00324|     if (!isGitkeepFile) {\n00325|       const filesResult = await $({ cwd: tempDir })`git diff-tree --no-commit-id --name-only -r ${claudeCommitHash} 2>&1`;\n00326|       const files = filesResult.stdout?.trim().split('\\n').filter(Boolean) || [];\n00327|       isGitkeepFile = files.includes('.gitkeep');\n00328|     }\n00329|     const fileName = isGitkeepFile ? '.gitkeep' : 'CLAUDE.md';\n00330|     await log(formatAligned('🔄', 'Cleanup:', `Reverting ${fileName} commit`));\n00331|     await log(`   Using saved commit hash: ${claudeCommitHash.substring(0, 7)}...`, { verbose: true });\n00332| \n00333|     // Issue #1572: Sync local branch with remote before cleanup to prevent push failures.\n00334|     // After auto-restart sessions, the local branch may be behind the remote.\n00335|     const pullResult = await $({ cwd: tempDir })`git pull origin ${branchName} 2>&1`;\n00336|     if (pullResult.code === 0) {\n00337|       await log(`   Synced local branch before cleanup`, { verbose: true });\n00338|     } else {\n00339|       throw new Error(`git pull failed (code ${pullResult.code}): ${pullResult.stdout?.toString() || pullResult.stderr?.toString() || 'no output'}`);\n00340|     }\n00341|     const commitToRevert = claudeCommitHash;\n00342|     // Issue #1791: .gitkeep is a normal repository file in some projects, and\n00343|     // user work may intentionally edit or delete it. Once later PR commits touch\n00344|     // .gitkeep, final cleanup must not restore the pre-session version.\n00345|     if (fileName === '.gitkeep' && (await wasFileTouchedAfterCommit(tempDir, commitToRevert, fileName))) {\n00346|       await log(`   ${fileName} changed after the initial auto-commit; leaving PR changes untouched`, {\n00347|         verbose: true,\n00348|       });\n00349|       return;\n00350|     }\n00351| \n00352|     // APPROACH 3: Check for modifications before reverting (proactive detection)\n00353|     // This is the main strategy - detect if the file was modified after initial commit\n00354|     await log(`   Checking if ${fileName} was modified since initial commit...`, { verbose: true });\n00355|     // Issue #2135: `mirror: false`. Only \"is it non-empty\" is asked here, and\n00356|     // the answer is a file's whole diff.\n00357|     const diffResult = await $({ cwd: tempDir, ...QUIET_PROBE })`git diff ${commitToRevert} HEAD -- ${fileName} 2>&1`;\n00358|     if (diffResult.stdout?.toString() && diffResult.stdout.trim()) {\n00359|       // File was modified after initial commit - use manual approach to avoid conflicts\n00360|       await log(`   ${fileName} was modified after initial commit, using manual cleanup...`, { verbose: true });\n00361| \n00362|       // Get the state of the file from before the initial commit (parent of the commit we're reverting)\n00363|       const parentCommit = `${commitToRevert}~1`;\n00364|       const parentFileExists = await $({ cwd: tempDir })`git cat-file -e ${parentCommit}:${fileName} 2>&1`;\n00365|       if (parentFileExists.code === 0) {\n00366|         // File existed before the initial commit - restore it to that state\n00367|         await log(`   ${fileName} existed before session, restoring to previous state...`, { verbose: true });\n00368|         await $({ cwd: tempDir })`git checkout ${parentCommit} -- ${fileName}`;\n00369|       } else {\n00370|         // File didn't exist before the initial commit - delete it\n00371|         await log(`   ${fileName} was created in session, removing it...`, { verbose: true });\n00372|         await $({ cwd: tempDir })`git rm -f ${fileName} 2>&1`;\n00373|       }\n00374| \n00375|       // Create a manual revert commit\n00376|       const commitResult = await $({ cwd: tempDir })`git commit -m \"Revert: Remove ${fileName} changes from initial commit\" 2>&1`;\n00377|       if (commitResult.code === 0) {\n00378|         await log(formatAligned('📦', 'Committed:', `${fileName} revert (manual)`));\n00379|         // Push the revert\n00380|         const pushRevertResult = await $({ cwd: tempDir })`git push origin ${branchName} 2>&1`;\n00381|         if (pushRevertResult.code === 0) {\n00382|           await log(formatAligned('📤', 'Pushed:', `${fileName} revert to GitHub`));\n00383|         } else {\n00384|           await log(`   Warning: Could not push ${fileName} revert`, { verbose: true });\n00385|         }\n00386|       } else {\n00387|         await log('   Warning: Could not create manual revert commit', { verbose: true });\n00388|         await log(`   Commit output: ${commitResult.stderr?.toString() || commitResult.stdout?.toString()}`, { verbose: true });\n00389|       }\n00390|     } else {\n00391|       // No modifications detected - safe to use git revert (standard approach)\n00392|       await log('   No modifications detected, using standard git revert...', { verbose: true });\n00393| \n00394|       // FALLBACK 1: Standard git revert\n00395|       const revertResult = await $({ cwd: tempDir })`git revert ${commitToRevert} --no-edit 2>&1`;\n00396|       if (revertResult.code === 0) {\n00397|         await log(formatAligned('📦', 'Committed:', `${fileName} revert`));\n00398|         // Push the revert\n00399|         const pushRevertResult = await $({ cwd: tempDir })`git push origin ${branchName} 2>&1`;\n00400|         if (pushRevertResult.code === 0) {\n00401|           await log(formatAligned('📤', 'Pushed:', `${fileName} revert to GitHub`));\n00402|         } else {\n00403|           await log(`   Warning: Could not push ${fileName} revert`, { verbose: true });\n00404|         }\n00405|       } else {\n00406|         // FALLBACK 2: Handle unexpected conflicts (three-way merge with automatic resolution)\n00407|         const revertOutput = revertResult.stderr?.toString() || revertResult.stdout?.toString() || '';\n00408|         const hasConflict = revertOutput.includes('CONFLICT') || revertOutput.includes('conflict');\n00409| \n00410|         if (hasConflict) {\n00411|           await log('   Unexpected conflict detected, attempting automatic resolution...', { verbose: true });\n00412|           // Check git status to see what files are in conflict\n00413|           const statusResult = await $({ cwd: tempDir })`git status --short 2>&1`;\n00414|           const statusOutput = statusResult.stdout?.toString() || '';\n00415|           // Check if the file is in the conflict\n00416|           if (statusOutput.includes(fileName)) {\n00417|             await log(`   Resolving ${fileName} conflict by restoring pre-session state...`, { verbose: true });\n00418| \n00419|             // Get the state of the file from before the initial commit (parent of the commit we're reverting)\n00420|             const parentCommit = `${commitToRevert}~1`;\n00421|             const parentFileExists = await $({ cwd: tempDir })`git cat-file -e ${parentCommit}:${fileName} 2>&1`;\n00422|             if (parentFileExists.code === 0) {\n00423|               // File existed before the initial commit - restore it to that state\n00424|               await log(`   ${fileName} existed before session, restoring to previous state...`, { verbose: true });\n00425|               await $({ cwd: tempDir })`git checkout ${parentCommit} -- ${fileName}`;\n00426|               // Stage the resolved file\n00427|               await $({ cwd: tempDir })`git add ${fileName} 2>&1`;\n00428|             } else {\n00429|               // File didn't exist before the initial commit - delete it\n00430|               await log(`   ${fileName} was created in session, removing it...`, { verbose: true });\n00431|               await $({ cwd: tempDir })`git rm -f ${fileName} 2>&1`;\n00432|               // No need to git add since git rm stages the deletion\n00433|             }\n00434| \n00435|             // Complete the revert with the resolved conflict\n00436|             const continueResult = await $({ cwd: tempDir })`git revert --continue --no-edit 2>&1`;\n00437|             if (continueResult.code === 0) {\n00438|               await log(formatAligned('📦', 'Committed:', `${fileName} revert (conflict resolved)`));\n00439| \n00440|               // Push the revert\n00441|               const pushRevertResult = await $({ cwd: tempDir })`git push origin ${branchName} 2>&1`;\n00442|               if (pushRevertResult.code === 0) {\n00443|                 await log(formatAligned('📤', 'Pushed:', `${fileName} revert to GitHub`));\n00444|               } else {\n00445|                 await log(`   Warning: Could not push ${fileName} revert`, { verbose: true });\n00446|               }\n00447|             } else {\n00448|               await log('   Warning: Could not complete revert after conflict resolution', { verbose: true });\n00449|               await log(`   Continue output: ${continueResult.stderr?.toString() || continueResult.stdout?.toString()}`, { verbose: true });\n00450|             }\n00451|           } else {\n00452|             // Conflict in some other file, not expected file - this is unexpected\n00453|             await log('   Warning: Revert conflict in unexpected file(s), aborting revert', { verbose: true });\n00454|             await $({ cwd: tempDir })`git revert --abort 2>&1`;\n00455|           }\n00456|         } else {\n00457|           // Non-conflict error\n00458|           await log(`   Warning: Could not revert ${fileName} commit`, { verbose: true });\n00459|           await log(`   Revert output: ${revertOutput}`, { verbose: true });\n00460|         }\n00461|       }\n00462|     }\n00463|     // Post-cleanup verification: check if the file was actually removed (Issue #1436)\n00464|     // This catches cases where revert/push succeeded in logs but file still exists\n00465|     const verifyResult = await $({ cwd: tempDir })`git ls-files ${fileName} 2>&1`;\n00466|     const fileStillExists = verifyResult.code === 0 && verifyResult.stdout?.toString() && verifyResult.stdout.trim();\n00467|     if (fileStillExists) {\n00468|       // Issue #2160: the pre-existence check must come FIRST. A file that legitimately predates\n00469|       // the session is not a cleanup failure, and warning about it produced a false positive\n00470|       // (\"⚠️ WARNING: .gitkeep still exists after cleanup\" immediately followed by\n00471|       // \"ℹ️ .gitkeep existed before this session — keeping pre-existing file\").\n00472|       const parentCommit = `${claudeCommitHash}~1`;\n00473|       const parentFileExists = await $({ cwd: tempDir })`git cat-file -e ${parentCommit}:${fileName} 2>&1`;\n00474|       if (parentFileExists.code !== 0) {\n00475|         // File didn't exist before the session — this is a real leftover, force remove it\n00476|         await log(`   ⚠️  WARNING: ${fileName} still exists after cleanup — attempting direct removal...`);\n00477|         await $({ cwd: tempDir })`git rm -f ${fileName} 2>&1`;\n00478|         const fallbackCommit = await $({ cwd: tempDir })`git commit -m \"Remove leftover ${fileName} (post-cleanup fallback)\" 2>&1`;\n00479|         if (fallbackCommit.code === 0) {\n00480|           const fallbackPush = await $({ cwd: tempDir })`git push origin ${branchName} 2>&1`;\n00481|           if (fallbackPush.code === 0) {\n00482|             await log(`   ✅ ${fileName} removed via post-cleanup fallback`);\n00483|           } else {\n00484|             await log(`   ⚠️  ${fileName} removed locally but push failed`, { verbose: true });\n00485|           }\n00486|         }\n00487|       } else {\n00488|         await log(`   ℹ️  ${fileName} existed before this session — keeping pre-existing file`, { verbose: true });\n00489|       }\n00490|     }\n00491|   } catch (e) {\n00492|     reportError(e, {\n00493|       context: 'cleanup_claude_file',\n00494|       tempDir,\n00495|       operation: 'revert_initial_commit',\n00496|     });\n00497|     // If revert fails, that's okay - the task is still complete\n00498|     await log('   Initial commit revert failed or not needed', { verbose: true });\n00499|   }\n00500| };\n00501| // Show session summary and handle limit reached scenarios\n00502| export const showSessionSummary = async (sessionId, limitReached, argv, issueUrl, tempDir, shouldAttachLogs = false) => {\n00503|   await log('\\n=== Session Summary ===');\n00504|   // Issue #1745: report how many tokens were masked during this run, with the\n00505|   // \"use --dangerously-skip-output-sanitization to skip\" hint when > 0.\n00506|   try {\n00507|     const sanitizationSummary = formatSanitizationSummary();\n00508|     if (sanitizationSummary) {\n00509|       await log(sanitizationSummary);\n00510|     }\n00511|   } catch {\n00512|     /* never fail the summary because of this */\n00513|   }\n00514| \n00515|   if (sessionId) {\n00516|     await log(`✅ Session ID: ${sessionId}`);\n00517|     // Always use absolute path for log file display\n00518|     const absoluteLogPath = path.resolve(getLogFile());\n00519|     await log(`✅ Complete log file: ${absoluteLogPath}`);\n00520|     // Show three resume options:\n00521|     //   1. Interactive claude  - opens Claude Code interactively (claude only)\n00522|     //   2. Autonomous claude   - one-shot claude --resume w/ --dangerously-skip-permissions -p (claude only)\n00523|     //   3. Solve resume        - re-enters solve.mjs with --resume so the full flow continues\n00524|     //                            (works for every supported tool, including codex/gemini/etc.)\n00525|     const tool = argv.tool || 'claude';\n00526|     await log('');\n00527|     await log('💡 To continue this session:');\n00528|     if (tool === 'claude') {\n00529|       await log(`   Interactive mode:    ${buildClaudeResumeCommand({ tempDir, sessionId, model: argv.model })}`);\n00530|       await log(`   Autonomous mode:     ${buildClaudeAutonomousResumeCommand({ tempDir, sessionId, model: argv.model })}`);\n00531|     }\n00532|     if (issueUrl) {\n00533|       const solveResumeCmd = buildSolveResumeCommand({ issueUrl, sessionId, tool, model: argv.model, fallbackModel: argv.fallbackModel, tempDir });\n00534|       await log(`   Solve resume mode:   ${solveResumeCmd}`);\n00535|     }\n00536|     await log('');\n00537| \n00538|     if (limitReached) {\n00539|       await log('⏰ LIMIT REACHED DETECTED!');\n00540|       if ((argv.autoResumeOnLimitReset || argv.autoRestartOnLimitReset) && global.limitResetTime) {\n00541|         const isRestart = !!argv.autoRestartOnLimitReset;\n00542|         await log(`\\n🔄 AUTO-${isRestart ? 'RESTART' : 'RESUME'} ON LIMIT RESET ENABLED - Will ${isRestart ? 'restart' : 'resume'} at ${global.limitResetTime}`);\n00543|         // Pass tempDir to ensure resumed session uses the same working directory\n00544|         // This is critical for Claude Code session resume to work correctly\n00545|         await autoContinueWhenLimitResets(issueUrl, sessionId, argv, shouldAttachLogs, tempDir, isRestart);\n00546|       } else {\n00547|         if (global.limitResetTime) {\n00548|           await log(`\\n⏰ Limit resets at: ${global.limitResetTime}`);\n00549|         }\n00550|         await log('\\n💡 After the limit resets, resume using the command above.');\n00551| \n00552|         if (argv.autoCleanup !== false) {\n00553|           await log('');\n00554|           await log('⚠️  Note: Temporary directory will be automatically cleaned up.');\n00555|           await log('   To keep the directory