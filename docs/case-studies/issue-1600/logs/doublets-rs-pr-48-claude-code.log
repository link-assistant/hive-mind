[2026-04-14T08:15:51.698Z] [INFO]         "content": "1\tuse funty::Unsigned;\n2\tuse std::{\n3\t    convert::{TryFrom, TryInto},\n4\t    fmt::Debug,\n5\t};\n6\t\n7\t/// Trait for creating small numeric values from u8.\n8\t///\n9\t/// This trait provides a convenient way to create numeric types from small u8 values,\n10\t/// which is commonly needed when working with link constants and indices.\n11\tpub trait FuntyPart: Sized + TryFrom<u8> {\n12\t    /// Create a value from a u8. Panics if the conversion fails.\n13\t    fn funty(n: u8) -> Self;\n14\t}\n15\t\n16\timpl<All: TryFrom<u8>> FuntyPart for All\n17\twhere\n18\t    <All as TryFrom<u8>>::Error: Debug,\n19\t{\n20\t    fn funty(n: u8) -> Self {\n21\t        All::try_from(n).expect(\"conversion from u8 should succeed for all unsigned types\")\n22\t    }\n23\t}\n24\t\n25\t/// Trait bound for numeric types that can be used as link identifiers.\n26\t///\n27\t/// This trait combines several requirements:\n28\t/// - Must be an unsigned integer type (via `Unsigned`)\n29\t/// - Must support creation from small values (via `FuntyPart`)\n30\t/// - Must support conversions to/from various integer types\n31\tpub trait LinkType:\n32\t    Unsigned\n33\t    + FuntyPart\n34\t    + TryFrom<i8, Error: Debug>\n35\t    + TryFrom<u8, Error: Debug>\n36\t    + TryFrom<i16, Error: Debug>\n37\t    + TryFrom<u16, Error: Debug>\n38\t    + TryFrom<i32, Error: Debug>\n39\t    + TryFrom<u32, Error: Debug>\n40\t    + TryFrom<i64, Error: Debug>\n41\t    + TryFrom<u64, Error: Debug>\n42\t    + TryFrom<i128, Error: Debug>\n43\t    + TryFrom<u128, Error: Debug>\n44\t    + TryFrom<isize, Error: Debug>\n45\t    + TryFrom<usize, Error: Debug>\n46\t    + TryInto<i8, Error: Debug>\n47\t    + TryInto<u8, Error: Debug>\n48\t    + TryInto<i16, Error: Debug>\n49\t    + TryInto<u16, Error: Debug>\n50\t    + TryInto<i32, Error: Debug>\n51\t    + TryInto<u32, Error: Debug>\n52\t    + TryInto<i64, Error: Debug>\n53\t    + TryInto<u64, Error: Debug>\n54\t    +