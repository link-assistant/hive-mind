{
  "name": "@link-assistant/hive-mind",
  "version": "2.39.9",
  "description": "AI-powered issue solver and hive mind for collaborative problem solving",
  "main": "src/hive.mjs",
  "type": "module",
  "bin": {
    "hive": "./src/hive.mjs",
    "solve": "./src/solve.mjs",
    "task": "./src/task.mjs",
    "fix": "./src/fix.mjs",
    "hive-cleanup": "./src/cleanup.mjs",
    "review": "./src/review.mjs",
    "configure-claude": "./src/configure-claude.mjs",
    "start-screen": "./src/start-screen.mjs",
    "hive-screens": "./src/hive-screens.mjs",
    "hive-models": "./src/hive-models.mjs",
    "hive-telegram-bot": "./src/telegram-bot.mjs",
    "close-linked-issues": "./src/close-linked-issues.mjs"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs --suite default",
    "test:queue": "node tests/solve-queue.test.mjs",
    "test:limits-display": "node tests/limits-display.test.mjs",
    "test:usage-limit": "node tests/test-usage-limit.mjs",
    "lint": "eslint --max-warnings=0 'src/**/*.{js,mjs,cjs}' 'scripts/**/*.{js,mjs,cjs}' 'eslint-rules/**/*.{js,mjs,cjs}' 'tests/**/*.{js,mjs,cjs}' && node scripts/check-github-retry-shell.mjs",
    "lint:fix": "eslint 'src/**/*.{js,mjs,cjs}' 'scripts/**/*.{js,mjs,cjs}' 'eslint-rules/**/*.{js,mjs,cjs}' 'tests/**/*.{js,mjs,cjs}' --fix",
    "check:duplication": "jscpd .",
    "check:secrets": "secretlint --secretlintignore .secretlintignore \"**/*\"",
    "format": "prettier --write \"**/*.{js,mjs,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md}\" --ignore-path .prettierignore",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "npm run build:pre && changeset publish",
    "build:pre": "chmod +x src/hive.mjs && chmod +x src/solve.mjs && chmod +x src/task.mjs && chmod +x src/fix.mjs && chmod +x src/cleanup.mjs && chmod +x src/review.mjs && chmod +x src/configure-claude.mjs && chmod +x src/start-screen.mjs && chmod +x src/hive-screens.mjs && chmod +x src/hive-models.mjs && chmod +x src/telegram-bot.mjs && chmod +x src/close-linked-issues.mjs",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-assistant/hive-mind.git"
  },
  "keywords": [
    "ai",
    "automation",
    "issue-solver",
    "cli",
    "hive-mind",
    "collaborative"
  ],
  "author": "link-assistant",
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/link-assistant/hive-mind/issues"
  },
  "homepage": "https://github.com/link-assistant/hive-mind#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "files": [
    "src",
    "locales",
    "*.md"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "command-stream": "2.6.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "test-anywhere": "^0.9.1"
  },
  "dependencies": {
    "@secretlint/core": "^13.1.0",
    "@secretlint/profiler": "^13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@sentry/node": "^11.10.0",
    "@sentry/profiling-node": "^11.10.0",
    "agent-commander": "^0.12.0",
    "dayjs": "^1.11.23",
    "decimal.js-light": "^2.5.1",
    "lino-arguments": "^0.4.0",
    "lino-i18n": "^0.5.0",
    "lino-objects-codec": "^0.9.4",
    "secretlint": "^13.1.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "tinyld": "^1.3.4"
  },
  "lint-staged": {
    "*.{js,mjs,json,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@sentry/node-cpu-profiler@2.4.4": true,
    "node-pty@1.1.0": false
  }
}
