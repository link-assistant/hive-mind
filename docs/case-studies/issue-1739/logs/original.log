        "content": "1\t/**\n2\t * Sync layer (R-F5).\n3\t *\n4\t * Last-writer-wins-per-link CRDT seed: every link carries a `version`\n5\t * (Lamport-style). `merge(a, b)` picks the higher version on conflict\n6\t * and union of children otherwise. `Peer` is transport-agnostic — the\n7\t * WebRTC adapter is plumbed via `Peer.connect(transport)` so the same\n8\t * code runs over loopback in tests, WebSocket on a server, or\n9\t * RTCDataChannel in the browser.\n10\t */\n11\t\n12\texport const tickVersion = (now = Date.now(), node = 'local') =>\n13\t  `${now}-${node}`;\n14\t\n15\texport const cmp = (a, b) => (a < b ? -1 : a > b ? 1 : 0);\n16\t\n17\t/**\n18\t * Vector-clock primitives. A clock is `{ [nodeId]: counter }`. Two\n19\t * clocks are *concurrent* when neither dominates — those are the cases\n20\t * that need a deterministic tiebreak (we use lexicographic node id of\n21\t * the highest-counter writer, then JSON of the link).\n22\t */\n23\texport const vcInit = () => ({});\n24\texport const vcTick = (vc, node) => ({ ...vc, [node]: (vc[node] ?? 0) + 1 });\n25\texport const vcMerge = (a, b) => {\n26\t  const out = { ...a };\n27\t  for (const [k, v] of Object.entries(b)) {\n28\t    out[k] = Math.max(out[k] ?? 0, v);\n29\t  }\n30\t  return out;\n31\t};\n32\tconst vcDominates = (a, b) => {\n33\t  let strict = false;\n34\t  for (const k of new Set([...Object.keys(a), ...Object.keys(b)])) {\n35\t    const av = a[k] ?? 0;\n36\t    const bv = b[k] ?? 0;\n37\t    if (av < bv) {\n38\t      return false;\n39\t    }\n40\t    if (av > bv) {\n41\t      strict = true;\n42\t    }\n43\t  }\n44\t  return strict;\n45\t};\n46\texport const vcCompare = (a, b) => {\n47\t  if (vcDominates(a, b)) {\n48\t    return 1;\n49\t  }\n50\t  if (vcDominates(b, a)) {\n51\t    return -1;\n52\t  }\n53\t  // Equal or concurrent.\n54\t  const ka = Object.keys(a).sort().join('|');\n55\t  const kb = Object.keys(b).sort().join('|');\n56\t  if (ka === kb && Object.keys(a).every((k) => a[k] === b[k])) {\n57\t    return 0;\n58\t  }\n59\t  return null; // concurrent\n60\t};\n61\t\n62\tconst tiebreak = (a, b) => {\n63\t  const av = a.vc ?? {};\n64\t  const bv = b.vc ?? {};\n65\t  const aTop = Object.entries(av).sort((x, y) => y[1] - x[1])[0]?.[0] ?? '';\n66\t  const bTop = Object.entries(bv).sort((x, y) => y[1] - x[1])[0]?.[0] ?? '';\n67\t  if (aTop !== bTop) {\n68\t    return aTop > bTop ? a : b;\n69\t  }\n70\t  return JSON.stringify(a) >= JSON.stringify(b) ? a : b;\n71\t};\n72\t\n73\texport const merge = (a, b) => {\n74\t  if (!a) {\n75\t    return b;\n76\t  }\n77\t  if (!b) {\n78\t    return a;\n79\t  }\n80\t  let winner;\n81\t  if (a.vc && b.vc) {\n82\t    const ord = vcCompare(a.vc, b.vc);\n83\t    if (ord === 1) {\n84\t      winner = a;\n85\t    } else if (ord === -1) {\n86\t      winner = b;\n87\t    } else if (ord === 0) {\n88\t      winner = a;\n89\t    } else {\n90\t      winner = tiebreak(a, b);\n91\t    }\n92\t    winner = { ...winner, vc: vcMerge(a.vc, b.vc) };\n93\t  } else {\n94\t    winner = cmp(a.version ?? '', b.version ?? '') >= 0 ? a : b;\n95\t  }\n96\t  const childIds = new Set([...(a.children ?? []), ...(b.children ?? [])]);\n97\t  return { ...winner, children: [...childIds] };\n98\t};\n99\t\n100\texport const createPeer = (store, { node = 'local' } = {}) => {\n101\t  const subs = new Set();\n102\t  let muted = false;\n103\t  store.subscribe((event) => {\n104\t    if (muted) {\n105\t      return;\n106\t    }\n107\t    for (const s of subs) {\n108\t      s(event);\n109\t    }\n110\t  });\n111\t  return {\n112\t    node,\n113\t    onLocal(handler) {\n114\t      subs.add(handler);\n115\t      return () => subs.delete(handler);\n116\t    },\n117\t    async receive(event) {\n118\t      muted = true;\n119\t      try {\n120\t        if (event.type === 'put') {\n121\t          const local = await store.get(event.link.id);\n122\t          await store.put(merge(local, event.link));\n123\t        } else if (event.type === 'delete') {\n124\t          await store.delete(event.link.id);\n125\t        }\n126\t      } finally {\n127\t        muted = false;\n128\t      }\n129\t    },\n130\t    connect(transport) {\n131\t      const offLocal = this.onLocal((e) => transport.send(e));\n132\t      transport.onMessage((e) => this.receive(e));\n133\t      return () => offLocal();\n134\t    },\n135\t  };\n136\t};\n137\t\n138\texport const loopback = () => {\n139\t  const aHandlers = new Set();\n140\t  const bHandlers = new Set();\n141\t  const pending = [];\n142\t  return {\n143\t    a: {\n144\t      send: (e) =>\n145\t        bHandlers.forEach((h) => pending.push(Promise.resolve(h(e)))),\n146\t      onMessage: (h) => aHandlers.add(h),\n147\t    },\n148\t    b: {\n149\t      send: (e) =>\n150\t        aHandlers.forEach((h) => pending.push(Promise.resolve(h(e)))),\n151\t      onMessage: (h) => bHandlers.add(h),\n152\t    },\n153\t    async settle() {\n154\t      while (pending.length) {\n155\t        await pending.shift();\n156\t      }\n157\t    },\n158\t  };\n159\t};\n160\t"
