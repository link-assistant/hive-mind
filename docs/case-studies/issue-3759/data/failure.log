[2026-10-24T15:17:34.091Z] [INFO]     "stdout": "/* ---------- Settings page (issue #13) ---------- */\n\n.settings__groups {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  align-items: start;\n  gap: 1rem;\n  margin-top: 2rem;\n}\n\n.settings__column {\n  display: grid;\n  gap: 1rem;\n  min-width: 0;\n}\n\n.settings__group {\n  min-width: 0;\n  padding: 1.1rem 1.2rem 1.2rem;\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  background: rgb(var(--panel-rgb) / calc(0.82 * var(--glass-level, 0.4)));\n  scroll-margin-top: 7rem;\n}\n\n.settings__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n}\n\n.settings__head h2 {\n  margin: 0;\n  font-size: 1.15rem;\n}\n\n.settings__lead {\n  margin: 0.5rem 0 0;\n  color: var(--text-2);\n  font-size: 0.88rem;\n}\n\n.settings__fields {\n  display: grid;\n  gap: 0.15rem;\n  margin: 0.8rem 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n/* label | control | value | reset; a select or a switch takes the value column too. */\n/* Tabs of the star layers (issue #15). */\n.settings__tabs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.3rem;\n  margin-top: 0.8rem;\n}\n\n.settings__tab {\n  padding: 0.3rem 0.75rem;\n  border: 1px solid var(--border-strong);\n  border-radius: 999px;\n  background: none;\n  color: var(--text-2);\n  font: inherit;\n  font-size: 0.85rem;\n  cursor: pointer;\n}\n\n.settings__tab[aria-selected='true'] {\n  border-color: var(--accent);\n  color: var(--text);\n  background: rgb(var(--accent-rgb) / 0.14);\n}\n\n.settings__tab.is-on::after {\n  content: '';\n  display: inline-block;\n  width: 0.45rem;\n  height: 0.45rem;\n  margin-left: 0.45rem;\n  border-radius: 50%;\n  background: var(--accent);\n  box-shadow: 0 0 6px var(--accent);\n  vertical-align: 0.1em;\n}\n\n.setting {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 4.4rem 1.7rem;\n  align-items: center;\n  gap: 0.15rem 0.6rem;\n  padding: 0.35rem 0;\n  border-top: 1px solid var(--border);\n  font-size: 0.88rem;\n}\n\n.setting label {\n  color: var(--text-2);\n}\n\n/* A changed setting is marked, so it is easy to see what differs from the defaults. */\n.setting.is-changed label {\n  color: var(--text);\n}\n\n.setting.is-changed label::before {\n  content: '';\n  display: inline-block;\n  width: 0.45rem;\n  height: 0.45rem;\n  margin-right: 0.4rem;\n  border-radius: 50%;\n  background: var(--accent);\n  vertical-align: 0.1em;\n}\n\n.setting__input {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n  min-height: 1.8rem;\n}\n\n.setting--select .setting__input,\n.setting--toggle .setting__input,\n.setting--tiles .setting__input {\n  grid-column: 2 / 4;\n}\n\n.setting__input input[type='range'] {\n  flex: 1;\n  min-width: 0;\n  accent-color: var(--accent);\n}\n\n.setting__input input[type='checkbox'] {\n  width: 1.1rem;\n  height: 1.1rem;\n  margin: 0;\n  accent-color: var(--accent);\n}\n\n.setting__input input[type='color'] {\n  width: 2.6rem;\n  height: 1.8rem;\n  padding: 0;\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  background: none;\n}\n\n.setting__input select {\n  flex: 1;\n  min-width: 0;\n  padding: 0.35rem 0.5rem;\n  border: 1px solid var(--border-strong);\n  border-radius: 8px;\n  background: var(--surface);\n  color: var(--text);\n  font: inherit;\n}\n\n.setting__value {\n  overflow: hidden;\n  color: var(--accent);\n  font-size: 0.8rem;\n  text-align: right;\n  white-space: nowrap;\n}\n\n.setting__reset {\n  flex: none;\n  width: 1.7rem;\n  height: 1.7rem;\n  border: 1px solid var(--border);\n  border-radius: 50%;\n  background: none;\n  color: var(--text-2);\n  cursor: pointer;\n}\n\n.setting__reset:disabled {\n  visibility: hidden;\n}\n\n/* ▶ next to a sound (issue #15): plays it. */\n.setting__play {\n  flex: none;\n  width: 1.8rem;\n  height: 1.8rem;\n  margin-left: 0.4rem;\n  border: 1px solid var(--border-strong);\n  border-radius: 50%;\n  background: none;\n  color: var(--accent);\n  font-size: 0.7rem;\n  line-height: 1;\nsrc/index.css:5:  --border: rgba(148, 197, 255, 0.14);\nsrc/index.css:9:  --muted: #7d8aa3;\nsrc/index.css:10:  --accent: #22d3ee;\nsrc/index.css:13:  --accent-2: #a78bfa;\nsrc/index.css:14:  --accent-3: #f472b6;\nsrc/index.css:17:  --accent-soft: rgba(34, 211, 238, 0.12);\nsrc/index.css:19:     *-rgb triplets are used as rgb(var(--panel-rgb) / 0.78), so every panel\nsrc/index.css:21:  --panel-rgb: 13 18 32;\nsrc/index.css:26:  --accent-rgb: 34 211 238;\nsrc/index.css:27:  --accent-2-rgb: 167 139 250;\nsrc/index.css:28:  --accent-3-rgb: 244 114 182;\nsrc/index.css:67:  --border: rgba(15, 40, 80, 0.14);\nsrc/index.css:71:  --muted: #5b6578;\nsrc/index.css:72:  --accent: #0e7490;\nsrc/index.css:74:  --accent-2: #6d28d9;\nsrc/index.css:75:  --accent-3: #be185d;\nsrc/index.css:76:  --accent-soft: rgba(14, 116, 144, 0.12);\nsrc/index.css:77:  --panel-rgb: 255 255 255;\nsrc/index.css:82:  --accent-rgb: 14 116 144;\nsrc/index.css:83:  --accent-2-rgb: 109 40 217;",
