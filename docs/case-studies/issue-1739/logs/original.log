        "content": "1\t/**\n2\t * DualStore — write-through to both the binary (Doublets) and text\n3\t * (`.lino`) backends so the unified database is always available in\n4\t * both forms (R-A3). Reads are served from the binary side because it\n5\t * is faster; the text side is treated as an authoritative export.\n6\t *\n7\t * `verify()` cross-checks the two backends and returns the set of\n8\t * links that disagree; this is the primitive the backup job runs\n9\t * before snapshotting (R-A4).\n10\t */\n11\t\n12\texport const createDualStore = ({ binary, text }) => ({\n13\t  async put(link) {\n14\t    await binary.put(link);\n15\t    await text.put(link);\n16\t    return link;\n17\t  },\n18\t  async get(id) {\n19\t    return binary.get(id);\n20\t  },\n21\t  async delete(id) {\n22\t    const a = await binary.delete(id);\n23\t    const b = await text.delete(id);\n24\t    return a || b;\n25\t  },\n26\t  async query(filter) {\n27\t    return binary.query(filter);\n28\t  },\n29\t  subscribe(h) {\n30\t    return binary.subscribe(h);\n31\t  },\n32\t  async flush() {\n33\t    await binary.flush?.();\n34\t    await text.flush?.();\n35\t  },\n36\t  async verify() {\n37\t    const a = await binary.query();\n38\t    const b = await text.query();\n39\t    const aMap = new Map(a.map((l) => [l.id, l]));\n40\t    const bMap = new Map(b.map((l) => [l.id, l]));\n41\t    const diffs = [];\n42\t    for (const [id, link] of aMap) {\n43\t      const other = bMap.get(id);\n44\t      if (!other || JSON.stringify(other) !== JSON.stringify(link)) {\n45\t        diffs.push({ id, binary: link, text: other ?? null });\n46\t      }\n47\t    }\n48\t    for (const [id, link] of bMap) {\n49\t      if (!aMap.has(id)) {\n50\t        diffs.push({ id, binary: null, text: link });\n51\t      }\n52\t    }\n53\t    return diffs;\n54\t  },\n55\t});\n56\t"
