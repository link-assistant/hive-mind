    {
      "id": "01M6S2FV5TZWQ753NHRB7BF5K7",
      "name": "Elevated error rates with some U.S. business Mastercards",
      "status": "resolved",
      "created_at": "2026-11-06T18:38:43Z",
      "updated_at": "2026-11-10T16:06:18Z",
      "resolved_at": "2026-11-10T16:06:18Z",
