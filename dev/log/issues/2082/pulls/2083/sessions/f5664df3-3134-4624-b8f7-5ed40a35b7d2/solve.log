jected]') || output.includes('non-fast-forward') || output.includes('fetch first') || output.includes('updates were rejected');\n     }\n\n     export async function pushWithRebaseRetry({ runner = runCommand, branch = 'main', remote = 'origin', maxAttempts = DEFAULT_PUSH_ATTEMPTS, delayMs = DEFAULT_PUSH_DELAY_MS, sleeper, logger = console, verbose = false }) {\n       const wait = sleeper ?? (ms => new Promise(resolve => setTimeout(resolve, ms)));\n       for (let attempt = 1; attempt <= maxAttempts; attempt++) {\n         const result = await runner('git', ['push', remote, branch], { verbose, logger });\n         if (result.code === 0) { return { pushed: true, attempt }; }\n         if (!isNonFastForward(result) || attempt === maxAttempts) {\n           throw new CommandFailedError('git', ['push', remote, branch], result);\n         }\n         logger.log(`Push rejected: ${remote}/${branch} has advanced (attempt ${attempt} of ${maxAttempts}). Rebasing and retrying...`);\n         await wait(delayMs);\n         await runStrict('git', ['pull', '--rebase', remote, branch], { runner, verbose, logger });\n       }\n       throw new Error(`Failed to push to ${remote}/${branch}`);\n     }\n     ```\n     `versionAndCommit({mode, bumpType, description, runner, output, readVersion, countChangesets, branch, remote, sleeper, logger, verbose})` — `const strict = (command, args) => runStrict(command, args, { runner, verbose, logger });` then: git config ×2 → `git fetch` → `rev-parse HEAD` vs `rev-parse origin/main` → if diverged and `countChangesets()===0` read `git show origin/main:package.json`, emit `already_released=true`, return; else `git rebase origin/main` → instant (`node scripts/instant-version-bump.mjs …`) or changeset (`npm run changeset:version`, `npm install --package-lock-only`) → `output('new_version', …)` → `git status --porcelain`; if clean emit `version_committed=false` and return → `git add -A`, `git commit -m newVersion` → **`await pushWithRebaseRetry(...)`** → only then `output('version_committed', 'true')`.\n\n   - **`scripts/version-and-commit.mjs`** — REWRITTEN as a thin CLI. Dropped `const { $ } = await use('command-stream');`. Now:\n     ```js\n     import { appendFileSync, readdirSync } from 'node:fs';\n     import { isVerbose } from './run-command.lib.mjs';\n     import { versionAndCommit } from './version-and-commit.lib.mjs';\n     // ...arg parsing/validation unchanged...\n     try {\n       await versionAndCommit({ mode, bumpType, description, output: setOutput, countChangesets, verbose: isVerbose() });\n     } catch (error) {\n       console.error('Error:', error.message);\n       process.exit(1);\n     }\n     ```\n\n   - **`tests/version-and-commit-2082.test.mjs`** — CREATED. `createHarness({respond, status, version})` + `REJECTED` fixture (`\" ! [rejected]        main -> main (fetch first)\\nerror: failed to push some refs to 'https://github.com/link-assistant/hive-mind'\\n\"`). 5 blocks: failing `changeset:version` rejects & nothing pushed & `version_committed` not true; clean tree → `version_committed==='false'`; rejected-then-successful push → `pushes===2`, rebase index > first-push index, `version_committed==='true'`; always-rejected push → rejects, `version_committed` not true; `pushWithRebaseRetry` in isolation → `result.attempt===3`, and `maxAttempts: 2` exhaustion rejects.\n\n   **Committed this session — `0e4eb599` (F6):**\n\n   - **`scripts/workflow-lint.lib.mjs`** — CREATED. Line-based scanner (deliberately not js-yaml):\n     ```js\n     export function findJobs(yaml) {\n       const lines = String(yaml || '').split('\\n');\n       const jobs = [];\n       let inJobs = false, current = null;\n       for (let index = 0; index < lines.length; index++) {\n         const line = lines[index];\n         if (/^\\S/.test(line)) { inJobs = /^jobs:\\s*(#.*)?$/.test(line); current = null; continue; }\n         if (!inJobs) continue;\n         const jobMatch = line.match(/^ {2}([A-Za-z_][A-Za-z0-9_-]*):\\s*(#.*)?$/);\n         if (jobMatch) { current = { name: jobMatch[1], line: index + 1, timeoutMinutes: null, reusable: false }; jobs.push(current); continue; }\n         if (!current) continue;\n         // Job-level keys: exactly four spaces. Anything deeper belongs to a step.\n         const keyMatch = line.match(/^ {4}([a-z-]+):\\s*(.*)$/);\n         if (!keyMatch) continue;\n         if (keyMatch[1] === 'timeout-minutes') {\n           const value = Number.parseInt(keyMatch[2], 10);\n           current.timeoutMinutes = Number.isNaN(value) ? null : value;\n         } else if (keyMatch[1] === 'uses') { current.reusable = true; }\n       }\n       return jobs;\n     }\n     export function findJobsMissingTimeout(yaml) {\n       return findJobs(yaml).filter(job => !job.reusable && job.timeoutMinutes === null);\n     }\n     ```\n\n   - **`tests/ci-workflow-timeouts-2082.test.mjs`** — CREATED. 4 scanner unit blocks (basic parse incl. `jobs[1].line === 9`; reusable-workflow caller exempt; step-level `uses:` does NOT exempt; `on:`/`env:` keys not mistaken for jobs) + a real-workflow block that reads `.github/workflows/*.yml|yaml`, asserts `files.length > 0` and `jobCount > 1` (anti-vacuity guards), and `assert.deepEqual(offenders, [], ...)`.\n\n   - **`.github/workflows/release.yml`** (+21 lines) and **`.github/workflows/cleanup-test-repos.yml`** (+1 line) — `timeout-minutes:` inserted after each job's `runs-on:`. Values map used:\n     ```\n     cleanup 15 | detect-changes 10 | version-check 10 | changeset-check 10\n     test-compilation 15 | lint 15 | check-file-line-limits 10 | test-suites 30\n     test-execution 20 | memory-check-linux 20 | validate-docs 15 | docker-pr-check 30\n     helm-pr-check 20 | release 30 | docker-publish-merge 30 | docker-publish-dind-merge 30\n     helm-release 20 | instant-release 30 | docker-publish-instant-merge 30\n     docker-publish-dind-instant-merge 30 | helm-release-instant 20 | changeset-pr 15\n     ```\n     The four matrix Docker jobs (release.yml lines 730, 881, 1124, 1271) already had `timeout-minutes: 60` and were left unchanged.\n\n   **Previously committed (`ba3c57a4`, prior session):** `scripts/run-command.lib.mjs` (`CommandFailedError`, `formatCommand`, `isVerbose` reading `HIVE_MIND_CI_VERBOSE`, `runCommand`, `runStrict`), `scripts/helm-release.lib.mjs`, `scripts/helm-release.mjs`, `tests/helm-release-2082.test.mjs`, `dev/log/issues/2082/pulls/2083/README.md`, `.../analysis/F0-existing-solutions-research.md`, `.gitattributes`.\n\n4. **Errors and fixes:**\n   - **Shell cwd persistence (recurred)** — I ran `cd .github/workflows && …` in one Bash call; the next call's `ls node_modules` failed with \"No such file or directory\" while `js-yaml` was still importable. Diagnosed the cwd carry-over and prefixed subsequent commands with the absolute `cd /tmp/gh-issue-solver-1784463865325`.\n   - **Wrong line-number assertion in my own test** — `tests/ci-workflow-timeouts-2082.test.mjs` asserted `jobs[1].line === 10`; actual was 9 (I miscounted the template literal). The scanner was correct; I fixed the test.\n   - **Mutation-check false reassurance** — for F4 mutant B (single push, no rebase retry) my `grep -E \"AssertionError\"` returned nothing, which could have been read as \"not caught\". I re-ran without the grep and confirmed it *was* caught (uncaught `CommandFailedError` at test line 128, exit 1). The grep was too narrow, not the test.\n   - **Ugly dynamic import** — I initially wrote `throw new (await import('./run-command.lib.mjs')).CommandFailedError(...)` inside `pushWithRebaseRetry`; replaced with a top-level `import { CommandFailedError, runCommand, runStrict }`.\n   - **js-yaml not a declared dependency** — discovered before writing the timeout check; chose a hand-rolled line scanner instead, then cross-validated the result against a real js-yaml parse (26 jobs, none missing).\n   - **`jq` is unavailable in this environment (exit 127)** — carried over constraint; I continue