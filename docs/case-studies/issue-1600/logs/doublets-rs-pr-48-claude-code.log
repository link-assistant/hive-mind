6\t                if value == any || link.source == value || link.target == value {\n267\t                    handler(link)\n268\t                } else {\n269\t                    Flow::Continue\n270\t                }\n271\t            } else {\n272\t                Flow::Continue\n273\t            };\n274\t        }\n275\t\n276\t        if query.len() == 3 {\n277\t            let source = query[constants.source_part.as_usize()];\n278\t            let target = query[constants.target_part.as_usize()];\n279\t\n280\t            return if index == any {\n281\t                if (source, target) == (any, any) {\n282\t                    self.each_core(handler, &[])\n283\t                } else if source == any {\n284\t                    self.targets.each_usages(target, handler)\n285\t                } else if target == any {\n286\t                    self.sources.each_usages(source, handler)\n287\t                } else {\n288\t                    let link = self.sources.search(source, target);\n289\t                    self.get_link(link).map_or(Flow::Continue, handler)\n290\t                }\n291\t            } else if let Some(link) = self.get_link(index) {\n292\t                if (target, source) == (any, any) {\n293\t                    handler(link) // TODO: add (x * *) search test\n294\t                } else if target != any && source != any {\n295\t                    if (source, target) == (link.source, link.target) {\n296\t                        handler(link)\n297\t                    } else {\n298\t                        Flow::Continue\n299\t                    }\n300\t                } else if source == any {\n301\t                    if link.target == target {\n302\t                        handler(link)\n303\t                    } else {\n304\t                        Flow::Continue\n305\t                    }\n306\t                } else if target == any {\n307\t                    if link.source == source {\n308\t                        handler(lin