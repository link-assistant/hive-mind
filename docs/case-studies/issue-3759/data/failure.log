[2026-10-24T14:59:17.458Z] [INFO]     "stdout": "  147 src/components/NetworkGallery.jsx\n  201 src/links/configurations.js\n  188 src/links/glyph.js\n  212 src/links/links.test.js\n   25 src/links/notation.js\n   74 src/links/notation.test.jsx\n   27 src/components/Glyph.jsx\n  147 src/pages/ArtPage.jsx\n    4 src/pages/art.jsx\n   12 src/pages/mount.jsx\n   81 src/pages/pages.js\n   31 scripts/check-file-line-limits.sh\n 1149 total\nimport { useMemo, useState } from 'react';\nimport {\n  classCount,\n  codeAt,\n  linksNotation,\n  mathNotation,\n  networkCount,\n  representatives,\n} from '../links/configurations';\nimport { COLORS } from '../links/glyph';\nimport { useLang } from '../i18n/prefs';\nimport { plural } from '../i18n/plural';\nimport { formatNumber } from './format';\nimport Glyph from './Glyph';\n\nconst SIZES = [1, 2, 3, 4];\nconst PAGE = 243;\nconst SUPERSCRIPTS = '⁰¹²³⁴⁵⁶⁷⁸⁹';\nconst superscript = (k) =>\n  String(k)\n    .split('')\n    .map((d) => SUPERSCRIPTS[d])\n    .join('');\nconst LINKS = { en: ['link', 'links'], ru: ['связь', 'связи', 'связей'] };\n// \"of N links\": Russian needs the genitive after «из».\nconst OF_LINKS = { en: ['link', 'links'], ru: ['связи', 'связей', 'связей'] };\nconst REAL_LINKS = { en: ['real link', 'real links'], ru: ['настоящая связь', 'настоящие связи', 'настоящих связей'] };\nconst NETWORKS = { en: ['network', 'networks'], ru: ['сеть', 'сети', 'сетей'] };\nconst DIGITS = { en: ['digit', 'digits'], ru: ['цифра', 'цифры', 'цифр'] };\nconst CLASSES = { en: ['class', 'classes'], ru: ['класс', 'класса', 'классов'] };\n\n/**\n * Every network of 1–4 links: all (N + 1)^(2N) codes in counting order, or\n * one network per renaming class. Symbols are drawn inline and shown page by\n * page, so even the 390,625 networks of 4 links never have to be enumerated.\n * \"Only real references\" (issue #13, off by default) leaves out every network\n * that refers to 0, so links refer only to each other or to themselves: N^(2N).\n */\nexport default function NetworkGallery({ initial = 2 }) {\n  const [n, setN] = useState(initial);\n  const [classes, setClasses] = useState(false);\n  const [real, setReal] = useState(false);\n  const [shown, setShown] = useState(PAGE);\n  const { lang, t } = useLang();\n  const number = (v) => formatNumber(v, lang);\n  const words = (k, forms) => plural(k, lang, forms);\n  const only = { real };\n  const total = classes ? classCount(n, { real }) : networkCount(n, { real });\n  const codes = useMemo(\n    () =>\n      classes\n        ? representatives(n, { real }).slice(0, shown)\n        : Array.from({ length: Math.min(shown, total) }, (_, i) => codeAt(n, i, { real })),\n    [n, classes, real, shown, total],\n  );\n  const choose = (k, c, r = real) => {\n    setN(k);\n    setClasses(c);\n    setReal(r);\n    setShown(PAGE);\n  };\n  const first = codeAt(n, 0, only);\n  const last = codeAt(n, networkCount(n, only) - 1, only);\n\n  return (\n    <div className=\"symbols\">\n      <p className=\"section__lead\">\n        {t({\n          en: 'Each symbol is one network of links, and each link is one unbroken line in its own colour: a bar marks its source, an arrow its target, and its middle is the point other links refer to. Link 0 (0: 0 0) is “nothing”: it always exists and is never drawn, so a reference to 0 is a free end, and a link that refers to itself twice is a figure eight. These networks are also the alphabet of the rain in the background.',\n          ru: 'Каждый символ — одна сеть связей, а каждая связь — одна непрерывная линия своего цвета: черта отмечает её начало, стрелка — конец, а середина — точку, на которую ссылаются другие связи. Связь 0 (0: 0 0) — это «ничто»: она существует всегда и никогда не рисуется, поэтому ссылка на 0 — это свободный конец, а связь, которая дважды ссылается на себя, — восьмёрка. Эти сети — ещё и алфавит дождя на фоне.',\n        })}\n      </p>\n      <div className=\"symbols__tabs\" role=\"group\" aria-label={t({ en: 'Number of links', ru: 'Количество связей' })}>\n        {SIZES.map((k) => (\n          <button key={k} type=\"button\" className=\"button\" aria-pressed={k === n} onClick={() => choose(k, classes)}>\n            {k} {words(k, LINKS)} <span className=\"mono\">{number(networkCount(k, only))}</span>\n          </button>\n        ))}\n        <button type=\"button\" className=\"button\" aria-pressed={classes} onClick={() => choose(n, !classes)}>\n          {t({ en: 'One per renaming', ru: 'Без переименований' })}{' '}\n          <span className=\"mono\">{number(classCount(n, only))}</span>\n        </button>\n        <button type=\"button\" className=\"button\" aria-pressed={real} onClick={() => choose(n, classes, !real)}>\n          {t({ en: 'Show only real references', ru: 'Только настоящие ссылки' })}{' '}\n          <span className=\"mono\">\n            {number(classes ? classCount(n, { real: true }) : networkCount(n, { real: true }))}\n          </span>\n        </button>\n      </div>\n\n      <dl className=\"symbols__formula\">\n        <dt>{t({ en: 'math notation', ru: 'математическая нотация' })}</dt>\n        <dd className=\"mono\">\n          {mathNotation(first)} … {mathNotation(last)} → {real ? n : n + 1}\n          {superscript(2 * n)} = {number(networkCount(n, only))} {words(networkCount(n, only), NETWORKS)}\n        </dd>\n        <dt>{t({ en: 'links notation', ru: 'нотация связей' })}</dt>\n        <dd className=\"mono\">\n          {linksNotation(first).join(' ')} … {linksNotation(last).join(' ')}\n        </dd>\n        <dd className=\"muted\">\n          {t({\n            en: `${n} ${words(n, REAL_LINKS)} after the zero link 0: every link is written as its source and target, so a network is ${2 * n} ${words(2 * n, DIGITS)} in base ${n + 1}.`,\n            ru: `${n} ${words(n, REAL_LINKS)} после нулевой связи 0: каждая связь записывается своим началом и концом, поэтому сеть — это ${2 * n} ${words(2 * n, DIGITS)} в системе счисления с основанием ${n + 1}.`,\n          })}\n          {real &&\n            t({\n              en: ` Only real references: networks that refer to 0 are left out, so every link refers to real links (each other or itself) and each digit is one of 1…${n}, ${n}${superscript(2 * n)} = ${number(networkCount(n, only))} ${words(networkCount(n, only), NETWORKS)}.`,\n              ru: ` Только настоящие ссылки: сети со ссылками на 0 не показаны, каждая связь ссылается на настоящие связи (друг на друга или на себя), и каждая цифра — одна из 1…${n}, ${n}${superscript(2 * n)} = ${number(networkCount(n, only))} ${words(networkCount(n, only), NETWORKS)}.`,\n            })}\n          {classes &&\n            t({\n              en: ` ${number(classCount(n, only))} ${words(classCount(n, only), CLASSES)} remain when networks that only rename the links are counted once (Burnside’s lemma).`,\n              ru: ` Если сети, которые отличаются только переименованием связей, считать один раз, остаётся ${number(classCount(n, only))} ${words(classCount(n, only), CLASSES)} (лемма Бёрнсайда).`,\n            })}\n        </dd>\n        <dd className=\"symbols__legend\">\n          {COLORS.slice(0, n).map((color, i) => (\n            <span key={color} style={{ color }}>\n              ━ {t({ en: 'link', ru: 'связь' })} {i + 1}\n            </span>\n          ))}\n        </dd>\n      </dl>\n\n      <ul\n        className=\"symbols__grid\"\n        aria-label={`${classes ? t({ en: 'Renaming classes', ru: 'Классы переименований' }) : t({ en: 'Networks', ru: 'Сети' })} ${t({ en: 'of', ru: 'из' })} ${n} ${words(n, OF_LINKS)}`}\n      >\n        {codes.map((code) => (\n          <li key={code} title={linksNotation(code).join(' ')}>\n            <Glyph code={code} size={64} />\n            <span className=\"mono\">{mathNotation(code)}</span>\n          </li>\n        ))}\n      </ul>\n      {total > shown && (\n        <button type=\"button\" className=\"button\" onClick={() => setShown(shown + PAGE * 2)}>\n          {t({\n            en: `Show more (${number(total - shown)} left)`,\n            ru: `Показать ещё (осталось ${number(total - shown)})`,\n          })}\n        </button>\n      )}\n    </div>\n  );\n}\n// Every network of 1–4 doublet links, encoded exactly as links.\n// Index 0 is the permanent zero link (0: 0 0): \"nothing\", always assumed and\n// never drawn. Real links are 1..N, and every link (i: s t) refers to links\n// 0..N by its source s and target t. So a network of N real links is written\n// with 2N digits in base N + 1, and there are (N + 1)^(2N) networks:\n//\n//   N = 1: base 2, 00₂ … 11₂                 4 networks\n//   N = 2: base 3, 00₃ 00₃ … 22₃ 22₃         81 networks\n//   N = 3: base 4, 00₄ 00₄ 00₄ … 33₄ 33₄ 33₄ 4,096 networks\n//   N = 4: base 5, 00₅ … 44₅ (four pairs)    390,625 networks\n//\n// For example (1: 0 0) is 00₂, (1: 1 0) is 10₂ and (1: 1 1) is 11₂.\n// Networks that differ only by renaming the real links (0 stays 0) form one\n// class; `classCount` counts them with Burnside's lemma and `representatives`\n// lists the smallest code of every class.\n//\n// With `{ real: true }` (issue #13) only networks whose links refer to real\n// links (each other or themselves) are counted, never to 0: every digit is\n// 1..N, so there are N^(2N) of them (1, 16, 729 and 65,536). Renaming never\n// turns a reference to 0 into a real one, so their classes are exactly the\n// classes without zeros.\n\nconst SUBSCRIPTS = '₀₁₂₃₄₅₆₇₈₉';\n\n/** The base of the codes of networks with `n` real links. */\nexport const baseOf = (n) => n + 1;\n\n/** How many networks of `n` real links exist: (n + 1)^(2n), or n^(2n) with only real references. */\nexport const networkCount = (n, { real = false } = {}) => (real ? n : baseOf(n)) ** (2 * n);\n\n/** Whether every link of the network refers only to real links, never to 0. */\nexport const isReal = (code) => !/0/.test(code);\n\n/** \"00 10\" → [[0, 0], [1, 0]]: link i + 1 is [source, target]. */\nexport function decode(code) {\n  return code.split(' ').map((pair) => [Number(pair[0]), Number(pair[1])]);\n}\n\n/** [[0, 0], [1, 0]] → \"00 10\". */\nexport const encode = (links) => links.map(([s, t]) => `${s}${t}`).join(' ');\n\n/** `index` as `length` digits in `base` (also base 1, where the only number is 0), most significant first. */\nfunction digitsOf(index, base, length) {\n  const digits = new Array(length).fill(0);\n  for (let k = length - 1; k >= 0 && index > 0; k--) {\n    digits[k] = index % base;\n    index = Math.floor(index / base);\n  }\n  return digits;\n}\n\nconst pairs = (digits) => digits.join('').match(/../g).join(' ');\n\n/**\n * The code of the `index`-th network of `n` links, counting in base n + 1;\n * with only real references the digits 1..n count in base n.\n */\nexport function codeAt(n, index, { real = false } = {}) {\n  if (!real) return pairs(digitsOf(index, baseOf(n), 2 * n));\n  return pairs(digitsOf(index, n, 2 * n).map((d) => d + 1));\n}\n\n/** The position of a code among the networks of its size (inverse of codeAt). */\nexport function indexOf(code, { real = false } = {}) {\n  const n = code.split(' ').length;\n  const base = real ? n : baseOf(n);\n  return [...code.replace(/ /g, '')].reduce((index, d) => index * base + Number(d) - (real ? 1 : 0), 0);\n}\n\n/** A random network of `n` links, or of 1–4 links when `n` is not given. */\nexport function randomCode(random = Math.random, n = 1 + Math.floor(random() * 4), { real = false } = {}) {\n  return codeAt(n, Math.floor(random() * networkCount(n, { real })), { real });\n}\n\n/** Math notation: the code with base subscripts, e.g. \"10₂\" or \"01₃ 20₃\". */\nexport function mathNotation(code) {\n  const base = String(baseOf(code.split(' ').length))\n    .split('')\n    .map((d) => SUBSCRIPTS[d])\n    .join('');\n  return code\n    .split(' ')\n    .map((pair) => pair + base)\n    .join(' ');\n}\n\n/** Links notation: one \"(index: source target)\" per real link. */\nexport const linksNotation = (code) => decode(code).map(([s, t], i) => `(${i + 1}: ${s} ${t})`);\n\nexport function permutations(n) {\n  if (n === 0) return [[]];\n  const result = [];\n  for (const rest of permutations(n - 1))\n    for (let i = 0; i <= rest.length; i++) result.push([...rest.slice(0, i), n - 1, ...rest.slice(i)]);\n  return result;\n}\n\n/**\n * Renames the real links by `perm` (perm[i] is the new 0-based position of\n * link i + 1); references to 0 stay 0.\n */\nexport function relabel(links, perm) {\n  const name = (ref) => (ref === 0 ? 0 : perm[ref - 1] + 1);\n  const result = new Array(links.length);\n  links.forEach(([s, t], i) => {\n    result[perm[i]] = [name(s), name(t)];\n  });\n  return result;\n}\n\n/** The smallest code among all renamings of the real links. */\nexport function canonical(links, perms = permutations(links.length)) {\n  let best = null;\n  for (const perm of perms) {\n    const code = encode(relabel(links, perm));\n    if (best === null || code < best) best = code;\n  }\n  return best;\n}\n\n/**\n * Whether no renaming of the real links gives a smaller code. Works on flat\n * digit arrays and stops at the first difference, so all 390,625 networks\n * of 4 links are checked in a fraction of a second.\n */\nfunction isSmallest(digits, perms, n) {\n  const renamed = new Array(2 * n);\n  for (const perm of perms) {\n    for (let i = 0; i < n; i++) {\n      const s = digits[2 * i];\n      const t = digits[2 * i + 1];\n      renamed[2 * perm[i]] = s === 0 ? 0 : perm[s - 1] + 1;\n      renamed[2 * perm[i] + 1] = t === 0 ? 0 : perm[t - 1] + 1;\n    }\n    for (let k = 0; k < 2 * n; k++) {\n      if (renamed[k] < digits[k]) return false;\n      if (renamed[k] > digits[k]) break;\n    }\n  }\n  return true;\n}\n\nconst cache = new Map();\n\n/** The smallest code of every renaming class of networks with `n` links. */\nexport function representatives(n, { real = false } = {}) {\n  if (real) {\n    const key = `real ${n}`;\n    if (!cache.has(key)) cache.set(key, representatives(n).filter(isReal));\n    return cache.get(key);\n  }\n  if (!cache.has(n)) {\n    const perms = permutations(n);\n    const base = baseOf(n);\n    const digits = new Array(2 * n).fill(0);\n    const result = [];\n    for (let i = 0; i < networkCount(n); i++) {\n      if (isSmallest(digits, perms, n)) result.push(pairs(digits));\n      // Count up in base n + 1, last digit first.\n      for (let k = 2 * n - 1; k >= 0 && ++digits[k] === base; k--) digits[k] = 0;\n    }\n    cache.set(n, result);\n  }\n  return cache.get(n);\n}\n\n/**\n * The number of renaming classes by Burnside's lemma: the average, over all\n * permutations of the real links, of the networks a permutation keeps fixed.\n */\nexport function classCount(n, { real = false } = {}) {\n  const perms = permutations(n);\n  let fixed = 0;\n  for (const perm of perms) {\n    const cycles = cycleLengths(perm);\n    let product = 1;\n    for (const k of cycles) {\n      // An end of a link on a k-cycle may refer to 0 (unless only real\n      // references count) or to any link whose cycle length divides k; both\n      // ends of the cycle's links are free.\n      const choices = (real ? 0 : 1) + cycles.filter((d) => k % d === 0).reduce((sum, d) => sum + d, 0);\n      product *= choices ** 2;\n    }\n    fixed += product;\n  }\n  return fixed / perms.length;\n}\n\nfunction cycleLengths(perm) {\n  const seen = new Array(perm.length).fill(false);\n  const lengths = [];\n  perm.forEach((_, start) => {\n    let length = 0;\n    for (let i = start; !seen[i]; i = perm[i]) {\n      seen[i] = true;\n      length += 1;\n    }\n    if (length) lengths.push(length);\n  });\n  return lengths;\n}\n// Draws a network of 1–4 doublet links as one symbol, after the blueprint of\n// github.com/konard/links-visuals: every link is ONE continuous curve in its\n// own colour. It starts with a bar at its source, passes through its own\n// middle and ends with an arrow at its target; nothing interrupts the line in\n// the middle. Other links refer to a link by touching its middle. A reference\n// to 0 (nothing) is a free end, a reference to the link itself is a loop that\n// returns to its own middle, so (1: 1 1) is a symmetric figure eight (∞).\n//\n// Geometry is computed in layout units (neighbouring middles are 1 apart),\n// every curve is a chain of cubic Bézier segments that share tangents where\n// they meet, and the finished drawing is scaled into a SIZE × SIZE box.\n\nexport const SIZE = 100;\nexport const STROKE = 2.4;\n/** One colour per real link: link 1, 2, 3, 4. */\nexport const COLORS = ['#22d3ee', '#c084fc', '#f472b6', '#facc15'];\n\nconst PAD = 9; // free margin around the drawing, in SIZE units\nconst SCALE = 60; // SIZE units per layout unit, unless the drawing must shrink\nconst BAR = 3.6; // half-length of the source bar\nconst ARROW = 5.5; // length of the arrow head arms\nconst ARROW_ANGLE = (28 * Math.PI) / 180;\nconst BULGE = (20 * Math.PI) / 180; // how much a lone reference bends aside\nconst GAP = 0.07; // ends stop this far from the middle they touch\nconst FREE = 0.42; // length of a free end (a reference to nothing)\nconst LOOP = 0.8; // size of a self-reference loop\nconst LONE = { free: 0.9, loop: 1.25 }; // a single link has the box to itself\n\nconst add = (a, b) => [a[0] + b[0], a[1] + b[1]];\nconst sub = (a, b) => [a[0] - b[0], a[1] - b[1]];\nconst mul = (a, k) => [a[0] * k, a[1] * k];\nconst dot = (a, b) => a[0] * b[0] + a[1] * b[1];\nconst length = (a) => Math.hypot(a[0], a[1]);\nconst unit = (a) => mul(a, 1 / length(a));\nconst rotate = (a, angle) => {\n  const c = Math.cos(angle);\n  const s = Math.sin(angle);\n  return [a[0] * c - a[1] * s, a[0] * s + a[1] * c];\n};\n/** Mirrors the tangent `d` across the chord direction `c`. */\nconst reflect = (d, c) => sub(mul(c, 2 * dot(d, c)), d);\n\n/**\n * A link that refers twice to the same other link is a lens: its ends meet\n * the other middle at 45° instead of sideways, so two links that refer to\n * each other twice cross instead of drawing the same oval.\n */\nconst lens = (dir, chord, twice) => (twice ? unit(add(dir, chord)) : dir);\n\n/** Middles of the links (layout units) and the outward direction of each. */\nexport function layout(n) {\n  if (n === 1) return [{ at: [0, 0], out: [0, -1] }];\n  const radius = 0.5 / Math.sin(Math.PI / n);\n  const start = n === 2 ? Math.PI : n === 3 ? -Math.PI / 2 : (-3 * Math.PI) / 4;\n  return Array.from({ length: n }, (_, i) => {\n    const out = [Math.cos(start + (2 * Math.PI * i) / n), Math.sin(start + (2 * Math.PI * i) / n)];\n    return { at: mul(out, radius), out };\n  });\n}\n\n/** Picks the side ±perp(d) whose loop, with axis between side and `away`, points outward. */\nfunction side(d, away, out) {\n  const left = rotate(d, Math.PI / 2);\n  const right = mul(left, -1);\n  return dot(add(left, away), out) >= dot(add(right, away), out) ? left : right;\n}\n\n/** The cubic segments of link `i` (0-based) and its two ends, in layout units. */\nfunction linkCurve(links, i, places) {\n  const n = links.length;\n  const [s, t] = links[i];\n  const { at: m, out } = places[i];\n  const other = (ref) => ref !== 0 && ref !== i + 1;\n  const free = n === 1 ? LONE.free : FREE;\n  const loop = n === 1 ? LONE.loop : LOOP;\n  const tangent = rotate(out, Math.PI / 2);\n  const tIn = other(s) ? unit(sub(m, places[s - 1].at)) : null;\n  const tOut = other(t) ? unit(sub(places[t - 1].at, m)) : null;\n\n  // The direction in which the link passes through its own middle.\n  let d;\n  if (tIn && tOut) {\n    const sum = add(tIn, tOut);\n    d = length(sum) < 1e-9 ? side(tOut, [0, 0], out) : unit(sum);\n  } else if (tIn || tOut) d = rotate(tIn || tOut, BULGE);\n  else if (s && t) d = rotate(tangent, Math.PI / 4);\n  else d = tangent;\n\n  let first;\n  let start;\n  if (s === 0) {\n    const from = sub(m, mul(d, free));\n    first = [from, add(from, mul(d, free / 3)), sub(m, mul(d, free / 3)), m];\n    start = { at: from, dir: d };\n  } else if (s === i + 1) {\n    // A loop that leaves the middle sideways and comes back through it.\n    const away = t === i + 1 ? rotate(d, Math.PI / 2) : side(d, mul(d, -1), out);\n    const from = add(m, mul(away, GAP));\n    first = [from, add(m, mul(away, loop)), sub(m, mul(d, loop)), m];\n    start = { at: from, dir: away };\n  } else {\n    const p = places[s - 1].at;\n    const chord = unit(sub(m, p));\n    const dir = lens(reflect(d, chord), chord, s === t);\n    const k = 0.38 * length(sub(m, p));\n    const from = add(p, mul(dir, GAP));\n    first = [from, add(from, mul(dir, k)), sub(m, mul(d, k)), m];\n    start = { at: from, dir };\n  }\n\n  let second;\n  let end;\n  if (t === 0) {\n    const to = add(m, mul(d, free));\n    second = [m, add(m, mul(d, free / 3)), sub(to, mul(d, free / 3)), to];\n    end = { at: to, dir: d };\n  } else if (t === i + 1) {\n    // Point-symmetric to the source loop, so (1: 1 1) is an even ∞.\n    const away = s === i + 1 ? rotate(d, -Math.PI / 2) : side(d, d, out);\n    const to = add(m, mul(away, GAP));\n    second = [m, add(m, mul(d, loop)), add(m, mul(away, loop)), to];\n    end = { at: to, dir: mul(away, -1) };\n  } else {\n    const q = places[t - 1].at;\n    const chord = unit(sub(q, m));\n    const dir = lens(reflect(d, chord), chord, s === t);\n    const k = 0.38 * length(sub(q, m));\n    const to = sub(q, mul(dir, GAP));\n    second = [m, add(m, mul(d, k)), sub(to, mul(dir, k)), to];\n    end = { at: to, dir };\n  }\n  return { segments: [first, second], start, end };\n}\n\n/** The point at parameter u ∈ [0, 1] of a cubic Bézier segment. */\nexport const bezier = ([p0, p1, p2, p3], u) => {\n  const v = 1 - u;\n  return add(add(mul(p0, v * v * v), mul(p1, 3 * v * v * u)), add(mul(p2, 3 * v * u * u), mul(p3, u * u * u)));\n};\n\n/** The curves of every link, already scaled into the SIZE box. */\nexport function glyphCurves(links) {\n  const n = links.length;\n  if (n < 1 || n > 4) throw new RangeError(`A symbol draws 1–4 links, got ${n}`);\n  const places = layout(n);\n  const curves = links.map((_, i) => linkCurve(links, i, places));\n  const points = curves.flatMap((c) =>\n    c.segments.flatMap((seg) => Array.from({ length: 17 }, (_, k) => bezier(seg, k / 16))),\n  );\n  const xs = points.map((p) => p[0]);\n  const ys = points.map((p) => p[1]);\n  const [minX, maxX, minY, maxY] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];\n  const scale = Math.min(SCALE, (SIZE - 2 * PAD) / Math.max(maxX - minX, maxY - minY, 1e-9));\n  const shift = [SIZE / 2 - ((minX + maxX) / 2) * scale, SIZE / 2 - ((minY + maxY) / 2) * scale];\n  const place = (p) => add(mul(p, scale), shift);\n  return curves.map((c) => ({\n    segments: c.segments.map((seg) => seg.map(place)),\n    start: { at: place(c.start.at), dir: c.start.dir },\n    end: { at: place(c.end.at), dir: c.end.dir },\n  }));\n}\n\nconst fmt = (p) => `${+p[0].toFixed(2)} ${+p[1].toFixed(2)}`;\n\n/** One SVG path per link: the continuous line, the source bar and the target arrow. */\nexport function glyphPaths(links) {\n  return glyphCurves(links).map(({ segments, start, end }, i) => {\n    const line = `M${fmt(segments[0][0])}` + segments.map((seg) => `C${seg.slice(1).map(fmt).join(' ')}`).join('');\n    const across = rotate(start.dir, Math.PI / 2);\n    const bar = `M${fmt(add(start.at, mul(across, BAR)))}L${fmt(sub(start.at, mul(across, BAR)))}`;\n    const back = mul(end.dir, -ARROW);\n    const arrow =\n      `M${fmt(add(end.at, rotate(back, ARROW_ANGLE)))}L${fmt(end.at)}` +\n      `L${fmt(add(end.at, rotate(back, -ARROW_ANGLE)))}`;\n    return { d: line + bar + arrow, color: COLORS[i] };\n  });\n}\n\n/** A standalone SVG document of a network (used by tests and experiments). */\nexport function glyphSvg(links, size = SIZE) {\n  const paths = glyphPaths(links)\n    .map(({ d, color }) => `<path d=\"${d}\" stroke=\"${color}\"/>`)\n    .join('');\n  return (\n    `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${size}\" height=\"${size}\" viewBox=\"0 0 ${SIZE} ${SIZE}\" ` +\n    `fill=\"none\" stroke-width=\"${STROKE}\" stroke-linecap=\"round\" stroke-linejoin=\"round\">${paths}</svg>`\n  );\n}\nimport { decode } from '../links/configurations';\nimport { glyphPaths, SIZE, STROKE } from '../links/glyph';\n\n/**\n * One network of links drawn inline in the links-visuals style: every link is\n * one continuous line in its own colour. `code` is a network code such as\n * '00 11' (link 1 = (1: 0 0), link 2 = (2: 1 1)); 0 is the zero link.\n */\nexport default function Glyph({ code, size = 48, title = null, className = 'glyph' }) {\n  return (\n    <svg\n      className={className}\n      viewBox={`0 0 ${SIZE} ${SIZE}`}\n      width={size}\n      height={size}\n      role={title ? 'img' : undefined}\n      aria-label={title || undefined}\n      aria-hidden={title ? undefined : 'true'}\n    >\n      <g fill=\"none\" strokeWidth={STROKE} strokeLinecap=\"round\" strokeLinejoin=\"round\">\n        {glyphPaths(decode(code)).map(({ d, color }, i) => (\n          <path key={i} d={d} stroke={color} data-link={i + 1} />\n        ))}\n      </g>\n    </svg>\n  );\n}",
