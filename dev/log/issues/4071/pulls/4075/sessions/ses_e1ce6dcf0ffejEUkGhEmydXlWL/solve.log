];\n00540| \n00541|   if (argv.fork) {\n00542|     // When in fork mode, check for existing branches in the fork\n00543|     try {\n00544|       // Get current user to determine fork name\n00545|       const userResult = await $(QUIET_PROBE)`gh api user --jq .login`;\n00546|       if (userResult.code === 0) {\n00547|         const currentUser = userResult.stdout.toString().trim();\n00548|         // Determine fork name based on --prefix-fork-name-with-owner-name option\n00549|         const forkRepoName = argv.prefixForkNameWithOwnerName ? `${owner}-${repo}` : repo;\n00550|         const forkRepo = `${currentUser}/${forkRepoName}`;\n00551| \n00552|         // Check if fork exists\n00553|         const forkCheckResult = await $`gh repo view ${forkRepo} --json name 2>/dev/null`;\n00554|         if (forkCheckResult.code === 0) {\n00555|           await log(`🔍 Fork mode: Checking for existing branches in ${forkRepo}...`);\n00556| \n00557|           // List all branches in the fork that match the pattern issue-{issueNumber}-* (supports both 8-char and 12-char formats)\n00558|           const branchPattern = getIssueBranchPrefix(issueNumber);\n00559|           // Issue #2135: `mirror: false`. The list grows with the repository -\n00560|           // a repository worked on by the solver accumulates one branch per\n00561|           // issue - and only the matching ones are reported below.\n00562|           const branchListResult = await $(QUIET_PROBE)`gh api --paginate repos/${forkRepo}/branches --jq '.[].name'`;\n00563| \n00564|           if (branchListResult.code === 0) {\n00565|             const allBranches = branchListResult.stdout\n00566|               .toString()\n00567|               .trim()\n00568|               .split('\\n')\n00569|               .filter(b => b);\n00570|             existingBranches = allBranches.filter(branch => matchesIssuePattern(branch, issueNumber));\n00571| \n00572|             if (existingBranches.length > 0) {\n00573|               await log(`📋 Found ${existingBranches.length} existing branch(es) in fork matching pattern '${branchPattern}*':`);\n00574|               for (const branch of existingBranches) {\n00575|                 await log(`  • ${branch}`);\n00576|               }\n00577|             }\n00578|           }\n00579|         }\n00580|       }\n00581|     } catch (forkBranchError) {\n00582|       reportError(forkBranchError, {\n00583|         context: 'check_fork_branches',\n00584|         owner,\n00585|         repo,\n00586|         issueNumber,\n00587|         operation: 'search_fork_branches',\n00588|       });\n00589|       await log(`⚠️  Warning: Could not check for existing branches in fork: ${forkBranchError.message}`, {\n00590|         level: 'warning',\n00591|       });\n00592|     }\n00593|   } else {\n00594|     // NOT in fork mode - check for existing branches in the main repository\n00595|     try {\n00596|       await log(`🔍 Checking for existing branches in ${owner}/${repo}...`);\n00597| \n00598|       // List all branches in the main repo that match the pattern issue-{issueNumber}-* (supports both 8-char and 12-char formats)\n00599|       const branchPattern = getIssueBranchPrefix(issueNumber);\n00600|       // Issue #2135: `mirror: false` - see the fork branch listing above.\n00601|       const branchListResult = await $(QUIET_PROBE)`gh api --paginate repos/${owner}/${repo}/branches --jq '.[].name'`;\n00602| \n00603|       if (branchListResult.code === 0) {\n00604|         const allBranches = branchListResult.stdout\n00605|           .toString()\n00606|           .trim()\n00607|           .split('\\n')\n00608|           .filter(b => b);\n00609|         existingBranches = allBranches.filter(branch => matchesIssuePattern(branch, issueNumber));\n00610| \n00611|         if (existingBranches.length > 0) {\n00612|           await log(`📋 Found ${existingBranches.length} existing branch(es) in main repo matching pattern '${branchPattern}*':`);\n00613|           for (const branch 