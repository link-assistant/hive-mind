tch mode\\n   880\\t  const temporaryWatchMode = shouldRestart && !argv.watch;\\n   881\\t  if (temporaryWatchMode) {\\n   882\\t    await log('');\\n   883\\t    await log('🔄 AUTO-RESTART: Uncommitted changes detected');\\n   884\\t    await log('   Starting temporary monitoring cycle (NOT --watch mode)');\\n   885\\t    await log('   The tool will run once more to commit the changes');\\n   886\\t    await log('   Will exit automatically after changes are committed');\\n   887\\t    await log('');\\n   888\\t  }\\n   889\\t\\n   890\\t  const watchResult = await startWatchMode({\\n   891\\t    issueUrl,\\n   892\\t    owner,\\n   893\\t    repo,\\n   894\\t    issueNumber,\\n   895\\t    prNumber,\\n   896\\t    prBranch,\\n   897\\t    branchName,\\n   898\\t    tempDir,\\n   899\\t    argv: {\\n   900\\t      ...argv,\\n   901\\t      watch: argv.watch || shouldRestart, // Enable watch if uncommitted changes\\n   902\\t      temporaryWatch: temporaryWatchMode  // Flag to indicate temporary watch mode\\n   903\\t    }\\n   904\\t  });\\n   905\\t\\n   906\\t  // Update session data with latest from watch mode for accurate pricing\\n   907\\t  if (watchResult && watchResult.latestSessionId) {\\n   908\\t    sessionId = watchResult.latestSessionId;\\n   909\\t    anthropicTotalCostUSD = watchResult.latestAnthropicCost;\\n   910\\t    if (argv.verbose) {\\n   911\\t      await log('');\\n   912\\t      await log('📊 Updated session data from watch mode:', { verbose: true });\\n   913\\t      await log(`   Session ID: ${sessionId}`, { verbose: true });\\n   914\\t      if (anthropicTotalCostUSD !== null && anthropicTotalCostUSD !== undefined) {\\n   915\\t        await log(`   Anthropic cost: $${anthropicTotalCostUSD.toFixed(6)}`, { verbose: true });\\n   916\\t      }\\n   917\\t    }\\n   918\\t  }\\n   919\\t\\n   920\\t  // Track whether logs were successfully attached (used by endWorkSession)\\n   921\\t  let logsAttached = false;\\n   922\\t\\n   923\\t  // After watch mode completes (either user watch or temporary)\\n   924\\t  // Push any committed changes if this was a temporary watch mode\\n   925\\t  if (temporaryWatchMode) {\\n   926\\t    await log('');\\n   927\\t    await log('📤 Pushing committed changes to GitHub...');\\n   928\\t    await log('');\\n   929\\t\\n   930\\t    try {\\n   931\\t      const pushResult = await $({ cwd: tempDir })`git push origin ${branchName}`;\\n   932\\t      if (pushResult.code === 0) {\\n   933\\t        await log('✅ Changes pushed successfully to remote branch');\\n   934\\t        await log(`   Branch: ${branchName}`);\\n   935\\t        await log('');\\n   936\\t      } else {\\n   937\\t        const errorMsg = pushResult.stderr?.toString() || 'Unknown error';\\n   938\\t        await log('⚠️  Push failed:', { level: 'error' });\\n   939\\t        await log(`   ${errorMsg.trim()}`, { level: 'error' });\\n   940\\t        await log('   Please push manually:', { level: 'error' });\\n   941\\t        await log(`   cd ${tempDir} && git push origin ${branchName}`, { level: 'error' });\\n   942\\t      }\\n   943\\t    } catch (error) {\\n   944\\t      await log('⚠️  Push failed:', { level: 'error' });\\n   945\\t      await log(`   ${cleanErrorMessage(error)}`, { level: 'error' });\\n   946\\t      await log('   Please push manually:', { level: 'error' });\\n   947\\t      await log(`   cd ${tempDir} && git push origin ${branchName}`, { level: 'error' });\\n   948\\t    }\\n   949\\t\\n   950\\t    // Attach updated logs to PR after auto-restart completes\\n   951\\t    if (shouldAttachLogs && prNumber) {\\n   952\\t      await log('📎 Uploading working session logs to Pull Request...');\\n   953\\t      try {\\n   954\\t        const logUploadSuccess = await attachLogToGitHub({\\n   955\\t          logFile: getLogFile(),\\n   956\\t          targetType: 'pr',\\n   957\\t          targetNumber: prNumber,\\n   958\\t          owner,\\n   959\\t          repo,\\n   960\\t          $,