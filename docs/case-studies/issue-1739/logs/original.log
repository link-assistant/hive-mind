        "type": "tool_result",
        "content": "1\timport { describe, it, expect } from 'test-anywhere';\n2\timport {\n3\t  createPeer,\n4\t  startSyncListener,\n5\t  connectSyncPeer,\n6\t} from '../src/sync/index.js';\n7\timport { createMemoryStore } from '../src/storage/index.js';\n8\t\n9\tdescribe('sync over TCP transport', () => {\n10\t  it('replicates a put from one store to another', async () => {\n11\t    const a = createMemoryStore();\n12\t    const b = createMemoryStore();\n13\t    const peerA = createPeer(a, { node: 'a' });\n14\t    const peerB = createPeer(b, { node: 'b' });\n15\t\n16\t    const listener = await startSyncListener({ port: 0 });\n17\t    const offA = peerA.connect(listener.transport);\n18\t\n19\t    const client = await connectSyncPeer({ port: listener.port });\n20\t    const offB = peerB.connect(client.transport);\n21\t\n22\t    await a.put({\n23\t      id: 'x',\n24\t      tokens: ['hello'],\n25\t      vc: { a: 1 },\n26\t    });\n27\t\n28\t    // Poll for the replicated record instead of sleeping a fixed\n29\t    // duration — bun on macOS occasionally needs more than a hundred\n30\t    // milliseconds for the TCP roundtrip + async receive() to settle.\n31\t    let replicated;\n32\t    const deadline = Date.now() + 5000;\n33\t    while (Date.now() < deadline) {\n34\t      replicated = await b.get('x');\n35\t      if (replicated?.tokens?.[0] === 'hello') {\n36\t        break;\n37\t      }\n38\t      await new Promise((r) => setTimeout(r, 25));\n39\t    }\n40\t    expect(replicated?.tokens?.[0]).toBe('hello');\n41\t\n42\t    offA();\n43\t    offB();\n44\t    await client.close();\n45\t    await listener.close();\n46\t  });\n47\t});\n48\t"
