[2026-07-19T12:28:48.456Z] [INFO]         "content": "###### check-mjs-syntax.sh\n--- tmpl/scripts/check-mjs-syntax.sh\t2026-07-19 12:26:18.986763054 +0000\n+++ gh-issue-solver-1784463865325/scripts/check-mjs-syntax.sh\t2026-07-19 12:24:55.940599581 +0000\n@@ -1,7 +1,7 @@\n #!/usr/bin/env bash\n # check-mjs-syntax.sh\n #\n-# Checks Node.js syntax for all .mjs files in src/, scripts/, and tests/.\n+# Checks Node.js syntax for all .mjs files in the project root, src/, and tests/.\n #\n # Usage:\n #   bash scripts/check-mjs-syntax.sh\n@@ -11,19 +11,21 @@\n set -euo pipefail\n \n echo \"Checking syntax for all .mjs files...\"\n-\n-CHECKED=0\n-for dir in src scripts tests; do\n-  if [ -d \"$dir\" ]; then\n-    for file in \"$dir\"/*.mjs; do\n-      if [ -f \"$file\" ]; then\n-        echo \"Checking $file...\"\n-        timeout 10s node --check \"$file\"\n-        CHECKED=$((CHECKED + 1))\n-      fi\n-    done\n+for file in *.mjs; do\n+  if [ -f \"$file\" ]; then\n+    echo \"Checking $file...\"\n+    timeout 10s node --check \"$file\"\n+  fi\n+done\n+for file in src/*.mjs; do\n+  if [ -f \"$file\" ]; then\n+    echo \"Checking $file...\"\n+    timeout 10s node --check \"$file\"\n+  fi\n+done\n+for file in tests/*.mjs; do\n+  if [ -f \"$file\" ]; then\n+    echo \"Checking $file...\"\n+    node --check \"$file\"\n   fi\n done\n-\n-echo \"\"\n-echo \"Syntax check passed for $CHECKED file(s).\"\n###### check-file-line-limits.sh\n--- tmpl/scripts/check-file-line-limits.sh\t2026-07-19 12:26:18.986763054 +0000\n+++ gh-issue-solver-1784463865325/scripts/check-file-line-limits.sh\t2026-07-19 12:24:55.940599581 +0000\n@@ -1,19 +1,7 @@\n #!/usr/bin/env bash\n # check-file-line-limits.sh\n #\n-# Enforces the documented 1500-line architecture limit on tracked\n-# JavaScript (.js, .mjs, .cjs) and Markdown (.md) files, plus\n-# .github/workflows/release.yml.\n-#\n-# This shell gate complements the ESLint `max-lines` rule: ESLint only\n-# covers source files it lints, while this check walks every tracked\n-# JavaScript and Markdown file so .js, .cjs, and documentation cannot\n-# slip past the limit.\n-#\n-# Intentional exceptions (kept in sync with the eslint.config.js ignore\n-# list): case-study and generated-data files under\n-# docs/case-studies/*/data/ mirror external sources verbatim and must not\n-# be reflowed to satisfy the limit, so they are excluded here.\n+# Enforces a 1500-line limit on all .mjs files and on release.yml.\n #\n # Usage:\n #   bash scripts/check-file-line-limits.sh\n@@ -23,49 +11,45 @@\n set -euo pipefail\n \n LIMIT=1500\n+# Issue #1593: Warning threshold to catch files approaching the limit before they exceed it.\n+# This mitigates the concurrent PR merge race condition where two PRs each pass CI individually\n+# but their combined changes push a file over the limit after both merge to main.\n+# See docs/case-studies/issue-1593 for the full analysis.\n WARN_THRESHOLD=1350\n FAILURES=()\n WARNINGS=()\n \n-# check_file FILE [HINT]\n-# Counts lines in FILE and records a warning or failure when it crosses\n-# the warning threshold or hard limit. HINT is appended to the GitHub\n-# annotation to suggest a remediation.\n-check_file() {\n-  local file=\"$1\"\n-  local hint=\"${2:-Extract code to keep files under the ${LIMIT} line limit.}\"\n-  local line_count\n-  line_count=$(wc -l < \"$file\" | tr -d '[:space:]')\n+echo \"Checking that all .mjs files are under ${LIMIT} lines...\"\n+\n+while IFS= read -r -d '' file; do\n+  line_count=$(wc -l < \"$file\")\n   echo \"$file: $line_count lines\"\n   if [ \"$line_count\" -gt \"$LIMIT\" ]; then\n     echo \"ERROR: $file has $line_count lines (limit: ${LIMIT})\"\n-    echo \"::error file=$file::File has $line_count lines (limit: ${LIMIT}). ${hint}\"\n+    echo \"::error file=$file::File has $line_count lines (limit: ${LIMIT})\"\n     FAILURES+=(\"$file\")\n   elif [ \"$line_count\" -gt \"$WARN_THRESHOLD\" ]; then\n     echo \"WARNING: $file has $line_count lines (approaching limit of ${LIMIT}, warning threshold: ${WARN_THRESHOLD})\"\n-    echo \"::warning file=$file::File has $line_count lines (approaching limit of ${LIMIT}). ${hint}\"\n+    echo \"::warning file=$file::File has $line_count lines (approaching limit of ${LIMIT}). Consider extracting code to keep under ${WARN_THRESHOLD} lines to prevent concurrent PR merge issues (see issue #1593).\"\n     WARNINGS+=(\"$file\")\n   fi\n-}\n-\n-echo \"Checking that JavaScript and Markdown files are under ${LIMIT} lines...\"\n-\n-# Walk every tracked JavaScript and Markdown file. node_modules is build\n-# output, and docs/case-studies/*/data holds verbatim external sources\n-# (see header note and eslint.config.js ignores).\n-while IFS= read -r -d '' file; do\n-  check_file \"$file\"\n-done < <(find . -type f \\\n###### simulate-fresh-merge.sh\n--- tmpl/scripts/simulate-fresh-merge.sh\t2026-07-19 12:26:18.989763024 +0000\n+++ gh-issue-solver-1784463865325/scripts/simulate-fresh-merge.sh\t2026-07-19 12:24:55.942599561 +0000\n@@ -12,12 +12,12 @@\n #\n # Exit code 0 = merge succeeded or not needed; non-zero = merge conflict detected.\n #\n-# See docs/case-studies/issue-23 for why this is critical.\n+# See docs/case-studies/issue-1141 for why this is critical.\n \n set -euo pipefail\n \n echo \"=== Synchronizing PR with latest $BASE_REF ===\"\n-echo \"This prevents stale merge preview issues (see docs/case-studies/issue-23)\"\n+echo \"This prevents stale merge preview issues (see issue #1141)\"\n echo \"\"\n \n # Configure git for merge\n=== set -e in sh scripts ===\ntmpl/scripts/simulate-fresh-merge.sh:17:set -euo pipefail\ngh-issue-solver-1784463865325/scripts/check-file-line-limits.sh:11:set -euo pipefail\ntmpl/scripts/push-main-with-rebase-retry.sh:2:set -euo pipefail\ngh-issue-solver-1784463865325/scripts/test-global-commands.sh:12:set -euo pipefail\ngh-issue-solver-1784463865325/scripts/verify-chart-yaml.sh:12:set -euo pipefail\ngh-issue-solver-1784463865325/scripts/verify-dind-exec-defaults.sh:2:set -euo pipefail\ngh-issue-solver-1784463865325/scripts/simulate-fresh-merge.sh:17:set -euo pipefail\ntmpl/scripts/check-mjs-syntax.sh:11:set -euo pipefail\ntmpl/scripts/check-file-line-limits.sh:23:set -euo pipefail\ngh-issue-solver-1784463865325/scripts/test-auto-fork-option.sh:12:set -euo pipefail\ngh-issue-solver-1784463865325/scripts/verify-log-file-contents.sh:12:set -euo pipefail\ngh-issue-solver-1784463865325/scripts/check-mjs-syntax.sh:11:set -euo pipefail\ngh-issue-solver-1784463865325/scripts/verify-docker-image.sh:16:set -euo pipefail\ngh-issue-solver-1784463865325/scripts/verify-docker-image.sh:21:# disable the unbound-variable check (set -u) while sourcing them.\ngh-issue-solver-1784463865325/scripts/verify-docker-image.sh:58:set -u\ngh-issue-solver-1784463865325/scripts/verify-docker-image.sh:266:set -u",
