[2026-10-24T15:01:59.145Z] [INFO]         "content": ":root {\n  --bg: #070b14;\n  --surface: #0d1220;\n  --surface-2: #121a2c;\n  --border: rgba(148, 197, 255, 0.14);\n  --border-strong: rgba(148, 197, 255, 0.32);\n  --text: #e6edf7;\n  --text-2: #b4c0d3;\n  --muted: #7d8aa3;\n  --accent: #22d3ee;\n  /* The accent of the theme itself, which the futuristic skin does not repaint (preset miniatures). */\n  --theme-accent: #22d3ee;\n  --accent-2: #a78bfa;\n  --accent-3: #f472b6;\n  --series-1: #3987e5;\n  --series-2: #d95926;\n  --accent-soft: rgba(34, 211, 238, 0.12);\n  /* Theme-dependent colours of panels, lines and glows (issue #11). The\n     *-rgb triplets are used as rgb(var(--panel-rgb) / 0.78), so every panel\n     keeps its own transparency in both themes. */\n  --panel-rgb: 13 18 32;\n  --panel-2-rgb: 18 26 44;\n  --deep-rgb: 7 11 20;\n  --abyss-rgb: 3 6 12;\n  --line-rgb: 148 197 255;\n  --accent-rgb: 34 211 238;\n  --accent-2-rgb: 167 139 250;\n  --accent-3-rgb: 244 114 182;\n  --series-2-rgb: 217 89 38;\n  --title-from: #fff;\n  --shadow-card: 0 12px 30px rgba(0, 0, 0, 0.35);\n  --shadow-tooltip: 0 8px 24px rgba(0, 0, 0, 0.45);\n  --ok: #34d399;\n  --ok-rgb: 52 211 153;\n  --fav: #c98500;\n  --fav-rgb: 201 133 0;\n  --silver: #c0c7d2;\n  --bronze: #d29a63;\n  --cloud-mix: white;\n  --cloud-tint: 70%;\n  --cloud-fade: 0.55;\n  --node-fill: #05080f;\n  /* Link colours of the symbols (the same as COLORS in src/links/glyph.js). */\n  --link-1: #22d3ee;\n  --link-2: #c084fc;\n  --link-3: #f472b6;\n  --link-4: #facc15;\n  /* Problem solving diagram (COLORS in src/components/ProblemSolvingDiagram.jsx). */\n  --psd-draft: #f8fafc;\n  --psd-draft-line: #f8fafc;\n  --psd-test: #eab308;\n  --psd-task: #ef4444;\n  --psd-solution: #22c55e;\n  --psd-flow: #3b82f6;\n  --radius: var(--glass-radius, 10px);\n  --font: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\n  --mono: 'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  color-scheme: dark;\n}\n\n/* Light theme (issue #11): set by the theme switch or by prefers-color-scheme,\n   see THEME_SCRIPT in vite.config.js and src/i18n/prefs.js. */\n:root[data-theme='light'] {\n  --bg: #f5f7fb;\n  --surface: #ffffff;\n  --surface-2: #eef2f8;\n  --border: rgba(15, 40, 80, 0.14);\n  --border-strong: rgba(15, 40, 80, 0.3);\n  --text: #0f1729;\n  --text-2: #334155;\n  --muted: #5b6578;\n  --accent: #0e7490;\n  --theme-accent: #0e7490;\n  --accent-2: #6d28d9;\n  --accent-3: #be185d;\n  --accent-soft: rgba(14, 116, 144, 0.12);\n  --panel-rgb: 255 255 255;\n  --panel-2-rgb: 255 255 255;\n  --deep-rgb: 250 251 253;\n  --abyss-rgb: 250 251 253;\nimport { act, fireEvent, render, screen, within } from '@testing-library/react';\nimport { afterEach, describe, expect, it } from 'vitest';\nimport archive from '../data/posts.json';\nimport { fields, professions } from '../data/fields';\nimport { experience, positions } from '../data/profile';\nimport NetworkGallery from '../components/NetworkGallery';\nimport { metaTheory } from '../data/theory';\nimport { setLang, tr } from '../i18n/prefs';\nimport { codeAt, indexOf } from '../links/configurations';\nimport { STACK_ORGANIZATIONS } from '../data/stack';\nimport { NetworkExample } from '../components/MetaTheory';\nimport ArtPage, { ART } from './ArtPage';\nimport AssociativePage, { STACK } from './AssociativePage';\nimport BlogPage from './BlogPage';\nimport ExperiencePage from './ExperiencePage';\nimport { dedupe, pick } from './feed';\nimport { PAGES } from './pages';\nimport RepositoriesPage from './RepositoriesPage';\nimport { allRepositories, inField, matches, ownRepositories, repo } from './repos';\nimport ResearchPage, { HIGHLIGHTS, LAWS } from './ResearchPage';\n\nconst go = (search = '') => window.history.replaceState(null, '', `/${search}`);\nafterEach(() => go());\n\n// Direct items only: repository rows contain their own list of fields.\nconst count = (list) => list.children.length;\n\ndescribe('curated repository lists', () => {\n  const curated = {\n    professions: professions.flatMap((p) => p.repos.map(([name]) => name)),\n    highlights: HIGHLIGHTS.flatMap((g) => g.repos.map(([name]) => name)),\n    laws: LAWS.map(([name]) => name),\n    stack: STACK.flatMap((l) => l.repos.map(([name]) => name)),\n    art: ART.map(([name]) => name),\n  };\n\n  it.each(Object.keys(curated))('only name original repositories that exist (%s)', (list) => {\n    const missing = curated[list].filter((name) => repo(name)?.kind !== 'own');\n    expect(missing).toEqual([]);\n  });\n\n  it('count only original repositories, without forks or mirrors', () => {\n    expect(ownRepositories.length).toBeGreaterThan(400);\n    expect(ownRepositories.every((r) => r.kind === 'own')).toBe(true);\n    expect(allRepositories.length).toBeGreaterThan(ownRepositories.length);\n  });\n\n  it('search names, descriptions, topics and languages', () => {\n    const notation = repo('link-foundation/links-notation');\n    expect(matches(notation, 'LINKS notation')).toBe(true);\n    expect(matches(notation, 'links nonexistent-word')).toBe(false);\n  });\n});\n\ndescribe('RepositoriesPage', () => {\n  it('summarizes every field and lists the examples of every profession', () => {\n    const { container } = render(<RepositoriesPage />);\n    expect(container.querySelectorAll('.field-card')).toHaveLength(fields.length);\n    professions.forEach((p) =>\n      expect(screen.getByRole('heading', { level: 3, name: tr(p.name, 'en') })).toBeInTheDocument(),\nsrc/pages/pages.test.jsx:17:import { PAGES } from './pages';\nsrc/pages/pages.test.jsx:359:    expect(PAGES.map((p) => p.id)).toEqual([\nsrc/pages/pages.test.jsx:368:    PAGES.forEach((p) => {\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\" />\n    <link rel=\"alternate icon\" href=\"/favicon.ico\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"theme-color\" content=\"#070b14\" />\n    <meta name=\"color-scheme\" content=\"dark light\" />\n    <meta name=\"author\" content=\"Konstantin Diachenko\" />\n    <meta\n      name=\"description\"\n      content=\"Every option of the background animation (universe, grid, rain of link networks), the skin (glass, liquid glass, futuristic) and the links theory notation, previewed at once.\"\n    />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:title\" content=\"Settings — Konstantin Diachenko (konard)\" />\n    <meta\n      property=\"og:description\"\n      content=\"Every option of the background animation (universe, grid, rain of link networks), the skin (glass, liquid glass, futuristic) and the links theory notation, previewed at once.\"\n    />\n    <meta property=\"og:url\" content=\"https://konard.github.io/settings/\" />\n    <meta property=\"og:image\" content=\"https://avatars.githubusercontent.com/u/1431904?v=4\" />\n    <meta property=\"profile:username\" content=\"konard\" />\n    <meta name=\"twitter:card\" content=\"summary\" />\n    <meta name=\"twitter:site\" content=\"@drakonard\" />\n    <link rel=\"canonical\" href=\"https://konard.github.io/settings/\" />\n    <link rel=\"me\" href=\"https://github.com/konard\" />\n    <link rel=\"apple-touch-icon\" href=\"/logo192.png\" />\n    <link rel=\"manifest\" href=\"/manifest.json\" />\n    <title>Settings — Konstantin Diachenko (konard)</title>\n  </head>\n  <body>\n    <noscript>\n      Every option of the background animation (universe, grid, rain of link networks), the skin (glass, liquid glass,\n      futuristic) and the links theory notation, previewed at once. Enable JavaScript to see this page, or visit\n      https://github.com/konard.\n    </noscript>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/pages/settings.jsx\"></script>\n  </body>",
