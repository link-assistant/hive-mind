y.len() == 2 {\n269\t            let value = query[1];\n270\t            return if index == any {\n271\t                if value == any {\n272\t                    self.each_core(handler, &[])\n273\t                } else {\n274\t                    if self.each_core(handler, &[index, value, any]).is_break() {\n275\t                        return Flow::Break;\n276\t                    }\n277\t                    self.each_core(handler, &[index, any, value])\n278\t                }\n279\t            } else if let Some(link) = self.get_link(index) {\n280\t                if value == any || link.source == value || link.target == value {\n281\t                    handler(link)\n282\t                } else {\n283\t                    Flow::Continue\n284\t                }\n285\t            } else {\n286\t                Flow::Continue\n287\t            };\n288\t        }\n289\t\n290\t        if query.len() == 3 {\n291\t            let source = query[constants.source_part.as_usize()];\n292\t            let target = query[constants.target_part.as_usize()];\n293\t\n294\t            return if index == any {\n295\t                if (source, target) == (any, any) {\n296\t                    self.each_core(handler, &[])\n297\t                } else if source == any {\n298\t                    self.targets.each_usages(target, handler)\n299\t                } else if target == any {\n300\t                    self.sources.each_usages(source, handler)\n301\t                } else {\n302\t                    let link = self.sources.search(source, target);\n303\t                    self.get_link(link).map_or(Flow::Continue, handler)\n304\t                }\n305\t            } else if let Some(link) = self.get_link(index) {\n306\t                if (target, source) == (any, any) {\n307\t                    handler(link) // TODO: add (x * *) search test\n308\t                } else if target != any && source != any {\n309\t                    if (source, target) == (link.source, link.