    // Fall back to current working directory\\n00267|         targetDir = process.cwd();\\n00268|       }\\n00269|     }\\n00270|     const timestamp = formatTimestamp();\\n00271|     const logFile = path.join(targetDir, `hive-${timestamp}.log`);\\n00272|     // Set the log file for the lib.mjs logging system\\n00273|     setLogFile(logFile);\\n00274|     // Create the log file immediately\\n00275|     await fs.writeFile(logFile, `# Hive.mjs Log - ${new Date().toISOString()}\\\\n\\\\n`);\\n00276|     // Always use absolute path for log file display\\n00277|     const absoluteLogPath = path.resolve(logFile);\\n00278|     await log(`📁 Log file: ${absoluteLogPath}`);\\n00279|     await log('   (All output will be logged here)');\\n00280|     // Initialize Sentry integration (unless disabled)\\n00281|     if (argv.sentry) {\\n00282|       await initializeSentry({\\n00283|         noSentry: !argv.sentry,\\n00284|         debug: argv.verbose,\\n00285|         version: process.env.npm_package_version || '0.12.0',\\n00286|       });\\n00287|       // Add breadcrumb for monitoring configuration\\n00288|       addBreadcrumb({\\n00289|         category: 'hive',\\n00290|         message: 'Started monitoring',\\n00291|         level: 'info',\\n00292|         data: {\\n00293|           mode: argv.projectMode ? 'project' : argv.allIssues ? 'all' : 'label',\\n00294|           concurrency: argv.concurrency,\\n00295|           model: argv.model,\\n00296|         },\\n00297|       });\\n00298|     }\\n00299|     // Initialize the exit handler with getAbsoluteLogPath function and Sentry cleanup\\n00300|     initializeExitHandler(getAbsoluteLogPath, log);\\n00301|     installGlobalExitHandlers();\\n00302|     // Validate GitHub URL requirement\\n00303|     if (!githubUrl) {\\n00304|       await log('❌ GitHub URL is required', { level: 'error' });\\n00305|       await log('   Usage: hive <github-url> [options]', { level: 'error' });\\n00306|       await log(`   📁 Full log file: ${absolu