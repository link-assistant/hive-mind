        "content": "1\t/**\n2\t * Backup helper — snapshots a DualStore directory into a single\n3\t * timestamped file in the configured archive folder, and applies\n4\t * a simple keep-last-N retention policy (R-A4).\n5\t *\n6\t * The archive format is intentionally trivial: a JSON manifest that\n7\t * embeds the .lino text and base64'd binary blob. A future PR will\n8\t * swap this for tar.zst once we add zstd-codec; the call sites do not\n9\t * change because they only use `createBackup(store, opts)`.\n10\t */\n11\t\n12\timport { promises as fs } from 'node:fs';\n13\timport path from 'node:path';\n14\timport {\n15\t  randomBytes,\n16\t  scryptSync,\n17\t  createCipheriv,\n18\t  createDecipheriv,\n19\t} from 'node:crypto';\n20\t\n21\tconst ENC_VERSION = 1;\n22\tconst KDF_N = 1 << 14;\n23\t\n24\tconst deriveKey = (passphrase, salt) =>\n25\t  scryptSync(passphrase, salt, 32, { N: KDF_N });\n26\t\n27\t/**\n28\t * Encrypt a backup manifest with AES-256-GCM. The output envelope\n29\t * is JSON with base64 fields so it remains diff-friendly and trivially\n30\t * portable — the binary path can use the same envelope when the call\n31\t * sites move to tar.zst (R-A4 hardening).\n32\t */\n33\texport const encryptBackup = (plaintext, passphrase) => {\n34\t  const salt = randomBytes(16);\n35\t  const iv = randomBytes(12);\n36\t  const key = deriveKey(passphrase, salt);\n37\t  const cipher = createCipheriv('aes-256-gcm', key, iv);\n38\t  const ct = Buffer.concat([cipher.update(plaintext, 'utf8'), cipher.final()]);\n39\t  const tag = cipher.getAuthTag();\n40\t  return JSON.stringify({\n41\t    version: ENC_VERSION,\n42\t    cipher: 'aes-256-gcm',\n43\t    kdf: { name: 'scrypt', N: KDF_N, r: 8, p: 1 },\n44\t    salt: salt.toString('base64'),\n45\t    iv: iv.toString('base64'),\n46\t    tag: tag.toString('base64'),\n47\t    ct: ct.toString('base64'),\n48\t  });\n49\t};\n50\t\n51\texport const decryptBackup = (envelopeJson, passphrase) => {\n52\t  const env = JSON.parse(envelopeJson);\n53\t  if (env.cipher !== 'aes-256-gcm') {\n54\t    throw new Error(`unsupported cipher ${env.cipher}`);\n55\t  }\n56\t  const key = deriveKey(passphrase, Buffer.from(env.salt, 'base64'));\n57\t  const decipher = createDecipheriv(\n58\t    'aes-256-gcm',\n59\t    key,\n60\t    Buffer.from(env.iv, 'base64')\n61\t  );\n62\t  decipher.setAuthTag(Buffer.from(env.tag, 'base64'));\n63\t  return Buffer.concat([\n64\t    decipher.update(Buffer.from(env.ct, 'base64')),\n65\t    decipher.final(),\n66\t  ]).toString('utf8');\n67\t};\n68\t\n69\tconst stamp = (d = new Date()) =>\n70\t  d.toISOString().replace(/[:.]/g, '-').replace('T', '_').replace(/Z$/, '');\n71\t\n72\texport const createBackup = async (\n73\t  store,\n74\t  { archiveDir, now = new Date(), passphrase = null }\n75\t) => {\n76\t  await fs.mkdir(archiveDir, { recursive: true });\n77\t  const links = await store.query();\n78\t  const manifest = {\n79\t    createdAt: now.toISOString(),\n80\t    version: 1,\n81\t    links,\n82\t  };\n83\t  const plaintext = JSON.stringify(manifest, null, 2);\n84\t  if (passphrase) {\n85\t    const file = path.join(archiveDir, `meta-sovereign-${stamp(now)}.json.enc`);\n86\t    await fs.writeFile(file, encryptBackup(plaintext, passphrase), 'utf8');\n87\t    return file;\n88\t  }\n89\t  const file = path.join(archiveDir, `meta-sovereign-${stamp(now)}.json`);\n90\t  await fs.writeFile(file, plaintext, 'utf8');\n91\t  return file;\n92\t};\n93\t\n94\texport const pruneBackups = async ({ archiveDir, keep }) => {\n95\t  const entries = await fs.readdir(archiveDir).catch(() => []);\n96\t  const ours = entries\n97\t    .filter(\n98\t      (f) =>\n99\t        f.startsWith('meta-sovereign-') &&\n100\t        (f.endsWith('.json') || f.endsWith('.json.enc'))\n101\t    )\n102\t    .sort();\n103\t  const toDelete = ours.slice(0, Math.max(0, ours.length - keep));\n104\t  for (const f of toDelete) {\n105\t    await fs.unlink(path.join(archiveDir, f));\n106\t  }\n107\t  return toDelete;\n108\t};\n109\t\n110\texport const restoreBackup = async (\n111\t  store,\n112\t  file,\n113\t  { passphrase = null } = {}\n114\t) => {\n115\t  let raw = await fs.readFile(file, 'utf8');\n116\t  if (file.endsWith('.enc')) {\n117\t    if (!passphrase) {\n118\t      throw new Error('encrypted backup requires a passphrase');\n119\t    }\n120\t    raw = decryptBackup(raw, passphrase);\n121\t  }\n122\t  const manifest = JSON.parse(raw);\n123\t  for (const link of manifest.links) {\n124\t    await store.put(link);\n125\t  }\n126\t  return manifest.links.length;\n127\t};\n128\t"
