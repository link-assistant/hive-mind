diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index f61b5337635cf745d44fefbf0b2845bea69ab1d3..e5c562f19569d9edabd1ff65b6f624521b70f2e6 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -6,9 +6,14 @@ on:
       - main
   pull_request:
-    types: [opened, synchronize, reopened]
+    types: [synchronize, ready_for_review]
   workflow_dispatch:
     inputs:
+      checks_only:
+        description: Run the full checks without publishing
+        type: boolean
+        default: false
       bump_type:
         description: 'Version bump type'
+        default: patch
         required: true
         type: choice
@@ -22,9 +27,7 @@ on:
         type: string

-# Never cancel an in-progress run on main (a release may be mid-flight); do
-# cancel superseded PR runs.
 concurrency:
-  group: ${{ github.workflow }}-${{ github.ref }}
-  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}
+  group: ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}-${{ github.event_name }}-${{ github.event.action || 'run' }}-${{ (github.event_name == 'pull_request' && github.event.action == 'synchronize' && 'latest') || (github.event_name == 'push' && github.sha) || github.run_id }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}

 permissions:
@@ -167,5 +170,5 @@ jobs:
               (
                 (github.event_name == 'push' && github.ref == 'refs/heads/main') ||
-                github.event_name == 'workflow_dispatch'
+                (github.event_name == 'workflow_dispatch' && !inputs.checks_only)
               ) && 'release' || 'report'
             }}
@@ -181,4 +184,5 @@ jobs:
     needs: [detect-changes]
     if: |
+      (github.event_name != 'pull_request' || github.event.action == 'ready_for_review') &&
       always() && !cancelled() && (
         github.event_name == 'push' ||
@@ -270,4 +274,5 @@ jobs:
     needs: [detect-changes, lint, test]
     if: |
+      (github.event_name != 'pull_request' || github.event.action == 'ready_for_review') &&
       always() && (
         github.event_name == 'push' ||
@@ -325,4 +330,8 @@ jobs:
     runs-on: ubuntu-26.04
     timeout-minutes: 30
+    concurrency:
+      group: main-writer-${{ github.repository }}-main
+      cancel-in-progress: false
+      queue: max
     permissions:
       contents: write
@@ -410,4 +419,5 @@ jobs:
     # and a passed preflight (issue #11).
     if: |
+      (!inputs.checks_only) &&
       always() && !cancelled() &&
       github.event_name == 'workflow_dispatch' &&
@@ -418,4 +428,8 @@ jobs:
     runs-on: ubuntu-26.04
     timeout-minutes: 30
+    concurrency:
+      group: main-writer-${{ github.repository }}-main
+      cancel-in-progress: false
+      queue: max
     permissions:
       contents: write
@@ -488,5 +502,5 @@ jobs:
   # (issue #9).
   pipeline-status:
-    name: Pipeline Status
+    name: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && 'Pipeline Status (commit)' || 'Pipeline Status' }}
     needs:
       - detect-changes
