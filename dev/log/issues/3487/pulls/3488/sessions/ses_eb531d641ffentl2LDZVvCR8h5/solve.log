[2026-10-17T17:12:35.307Z] [INFO]           "before": "name: Test Hello World Scala\n\non:\n  push:\n    branches: [ '**' ]\n  pull_request:\n    branches: [ '**' ]\n\njobs:\n  build-and-test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Set up Scala\n        uses: scala-lang/setup-scala@v1\n        with:\n          scala-version: \"2.13.12\"\n\n      - name: Compile and run HelloWorld\n        run: |\n          scalac HelloWorld.scala\n          scala HelloWorld\n\n      - name: Verify output\n        run: |\n          output=$(scala HelloWorld)\n          if [ \"$output\" = \"Hello, World!\" ]; then\n            echo \"Output matches expected value.\"\n          else\n            echo \"Expected: 'Hello, World!'\"\n            echo \"Got: '$output'\"\n            exit 1\n          fi",
[2026-10-17T17:12:35.307Z] [INFO]           "after": "name: Test Hello World Scala\n\non:\n  push:\n    branches: [ '**' ]\n  pull_request:\n    branches: [ '**' ]\n  workflow_dispatch:\n\njobs:\n  build-and-test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Set up Scala\n        uses: scala-lang/setup-scala@v1\n        with:\n          scala-version: \"2.13.12\"\n\n      - name: Compile and run HelloWorld\n        run: |\n          scalac HelloWorld.scala\n          scala HelloWorld\n\n      - name: Verify output\n        run: |\n          output=$(scala HelloWorld)\n          if [ \"$output\" = \"Hello, World!\" ]; then\n            echo \"Output matches expected value.\"\n          else\n            echo \"Expected: 'Hello, World!'\"\n            echo \"Got: '$output'\"\n            exit 1\n          fi",
