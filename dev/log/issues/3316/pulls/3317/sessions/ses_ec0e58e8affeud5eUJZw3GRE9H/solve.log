[2026-10-15T10:29:19.806Z] [INFO]           "before": "name: Test Hello World\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n  build-and-test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      \n      - name: Setup Scala\n        uses: coursier/setup-scala@v1\n        with:\n          scala-version: '2.13.10'\n      \n      - name: Compile Scala code\n        run: scalac HelloWorld.scala\n      \n      - name: Run and test HelloWorld\n        run: |\n          output=$(scala HelloWorld)\n          if [ \"$output\" = \"Hello, World!\" ]; then\n            echo \"Test passed\"\n          else\n            echo \"Test failed: expected 'Hello, World!', got '$output'\"\n            exit 1\n          fi",
