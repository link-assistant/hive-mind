+
+      - name: Free disk space for the hive-mind image
+        if: steps.decide.outputs.should_run == 'true'
+        run: node scripts/free-disk-space.mjs
+
+      - name: Open the Formal AI draft
+        if: steps.decide.outputs.should_run == 'true'
+        env:
+          FORMAL_AI_DRAFT_ISSUE: ${{ github.event.inputs.issue_number }}
+          FORMAL_AI_DRAFT_IMAGE: ${{ vars.FORMAL_AI_DRAFT_IMAGE || 'konard/hive-mind:latest' }}
+          FORMAL_AI_DRAFT_LOG_DIR: ${{ runner.temp }}/formal-ai-draft-logs
+          FORMAL_AI_DRAFT_TOKEN: ${{ secrets.FORMAL_AI_DRAFT_TOKEN }}
+          GH_TOKEN: ${{ secrets.FORMAL_AI_DRAFT_TOKEN }}
+        run: node scripts/formal-ai-draft.mjs
+
+      # `--attach-logs` already puts the session log on the pull request. This
+      # is the copy for the case where no pull request was opened at all, which
+      # is exactly the failure mode worth reading. `!cancelled()` rather than
+      # `always()`: see tests/ci-workflow-cancellation-2082.test.mjs.
+      - name: Upload the session log
+        if: ${{ !cancelled() && steps.decide.outputs.should_run == 'true' }}
