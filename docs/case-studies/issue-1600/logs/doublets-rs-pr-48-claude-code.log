[2026-04-14T08:19:53.838Z] [INFO]     "originalFile": "use doublets::{unit, Doublets, Error};\nuse mem::FileMapped;\nuse std::io::Result as IoResult;\n\npub mod extensions;\n\n#[test]\nfn basic() -> Result<(), Error<usize>> {\n    let temp = tempfile::tempfile().unwrap();\n    let mem = FileMapped::new(temp).unwrap();\n    let mut store: Box<dyn Doublets<_>> = Box::new(unit::Store::<usize, _>::new(mem)?);\n\n    let a = store.create_point()?;\n    let b = store.create_point()?;\n    let _ = store.create_link(a, b)?;\n\n    assert_eq!(store.count(), 3);\n\n    Ok(())\n}\n"
