// Set the GITHUB_TOKEN environment variable for gh CLI\n106\t    process.env.GITHUB_TOKEN = process.env.TEST_GITHUB_USER_TOKEN;\n107\t  }\n108\t\n109\t  // Get current user\n110\t  const userResult = $('gh auth status', { silent: true });\n111\t  if (userResult.code !== 0) {\n112\t    const skipError = new Error('GitHub authentication required');\n113\t    skipError.isPermissionError = true;"
