76\t    {\n377\t        self.count_by(query) != T::funty(0)\n378\t    }\n379\t\n380\t    fn find(&self, query: impl ToQuery<T>) -> Option<Link<T>>\n381\t    where\n382\t        Self: Sized,\n383\t    {\n384\t        let mut result = None;\n385\t        self.each_by(query, |link| {\n386\t            result = Some(link);\n387\t            Flow::Break\n388\t        });\n389\t        result\n390\t    }\n391\t\n392\t    fn search(&self, source: T, target: T) -> Option<T>\n393\t    where\n394\t        Self: Sized,\n395\t    {\n396\t        self.find([self.constants().any, source, target])\n397\t            .map(|link| link.index)\n398\t    }\n399\t\n400\t    #[deprecated(note = \"use `search` instead\")]\n401\t    fn search_or(&self, source: T, target: T, default: T) -> T\n402\t    where\n403\t        Self: Sized,\n404\t    {\n405\t        self.search(source, target).unwrap_or(default)\n406\t    }\n407\t\n408\t    fn single(&self, query: impl ToQuery<T>) -> Option<Link<T>>\n409\t    where\n410\t        Self: Sized,\n411\t    {\n412\t        let mut result = None;\n413\t        self.each_by(query, |link| {\n414\t            if result.is_none() {\n415\t                result = Some(link);\n416\t                Flow::Continue\n417\t            } else {\n418\t                result = None;\n419\t                Flow::Break\n420\t            }\n421\t        });\n422\t        result\n423\t    }\n424\t\n425\t    fn get_or_create(&mut self, source: T, target: T) -> Result<T, Error<T>>\n426\t    where\n427\t        Self: Sized,\n428\t    {\n429\t        if let Some(link) = self.search(source, target) {\n430\t            Ok(link)\n431\t        } else {\n432\t            self.create_link(source, target)\n433\t        }\n434\t    }\n435\t\n436\t    fn count_usages(&self, index: T) -> Result<T, Error<T>>\n437\t    where\n438\t        Self: Sized,\n439\t    {\n440\t        let any = self.constants().any;\n441\t\n442\t        let link = self.try_get_link(index)?;\n443\t\n444\t        let mut usage_source = self.count_by([any, index, any]);\n445\t        if index == link.source {\n446\t            usage_source -= T::funty(1);\n447\t        }\n448\t\n449\t        let mut usage_target = self.count_by([any, any, index]);\n450\t        if index == link.target {\n451\t            usage_target -= T::funty(1);\n452\t        }\n453\t\n454\t        Ok(usage_source + usage_target)\n455\t    }\n456\t\n457\t    fn usages(&self, index: T) -> Result<Vec<T>, Error<T>>\n458\t    where\n459\t        Self: Sized,\n460\t    {\n461\t        let any = self.constants().any;\n462\t        let mut usages = Vec::with_capacity(self.count_usages(index)?.as_usize());\n463\t\n464\t        self.each_by([any, index, any], |link| {\n465\t            if link.index != index {\n466\t                usages.push(link.index);\n467\t            }\n468\t            Flow::Continue\n469\t        });\n470\t\n471\t        self.each_by([any, any, index], |link| {\n472\t            if link.index != index {\n473\t                usages.push(link.index);\n474\t            }\n475\t            Flow::Continue\n476\t        });\n477\t        Ok(usages)\n478\t    }\n479\t\n480\t    fn exist(&self, link: T) -> bool\n481\t    where\n482\t        Self: Sized,\n483\t    {\n484\t        let constants = self.constants();\n485\t        if constants.is_external(link) {\n486\t            true\n487\t        } else {\n488\t            constants.is_internal(link) && self.count_by([link]) != T::funty(0)\n489\t        }\n490\t    }\n491\t\n492\t    fn has_usages(&self, link: T) -> bool\n493\t    where\n494\t        Self: Sized,\n495\t    {\n496\t        self.count_usages(link)\n497\t            .map_or(false, |link| link != T::funty(0))\n498\t    }\n499\t\n500\t    fn rebase_with<F, R>(&mut self, old: T, new: T, handler: F) -> Result<(), Error<T>>\n501\t    where\n502\t        F: FnMut(Link<T>, Link<T>) -> R,\n503\t        R: Try<Output = ()>,\n504\t        Self: Sized,\n505\t    {\n506\t        // guard\n507\t        let _ = self.try_get_link(old)?;\n508\t\n509\t        if old == new {\n510\t            return Ok(());\n511\t        }\n512\t\n513\t        let any = self.constants().any;\n514\t\n515\t        let mut handler = Fuse::new(handler);\n516\t\n517\t        None.into_iter()\n518\t            // best readability\n519\t            .chain(self.each_iter([any, old, any]))\n520\t            .chain(self.each_iter([any, any, old]))\n521\t            .filter(|usage| usage.index != old)\n522\t            .try_for_each(|usage| {\n523\t                if usage.source == old {\n524\t                    self.update_with(usage.index, new, usage.target, &mut handler)?;\n525\t                }\n526\t                if usage.target == old {\n527\t                    self.update_with(usage.index, usage.source, new, &mut handler)?;\n528\t                }\n529\t                Ok(())\n530\t            })\n531\t    }\n532\t\n533\t    fn rebase(&mut self, old: T, new: T) -> Result<T, Error<T>>\n534\t    where\n535\t        Self: Sized,\n536\t    {\n537\t        self.rebase_with(old, new, |_, _| Flow::Continue)\n538\t            .map(|_| new)\n539\t    }\n540\t\n541\t    fn rebase_and_delete(&mut self, old: T, new: T) -> Result<T, Error<T>>\n542\t    where\n543\t        Self: Sized,\n544\t    {\n545\t        if old == new {\n546\t            Ok(new)\n547\t        } else {\n548\t            self.rebase(old, new)?;\n549\t            self.delete(old)\n550\t        }\n551\t    }\n552\t}\n553\t\n554\timpl<T: LinkType, All: Doublets<T> + ?Sized> Links<T> for Box<All> {\n555\t    fn constants(&self) -> &LinksConstants<T> {\n556\t        (**self).constants()\n557\t    }\n558\t\n559\t    fn count_links(&self, query: &[T]) -> T {\n560\t        (**self).count_links(query)\n561\t    }\n562\t\n563\t    fn create_links(\n564\t        &mut self,\n565\t        query: &[T],\n566\t        handler: WriteHandler<'_, T>,\n567\t    ) -> Result<Flow, Error<T>> {\n568\t        (**self).create_links(query, handler)\n569\t    }\n570\t\n571\t    fn each_links(&self, query: &[T], handler: ReadHandler<'_, T>) -> Flow {\n572\t        (**self).each_links(query, handler)\n573\t    }\n574\t\n575\t    fn update_links(\n576\t        &mut self,\n577\t        query: &[T],\n578\t        change: &[T],\n579\t        handler: WriteHandler<'_, T>,\n580\t    ) -> Result<Flow, Error<T>> {\n581\t        (**self).update_links(query, change, handler)\n582\t    }\n583\t\n584\t    fn delete_links(\n585\t        &mut self,\n586\t        query: &[T],\n587\t        handler: WriteHandler<'_, T>,\n588\t    ) -> Result<Flow, Error<T>> {\n589\t        (**self).delete_links(query, handler)\n590\t    }\n591\t}\n592\t\n593\timpl<T: LinkType, All: Doublets<T> + ?Sized> Doublets<T> for Box<All> {\n594\t    fn get_link(&self, index: T) -> Option<Link<T>> {\n595\t        (**self).get_link(index)\n596\t    }\n597\t}\n598\t\n599\tpub trait DoubletsExt<T: LinkType>: Sized + Doublets<T> {\n600\t    #[cfg(feature = \"rayon\")]\n601\t    type IdxParIter: IndexedParallelIterator<Item = Link<T>>;\n602\t\n603\t    #[cfg(feature = \"rayon\")]\n604\t    fn par_iter(&self) -> Self::IdxParIter;\n605\t\n606\t    #[cfg(feature = \"rayon\")]\n607\t    fn par_each_iter(&self, query: impl ToQuery<T>) -> Self::IdxParIter;\n608\t\n609\t    // Box<dyn Iterator<Item = T>> must used while `-> impl Trait` is not stabilized\n610\t    // Box<dyn> than easier `Self::ImplIterator1,2,...`\n611\t    // and have same performance if has only one possible dyn variant\n612\t\n613\t    type ImplIter: Iterator<Item = Link<T>>;\n614\t    fn iter(&self) -> Self::ImplIter;\n615\t\n616\t    type ImplIterEach: Iterator<Item = Link<T>>;\n617\t    fn each_iter(&self, query: impl ToQuery<T>) -> Self::ImplIterEach;\n618\t\n619\t    #[cfg(feature = \"small-search\")]\n620\t    type ImplIterSmall: Iterator<Item = Link<T>>;\n621\t    #[cfg(feature = \"small-search\")]\n622\t    fn iter_small(&self) -> Self::ImplIterSmall;\n623\t\n624\t    #[cfg(feature = \"small-search\")]\n625\t    type ImplIterEachSmall: Iterator<Item = Link<T>>;\n626\t    #[cfg(feature = \"small-search\")]\n627\t    fn each_iter_small(&self, query: impl ToQuery<T>) -> Self::ImplIterEachSmall;\n628\t}\n629\t\n630\timpl<T: LinkType, All: Doublets<T> + Sized> DoubletsExt<T> for All {\n631\t    #[cfg(feature = \"rayon\")]\n632\t    type IdxParIter = impl IndexedParallelIterator<Item = Link<T>>;\n633\t\n634\t    #[cfg(feature = \"rayon\")]\n635\t    fn par_iter(&self) -> Self::IdxParIter {\n636\t        self.par_each_iter([self.constants().any; 3])\n637\t    }\n638\t\n639\t    #[cfg(feature = \"rayon\")]\n640\t    fn par_each_iter(&self, query: impl ToQuery<T>) -> Self::IdxParIter {\n641\t        let mut vec = Vec::with_capacity(self.count_by(query.to_query()).as_usize());\n642\t        self.each_by(query, |link| {\n643\t            vec.push(link);\n644\t            Flow::Continue\n645\t        });\n646\t        vec.into_par_iter()\n647\t    }\n648\t\n649\t    type ImplIter = Self::ImplIterEach;\n650\t\n651\t    #[inline]\n652\t    fn iter(&self) -> Self::ImplIter {\n653\t        self.each_iter([self.constants().any; 3])\n654\t    }\n655\t\n656\t    type ImplIterEach = impl Iterator<Item = Link<T>> + ExactSizeIterator + DoubleEndedIterator;\n657\t\n658\t    #[cfg_attr(feature = \"more-inline\", inline)]\n659\t    fn each_iter(&self, query: impl ToQuery<T>) -> Self::ImplIterEach {\n660\t        let cap = self.count_by(query.to_query()).as_usize();\n661\t\n662\t        let mut vec = Vec::with_capacity(cap);\n663\t        self.each_by(query, &mut |link| {\n664\t            vec.push(link);\n665\t            Flow::Continue\n666\t        });\n667\t        vec.into_iter()\n668\t    }\n669\t\n670\t    #[cfg(feature = \"small-search\")]\n671\t    type ImplIterSmall = Self::ImplIterEachSmall;\n672\t\n673\t    #[inline]\n674\t    #[cfg(feature = \"small-search\")]\n675\t    fn iter_small(&self) -> Self::ImplIterSmall {\n676\t        self.each_iter_small([self.constants().any; 3])\n677\t    }\n678\t\n679\t    #[cfg(feature = \"small-search\")]\n680\t    type ImplIterEachSmall =\n681\t        impl Iterator<Item = Link<T>> + ExactSizeIterator + DoubleEndedIterator;\n682\t\n683\t    #[cfg(feature = \"small-search\")]\n684\t    #[cfg_attr(feature = \"more-inline\", inline)]\n685\t    fn each_iter_small(&self, query: impl ToQuery<T>) -> Self::ImplIterEachSmall {\n686\t        // fixme: later use const generics\n687\t        const SIZE_HINT: usize = 2;\n688\t\n689\t        let mut vec = smallvec::SmallVec::<[Link<_>; SIZE_HINT]>::with_capacity(\n690\t            self.count_by(query.to_query()).as_usize(),\n691\t        );\n692\t        self.each_by(query, |link| {\n693\t            vec.push(link);\n694\t            Flow::Continue\n695\t        });\n696\t        vec.into_iter()\n697\t    }\n698\t}\n699\t"
