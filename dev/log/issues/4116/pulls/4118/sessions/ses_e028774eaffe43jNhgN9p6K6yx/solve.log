tion: 'spawn_solve_worker',\n00770|             });\n00771|             await log(`   ❌ Worker ${workerId} failed on ${issueUrl}: ${cleanErrorMessage(error)}`, {\n00772|               level: 'error',\n00773|             });\n00774|             issueQueue.markFailed(issueUrl);\n00775|             issueFailed = true;\n00776|             break; // Stop trying more PRs for this issue\n00777|           }\n00778|         }\n00779|         // Only mark as completed if it didn't fail and wasn't gracefully stopped mid-shutdown.\n00780|         // Issue #1823: a graceful stop is neither a success nor a failure — leave it in\n00781|         // \"processing\" so it is not miscounted as completed (which would also trigger cleanup).\n00782|         if (environmentDeferral) {\n00783|           // Issue #2160: back to the queue (neither completed nor failed). Stop the run when\n00784|           // nothing else is in flight, since no other worker can release disk space.\n00785|           const deferrals = issueQueue.requeue(issueUrl);\n00786|           if (deferrals >= MAX_DISK_SPACE_DEFERRALS && issueQueue.getStats().processing === 0) {\n00787|             diskSpaceHalt = 'Insufficient disk space reported by the solver pre-flight check';\n00788|             await log('   🛑 Stopping: no in-flight work can release disk space. Free space on this host (or enable --auto-cleanup) and rerun.', { level: 'error' });\n00789|             // Issue #2187: the solver reported this, so nothing measured it here yet.\n00790|             await logReclaimableSpace({ log, level: 'error', options: { protectedPaths: getProtectedWorkspacePaths() } });\n00791|             issueQueue.stop();\n00792|           }\n00793|         } else if (!issueFailed && !gracefulStop) {\n00794|           issueQueue.markCompleted(issueUrl);\n\n(Output capped at 50 KB. Showing lines 1-794. Use offset=794 to continue.)\n</file>",
