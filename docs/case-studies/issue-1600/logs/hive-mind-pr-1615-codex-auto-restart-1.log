e validation');\\n00997|                 await log('');\\n00998|                 await log('  🔧 How to fix:');\\n00999|                 await log('');\\n01000|                 await log('     Option 1: Assign manually in the PR page');\\n01001|                 await log('     ─────────────────────────────────────────');\\n01002|                 await log(`     1. Visit the PR: ${prUrl}`);\\n01003|                 await log('     2. Click \\\"Assignees\\\" in the right sidebar');\\n01004|                 await log('     3. Add yourself to the PR');\\n01005|                 await log('');\\n01006|                 await log('     Option 2: Request collaborator access');\\n01007|                 await log('     ─────────────────────────────────────────');\\n01008|                 await log('     Ask the repository owner to add you as a collaborator:');\\n01009|                 await log(`       → Go to: https://github.com/${owner}/${repo}/settings/access`);\\n01010|                 await log(`       → Add user: ${currentUser}`);\\n01011|                 await log('');\\n01012|                 await log('  ℹ️  Note: This does not affect the PR itself - it was created successfully.');\\n01013|                 await log('');\\n01014|               } else if (currentUser && canAssign) {\\n01015|                 await log(formatAligned('👤', 'Assigned to:', currentUser));\\n01016|               } else if (currentUser && !canAssign) {\\n01017|                 await log(formatAligned('ℹ️', 'Note:', 'Could not assign (no permission)'));\\n01018|               }\\n01019| \\n01020|               // CLAUDE.md will be removed after Claude command completes\\n01021| \\n01022|               // Link the issue to the PR in GitHub's Development section using GraphQL API\\n01023|               await log(formatAligned('🔗', 'Linking:', `Issue #${issueNumber} to PR #${localPrNumber}...`));\\n01024|               try {\\n01025|                 // First, get the node IDs for both the issue and