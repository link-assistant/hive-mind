        "tool_use_id": "toolu_011e2M74QCe8LpntNpDJm9ze",
        "type": "tool_result",
        "content": "1\t/**\n2\t * Read-only API routes that derive views from the unified store\n3\t * (contacts, status, autocomplete, audience, facts).\n4\t *\n5\t * Every endpoint returns plain JSON so the SPA can render without\n6\t * extra parsing logic — the store remains the single source of truth.\n7\t */\n8\t\n9\timport { json } from './util.js';\n10\timport { extractFacts } from '../facts/index.js';\n11\timport { intersect, union, difference, localSearch } from '../crm/index.js';\n12\t\n13\tconst aggregateContacts = (links) => {\n14\t  const messages = links.filter((l) => l.id?.startsWith('msg:'));\n15\t  const byContact = new Map();\n16\t  for (const m of messages) {\n17\t    if (!m.sender) continue;\n18\t    const entry = byContact.get(m.sender) ?? {\n19\t      id: m.sender,\n20\t      networks: new Set(),\n21\t      chats: new Set(),\n22\t      messageCount: 0,\n23\t      lastSeen: null,\n24\t    };\n25\t    entry.networks.add(m.source);\n26\t    entry.chats.add(m.chat);\n27\t    entry.messageCount += 1;\n28\t    if (!entry.lastSeen || (m.timestamp ?? '') > entry.lastSeen) {\n29\t      entry.lastSeen = m.timestamp ?? null;\n30\t    }\n31\t    byContact.set(m.sender, entry);\n32\t  }\n33\t  return [...byContact.values()].map((c) => ({\n34\t    ...c,\n35\t    networks: [...c.networks],\n36\t    chats: [...c.chats],\n37\t  }));\n38\t};\n39\t\n40\tconst computeStatus = (all, diffs) => ({\n41\t  links: all.length,\n42\t  messages: all.filter((l) => l.id?.startsWith('msg:')).length,\n43\t  patterns: all.filter((l) => l.id?.startsWith('pattern:')).length,\n44\t  graphs: all.filter((l) => l.id?.startsWith('graph:')).length,\n45\t  replies: all.filter((l) => l.id?.startsWith('reply:')).length,\n46\t  contacts: aggregateContacts(all).length,\n47\t  chats: new Set(\n48\t    all\n49\t      .filter((l) => l.id?.startsWith('msg:'))\n50\t      .map((m) => `${m.source}:${m.chat}`)\n51\t  ).size,\n52\t  verifyDiffs: diffs.length,\n53\t});\n54\t\n55\tconst completionsFor = (links, prefix, me, limit) => {\n56\t  const lower = String(prefix ?? '').toLowerCase();\n57\t  const seen = new Map();\n58\t  const messages = links.filter(\n59\t    (l) => l.id?.startsWith('msg:') && l.sender === me && typeof l.body === 'string'\n60\t  );\n61\t  for (const m of messages) {\n62\t    if (!m.body.toLowerCase().startsWith(lower)) continue;\n63\t    if (!seen.has(m.body) || (m.timestamp ?? '') > seen.get(m.body)) {\n64\t      seen.set(m.body, m.timestamp ?? '');\n65\t    }\n66\t  }\n67\t  return [...seen.entries()]\n68\t    .sort((a, b) => String(b[1]).localeCompare(String(a[1])))\n69\t    .slice(0, limit)\n70\t    .map(([body]) => body);\n71\t};\n72\t\n73\tconst buildAudience = (links, expression) => {\n74\t  const ops = parseAudience(expression);\n75\t  const evalExpr = (node) => {\n76\t    if (node.kind === 'set') return links.filter(node.predicate);\n77\t    if (node.kind === 'and') return intersect(evalExpr(node.left), evalExpr(node.right));\n78\t    if (node.kind === 'or') return union(evalExpr(node.left), evalExpr(node.right));\n79\t    if (node.kind === 'not') return difference(links, evalExpr(node.expr));\n80\t    return [];\n81\t  };\n82\t  const linksMatched = evalExpr(ops);\n83\t  return aggregateContacts(linksMatched);\n84\t};\n85\t\n86\tconst parseAudience = (expr) => {\n87\t  const tokens = String(expr ?? '')\n88\t    .replace(/([(),])/g, ' $1 ')\n89\t    .split(/\\s+/)\n90\t    .filter(Boolean);\n91\t  let i = 0;\n92\t  const peek = () => tokens[i];\n93\t  const eat = () => tokens[i++];\n94\t  const parsePrimary = () => {\n95\t    const t = eat();\n96\t    if (t === 'NOT') return { kind: 'not', expr: parsePrimary() };\n97\t    if (t === '(') {\n98\t      const inner = parseOr();\n99\t      eat();\n100\t      return inner;\n101\t    }\n102\t    return makeSet(t);\n103\t  };\n104\t  const parseAnd = () => {\n105\t    let left = parsePrimary();\n106\t    while (peek() === 'AND') {\n107\t      eat();\n108\t      left = { kind: 'and', left, right: parsePrimary() };\n109\t    }\n110\t    return left;\n111\t  };\n112\t  const parseOr = () => {\n113\t    let left = parseAnd();\n114\t    while (peek() === 'OR') {\n115\t      eat();\n116\t      left = { kind: 'or', left, right: parseAnd() };\n117\t    }\n118\t    return left;\n119\t  };\n120\t  return parseOr();\n121\t};\n122\t\n123\tconst makeSet = (token) => {\n124\t  const m = token.match(/^(network|chat|sender|fact|kind):(.+)$/);\n125\t  if (!m) {\n126\t    return { kind: 'set', predicate: () => false };\n127\t  }\n128\t  const [, dim, value] = m;\n129\t  if (dim === 'network') {\n130\t    return { kind: 'set', predicate: (l) => l.source === value };\n131\t  }\n132\t  if (dim === 'chat') {\n133\t    return { kind: 'set', predicate: (l) => l.chat === value };\n134\t  }\n135\t  if (dim === 'sender') {\n136\t    return { kind: 'set', predicate: (l) => l.sender === value };\n137\t  }\n138\t  if (dim === 'kind') {\n139\t    return { kind: 'set', predicate: (l) => l.id?.startsWith(`${value}:`) };\n140\t  }\n141\t  return {\n142\t    kind: 'set',\n143\t    predicate: (l) => (l.facts ?? []).some((f) => f.includes(value)),\n144\t  };\n145\t};\n146\t\n147\texport const handleDerivedRoutes = async (store, req, res, p, url) => {\n148\t  if (req.method !== 'GET') return false;\n149\t  if (p === '/api/contacts') {\n150\t    return json(res, 200, aggregateContacts(await store.query())) ?? true;\n151\t  }\n152\t  if (p === '/api/status') {\n153\t    const all = await store.query();\n154\t    const diffs = (await store.verify?.()) ?? [];\n155\t    return json(res, 200, computeStatus(all, diffs)) ?? true;\n156\t  }\n157\t  if (p === '/api/autocomplete') {\n158\t    const all = await store.query();\n159\t    return (\n160\t      json(\n161\t        res,\n162\t        200,\n163\t        completionsFor(\n164\t          all,\n165\t          url.searchParams.get('q') ?? '',\n166\t          url.searchParams.get('me') ?? 'me',\n167\t          Number(url.searchParams.get('limit') ?? 10)\n168\t        )\n169\t      ) ?? true\n170\t    );\n171\t  }\n172\t  if (p === '/api/audience') {\n173\t    const all = await store.query();\n174\t    return (\n175\t      json(res, 200, buildAudience(all, url.searchParams.get('q') ?? '')) ??\n176\t      true\n177\t    );\n178\t  }\n179\t  if (p === '/api/facts') {\n180\t    const all = await store.query();\n181\t    const messages = all.filter((l) => l.id?.startsWith('msg:'));\n182\t    const patterns = all\n183\t      .filter((l) => l.id?.startsWith('pattern:'))\n184\t      .map((p2) => ({\n185\t        id: p2.id,\n186\t        regex: typeof p2.regex === 'string' ? new RegExp(p2.regex, 'i') : p2.regex,\n187\t      }));\n188\t    return json(res, 200, extractFacts(messages, patterns)) ?? true;\n189\t  }\n190\t  if (p === '/api/search') {\n191\t    const all = await store.query();\n192\t    return (\n193\t      json(\n194\t        res,\n195\t        200,\n196\t        await localSearch(\n197\t          { query: async () => all },\n198\t          {\n199\t            query: url.searchParams.get('q') ?? '',\n200\t            min: Number(url.searchParams.get('min') ?? 0.2),\n201\t          }\n202\t        )\n203\t      ) ?? true\n204\t    );\n205\t  }\n206\t  return false;\n207\t};\n208\t"
