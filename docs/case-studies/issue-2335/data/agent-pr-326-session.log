ep.\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n  # Note: -Dwarnings is disabled while Rust implementation is WIP\n  # Enable later with: RUSTFLAGS: -Dwarnings\n\n# Concurrency is declared per job rather than once for the whole workflow\n# (principle 10 of the CI/CD best practices, and the shape both pipeline\n# templates use):\n#\n#   * read-only checks share `check-<workflow>-<ref>-<job>` and cancel in\n#     progress off the default branch, so a force-push stops only the stale\n#     copy of that one job instead of queueing the entire workflow;\n#   * jobs that push to main or publish share the repository-wide\n#     `main-writer-...` group and never cancel in progress, so a release is\n#     never interrupted between the version bump and the publish, and the JS\n#     and Rust releases cannot race each other.\njobs:\n  # Changelog fragment check - only runs on PRs\n  changelog-check:\n    name: Changelog Fragment Check\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-changelog-check\n      cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}\n    if: github.event_name == 'pull_request'\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Check for changelog fragments\n        # BASE_REF is a branch name. Interpolating it directly into the script\n        # would let a branch name execute shell code (zizmor template-injection).\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: |\n          # Get list of fragment files (excluding README)\n          FRAGMENTS=$(find rust/changelog.d -name \"*.md\" ! -name \"README.md\" 2>/dev/null | wc -l)\n\n          # Get changed files in PR\n          CHANGED_FILES=$(git diff --name-only \"origin/$BASE_REF...HEAD\")\n\n          # Check if any Rust source files changed\n          SOURCE_CHANGED=$(echo \"$CHANGED_FILES\" | grep -cE \"^rust/(src/|tests/|Cargo\\.toml)\" || true)\n\n          if [ \"$SOURCE_CHANGED\" -gt 0 ] && [ \"$FRAGMENTS\" -eq 0 ]; then\n            echo \"::warning::No changelog fragment found. Please add a changelog entry in rust/changelog.d/\"\n            echo \"\"\n            echo \"To create a changelog fragment:\"\n            echo \"  touch rust/changelog.d/\\$(date +%Y%m%d_%H%M%S)_description.md\"\n            echo \"\"\n            echo \"See rust/changelog.d/README.md for more information.\"\n            # Note: This is a warning, not a failure, to allow flexibility\n            exit 0\n          fi\n\n          echo \"Changelog check passed\"\n\n  # Lint and format check\n  lint:\n    name: Lint and Format Check\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-lint\n      cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}\n    needs: [changelog-check]\n    if: ${{ !cancelled() && (github.event_name == 'push' || github.event_name == 'workflow_dispatch' || needs.changelog-check.result == 'success' || needs.changelog-check.result == 'skipped') }}\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          # Needed to merge the base branch below.\n          fetch-depth: 0\n\n      # refs/pull/N/merge is built when the pull request is synchronized, so\n      # commits landing on the base branch afterwards are not checked. Merging\n      # them here makes the checks below validate the real merge result.\n      - name: Simulate fresh merge with base branch (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: bash scripts/simulate-fresh-merge.sh\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87 # stable\n        with:\n          components: rustfmt, clippy\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n\n      - name: Cache cargo registry\n        uses: actions/cache@v5\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            rust/target\n          key: ${{ runner.os }}-cargo-${{ hashFiles('rust/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-cargo-\n\n      - name: Check formatting\n        run: cargo fmt --all -- --check\n        working-directory: rust\n\n","exit_code":0,"status":"completed"}}
