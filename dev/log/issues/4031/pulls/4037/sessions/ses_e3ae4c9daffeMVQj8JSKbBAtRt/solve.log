ent_bytes).hexdigest() != expected_sha:\\\\n                raise ValueError('\\\\\\\\''owned_write_preimage_changed'\\\\\\\\'')\\\\n        os.replace(temporary, path)\\\\n    finally:\\\\n        if temporary.exists():\\\\n            temporary.unlink()\\\\n\\\\n\\\\ndef placeholder_content_matches(data, issue, branch):\\\\n    if not data:\\\\n        return True\\\\n    if not isinstance(issue, str) or not isinstance(branch, str) or len(data) > 1024:\\\\n        return False\\\\n    import re\\\\n    import datetime\\\\n    match = re.fullmatch(r'\\\\\\\\''# \\\\\\\\.gitkeep file auto-generated at ([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\\\\\.[0-9]{3}Z) for PR creation at branch (issue-[1-9][0-9]*-[A-Za-z0-9-]+) for issue (https://github\\\\\\\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*)'\\\\\\\\'', data.decode('\\\\\\\\''utf-8'\\\\\\\\'', '\\\\\\\\''strict'\\\\\\\\''))\\\\n    if match is None or match[2] != branch or match[3] != issue:\\\\n        return False\\\\n    if not branch.startswith('\\\\\\\\''issue-'\\\\\\\\'' + issue.rsplit('\\\\\\\\''/'\\\\\\\\'', 1)[1] + '\\\\\\\\''-'\\\\\\\\''):\\\\n        return False\\\\n    try:\\\\n        datetime.datetime.fromisoformat(match[1].replace('\\\\\\\\''Z'\\\\\\\\'', '\\\\\\\\''+00:00'\\\\\\\\''))\\\\n    except ValueError:\\\\n        return False\\\\n    return True\\\\n\\\\npath_value = plan['\\\\\\\\''path'\\\\\\\\'']\\\\npath = owned_path(path_value)\\\\ntry:\\\\n    os.lstat(path)\\\\nexcept FileNotFoundError:\\\\n    result = {'\\\\\\\\''schema'\\\\\\\\'': '\\\\\\\\''workspace-source-v1'\\\\\\\\'', '\\\\\\\\''path'\\\\\\\\'': path_value, '\\\\\\\\''success'\\\\\\\\'': True,\\\\n              '\\\\\\\\''complete'\\\\\\\\'': True, '\\\\\\\\''absent'\\\\\\\\'': True, '\\\\\\\\''error_code'\\\\\\\\'': '\\\\\\\\''ENOENT'\\\\\\\\''}\\\\nelse:\\\\n    data, identity = read_regular(path, MAXIMUM_FILE_BYTES)\\\\n    result = {'\\\\\\\\''schema'\\\\\\\\'': '\\\\\\\\''workspace-source-v