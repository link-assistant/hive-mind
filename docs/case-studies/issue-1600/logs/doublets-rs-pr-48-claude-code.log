[2026-04-14T08:21:38.583Z] [INFO]         "content": "1\tname: CI/CD Pipeline\n2\t\n3\ton:\n4\t  push:\n5\t    branches: [main]\n6\t  pull_request:\n7\t    branches: [main]\n8\t  workflow_dispatch:\n9\t    inputs:\n10\t      bump_type:\n11\t        description: 'Version bump type'\n12\t        required: true\n13\t        type: choice\n14\t        options:\n15\t          - patch\n16\t          - minor\n17\t          - major\n18\t      description:\n19\t        description: 'Release description (optional)'\n20\t        required: false\n21\t        type: string\n22\t\n23\tconcurrency:\n24\t  group: ${{ github.workflow }}-${{ github.ref }}\n25\t  cancel-in-progress: true\n26\t\n27\tenv:\n28\t  RUST_BACKTRACE: 1\n29\t  CARGO_TERM_COLOR: always\n30\t\n31\tjobs:\n32\t  # REQUIRED CI CHECKS - All must pass before release\n33\t  # These jobs ensure code quality and tests pass before any release\n34\t\n35\t  # Linting and formatting\n36\t  lint:\n37\t    name: Lint and Format Check\n38\t    runs-on: ubuntu-latest\n39\t    steps:\n40\t      - uses: actions/checkout@v4\n41\t        with:\n42\t          submodules: true\n43\t\n44\t      - name: Setup Rust\n45\t        uses: dtolnay/rust-toolchain@master\n46\t        with:\n47\t          toolchain: nightly-2022-08-22\n48\t          components: rustfmt, clippy\n49\t\n50\t      - name: Setup Node.js\n51\t        uses: actions/setup-node@v4\n52\t        with:\n53\t          node-version: '20.x'\n54\t\n55\t      - name: Cache cargo registry\n56\t        uses: actions/cache@v4\n57\t        with:\n58\t          path: |\n59\t            ~/.cargo/registry\n60\t            ~/.cargo/git\n61\t            target\n62\t          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}\n63\t          restore-keys: |\n64\t            ${{ runner.os }}-cargo-\n65\t\n66\t      - name: Check formatting\n67\t        run: |\n68\t          # Check formatting only for main workspace crates\n69\t          # Skip submodules (dev-deps/) as they have their own formatting rules\n70\t          cargo fmt -p doublets -p doublets-ffi -p integration -p ffi-attributes -p env-decorators -- --check\n71\t\n72\t      - name: Run Clippy\n73\t        run: |\n74\t          # Run Clippy only for main workspace crates\n75\t          # Skip submodules (dev-deps/) as they have their own linting rules\n76\t          cargo clippy -p doublets -p doublets-ffi -p integration -p ffi-attributes -p env-decorators --tests --all-features\n77\t\n78\t      - name: Check file size limit\n79\t        run: node scripts/check-file-size.mjs\n80\t\n81\t  # Test on multiple OS\n82\t  test:\n83\t    name: Test (${{ matrix.os }})\n84\t    runs-on: ${{ matrix.os }}\n85\t    strategy:\n86\t      fail-fast: false\n87\t      matrix:\n88\t        os: [ubuntu-latest, macos-latest, windows-latest]\n89\t        rustflags:\n90\t          - '-C target-cpu=native'\n91\t          - '-C target-cpu=native -C target-feature=-avx2'\n92\t    env:\n93\t      RUSTFLAGS: ${{ matrix.rustflags }}\n94\t    steps:\n95\t      - uses: actions/checkout@v4\n96\t        with:\n97\t          submodules: true\n98\t\n99\t      - name: Setup Rust\n100\t        uses: dtolnay/rust-toolchain@master\n101\t        with:\n102\t          toolchain: nightly-2022-08-22\n103\t\n104\t      - name: Cache cargo registry\n105\t        uses: actions/cache@v4\n106\t        with:\n107\t          path: |\n108\t            ~/.cargo/registry\n109\t            ~/.cargo/git\n110\t            target\n111\t          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}\n112\t          restore-keys: |\n113\t            ${{ runner.os }}-cargo-\n114\t\n115\t      - name: Run tests\n116\t        run: cargo test --release --all-features -- --nocapture\n117\t\n118\t      - name: Run doc tests\n119\t        run: cargo test --doc --all-features\n120\t\n121\t  # Build package - only runs if lint and test pass\n122\t  build:\n123\t    name: Build Package\n124\t    runs-on: ubuntu-latest\n125\t    needs: [lint, test]\n126\t    steps:\n127\t      - uses: actions/checkout@v4\n128\t        with:\n129\t          submodules: true\n130\t\n131\t      - name: Setup Rust\n132\t        uses: dtolnay/rust-toolchain@master\n133\t        with:\n134\t          toolchain: nightly-2022-08-22\n135\t\n136\t      - name: Cache cargo registry\n137\t        uses: actions/cache@v4\n138\t        with:\n139\t          path: |\n140\t            ~/.cargo/registry\n141\t            ~/.cargo/git\n142\t            target\n143\t          key: ${{ runner.os }}-cargo-build-${{ hashFiles('**/Cargo.lock') }}\n144\t          restore-keys: |\n145\t            ${{ runner.os }}-cargo-build-\n146\t\n147\t      - name: Build release\n148\t        run: cargo build --release --all-features\n149\t\n150\t  # Miri for memory safety checks\n151\t  # NOTE: Miri is currently disabled due to fundamental incompatibility:\n152\t  # - Old nightly (2022-08-22): Miri's xargo dependencies require rustc 1.68+\n153\t  # - New nightly (2024+): Code in dev-deps uses removed features (const_deref, etc.)\n154\t  # To re-enable, the codebase needs to be updated to work with a recent nightly.\n155\t  miri:\n156\t    name: Miri\n157\t    runs-on: ubuntu-latest\n158\t    # Skip Miri until codebase is updated for modern nightly compatibility\n159\t    if: false\n160\t    continue-on-error: true\n161\t    steps:\n162\t      - uses: actions/checkout@v4\n163\t        with:\n164\t          submodules: true\n165\t\n166\t      - name: Install rustup\n167\t        run: |\n168\t          curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain none\n169\t          echo \"$HOME/.cargo/bin\" >> $GITHUB_PATH\n170\t\n171\t      - name: Run miri\n172\t        run: |\n173\t          cd ci\n174\t          chmod +x miri.sh\n175\t          ./miri.sh\n176\t\n177\t  # Code coverage\n178\t  coverage:\n179\t    name: Code Coverage\n180\t    runs-on: ubuntu-latest\n181\t    steps:\n182\t      - uses: actions/checkout@v4\n183\t        with:\n184\t          submodules: true\n185\t\n186\t      - name: Setup Rust\n187\t        uses: dtolnay/rust-toolchain@master\n188\t        with:\n189\t          toolchain: nightly-2022-08-22\n190\t          components: llvm-tools-preview\n191\t\n192\t      - name: Install cargo-llvm-cov\n193\t        uses: taiki-e/install-action@cargo-llvm-cov\n194\t\n195\t      - name: Cache cargo registry\n196\t        uses: actions/cache@v4\n197\t        with:\n198\t          path: |\n199\t            ~/.cargo/registry\n200\t            ~/.cargo/git\n201\t            target\n202\t          key: ${{ runner.os }}-cargo-cov-${{ hashFiles('**/Cargo.lock') }}\n203\t          restore-keys: |\n204\t            ${{ runner.os }}-cargo-cov-\n205\t\n206\t      - name: Generate code coverage\n207\t        run: cargo llvm-cov --all-features --workspace --lcov --output-path lcov.info\n208\t\n209\t      - name: Upload coverage to Codecov\n210\t        uses: codecov/codecov-action@v4\n211\t        with:\n212\t          files: lcov.info\n213\t          fail_ci_if_error: false\n214\t          verbose: true\n215\t\n216\t  # Check for changelog fragments in PRs\n217\t  changelog:\n218\t    name: Changelog Fragment Check\n219\t    runs-on: ubuntu-latest\n220\t    if: github.event_name == 'pull_request'\n221\t    steps:\n222\t      - uses: actions/checkout@v4\n223\t        with:\n224\t          fetch-depth: 0\n225\t\n226\t      - name: Check for changelog fragments\n227\t        run: |\n228\t          # Get list of fragment files (excluding README and template)\n229\t          FRAGMENTS=$(find changelog.d -name \"*.md\" ! -name \"README.md\" 2>/dev/null | wc -l)\n230\t\n231\t          # Get changed files in PR\n232\t          CHANGED_FILES=$(git diff --name-only origin/${{ github.base_ref }}...HEAD)\n233\t\n234\t          # Check if any source files changed (excluding docs and config)\n235\t          SOURCE_CHANGED=$(echo \"$CHANGED_FILES\" | grep -E \"^(doublets/src/|doublets-ffi/src/|integration/src/)\" | wc -l)\n236\t\n237\t          if [ \"$SOURCE_CHANGED\" -gt 0 ] && [ \"$FRAGMENTS\" -eq 0 ]; then\n238\t            echo \"::warning::No changelog fragment found. Please add a changelog entry in changelog.d/\"\n239\t            echo \"\"\n240\t            echo \"To create a changelog fragment:\"\n241\t            echo \"  Create a new .md file in changelog.d/ with your changes\"\n242\t            echo \"\"\n243\t            echo \"See changelog.d/README.md for more information.\"\n244\t            # Note: This is a warning, not a failure, to allow flexibility\n245\t            # Change 'exit 0' to 'exit 1' to make it required\n246\t            exit 0\n247\t          fi\n248\t\n249\t          echo \"Changelog check passed\"\n250\t\n251\t  # All required checks must pass\n252\t  tests-pass:\n253\t    name: All Checks Pass\n254\t    runs-on: ubuntu-latest\n255\t    needs: [lint, test, build, coverage]\n256\t    steps:\n257\t      - run: echo \"All CI checks passed!\"\n258\t\n259\t  # Automatic release on push to main using changelog fragments\n260\t  auto-release:\n261\t    name: Auto Release\n262\t    needs: [lint, test, build]\n263\t    if: github.event_name == 'push' && github.ref == 'refs/heads/main'\n264\t    runs-on: ubuntu-latest\n265\t    permissions:\n266\t      contents: write\n267\t    steps:\n268\t      - uses: actions/checkout@v4\n269\t        with:\n270\t          fetch-depth: 0\n271\t          token: ${{ secrets.GITHUB_TOKEN }}\n272\t\n273\t      - name: Setup Rust\n274\t        uses: dtolnay/rust-toolchain@master\n275\t        with:\n276\t          toolchain: nightly-2022-08-22\n277\t\n278\t      - name: Setup Node.js\n279\t        uses: actions/setup-node@v4\n280\t        with:\n281\t          node-version: '20.x'\n282\t\n283\t      - name: Configure git\n284\t        run: |\n285\t          git config user.name \"github-actions[bot]\"\n286\t          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n287\t\n288\t      - name: Determine bump type from changelog fragments\n289\t        id: bump_type\n290\t        run: node scripts/get-bump-type.mjs\n291\t\n292\t      - name: Check if version already released or no fragments\n293\t        id: check\n294\t        run: |\n295\t          # Check if there are changelog fragments\n296\t          if [ \"${{ steps.bump_type.outputs.has_fragments }}\" != \"true\" ]; then\n297\t            # No fragments - check if current version tag exists\n298\t            CURRENT_VERSION=$(grep -Po '(?<=^version = \")[^\"]*' doublets/Cargo.toml | head -1)\n299\t            if git rev-parse \"v$CURRENT_VERSION\" >/dev/null 2>&1; then\n300\t              echo \"No changelog fragments and v$CURRENT_VERSION already released\"\n301\t              echo \"should_release=false\" >> $GITHUB_OUTPUT\n302\t            else\n303\t              echo \"No changelog fragments but v$CURRENT_VERSION not yet released\"\n304\t              echo \"should_release=true\" >> $GITHUB_OUTPUT\n305\t              echo \"skip_bump=true\" >> $GITHUB_OUTPUT\n306\t            fi\n307\t          else\n308\t            echo \"Found changelog fragments, proceeding with release\"\n309\t            echo \"should_release=true\" >> $GITHUB_OUTPUT\n310\t            echo \"skip_bump=false\" >> $GITHUB_OUTPUT\n311\t          fi\n312\t\n313\t      - name: Collect changelog and bump version\n314\t        id: version\n315\t        if: steps.check.outputs.should_release == 'true' && steps.check.outputs.skip_bump != 'true'\n316\t        run: |\n317\t          node scripts/version-and-commit.mjs \\\n318\t            --bump-type \"${{ steps.bump_type.outputs.bump_type }}\"\n319\t\n320\t      - name: Get current version\n321\t        id: current_version\n322\t        if: steps.check.outputs.should_release == 'true'\n323\t        run: |\n324\t          CURRENT_VERSION=$(grep -Po '(?<=^version = \")[^\"]*' doublets/Cargo.toml | head -1)\n325\t          echo \"version=$CURRENT_VERSION\" >> $GITHUB_OUTPUT\n326\t\n327\t      - name: Build release\n328\t        if: steps.check.outputs.should_release == 'true'\n329\t        run: cargo build --release --all-features\n330\t\n331\t      - name: Create GitHub Release\n332\t        if: steps.check.outputs.should_release == 'true'\n333\t        env:\n334\t          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n335\t        run: |\n336\t          node scripts/create-github-release.mjs \\\n337\t            --release-version \"${{ steps.current_version.outputs.version }}\" \\\n338\t            --repository \"${{ github.repository }}\"\n339\t\n340\t  # Manual release via workflow_dispatch - only after CI passes\n341\t  manual-release:\n342\t    name: Manual Release\n343\t    needs: [lint, test, build]\n344\t    if: github.event_name == 'workflow_dispatch'\n345\t    runs-on: ubuntu-latest\n346\t    permissions:\n347\t      contents: write\n348\t    steps:\n349\t      - uses: actions/checkout@v4\n350\t        with:\n351\t          fetch-depth: 0\n352\t          token: ${{ secrets.GITHUB_TOKEN }}\n353\t\n354\t      - name: Setup Rust\n355\t        uses: dtolnay/rust-toolchain@master\n356\t        with:\n357\t          toolchain: nightly-2022-08-22\n358\t\n359\t      - name: Setup Node.js\n360\t        uses: actions/setup-node@v4\n361\t        with:\n362\t          node-version: '20.x'\n363\t\n364\t      - name: Configure git\n365\t        run: |\n366\t          git config user.name \"github-actions[bot]\"\n367\t          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n368\t\n369\t      - name: Collect changelog fragments\n370\t        run: |\n371\t          # Check if there are any fragments to collect\n372\t          FRAGMENTS=$(find changelog.d -name \"*.md\" ! -name \"README.md\" 2>/dev/null | wc -l)\n373\t          if [ \"$FRAGMENTS\" -gt 0 ]; then\n374\t            echo \"Found $FRAGMENTS changelog fragment(s), collecting...\"\n375\t            node scripts/collect-changelog.mjs\n376\t          else\n377\t            echo \"No changelog fragments found, skipping collection\"\n378\t          fi\n379\t\n380\t      - name: Version and commit\n381\t        id: version\n382\t        run: |\n383\t          node scripts/version-and-commit.mjs \\\n384\t            --bump-type \"${{ github.event.inputs.bump_type }}\" \\\n385\t            --description \"${{ github.event.inputs.description }}\"\n386\t\n387\t      - name: Build release\n388\t        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n389\t        run: cargo build --release --all-features\n390\t\n391\t      - name: Create GitHub Release\n392\t        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n393\t        env:\n394\t          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n395\t        run: |\n396\t          node scripts/create-github-release.mjs \\\n397\t            --release-version \"${{ steps.version.outputs.new_version }}\" \\\n398\t            --repository \"${{ github.repository }}\"\n399\t"
