922|         if tag == UNIX_DIAG_RQLEN and size == attribute.size + 8:\\n00923|             counters = struct.unpack_from(\\\"=II\\\", response, value)\\n00924|         offset += (size + 3) & ~3\\n00925|     return (*counters, peer) if counters else None\\n00926| \\n00927| try:\\n00928|     with socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_SOCK_DIAG) as diagnostic, os.scandir(sys.argv[1]) as descriptors:\\n00929|         diagnostic.settimeout(1)\\n00930|         diagnostic.connect((0, 0))\\n00931|         for descriptor in itertools.islice(descriptors, 512):\\n00932|             try:\\n00933|                 target = os.readlink(descriptor.path)\\n00934|             except FileNotFoundError:\\n00935|                 continue\\n00936|             match = re.fullmatch(r\\\"socket:\\\\[(\\\\d+)\\\\]\\\", target)\\n00937|             if not match:\\n00938|                 continue\\n00939|             inode = int(match[1])\\n00940|             if not 0 < inode <= 0xFFFFFFFF:\\n00941|                 continue\\n00942|             result = queues(inode)\\n00943|             if result:\\n00944|                 received, sent, peer = result\\n00945|                 peer_queues = queues(peer) if peer else None\\n00946|                 print(inode, descriptor.name, received, sent, peer_queues[1] if peer_queues else \\\"unknown\\\")\\n00947| except (OSError, ValueError, struct.error):\\n00948|     sys.exit(1)\\n00949| UNIX_QUEUES\\n00950| }\\n00951| \\n00952| started=$(process_start)\\n00953| if [[ ! $started ]]; then\\n00954|   printf 'Process %s is unavailable in the container\\\\n' \\\"$1\\\" >&2\\n00955|   exit 1\\n00956| fi\\n00957| socket_evidence=false\\n00958| if command -v python3 >/dev/null && command -v timeout >/dev/null && first_queues=$(socket_sample); then socket_evidence=true; fi\\n00959| first_io=$(cat \\\"$proc/io\\\" 2>/dev/null)\\n00960| sleep 2\\n00961| last_io=$(cat \\\"$proc/io\\\" 2>/dev/null)\\n00962| if $socket_evidence && ! last_queues=$