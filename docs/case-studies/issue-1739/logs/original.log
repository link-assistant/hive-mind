          "+        tokens: Vec::new(),",
          "+        children: Vec::new(),",
          "+    };",
          "+    let mut stack: Vec<(i32, *mut LinoNode)> = vec![(-1, &mut root as *mut _)];",
          "+    for raw in text.lines() {",
          "+        let trimmed = raw.trim();",
          "+        if trimmed.is_empty() || trimmed.starts_with(\"//\") {",
          "+            continue;",
          "+        }",
