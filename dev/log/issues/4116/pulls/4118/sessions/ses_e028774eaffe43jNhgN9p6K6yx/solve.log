free disk space before every task. hive used to check it once at\\n00578|         // startup, so a run whose kept workspaces filled the disk kept spawning solvers that died\\n00579|         // in their own pre-flight check — and each of those was counted as a *task* failure\\n00580|         // (`❌ 4 task(s) failed (completed: 6)`). Reclaim idle workspaces, wait for in-flight ones,\\n00581|         // and defer the task rather than burn it.\\n00582|         if (!argv.dryRun) {\\n00583|           const requiredDiskSpaceMB = argv.minDiskSpace || 10240;\\n00584|           const otherWorkInFlight = issueQueue.getStats().processing > 1;\\n00585|           const diskGuard = await ensureDiskSpaceForWorker({\\n00586|             requiredMB: requiredDiskSpaceMB,\\n00587|             protectedPaths: getProtectedWorkspacePaths(),\\n00588|             maxWaitMs: otherWorkInFlight ? DISK_SPACE_WAIT_MS : 0,\\n00589|             // Issue #2187: with --auto-cleanup the guard may also drop images a\\n00590|             // rebuild superseded before it defers the task.\\n00591|             dockerImageReclaimMode: resolveDockerImageReclaimMode(argv),\\n00592|             log,\\n00593|           });\\n00594|           if (!diskGuard.ok) {\\n00595|             const deferrals = issueQueue.requeue(issueUrl);\\n00596|             await log(`   ⏸️  Worker ${workerId} deferred ${issueUrl}: ${diskGuard.freeMB}MB free, ${requiredDiskSpaceMB}MB required (deferral ${deferrals}/${MAX_DISK_SPACE_DEFERRALS}, not a task failure)`, { level: 'warning' });\\n00597|             if (deferrals >= MAX_DISK_SPACE_DEFERRALS && issueQueue.getStats().processing === 0) {\\n00598|               diskSpaceHalt = `Insufficient disk space: ${diskGuard.freeMB}MB free, ${requiredDiskSpaceMB}MB required`;\\n00599|               await log('   🛑 Stopping: no in-flight work can release disk space. Free space on this host (or enable --auto-cleanup) and rerun.', { level: 'error' });\\n00600|               // Issue #2187: the