      {
        "tool_use_id": "toolu_01S8QXJQ2i5Kkfnt3ewU9nwr",
        "type": "tool_result",
        "content": "1\t/**\n2\t * Mutating API routes: links CRUD, pattern persistence + inference,\n3\t * graphs persistence + run, replies CRUD, profile + resume sync.\n4\t *\n5\t * Each endpoint returns plain JSON. The store is the single source of\n6\t * truth; nothing is held in server-side memory.\n7\t */\n8\t\n9\timport { json, readBody } from './util.js';\n10\timport { inferRegex, simplifyRegex, inferRegexLcs } from '../patterns/index.js';\n11\timport { runGraph } from '../automation/index.js';\n12\timport { listSources } from '../sources/index.js';\n13\t\n14\tconst handleLinks = async (store, req, res, p) => {\n15\t  if (p === '/links' && req.method === 'GET') {\n16\t    return json(res, 200, await store.query()) ?? true;\n17\t  }\n18\t  if (p === '/links' && req.method === 'PUT') {\n19\t    const link = await readBody(req);\n20\t    await store.put(link);\n21\t    return json(res, 200, link) ?? true;\n22\t  }\n23\t  const m = p.match(/^\\/links\\/(.+)$/);\n24\t  if (!m) {\n25\t    return false;\n26\t  }\n27\t  if (req.method === 'GET') {\n28\t    const link = await store.get(decodeURIComponent(m[1]));\n29\t    return (\n30\t      (link ? json(res, 200, link) : json(res, 404, { error: 'not found' })) ??\n31\t      true\n32\t    );\n33\t  }\n34\t  if (req.method === 'DELETE') {\n35\t    const ok = await store.delete(decodeURIComponent(m[1]));\n36\t    return json(res, ok ? 200 : 404, { ok }) ?? true;\n37\t  }\n38\t  return false;\n39\t};\n40\t\n41\tconst handlePrefixedPut = async (store, req, res, prefix, kind) => {\n42\t  const link = await readBody(req);\n43\t  if (!link.id?.startsWith(`${prefix}:`)) {\n44\t    return json(res, 400, { error: `${kind}.id must start with \"${prefix}:\"` });\n45\t  }\n46\t  await store.put(link);\n47\t  return json(res, 200, link);\n48\t};\n49\t\n50\tconst handlePrefixedGet = async (store, res, prefix) => {\n51\t  const all = await store.query();\n52\t  return json(\n53\t    res,\n54\t    200,\n55\t    all.filter((l) => l.id?.startsWith(`${prefix}:`))\n56\t  );\n57\t};\n58\t\n59\tconst handlePatternInfer = async (req, res) => {\n60\t  const { examples, mode = 'simple' } = await readBody(req);\n61\t  const regex =\n62\t    mode === 'lcs'\n63\t      ? inferRegexLcs(examples ?? [])\n64\t      : simplifyRegex(inferRegex(examples ?? []));\n65\t  return json(res, 200, { regex: regex.source, flags: regex.flags });\n66\t};\n67\t\n68\tconst handlePatterns = async (store, req, res, p) => {\n69\t  if (p === '/api/patterns' && req.method === 'GET') {\n70\t    return handlePrefixedGet(store, res, 'pattern') ?? true;\n71\t  }\n72\t  if (p === '/api/patterns' && req.method === 'PUT') {\n73\t    return handlePrefixedPut(store, req, res, 'pattern', 'pattern') ?? true;\n74\t  }\n75\t  if (p === '/api/patterns/infer' && req.method === 'POST') {\n76\t    return handlePatternInfer(req, res) ?? true;\n77\t  }\n78\t  return false;\n79\t};\n80\t\n81\tconst handleGraphRun = async (store, req, res) => {\n82\t  const { id, message, mode = 'semi' } = await readBody(req);\n83\t  const persisted = await store.get(id);\n84\t  if (!persisted) {\n85\t    return json(res, 404, { error: `graph ${id} not found` });\n86\t  }\n87\t  return json(res, 200, runGraph(hydrateGraph(persisted), message, { mode }));\n88\t};\n89\t\n90\tconst handleGraphs = async (store, req, res, p) => {\n91\t  if (p === '/api/graphs' && req.method === 'GET') {\n92\t    return handlePrefixedGet(store, res, 'graph') ?? true;\n93\t  }\n94\t  if (p === '/api/graphs' && req.method === 'PUT') {\n95\t    return handlePrefixedPut(store, req, res, 'graph', 'graph') ?? true;\n96\t  }\n97\t  if (p === '/api/graphs/run' && req.method === 'POST') {\n98\t    return handleGraphRun(store, req, res) ?? true;\n99\t  }\n100\t  return false;\n101\t};\n102\t\n103\tconst hydrateGraph = (persisted) => {\n104\t  const nodes = new Map();\n105\t  for (const n of persisted.nodes ?? []) {\n106\t    nodes.set(n.id, {\n107\t      ...n,\n108\t      regex: n.regex ? new RegExp(n.regex, n.flags ?? 'i') : undefined,\n109\t      group: n.group,\n110\t    });\n111\t  }\n112\t  return { nodes, edges: persisted.edges ?? [] };\n113\t};\n114\t\n115\tconst handleReplies = async (store, req, res, p) => {\n116\t  if (p === '/api/replies' && req.method === 'GET') {\n117\t    return handlePrefixedGet(store, res, 'reply') ?? true;\n118\t  }\n119\t  if (p === '/api/replies' && req.method === 'PUT') {\n120\t    return handlePrefixedPut(store, req, res, 'reply', 'reply') ?? true;\n121\t  }\n122\t  return false;\n123\t};\n124\t\n125\tconst handleProfile = async (store, req, res, p) => {\n126\t  if (p === '/api/profile' && req.method === 'GET') {\n127\t    const profile = await store.get('profile:me');\n128\t    return (\n129\t      json(res, 200, profile ?? { id: 'profile:me', tokens: ['profile'] }) ??\n130\t      true\n131\t    );\n132\t  }\n133\t  if (p === '/api/profile' && req.method === 'PUT') {\n134\t    const profile = await readBody(req);\n135\t    profile.id = 'profile:me';\n136\t    profile.tokens = profile.tokens ?? ['profile'];\n137\t    await store.put(profile);\n138\t    return (\n139\t      json(res, 200, {\n140\t        profile,\n141\t        plannedSyncs: listSources().map((s) => ({\n142\t          source: s,\n143\t          status: 'queued',\n144\t        })),\n145\t      }) ?? true\n146\t    );\n147\t  }\n148\t  return false;\n149\t};\n150\t\n151\tconst handleResume = async (store, req, res, p) => {\n152\t  if (p === '/api/resume' && req.method === 'GET') {\n153\t    const resume = await store.get('resume:me');\n154\t    return (\n155\t      json(res, 200, resume ?? { id: 'resume:me', tokens: ['resume'] }) ?? true\n156\t    );\n157\t  }\n158\t  if (p === '/api/resume' && req.method === 'PUT') {\n159\t    const resume = await readBody(req);\n160\t    resume.id = 'resume:me';\n161\t    resume.tokens = resume.tokens ?? ['resume'];\n162\t    await store.put(resume);\n163\t    const targets = ['hh', 'habr-career', 'superjob', 'linkedin'];\n164\t    return (\n165\t      json(res, 200, {\n166\t        resume,\n167\t        plannedSyncs: targets.map((s) => ({ source: s, status: 'queued' })),\n168\t      }) ?? true\n169\t    );\n170\t  }\n171\t  return false;\n172\t};\n173\t\n174\tconst handleBroadcast = async (store, req, res, p) => {\n175\t  if (p !== '/api/broadcast' || req.method !== 'POST') {\n176\t    return false;\n177\t  }\n178\t  const { text: body, networks } = await readBody(req);\n179\t  const targets = (networks ?? listSources()).filter((n) =>\n180\t    listSources().includes(n)\n181\t  );\n182\t  const post = {\n183\t    id: `broadcast:${Date.now()}`,\n184\t    tokens: ['broadcast', ...targets],\n185\t    body,\n186\t    networks: targets,\n187\t    timestamp: new Date().toISOString(),\n188\t    status: 'queued',\n189\t  };\n190\t  await store.put(post);\n191\t  return json(res, 200, post) ?? true;\n192\t};\n193\t\n194\texport const handleMutatingRoutes = async (store, req, res, p) =>\n195\t  (await handleLinks(store, req, res, p)) ||\n196\t  (await handlePatterns(store, req, res, p)) ||\n197\t  (await handleGraphs(store, req, res, p)) ||\n198\t  (await handleReplies(store, req, res, p)) ||\n199\t  (await handleProfile(store, req, res, p)) ||\n200\t  (await handleResume(store, req, res, p)) ||\n201\t  (await handleBroadcast(store, req, res, p));\n202\t"
      }
    ]
  },
