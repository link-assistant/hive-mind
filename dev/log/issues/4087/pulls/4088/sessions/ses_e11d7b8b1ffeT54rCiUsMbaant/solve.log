ng the heading.\n00466|               const commentBody = appendIssueClosingSection(`## 🎉 ${AUTO_MERGED_MARKER}\\n\\nThis pull request has been automatically merged by hive-mind.\\n${ciLine}`, mergeResult.issueClosing);\n00467|               await postTrackedComment({ $, owner, repo, targetNumber: prNumber, body: commentBody });\n00468|             } catch {\n00469|               // Don't fail if comment posting fails\n00470|             }\n00471|             return { success: true, reason: 'auto-merged', latestSessionId, latestAnthropicCost };\n00472|           } else {\n00473|             if (mergeResult.blocker) {\n00474|               await reportAutoMergeBlockedByIssue({ owner, repo, prNumber, issueNumber, mergeBlockers: [mergeResult.blocker], verbose: argv.verbose, attachLogWithNotice });\n00475|               return { success: false, reason: mergeResult.category, mergeBlockers: [mergeResult.blocker], latestSessionId, latestAnthropicCost };\n00476|             }\n00477|             // Issue #2182: an unclassified merge failure used to be logged as\n00478|             // \"Will continue monitoring...\" and retried every 120 seconds\n00479|             // forever (5384 identical failures in the reported run). Classify\n00480|             // it: self-heal what we can, stop on terminal causes, and cap the\n00481|             // number of consecutive failures for everything else.\n00482|             const decision = await resolveMergeFailure({ error: mergeResult.error, owner, repo, prNumber, $, log, formatAligned, reportError, reportAutomationStop, verbose: argv.verbose, state: guardState });\n00483|             if (decision.action === 'stop') {\n00484|               return { success: false, reason: decision.reason, error: mergeResult.error, latestSessionId, latestAnthropicCost };\n00485|             }\n00486|             if (decision.action === 'retry') {\n00487|               lastCheckTime = currentTime;\n00488|               await interruptibleSleep(DRAFT_RECHEC