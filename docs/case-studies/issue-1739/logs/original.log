        "type": "tool_result",
        "content": "1\t/**\n2\t * CRM module (R-D1..R-D4).\n3\t *\n4\t * - `aggregateContact(store, contactId)` collects every link\n5\t *   referencing the contact into a single view.\n6\t * - Set-algebra over saved queries: `intersect`, `union`, `difference`.\n7\t * - `localSearch` runs a Dice-similarity scan over messages, contacts,\n8\t *   chats, communities — the simplest implementation that satisfies\n9\t *   \"configurable parameters\" without taking a search-index dep yet.\n10\t */\n11\t\n12\timport { dice } from '../replies/index.js';\n13\t\n14\texport const aggregateContact = async (store, contactId) => {\n15\t  const all = await store.query();\n16\t  const messages = all.filter(\n17\t    (l) =>\n18\t      l.sender === contactId || l.children?.some((c) => c.includes(contactId))\n19\t  );\n20\t  const chats = new Set(messages.map((m) => m.chat));\n21\t  return {\n22\t    id: contactId,\n23\t    chats: [...chats],\n24\t    messageCount: messages.length,\n25\t    messages,\n26\t  };\n27\t};\n28\t\n29\texport const intersect = (a, b) => {\n30\t  const idsB = new Set(b.map((l) => l.id));\n31\t  return a.filter((l) => idsB.has(l.id));\n32\t};\n33\texport const union = (a, b) => {\n34\t  const map = new Map();\n35\t  [...a, ...b].forEach((l) => map.set(l.id, l));\n36\t  return [...map.values()];\n37\t};\n38\texport const difference = (a, b) => {\n39\t  const idsB = new Set(b.map((l) => l.id));\n40\t  return a.filter((l) => !idsB.has(l.id));\n41\t};\n42\t\n43\texport const localSearch = async (\n44\t  store,\n45\t  { query, fields = ['body'], min = 0.3 } = {}\n46\t) => {\n47\t  const all = await store.query();\n48\t  return all\n49\t    .map((l) => {\n50\t      const hay = fields\n51\t        .map((f) => l[f])\n52\t        .filter((v) => typeof v === 'string')\n53\t        .join(' ');\n54\t      return { link: l, score: hay ? dice(query, hay) : 0 };\n55\t    })\n56\t    .filter((r) => r.score >= min)\n57\t    .sort((a, b) => b.score - a.score);\n58\t};\n59\t"
