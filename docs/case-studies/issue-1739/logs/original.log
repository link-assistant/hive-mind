          "+const parseAudience = (expr) => {",
          "+  const tokens = String(expr ?? '')",
          "+    .replace(/([(),])/g, ' $1 ')",
          "+    .split(/\\s+/)",
          "+    .filter(Boolean);",
          "+  let i = 0;",
          "+  const peek = () => tokens[i];",
