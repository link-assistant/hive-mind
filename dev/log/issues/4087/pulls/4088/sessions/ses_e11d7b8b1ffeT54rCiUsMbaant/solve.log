nsensus } = githubMergeLib;\n00035| const { createStuckCiMonitor } = await import('./solve.auto-merge-stuck-ci.lib.mjs'); // Issue #4048: explain stuck CI waits, recover ghost runs\n00036| // Issue #2182: guard rails for this loop (wall-clock ceiling, draft self-heal,\n00037| // classified merge failures). See solve.auto-merge-guards.lib.mjs.\n00038| const autoMergeGuards = await import('./solve.auto-merge-guards.lib.mjs');\n00039| const { buildDeliberateDraftFeedback, DRAFT_RECHECK_DELAY_MS, evaluateWatchTimeout, resolveDraftBlocker, resolveMergeFailure, revertPlaceholderBeforeMerge } = autoMergeGuards;\n00040| // Re-exported so callers and tests keep a single entry point for the watch loop.\n00041| export const { DEFAULT_WATCH_TIMEOUT_HOURS, normalizeWatchTimeoutHours } = autoMergeGuards;\n00042| // Import GitHub functions for log attachment\n00043| const githubLib = await import('./github.lib.mjs');\n00044| const { sanitizeLogContent, attachLogToGitHub } = githubLib;\n00045| \n00046| // Import shared utilities from the restart-shared module\n00047| import * as restartShared from './solve.restart-shared.lib.mjs';\n00048| const { checkPRMerged, checkForUncommittedChanges, getUncommittedChangesDetails, executeToolIteration, buildAutoRestartInstructions, buildUncommittedChangesFeedback, isUsageLimitReached } = restartShared;\n00049| // Issue #1931: deleted/inaccessible repositories, PRs, issues, and branches\n00050| // are terminal states for long-running watch loops, not retryable CI states.\n00051| const terminalStateLib = await import('./github-terminal-state.lib.mjs');\n00052| const { checkGitHubTerminalState } = terminalStateLib;\n00053| // Issue #2144: these probes answer with a ~33 KB pull request object and a full\n00054| // issue object on every iteration. Issue #2130 made the helper's own default\n00055| // runner quiet, but passing `$` here bypassed it and the payloads were still\n00056| // mirrored into the attached log. Bind the quiet options to the injected `$`.\n00057| const { quietProbe } = await import('./quiet-probe.lib.mjs');\n00058| // Issue #2144: a closed linked issue is NOT terminal — it only blocks the final\n00059| // automatic merge. Every stop of this loop is also published as a GitHub comment\n00060| // stating exactly why it stopped.\n00061| const stopReportingLib = await import('./automation-stop-reporting.lib.mjs');\n00062| const { reportAutomationStop } = stopReportingLib;\n00063| // Issue #2301: a failed AI session in this loop fails the run (see automation-failure.lib.mjs).\n00064| const { recordLoopToolFailure } = await import('./automation-failure.lib.mjs');\n00065| // Issue #2306: never auto-merge a pull request that leaves required issues open.\n00066| const { checkClosingReferencesBeforeMerge } = await import('./solve.ensure-sub-issues.lib.mjs');\n00067| // Issue #2395: never auto-merge a pull request that is not linked to its issue; a breaker stop continues with feedback.\n00068| const { ensureIssueLinkBeforeMerge } = await import('./pr-issue-link-merge-gate.lib.mjs');\n00069| const { isRestartWithFeedback, reportSessionStoppedForFeedback } = await import('./solve.auto-merge-session-stop.lib.mjs');\n00070| const { resumeAfterToolKill } = await import('./solve.tool-kill-resume.lib.mjs'); // Issue #2408\n00071| // Import validation functions for time parsing (used for usage limit wait)\n00072| const validation = await import('./solve.validation.lib.mjs');\n00073| const { calculateWaitTime } = validation;\n00074| // Import configuration (used for limit reset buffer and jitter)\n00075| import { ciFailureRepeat, limitReset } from './config.lib.mjs';\n00076| // Import helper functions extracted for file size management (Issue #1593)\n00077| const autoMergeHelpers = await import('./solve.auto-merge-helpers.lib.mjs');\n00078| const { checkForExistingComment, checkForNonBotComments, checkForIssueMetadataChanges, getMergeBlockers, shouldResetNoRunsCounter, trackAuthenticatedUserCommentsSince, nextM