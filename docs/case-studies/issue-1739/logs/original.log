        "type": "tool_result",
        "content": "1\t/**\n2\t * Telegram source adapter.\n3\t *\n4\t * `parseArchive` accepts the JSON shape produced by Telegram Desktop's\n5\t * \"Export chat history\" feature. Live API integration (MTProto via\n6\t * konard/telegram-bot, konard/telegramify-markdown) is stubbed in\n7\t * `live` and will be implemented in a follow-up PR (R-E2).\n8\t */\n9\t\n10\timport { buildMessageLink } from './index.js';\n11\t\n12\tconst SOURCE = 'telegram';\n13\t\n14\tconst fromTextEntity = (text) => {\n15\t  if (typeof text === 'string') {\n16\t    return text;\n17\t  }\n18\t  if (Array.isArray(text)) {\n19\t    return text.map(fromTextEntity).join('');\n20\t  }\n21\t  if (text && typeof text === 'object' && 'text' in text) {\n22\t    return text.text;\n23\t  }\n24\t  return '';\n25\t};\n26\t\n27\texport const telegramSource = {\n28\t  name: SOURCE,\n29\t  async parseArchive(archive) {\n30\t    const obj = typeof archive === 'string' ? JSON.parse(archive) : archive;\n31\t    const chats = obj.chats?.list ?? (obj.name ? [obj] : []);\n32\t    const out = [];\n33\t    for (const chat of chats) {\n34\t      for (const msg of chat.messages ?? []) {\n35\t        if (msg.type !== 'message') {\n36\t          continue;\n37\t        }\n38\t        out.push(\n39\t          buildMessageLink({\n40\t            source: SOURCE,\n41\t            externalId: String(msg.id),\n42\t            sender: String(msg.from_id ?? msg.from ?? 'unknown'),\n43\t            chat: String(chat.id ?? chat.name),\n44\t            body: fromTextEntity(msg.text),\n45\t            timestamp: msg.date,\n46\t            replyTo: msg.reply_to_message_id\n47\t              ? String(msg.reply_to_message_id)\n48\t              : null,\n49\t          })\n50\t        );\n51\t      }\n52\t    }\n53\t    return out;\n54\t  },\n55\t  live: {\n56\t    async listChats() {\n57\t      throw new Error('telegram live API: not implemented yet (R-E2)');\n58\t    },\n59\t  },\n60\t};\n61\t"
