        "content": "1\t/**\n2\t * Universal Links Access interface.\n3\t *\n4\t * Every storage backend (text-only `.lino`, binary doublets, dual store,\n5\t * or a remote HTTP client) implements the same API so callers do not\n6\t * care which substrate is underneath. This is requirement R-F8.\n7\t *\n8\t * A \"link\" is `{ id: string, tokens: string[], children?: string[] }`.\n9\t * `tokens` are the human-readable payload; `children` is an optional\n10\t * list of child link IDs for hierarchical structures.\n11\t */\n12\t\n13\t/**\n14\t * @typedef {Object} Link\n15\t * @property {string} id\n16\t * @property {string[]} tokens\n17\t * @property {string[]} [children]\n18\t */\n19\t\n20\t/**\n21\t * @typedef {Object} UniversalLinksAccess\n22\t * @property {(link: Link) => Promise<Link>} put\n23\t * @property {(id: string) => Promise<Link | null>} get\n24\t * @property {(id: string) => Promise<boolean>} delete\n25\t * @property {(filter?: (l: Link) => boolean) => Promise<Link[]>} query\n26\t * @property {(handler: (event: {type: string, link: Link}) => void) => () => void} subscribe\n27\t */\n28\t\n29\texport const createMemoryStore = () => {\n30\t  const data = new Map();\n31\t  const handlers = new Set();\n32\t  const emit = (event) => handlers.forEach((h) => h(event));\n33\t\n34\t  return {\n35\t    async put(link) {\n36\t      if (!link || typeof link.id !== 'string') {\n37\t        throw new Error('link.id is required');\n38\t      }\n39\t      data.set(link.id, { ...link });\n40\t      emit({ type: 'put', link });\n41\t      return link;\n42\t    },\n43\t    async get(id) {\n44\t      const v = data.get(id);\n45\t      return v ? { ...v } : null;\n46\t    },\n47\t    async delete(id) {\n48\t      const existed = data.has(id);\n49\t      const link = data.get(id);\n50\t      data.delete(id);\n51\t      if (existed) {\n52\t        emit({ type: 'delete', link });\n53\t      }\n54\t      return existed;\n55\t    },\n56\t    async query(filter) {\n57\t      const all