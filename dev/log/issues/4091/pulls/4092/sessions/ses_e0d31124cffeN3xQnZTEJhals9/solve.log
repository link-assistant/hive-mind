  "bodyPreview": "data: {\"choices\":[{\"delta\":{\"role\":\"assistant\"},\"finish_reason\":null,\"index\":0}],\"created\":1795075026,\"id\":\"chatcmpl_b7335487d19b9564\",\"model\":\"formal-ai\",\"object\":\"chat.completion.chunk\"}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"{\\\"authored\\\":false,\\\"coverage\\\":\\\"explicit-paths-only; at most eight files\\\",\\\"decomposition\\\":[{\\\"status\\\":\\\"incomplete\\\",\\\"step\\\":\\\"collect_repository_evidence\\\"},{\\\"status\\\":\\\"unverified\\\",\\\"step\\\":\\\"bind_requirements_to_source\\\"},{\\\"status\\\":\\\"not_executed\\\",\\\"step\\\":\\\"implement_requested_change\\\"},{\\\"status\\\":\\\"not_executed\\\",\\\"step\\\":\\\"verify_artifact_and_requirements\\\"}],\\\"observations\\\":[],\\\"reason\\\":\\\"ReadPolicyRefused\\\",\\\"requirements\\\":[{\\\"span\\\":[0,9932],\\\"status\\\":\\\"unbound\\\",\\\"text\\\":\\\"Session stuck for 5+ hours after posting its final log: watch loop waits without limit on a HEAD workflow run held in a concurrency queue (status pending, 0 jobs); no finish/auto-continue, Telegram still shows Executing · Issue #4091 · link-assistant/hive-mind · GitHub\\\\n\\\\n\\\\n\\\\n  \\\\n  \\\\n  \\\\n  \\\\n\\\\n    \\\\n  \\\\n\\\\n\\\\n  \\\\n\\\\n\\\\n    \\\\n\\\\n\\\\n  \\\\n  \\\\n\\\\n  \\\\n  \\\\n\\\\n    \\\\n\\\\n\\\\n\\\\n\\\\n\\\\n\\\\n\\\\n  \\\\n\\\\n  \\\\n\\\\n\\\\n\\\\n\\\\n    \\\\n\\\\n  \\\\n\\\\n    \\\\n\\\\n    \\\\n\\\\n      \\\\n\\\\n      \\\\n\\\\n    \\\\n    \\\\n    \\\\n\\\\n      \\\\n  \\\\n  \\\\n\\\\n\\\\n\\\\n      \\\\n\\\\n\\\\n\\\\n        \\\\n\\\\n\\\\n  \\\\n  \\\\n  \\\\n  \\\\n\\\\n  \\\\n\\\\n      \\\\n  \\\\n\\\\n  \\\\n  \\\\n\\\\n\\\\n\\\\n      \\\\n\\\\n\\\\n    \\\\n  \\\\n\\\\n\\\\n  \\\\n\\\\n\\\\n  \\\\n\\\\n  \\\\n  \\\\n\\\\n  \\\\n  \\\\n  \\\\n\\\\n\\\\n\\\\n\\\\n\\\\n  \\\\n\\\\n  \\\\n\\\\n  \\\\n    \\\\n      \\\\n      \\\\n\\\\n    \\\\n      Skip to content\\\\n\\\\n      \\\\n    \\\\n      \\\\n      \\\\