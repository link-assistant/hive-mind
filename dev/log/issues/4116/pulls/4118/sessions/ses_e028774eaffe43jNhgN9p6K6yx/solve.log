on-check');\\n00646|             if (argv.dryRun) args.push('--dry-run');\\n00647|             if (argv.autoCleanup) args.push('--auto-cleanup');\\n00648|             const SKIP_AUTO_FORWARD = new Set(['model', 'worker-model', 'base-branch', 'skip-tool-connection-check', 'tool-connection-check', 'skip-tool-check', 'skip-claude-check', 'tool-check', 'dry-run', 'auto-cleanup']);\\n00649|             // Issue #3190: shared, definition-driven serializer (also guards issue #1718's `false` string defaults)\\n00650|             const { buildArgsFromParsedArgv } = await import('./cli-option-forwarding.lib.mjs');\\n00651|             args.push(...buildArgsFromParsedArgv({ argv, definitions: SOLVE_OPTION_DEFINITIONS, optionNames: getSolvePassthroughOptionNames(), skip: SKIP_AUTO_FORWARD }));\\n00652|             // Log the actual command being executed so users can investigate/reproduce\\n00653|             await log(`   📋 Command: ${solveCommand} ${args.join(' ')}`);\\n00654|             let exitCode = 0;\\n00655|             // Create promise to handle async spawn process\\n00656|             await new Promise(resolve => {\\n00657|               const child = spawn(solveCommand, args, {\\n00658|                 stdio: ['pipe', 'pipe', 'pipe'],\\n00659|                 env: process.env,\\n00660|                 // Issue #1823: run solve in its own process group so a terminal SIGINT (or the\\n00661|                 // \\\\003 `$ --stop`/screen injects) hits only hive, not solve+codex. hive instead\\n00662|                 // forwards a controlled SIGTERM (see gracefulShutdown). stdio stays piped and we\\n00663|                 // must NOT unref() — hive keeps waiting. See docs/case-studies/issue-1823.\\n00664|                 detached: true,\\n00665|               });\\n00666|               // Issue #1823: register the in-flight child for optional force-kill on a 2nd signal\\n00667|               activeSolveChildren.add(child);\\n00668|               // Issue #2160: start col