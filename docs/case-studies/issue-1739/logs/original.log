        "type": "tool_result",
        "content": "1\t/**\n2\t * meta-sovereign CLI (R-F2).\n3\t *\n4\t * Subcommands: `import`, `export`, `backup`, `restore`, `serve`,\n5\t * `sources`. Returns the exit code instead of calling `process.exit`\n6\t * so it stays unit-testable.\n7\t */\n8\t\n9\timport path from 'node:path';\n10\timport { promises as fs } from 'node:fs';\n11\timport { parseArgs } from './lino-args.js';\n12\timport {\n13\t  createDualStore,\n14\t  createLinoTextStore,\n15\t  createDoubletsStore,\n16\t} from '../storage/index.js';\n17\timport {\n18\t  createBackup,\n19\t  pruneBackups,\n20\t  restoreBackup,\n21\t} from '../storage/backup.js';\n22\timport { listSources, importInto } from '../sources/index.js';\n23\timport { startServer } from '../server/index.js';\n24\t\n25\tconst HELP = `meta-sovereign <command> [options]\n26\t\n27\tCommands:\n28\t  import   --source=<name> --file=<path> --store=<dir>\n29\t  export   --file=<path> --store=<dir>\n30\t  backup   --store=<dir> --archive=<dir> [--keep=<n>]\n31\t  restore  --file=<path> --store=<dir>\n32\t  serve    [--port=<n>] [--store=<dir>]\n33\t  sources\n34\t  help\n35\t`;\n36\t\n37\tconst openStore = async (dir) => {\n38\t  await fs.mkdir(dir, { recursive: true });\n39\t  const text = await createLinoTextStore(path.join(dir, 'data.lino'));\n40\t  const binary = await createDoubletsStore(path.join(dir, 'data.bin'));\n41\t  return createDualStore({ binary, text });\n42\t};\n43\t\n44\tconst importCmd = async (args, log) => {\n45\t  const file = args.file;\n46\t  const archive = await fs.readFile(file, 'utf8');\n47\t  const parsed = file.endsWith('.json') ? JSON.parse(archive) : archive;\n48\t  const store = await openStore(args.store ?? '.meta-sovereign');\n49\t  const n = await importInto(store, args.source, parsed);\n50\t  log(`imported ${n} messages from ${args.source}`);\n51\t  return 0;\n52\t};\n53\t\n54\tconst exportCmd = async (args, log) => {\n55\t  const store = await openStore(args.store ?? '.meta-sovereign');\n56\t  const links = await store.query();\n57\t  await fs.writeFile(args.file, JSON.stringify(links, null, 2));\n58\t  log(`exported ${links.length} links to ${args.file}`);\n59\t  return 0;\n60\t};\n61\t\n62\tconst backupCmd = async (args, log) => {\n63\t  const store = await openStore(args.store ?? '.meta-sovereign');\n64\t  const file = await createBackup(store, { archiveDir: args.archive });\n65\t  if (args.keep) {\n66\t    await pruneBackups({ archiveDir: args.archive, keep: Number(args.keep) });\n67\t  }\n68\t  log(`backup written to ${file}`);\n69\t  return 0;\n70\t};\n71\t\n72\tconst restoreCmd = async (args, log) => {\n73\t  const store = await openStore(args.store ?? '.meta-sovereign');\n74\t  const n = await restoreBackup(store, args.file);\n75\t  log(`restored ${n} links from ${args.file}`);\n76\t  return 0;\n77\t};\n78\t\n79\tconst serveCmd = async (args, log) => {\n80\t  const handle = await startServer({\n81\t    port: Number(args.port ?? 8787),\n82\t    storeDir: args.store ?? '.meta-sovereign',\n83\t  });\n84\t  log(`meta-sovereign listening on http://127.0.0.1:${handle.port}`);\n85\t  return 0;\n86\t};\n87\t\n88\tconst sourcesCmd = async (_args, log) => {\n89\t  log(listSources().join('\\n'));\n90\t  return 0;\n91\t};\n92\t\n93\tconst COMMANDS = {\n94\t  import: importCmd,\n95\t  export: exportCmd,\n96\t  backup: backupCmd,\n97\t  restore: restoreCmd,\n98\t  serve: serveCmd,\n99\t  sources: sourcesCmd,\n100\t  help: async (_a, log) => {\n101\t    log(HELP);\n102\t    return 0;\n103\t  },\n104\t};\n105\t\n106\texport const runCli = async (argv, { log = console.log } = {}) => {\n107\t  const [cmd, ...rest] = argv;\n108\t  const handler = COMMANDS[cmd ?? 'help'];\n109\t  if (!handler) {\n110\t    log(HELP);\n111\t    return 1;\n112\t  }\n113\t  return handler(parseArgs(rest), log);\n114\t};\n115\t"
